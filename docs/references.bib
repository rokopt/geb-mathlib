@incollection{Clote1999,
  author    = {Clote, Peter},
  title     = {Computation models and function algebras},
  booktitle = {Handbook of Computability Theory},
  editor    = {Griffor, Edward R.},
  series    = {Studies in Logic and the Foundations of Mathematics},
  volume    = {140},
  publisher = {Elsevier},
  pages     = {589--681},
  year      = {1999},
  doi       = {10.1016/S0049-237X(99)80033-0},
  note      = {Theorem 3.20 is the arithmetic analogue of [Strahm2003]
               Theorem 1(2): over the naturals, with $*$ read as
               $2^{|y|}x + y$, with a value rather than a length proviso
               (Definition 3.18, which also carries an $x \ne 0$ guard
               forced by $s_0(0) = 0$), and with $\times$ ordinary
               multiplication rather than [Strahm2003]'s word
               multiplication --- the two operations named $\times$ must be
               distinguished before both sources are cited. Its GTimeSpace
               is not a bare simultaneous-resource class: Definition 2.13
               reads it as the functions of linear growth whose bitgraph
               lies in the class, and its space measure counts work-tape
               cells only. Footnote 10 records that limited and bounded
               name the same schemes here, both carrying the side
               condition; Definition 4.5's limited recursion on notation
               carries it explicitly.},
}

