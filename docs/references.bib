@article{Strahm2003,
  author  = {Strahm, Thomas},
  title   = {Theories with self-application and computational complexity},
  journal = {Information and Computation},
  volume  = {185},
  number  = {2},
  pages   = {263--297},
  year    = {2003},
  doi     = {10.1016/S0890-5401(03)00086-5},
  note    = {Section 2 defines bounded recursion on notation (BRN) and
             bounded lexicographic recursion (BRL) over binary words, and
             states in the same paragraph that in the proviso
             $F(\vec{x}, y) \le K(\vec{x}, y)$, ``$x \le y$ signifies that
             the length of the word $x$ is less than or equal to the length
             of the word $y$'' --- so the proviso is a length bound,
             agreeing with [HeraudNowak2011]. Theorem 1 gives the four
             function-algebra characterizations. Only the left-to-right
             inclusion of its item 2 is relied on here: the class carries
             no stated growth restriction or space convention, and read
             literally the equality fails, the smash being computable in
             polynomial time and logarithmic work space while lying outside
             the algebra. Section 4 attests ``cut-off'' for the clamp
             operator and for truncated subtraction, and defines the
             most-significant-part function msp.},
}

@incollection{Strahm2010,
