@article{Mazzanti2016,
  author  = {Mazzanti, Stefano},
  title   = {Unbounded Recursion and Non-size-increasing Functions},
  journal = {Electronic Notes in Theoretical Computer Science},
  volume  = {322},
  pages   = {197--210},
  year    = {2016},
  doi     = {10.1016/j.entcs.2016.03.014},
  note    = {Section 2 defines the size-bounded binary successors
             $\mathit{sbs}_i(x, y) = s_i(x)$ if $|s_i(x)| \le |y|$ and $x$
             otherwise, simultaneous recursion on notation (SRN) with no
             side condition, and the algebra $S(F) = \mathrm{clos}(F,
             \{C_n\}; \mathit{SUBST}, \mathit{SRN})$; Lemma 2.1 states that
             $S(F)$ is non-size-increasing when $F$ is, and Lemma 2.2 that
             it is polynomial-time when $F$ is, both without proof.
             Theorem 5.7 identifies $S(\mathit{sbs}_0, \mathit{sbs}_1)$ with
             the non-size-increasing functions computable simultaneously in
             polynomial time and linear space, through Theorem 5.2, the
             algebra $\mathrm{clos}(C_0, s_0, s_1, \max, \mathit{quad};
             \mathit{SUBST}, \mathit{BRN})$ it attributes to [Clote1999]
             Theorem 3.45. The paper works over the naturals in binary
             notation, where $s_0(0) = 0$ forces the guard $x > 0$ in the
             $i = 0$ recursion clause; over bitstrings both successors are
             injective and the guard is vacuous.},
}

@article{Kristiansen2005,
  author  = {Kristiansen, Lars},
  title   = {Neat Function Algebraic Characterizations of Logspace and Linspace},
  journal = {computational complexity},
  volume  = {14},
  pages   = {72--88},
  year    = {2005},
  doi     = {10.1007/s00037-005-0191-0},
  note    = {Section 4 characterizes the languages decidable in logarithmic
             space as those decided by a unary function of the algebra
             $[I, C_W; \mathit{comp}, \mathit{simn}]$: projections and
             word constants closed under composition and simultaneous
             recursion on notation, with no successor and no bound, a
             function deciding the language of the words it sends to the
             empty word (Theorem 4.7, Corollary 4.8). Lemma 4.5 states
             that for every function of the algebra there is an $m$ such
             that any value longer than $m$ is an end segment of one of
             the arguments; the logarithmic-space machine of Theorem 4.7
             represents each register by a status bit, $m$ bits of word
             and a binary end-segment length, and is left as a sketch.
             Lemmas 4.2 and 4.4, the completeness half, pass through the
             imperative language CLIP. Section 3 is the parallel
             characterization of linear-space $0$-$1$ valued functions by
             simultaneous recursion on the naturals.},
}

