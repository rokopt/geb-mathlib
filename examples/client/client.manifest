; The pinned library precedes the application that imports it.
(program client (edition 0) (document (syntax authoring 0) (schema 0) (prose verso 0))
  (layers (library (manifest geb/library/library.manifest))
    (application Client.geb Copy.geb Settings.geb Upgrade.geb))
  (entries Client.mirror Client.run Copy.step Settings.choose Settings.apply Upgrade.migrate))
