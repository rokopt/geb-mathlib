; The migration of an order that the client's previous revision saved, at version 1 of the encoding
; of {geb}`Settings.Order`, whose declaration then had no {geb}`Settings.reversed`.
; {geb}`Upgrade.migrate`, run by {lit}`geb-author interact` with the path of a setting saved at
; version 1 and the path of its migration, writes the same order at the current version. It exits
; with status 0 when it has written the migration, 1 when a request fails or the setting is not
; one of version 1, 2 with other arguments and 3 when the host's protocol is not version 0.

(module Upgrade (export migrate) (import Optional) (import Lists) (import Bytes) (import Requests)
  (import Settings)
  ; The order as version 1 declared it.
  (data Previous (previousForward) (previousMirrored))
  ; The order of the current version that an order of version 1 denotes.
  (defn convert ((p Previous)) Order
    (case p ((previousForward) forward) ((previousMirrored) mirrored)))
  ; The state the program resumes in: reading a setting of version 1, with the path of its
  ; migration; or writing.
  (data State (reading Path) (writing))
  ; The action after a request's result: the write of the migration, or the end of the run.
  (defn after ((st State) (r Result)) Action
    (case r ((failed f) (done 1))
      ((succeeded & xs)
       (case st
         ((reading out)
          (case (savedTag 1 (contents xs)) ((none T) (done 1))
            ((some T tag)
             (decode Previous tag
               (lam ((p Previous)) (call (write out (save (convert p))) (rep writing)))
               (done 1)))))
         ((writing) (done 0))))))
  ; The program writing at the current version the order that a setting saves at version 1.
  (note
    (example (Upgrade.migrate (quote (1 (0 (0 (115))) (1 (0 (79) (1) (1))))))
      (quote (1 (1 (0 (115)) (0 (79) (2) (2))) (1)))))
  (defn migrate ((e T)) T
    (rep
      (decode Event e
        (lam ((ev Event))
          (case ev
            ((start v & args)
             (if (eq v 0)
               (if (eq (length Bytes args) 2)
                 (call (read (argument args 0)) (rep (reading (argument args 1))))
                 (done 2))
               (done 3)))
            ((resume s r) (decode State s (lam ((st State)) (after st r)) (done 2)))))
        (done 2)))))
