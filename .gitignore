# Vale's StylesPath holds vendored style packages, which are fetched by
# `vale sync` and not authored here. The project vocabulary under
# `styles/config/` is authored, and `.vale.ini` names it, so it is tracked.
styles/*
node_modules/
!styles/config/
/manual/_out
package-lock.json
package.json
skills-lock.json
.agents/

# Cargo build artifacts of the Rust prototypes.
prototypes/rust/**/target/
