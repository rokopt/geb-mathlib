diff --git a/tests/comments-and-line-endings.test.ts b/tests/comments-and-line-endings.test.ts
--- /dev/null
+++ b/tests/comments-and-line-endings.test.ts
@@ -0,0 +1,162 @@
+import { beforeEach, describe, expect, jest, test } from '@jest/globals';
+import * as vscode from 'vscode';
+import { EditableDocument, LineInputModel, ModelEditSelection } from '../src/cursor-doc/model';
+import { VSCodeScanner } from '../src/cursor-doc/vscode-scanner';
+import { getCommentConfig } from '../src/cursor-doc/language-config';
+import { barfSexpForward, barfSexpBackward, slurpSexpForward, slurpSexpBackward } from '../src/paredit';
+
+jest.mock('../src/cursor-doc/language-config', () => ({
+  getCommentConfig: jest.fn(() => ({ lineComment: ';' }))
+}));
+
+function scanned(text: string): LineInputModel {
+  const lines = text.split(/\r?\n/);
+  const document = {
+    version: 1,
+    languageId: 'test',
+    lineAt: (line: number) => ({ text: lines[line] })
+  } as unknown as vscode.TextDocument;
+  return new LineInputModel(text, new VSCodeScanner(document));
+}
+
+describe('comments outside strings', () => {
+  beforeEach(() => {
+    jest.mocked(getCommentConfig).mockReturnValue({ lineComment: ';' });
+  });
+
+  test.each(['"(;)"', '"escaped \\";\\" quote"', '"first\n(; second"'])
+  ('keeps %s in the string', atom => {
+    const model = scanned(`(f ${atom})`);
+    const tokens = model.getLines().flatMap(line => line.tokens);
+    expect(tokens.filter(token => token.type === 'comment')).toHaveLength(0);
+    expect(tokens[tokens.length - 1].type).toBe('close');
+  });
+
+  test('finds a real comment after a quoted comment marker', () => {
+    const model = scanned('(f "(;)") ; real "(\n(next)');
+    const lines = model.getLines();
+    expect(lines[0].tokens.filter(token => token.type === 'comment')
+      .map(token => token.raw)).toEqual(['; real "(']);
+    expect(lines[1].startState.inString).toBe(false);
+    expect(lines[1].tokens[0].type).toBe('open');
+  });
+
+  test('keeps the end state of a multiline string before a comment', () => {
+    const model = scanned('(f "first\nsecond") ; real "(\n(next)');
+    const lines = model.getLines();
+    expect(lines[1].startState.inString).toBe(true);
+    expect(lines[1].endState.inString).toBe(false);
+    expect(lines[2].tokens[0].type).toBe('open');
+  });
+
+  test('keeps an atom immediately before the comment marker', () => {
+    const model = scanned('(f name; ) "\n)');
+    expect(model.getLines()[0].tokens.map(token => token.raw))
+      .toEqual(['(', 'f', ' ', 'name', '; ) "']);
+    expect(model.getLines()[1].tokens[0].type).toBe('close');
+  });
+
+  test('uses the configured multi-character line comment', () => {
+    jest.mocked(getCommentConfig).mockReturnValue({ lineComment: '//' });
+    const model = scanned('(f "http://host")// real "(\n(next)');
+    const lines = model.getLines();
+    expect(lines[0].tokens.filter(token => token.type === 'comment')
+      .map(token => token.raw)).toEqual(['// real "(']);
+    expect(lines[1].startState.inString).toBe(false);
+  });
+});
+
+describe('document offsets and line endings', () => {
+  test.each(['\n', '\r\n'])('preserves %j offsets and text', eol => {
+    const text = ['(f "🌳")', '', '(next λ)', ''].join(eol);
+    const model = new LineInputModel(text);
+    const next = text.indexOf('(next');
+    expect(model.getLength()).toBe(text.length);
+    expect(model.getOffsetForLine(2)).toBe(next);
+    const cursor = model.getTokenCursor(next);
+    expect(cursor.lineNumber).toBe(2);
+    expect(cursor.getToken()?.raw).toBe('(');
+    expect(cursor.offsetStart).toBe(next);
+    expect(model.getText(0, next)).toBe(`(f "🌳")${eol}${eol}`);
+    expect(model.getText(next, text.length)).toBe(`(next λ)${eol}`);
+    expect(model.getText(0, model.getLength())).toBe(text);
+  });
+
+  test('preserves mixed line endings', () => {
+    const text = 'a\r\nb\n\r\n(tail)';
+    const model = new LineInputModel(text);
+    expect(model.getOffsetForLine(3)).toBe(7);
+    expect(model.getTokenCursor(7).offsetStart).toBe(7);
+    expect(model.getText(1, 7)).toBe('\r\nb\n\r\n');
+    expect(model.getLength()).toBe(13);
+  });
+
+  test('maps both characters of CRLF to the preceding line end', () => {
+    const model = new LineInputModel('a\r\nb');
+    for (const offset of [1, 2]) {
+      const cursor = model.getTokenCursor(offset);
+      expect(cursor.lineNumber).toBe(0);
+      expect(cursor.getToken()?.raw).toBe('a');
+    }
+    expect(model.getTokenCursor(3).getToken()?.raw).toBe('b');
+    expect(model.getText(1, 2)).toBe('\r');
+    expect(model.getText(2, 3)).toBe('\n');
+  });
+
+  test('refreshes offsets and text after changing line endings', () => {
+    const model = new LineInputModel('a\nb');
+    model.update('a\r\nb');
+    expect(model.getOffsetForLine(1)).toBe(3);
+    expect(model.getTokenCursor(3).offsetStart).toBe(3);
+    expect(model.getText(0, model.getLength())).toBe('a\r\nb');
+  });
+});
+
+describe('structural edits with comments and strings', () => {
+  beforeEach(() => {
+    jest.mocked(getCommentConfig).mockReturnValue({ lineComment: ';' });
+  });
+
+  async function edited(action: (doc: EditableDocument) => Promise<void>, text: string, at: number) {
+    let model = scanned(text);
+    const doc = {
+      selections: [new ModelEditSelection(at, at)],
+      getTokenCursor: (offset: number) => model.getTokenCursor(offset),
+      getText: (start: number, end: number) => model.getText(start, end),
+      changeRange: async (start: number, end: number, replacement: string) => {
+        text = text.substring(0, start) + replacement + text.substring(end);
+        model = scanned(text);
+        return true;
+      }
+    } as unknown as EditableDocument;
+    await action(doc);
+    return text;
+  }
+
+  for (const eol of ['\n', '\r\n']) {
+    const comment = `; unmatched "(${eol} `;
+    test(`forward barf skips comments (${JSON.stringify(eol)})`, async () => {
+      expect(await edited(barfSexpForward, `(a ${comment}b)`, 0)).toBe(`(a) ${comment}b`);
+    });
+    test(`backward barf skips comments (${JSON.stringify(eol)})`, async () => {
+      expect(await edited(barfSexpBackward, `(a ${comment}b)`, 0)).toBe(`a ${comment}(b)`);
+    });
+    test(`forward slurp includes a whole string (${JSON.stringify(eol)})`, async () => {
+      expect(await edited(slurpSexpForward, `(a) ${comment}"(; b)"`, 0))
+        .toBe(`(a ${comment}"(; b)")`);
+    });
+    test(`backward slurp skips comments (${JSON.stringify(eol)})`, async () => {
+      const text = `"(; a)" ${comment}(b)`;
+      expect(await edited(slurpSexpBackward, text, text.indexOf('(b)')))
+        .toBe(`("(; a)" ${comment}b)`);
+    });
+    test(`forward barf moves a whole string (${JSON.stringify(eol)})`, async () => {
+      expect(await edited(barfSexpForward, `(a "first${eol}(; b)")`, 0))
+        .toBe(`(a) "first${eol}(; b)"`);
+    });
+    test(`backward barf moves a whole string (${JSON.stringify(eol)})`, async () => {
+      expect(await edited(barfSexpBackward, `("first${eol}(; a)" b)`, 0))
+        .toBe(`"first${eol}(; a)" (b)`);
+    });
+  }
+});
