{
  "name": "geb-language",
  "displayName": "Geb",
  "description": "Geb source editing, compilation, proofs and development records",
  "version": "0.3.0",
  "publisher": "geb-mathlib",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rokopt/geb-mathlib.git",
    "directory": "editors/vscode"
  },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "geb",
      "aliases": ["Geb", "geb"],
      "extensions": [".geb"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "geb",
      "scopeName": "source.geb",
      "path": "./syntaxes/geb.tmLanguage.json"
    }],
    "problemMatchers": [{
      "name": "geb",
      "owner": "geb",
      "fileLocation": ["autoDetect", "${workspaceFolder}"],
      "pattern": {
        "regexp": "^(.+):(\\d+):(\\d+): error: (.*)$",
        "file": 1,
        "line": 2,
        "column": 3,
        "message": 4
      }
    }],
    "configurationDefaults": {
      "[geb]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.formatOnSave": false,
        "editor.wordSeparators": "()\";"
      }
    },
    "commands": [
      {
        "command": "geb.selectProgram",
        "title": "Select Program",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.selectRecord",
        "title": "Select Development Record",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.compile",
        "title": "Compile Program",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.prove",
        "title": "Prove Statements",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.replay",
        "title": "Replay Certificate",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.holes",
        "title": "Show Kernel Holes",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.record",
        "title": "Record Development",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.verify",
        "title": "Verify Record Integrity",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.check",
        "title": "Check Recorded Development",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      },
      {
        "command": "geb.compare",
        "title": "Compare Sources with Record",
        "category": "Geb",
        "enablement": "isWorkspaceTrusted && workspaceFolderCount != 0"
      }
    ],
    "taskDefinitions": [{
      "type": "geb",
      "required": ["gebExecution"],
      "properties": {
        "gebExecution": { "type": "string", "description": "Identity of a command invocation." }
      }
    }],
    "configuration": {
      "title": "Geb",
      "properties": {
        "geb.toolchainDirectory": {
          "type": "string",
          "default": ".",
          "scope": "resource",
          "description": "Geb repository containing lakefile.toml and scripts/preserve.py. Relative to the workspace folder."
        },
        "geb.programs": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "description": "Programs available to Geb commands. Paths are absolute or relative to their workspace folder; source ordering is read by the host from the manifest.",
          "items": {
            "type": "object",
            "required": ["name", "manifest"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Display name, unique within the workspace folder."
              },
              "manifest": {
                "type": "string",
                "minLength": 1,
                "description": "Program manifest path."
              },
              "proofs": {
                "type": "string",
                "minLength": 1,
                "description": "Entry proof document path; required for prove, replay, record and compare."
              },
              "image": {
                "type": "string",
                "minLength": 1,
                "description": "Compiled image path; defaults to .lake/geb-editor/program-NAME/program.img."
              },
              "certificate": {
                "type": "string",
                "minLength": 1,
                "description": "Saved certificate path; defaults to .lake/geb-editor/program-NAME/proof.cert."
              },
              "record": {
                "type": "string",
                "minLength": 1,
                "description": "Existing immutable development record to verify, check or compare."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/grammar.test.cjs",
    "test:editor": "node test/run.cjs",
    "build:paredit": "bash patches/build.sh",
    "test:paredit": "npm run build:paredit && node test/run.cjs --paredit",
    "test:paredit-release": "node test/run.cjs --paredit-release",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/rokopt/geb-mathlib/blob/main/editors/vscode --out geb-language.vsix"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "editorTest": {
    "vscode": "1.145.2",
    "paredit": {
      "release": "MikeDelmonaco.paredit@0.2.1",
      "repository": "https://github.com/quasarbright/vscode-paredit.git",
      "commit": "dcc13c5cf5438ca3236e1c7b46f3bbd089337817",
      "patch": "patches/paredit-0.2.1.patch",
      "version": "0.2.1+geb.1"
    }
  },
  "main": "./extension.cjs",
  "activationEvents": ["onLanguage:geb"],
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting is available; Geb commands execute workspace tools and require trust."
    },
    "virtualWorkspaces": false
  }
}
