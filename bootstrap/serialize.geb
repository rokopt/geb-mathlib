;
; The image of a tree, byte for byte the image the seed writes: a header of the magic number
; GEBK, the version 1 and the bit count in eight bytes, least significant first, followed by
; the tree's serialization packed eight bits to a byte, least significant first. Each node in
; preorder is its arity in unary ones and a zero, the Elias delta code of its label's length,
; its label's bits below the sentinel, least significant first, and then its children.

(module Serialize (export image) (import Prelude)
  ; unread trees and output accumulated in reverse order
  (deftype Work (Prod Ts Ts))
  ; reverse a list by iterating over its length, keeping the unread suffix and the result
  (def reverseList
    (lam ((xs Ts))
      (snd
        (iter Work
          (lam ((s Work))
            (lcase T Work (fst s) s (lam ((x T) (rest Ts)) (pair rest (cons x (snd s))))))
          (pair xs (nil T))
          (length xs)))))

  ; the low n digits, least significant first, with no continuation for each digit
  (def lowDigits (lam ((base T) (m T) (n T)) (reverseList (digitsMsb base m n))))

  ; the Elias delta code of n: the size of the size in unary zeros and a one, then the size and
  ; n + 1 below their leading ones, most significant first
  (def deltaBits
    (lam ((n T))
      (let m T (add n 1)
        (let s T (add (log2 m) 1)
          (let z T (log2 s)
            (append (replicate z 0)
              (cons 1 (append (digitsMsb 2 s z) (digitsMsb 2 m (sub s 1))))))))))

  ; one node's header
  (def nodeBits
    (lam ((k T) (l T))
      (let m T (add l 1)
        (append (replicate k 1) (cons 0 (append (deltaBits (log2 m)) (lowDigits 2 m (log2 m))))))))

  ; the number of nodes bounds the iteration over the preorder work list
  (def nodeCount (lam ((t T)) (fold T (lam ((l T) (rs Ts)) (add 1 (foldr T T add 0 rs))) t)))

  ; visit each node once, putting its children before the rest of the work list and its
  ; reversed header before the bits already written; reverse the complete stream once
  (def treeBits
    (lam ((t T))
      (reverseList
        (snd
          (iter Work
            (lam ((s Work))
              (lcase T Work (fst s) s
                (lam ((nd T) (rest Ts))
                  (pair (append (children nd) rest)
                    (append (reverseList (nodeBits (arity nd) (label nd))) (snd s))))))
            (pair (single t) (nil T))
            (nodeCount t))))))

  ; pack from the last bit to the first; the last byte starts at its highest occupied bit,
  ; and every preceding byte at weight 128. Completing a byte prepends it to the bytes already
  ; packed. The fold's state is the partial byte, the next weight and the completed bytes.
  (deftype Pack (Prod T (Prod T Ts)))
  (def packBits
    (lam ((bits Ts))
      (snd
        (snd
          (foldr T Pack
            (lam ((b T) (s Pack))
              (let byte T (add (fst s) (mul b (fst (snd s))))
                (if (eq (fst (snd s)) 1) (pair 0 (pair 128 (cons byte (snd (snd s)))))
                  (pair byte (pair (div (fst (snd s)) 2) (snd (snd s)))))))
            (pair 0 (pair (iter T (lam ((w T)) (mul 2 w)) 1 (mod (sub (length bits) 1) 8)) (nil T)))
            bits)))))

  ; the image, as a file: a node whose children are the leaves of the bytes
  (def image
    (lam ((t T))
      (let bits Ts (treeBits t)
        (node 0
          (append (cons 71 (cons 69 (cons 66 (cons 75 (cons 1 (nil T))))))
            (append (lowDigits 256 (length bits) 8) (packBits bits))))))))
