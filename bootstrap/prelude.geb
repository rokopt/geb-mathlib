;
; The names of the kernel's labels, and utilities over trees and lists of trees, written in the
; kernel's syntax. Data are trees and lists of trees throughout, since the kernel's types are
; not polymorphic.

; the labels of the kernel's types and terms and the indices of its primitives, as
; Geb.Kernel.Label and Geb.Kernel.Prim name them
(defnum Label.tyTree 0)
(defnum Label.tyUnit 1)
(defnum Label.tyProd 2)
(defnum Label.tyArrow 3)
(defnum Label.tyList 4)
(defnum Label.var 8)
(defnum Label.lam 9)
(defnum Label.app 10)
(defnum Label.unit 11)
(defnum Label.pair 12)
(defnum Label.fst 13)
(defnum Label.snd 14)
(defnum Label.quote 15)
(defnum Label.cond 16)
(defnum Label.fold 17)
(defnum Label.iter 18)
(defnum Label.nil 19)
(defnum Label.cons 20)
(defnum Label.foldr 21)
(defnum Label.prim 22)
(defnum Label.ref 23)
(defnum Label.lcase 24)
(defnum Label.para 25)
(defnum Prim.label 0)
(defnum Prim.arity 1)
(defnum Prim.child 2)
(defnum Prim.node 3)
(defnum Prim.children 4)
(defnum Prim.add 5)
(defnum Prim.sub 6)
(defnum Prim.mul 7)
(defnum Prim.div 8)
(defnum Prim.mod 9)
(defnum Prim.eq 10)
(defnum Prim.lt 11)
(defnum Prim.equal 12)
(defnum Prim.log2 13)

(deftype Ts (List T))
(deftype Endo (Arrow Ts Ts))

; lists of trees
(def append (lam ((xs Ts) (ys Ts)) (foldr T Ts (lam ((x T) (r Ts)) (cons x r)) ys xs)))
(def length (lam ((xs Ts)) (foldr T T (lam ((x T) (n T)) (add n 1)) 0 xs)))
(def reverse (lam ((xs Ts))
  ((foldr T Endo (lam ((x T) (k Endo) (acc Ts)) (k (cons x acc))) (lam ((acc Ts)) acc) xs)
   (nil T))))
(def replicate (lam ((n T) (x T)) (iter Ts (lam ((r Ts)) (cons x r)) (nil T) n)))
(def single (lam ((x T)) (cons x (nil T))))

; optional trees: the node of label 1 over a tree, or the leaf 0
(def some (lam ((x T)) (node 1 (single x))))
(def none 0)
(def isSome (lam ((m T)) (eq (label m) 1)))
(def get (lam ((m T)) (child m 0)))

; the conjunction and the disjunction of two tests
(def and (lam ((a T) (b T)) (if a b 0)))
(def or (lam ((a T) (b T)) (if a 1 b)))

; lists of trees by position, through a node's constant-time children: the element at a
; position, the leaf 0 out of range; the element when the position is in range; the tail; and
; the list without its first n elements
(def at (lam ((xs Ts) (i T)) (child (node 0 xs) i)))
(def nth (lam ((xs Ts) (i T)) (if (lt i (length xs)) (some (at xs i)) none)))
(def tail (lam ((xs Ts)) (lcase T Ts xs (nil T) (lam ((x T) (r Ts)) r))))
(def drop (lam ((n T) (xs Ts)) (iter Ts tail xs n)))

; the low n digits of m in a base, most significant first
(deftype Digits (Prod T Ts))
(def digitsMsb (lam ((base T) (m T) (n T))
  (snd (iter Digits
         (lam ((s Digits)) (pair (div (fst s) base) (cons (mod (fst s) base) (snd s))))
         (pair m (nil T))
         n))))
(def digitsLsb (lam ((base T) (m T) (n T)) (reverse (digitsMsb base m n))))
