            (lam ((a T))
              (bindHT (lowerHyps G n g1 hs)
                (lam ((hn Terms))
                  (let h1 Ts (termsOf hn)
                    (let g2 Ts (cons c (cons a g1))
                      (let h2 Ts (mapT weaken2 h1)
                        (bindO (p0 g1 h1 (instAt 0 (single a) t) (instAt 0 (single a) u))
                          (lam ((d0 T))
                            (bindO (p1v g2 h2 (listConsAt 1 a t) (subst s (atVar0 (weakenElem t))))
                              (lam ((d1 T))
                                (mapO (lam ((d2 T)) (dNode 20 (l3 0 1 s) (l3 d0 d1 d2)))
                                  (p1v g2 h2 (listConsAt 1 a u)
                                    (subst s (atVar0 (weakenElem u))))))))))))))))))))
  ; The pointwise form, (pointwise THEOREM DEPTH RULE ...), and the rewriting under a test,
  ; (mask-rewrite A B ABSORB LEMMA (TERM ...) TEST ELSE OLD NEW OTHER BRANCH): in the branch a
  ; conditional on TEST selects, of the type A, the occurrences of OLD, of the type B, are
  ; replaced by NEW, which LEMMA at its objects, (LEMMA TYPE ...), and at the terms for its
  ; variables equates with OLD under the same test and against OTHER; ABSORB names the theorem
  ; that a conditional on the test of a branch is its first branch there.
  (defn script3
    ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (vars Ts) (kts Ts) (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let rd (Arrow T T) (lam ((e T)) (iterm v gt defs ovars e vars kts))
              (if (headed nd (quote (0 pointwise)))
                (let j T (lemmaOf eb thms at1)
                  (pair
                    (and (lt 2 k)
                      (and (isSome j)
                        (and (isSome (depthOf (at es 2)))
                          (allT (ruleOk 2 defs ovars hyps thms) (drop 3 es)))))
                    (lam ((G Globals) (E (List Entry)) (base NRs))
                      (byPointwise G E n (getD j 0)
                        (rulesIn E (rulesFrom eb defs ovars hyps thms (drop 3 es)) base)
                        (getD (depthOf (at es 2)) 0)))))
                (if (form nd (quote (0 mask-rewrite)) 12)
                  (let a T (itype ovars at1)
                    (let b T (itype ovars (at es 2))
                      (let ab T (lemmaOf eb thms (at es 3))
                        (let le T (at es 4)
                          (let j T (lemmaOf eb thms (if (Source.isAtom le) le (child le 0)))
                            (let th T
                              (allSomeT
                                (mapT (itype ovars)
                                  (if (Source.isAtom le) (nil T) (drop 1 (children le)))))
                              (let sg T (allSomeT (mapT rd (children (at es 5))))
                                (let ts T (allSomeT (mapT rd (drop 6 es)))
                                  (pair
                                    (and (isSome a)
                                      (and (isSome b)
                                        (and (isSome ab)
                                          (and (isSome j)
                                            (and (isSome th)
                                              (and (Source.isList (at es 5))
                                                (and (isSome sg) (isSome ts))))))))
                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                      (lam ((g Ts) (hs Ts) (t T) (u T))
                                        (let xs Ts (children (getD ts (node 0 (nil T))))
                                          (some
                                            (maskRw (getD a one) (getD b one) (getD ab 0) (getD j 0)
                                              (children (getD th (node 0 (nil T))))
                                              (children (getD sg (node 0 (nil T))))
                                              (at xs 0)
                                              (at xs 1)
                                              (at xs 2)
                                              (at xs 3)
                                              (at xs 4)
                                              (at xs 5)))))))))))))))
                  (pair 0 failTac)))))))))
  ; The instances a script takes of a hypothesis that equates functions, ((NAME TERM ...) ...):
  ; each names the hypothesis's instance at its terms, one for each argument of the functions.
  (deftype Tss (List Ts))
  (import (Seq Tss) as Kids)
  (def unnamed (node 0 (nil T)))
  (defn instancesOk ((rd (Arrow T T)) (e T)) T
    (and (Source.isList e)
      (allT
        (lam ((x T))
          (and (Source.isList x)
            (and (lt 0 (length (children x)))
              (and (bindable 3 (child x 0))
                (allT (lam ((a T)) (isSome (rd a))) (drop 1 (children x)))))))
        (children e))))
  (defn instanceNames ((e T)) Ts (mapT (lam ((x T)) (Source.nameOf (child x 0))) (children e)))
  (defn instanceArgs ((rd (Arrow T T)) (e T)) Tss
    (foldr T Tss
      (lam ((x T) (acc Tss))
        (cons (mapT (lam ((a T)) (getD (rd a) mStar)) (drop 1 (children x))) acc))
      (nil Ts)
      (children e)))
  ; The instance of an earlier theorem cut in as a hypothesis: the equation of its sides at
  ; objects and at terms for its variables, applied to arguments.
  (defn withInstance ((E (List Entry)) (j T) (th Ts) (sg Ts) (al Ts) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (case (thmAt E j) ((OThm.nothing) none)
        ((OThm.just b)
         (bindPT (eqParts (thConcl b))
           (lam ((FH TPair))
             (let chi T (mEq (apps (instTerm th sg (p1 FH)) al) (apps (instTerm th sg (p2 FH)) al))
               (mapO
                 (lam ((q T))
                   (dNode 22 (single chi)
                     (l2
                       (dNode 18 (nil T)
                         (l2
                           (foldr T T
                             (lam ((a T) (d T)) (dNode 2 (nil T) (l2 d (dNode 0 (nil T) (nil T)))))
                             (dNode 16 (l4 j (node 0 th) (node 0 sg) 0) (nil T))
                             al)
                           (dNode 0 (nil T) (nil T))))
                       q)))
                 (p g (append hs (single chi)) t u)))))))))
  ; The equation of the applications of a function to the sides of an equation among the
  ; hypotheses, cut in as a hypothesis.
  (defn withCongruence ((i T) (f T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindPT (bindTP (nth hs i) eqParts)
        (lam ((LR TPair))
          (let chi T (mEq (app f (p1 LR)) (app f (p2 LR)))
            (mapO
              (lam ((q T))
                (dNode 22 (single chi)
                  (l2
                    (dNode 18 (nil T)
                      (l2
                        (dNode 2 (nil T) (l2 (dNode 0 (nil T) (nil T)) (dNode 17 (l2 i 0) (nil T))))
                        (dNode 0 (nil T) (nil T))))
                    q)))
              (p g (append hs (single chi)) t u)))))))
  ; The left side of an equation among the hypotheses whose right side is the equation of a term
  ; with itself, cut in as a hypothesis.
  (defn withHolds ((i T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindPT (bindTP (nth hs i) eqParts)
        (lam ((LR TPair))
          (mapO
            (lam ((q T))
              (dNode 22 (single (p1 LR))
                (l2
                  (dNode 23 (nil T)
                    (l2 (dNode 17 (l2 i 0) (nil T))
                      (dNode 18 (nil T) (l2 (dNode 0 (nil T) (nil T)) (dNode 0 (nil T) (nil T))))))
                  q)))
            (p g (append hs (single (p1 LR))) t u))))))
  ; The first of a term's subterms, outside binders and folds, that applies the definition of an
  ; index to arguments, each any term or one given.
  (defn isCall ((k T) (h T)) T
    (and (eq (label h) 11) (and (eq (mD h 0) k) (equal (mD h 1) (node 0 (nil T))))))
  (defn callArgs ((k T) (m T) (u T)) T
    (let st T
      (iter T
        (lam ((s T))
          (if (isSome s)
            (let h T (child (get s) 0)
              (if (mIs 6 2 h)
                (some (node 0 (cons (mArg h 0) (cons (mArg h 1) (drop 1 (children (get s)))))))
                none))
            none))
        (some (node 0 (single u)))
        m)
      (if (isSome st)
        (if (isCall k (child (get st) 0)) (some (node 0 (drop 1 (children (get st))))) none)
        none)))
  (defn testMatches ((k T) (specs Ts) (u T)) T
    (let as T (callArgs k (length specs) u)
      (and (isSome as)
        (allT
          (lam ((i T))
            (let sp T (at specs i)
              (or (not (isSome sp)) (equal (get sp) (at (children (get as)) i)))))
          (range (length specs))))))
  (defn findTest ((k T) (specs Ts) (w T)) T
    (foldr T T (lam ((u T) (acc T)) (if (testMatches k specs u) (some u) acc)) none
      (openSubterms w)))
  ; The case analysis of the values of tests, to a number of rounds: the sides are reduced to
  ; weak normal form, the first test among their subterms is generalized to a tree, the tree is
  ; split to a node and its label to the empty bitstring, where the search repeats, and to a bit
  ; before a bitstring, where the first prover proves the goal; where no test occurs, or the
  ; rounds are spent, the second does. The provers are given the number of rounds before them.
  (deftype PvN (Arrow T Pv))
  (defn byTests
    ((G Globals) (E (List Entry)) (n T) (k T) (specs Ts) (lk T) (rs NRs) (pT PvN) (pR PvN) (d T))
    Pv
    ((iter PvN
       (lam ((rec PvN) (j T))
         (byNF G E n rs 1
           (lam ((g Ts) (hs Ts) (t T) (u T))
             (let N T (let a T (findTest k specs t) (if (isSome a) a (findTest k specs u)))
               (if (isSome N)
                 (byGeneralize treeTy (get N)
                   (byTreeSplit lk 0 (byListSplit G n 1 (rec (add j 1)) (pT j)))
                   g
                   hs
                   t
                   u)
                 (pR j g hs t u))))))
       pR
       d) 0))
  ; The forms of hypotheses, of reductions and of searches that version 3 adds. An instance cut
  ; in, (have h LEMMA (TERM ...) (TERM ...) SCRIPT), proves the goal under the hypothesis h: the
  ; equation of the sides of LEMMA at its objects and at the first terms for its variables,
  ; applied to the second terms. A congruence, (congruence h (g (z TYPE) TERM) SCRIPT), proves it
  ; under the hypothesis g: the equation of the applications to the sides of the hypothesis h of
  ; the function of z that TERM is. A formula that holds, (holds h (g) SCRIPT), proves it under
  ; the hypothesis g: the left side of the hypothesis h, whose right side is the equation of a
  ; term with itself. A reduction, (reduced DEPTH SCRIPT), proves the goal by the script's proof
  ; of the equation of its sides' normal forms at the depth. The case analysis of tests,
  ; (test-cases (NAME ARG ...) ROUNDS LEMMA SCRIPT SCRIPT), to a number of rounds: the sides are
  ; reduced to weak normal form, the first of their subterms, outside binders and folds, that
  ; applies the definition NAME of the program to arguments, each any term, written any, or the
  ; term given, is generalized to a tree, and the tree is split to a node and its label to the
  ; empty bitstring, where the search repeats, and to a bit before a bitstring, where the first
  ; script proves the goal; where no such subterm occurs, or the rounds are spent, the second
  ; does. LEMMA names the theorem that a tree is the node of its unfolding. The rewriting under
  ; masks, (mask-hypotheses ABSORB SAME ROUNDS SCRIPT), to a number of rounds: the sides are
  ; reduced to weak normal form, and a conditional among their subterms whose test a hypothesis
  ; rewrites a term under, in its first branch, is cut in rewritten; the script proves the goal
  ; with the equations cut in before the rules. ABSORB and SAME name the theorems that inside the
  ; branch a test selects a conditional on the test is its first branch, and that a conditional
  ; between two terms of one value is that value. The search of conditionals,
  ; (auto-conditions SPLITS LEMMA RULE ...), reduces to weak normal form and splits the list,
  ; coproduct or tree variable that the reduction, or a conditional's test, is stuck on. The
  ; scripts of the two searches by rounds are read at each number of rounds, in the variables
  ; and hypotheses they add, none of them named.
  (defn script6
    ((eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR)) (vars Ts) (kts Ts)
     (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let at2 T (at es 2)
              (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
                (let rd (Arrow T T) (lam ((e T)) (iterm 3 gt defs ovars e vars kts))
                  (let fresh (Arrow Ts T)
                    (lam ((xs Ts)) (distinctFrom (append vars (append hyps thms)) xs))
                    (let hypAt (Arrow T T)
                      (lam ((e T))
                        (if (Source.isAtom e) (Source.indexOf (Source.nameOf e) hyps) none))
                      (let blanks (Arrow T Ts) (lam ((m T)) (mapT (lam ((q T)) unnamed) (range m)))
                        (let nones (Arrow T Ts) (lam ((m T)) (mapT (lam ((q T)) none) (range m)))
                          (if (form nd (quote (0 have)) 6)
                            (let j T (lemmaOf eb thms (if (Source.isAtom at2) at2 (child at2 0)))
                              (let th T
                                (allSomeT
                                  (mapT (itype ovars)
                                    (if (Source.isAtom at2) (nil T) (drop 1 (children at2)))))
                                (let sg T (allSomeT (mapT rd (children (at es 3))))
                                  (let al T (allSomeT (mapT rd (children (at es 4))))
                                    (let r (Prod T Tac)
                                      (childR 5 vars kts (append hyps (single (Source.nameOf at1))))
                                      (pair
                                        (and (bindable 3 at1)
                                          (and (fresh (single (Source.nameOf at1)))
                                            (and (isSome j)
                                              (and (isSome th)
                                                (and (Source.isList (at es 3))
                                                  (and (isSome sg)
                                                    (and (Source.isList (at es 4))
                                                      (and (isSome al) (fst r)))))))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (withInstance E (getD j 0)
                                            (children (getD th (node 0 (nil T))))
                                            (children (getD sg (node 0 (nil T))))
                                            (children (getD al (node 0 (nil T))))
                                            ((snd r) G E base)))))))))
                            (if (form nd (quote (0 congruence)) 4)
                              (let spec Ts (children at2)
                                (let nm T (Source.nameOf (at spec 0))
                                  (let b T (at spec 1)
                                    (let f T
                                      (iterm 3 gt defs ovars (at spec 2)
                                        (cons (Source.nameOf (child b 0)) vars)
                                        (cons (kernelType defs (child b 1)) kts))
                                      (let r (Prod T Tac)
                                        (childR 3 vars kts (append hyps (single nm)))
                                        (pair
                                          (and (isSome (hypAt at1))
                                            (and (and (Source.isList at2) (eq (length spec) 3))
                                              (and (bindable 3 (at spec 0))
                                                (and (fresh (single nm))
                                                  (and (ibinder 3 ovars b)
                                                    (and
                                                      (fresh (single (Source.nameOf (child b 0))))
                                                      (and (isSome f) (fst r))))))))
                                          (lam ((G Globals) (E (List Entry)) (base NRs))
                                            (withCongruence (getD (hypAt at1) 0)
                                              (mLam (getD (itype ovars (child b 1)) one)
                                                (getD f mStar))
                                              ((snd r) G E base)))))))))
                              (if (form nd (quote (0 holds)) 4)
                                (let nm T (Source.nameOf (child at2 0))
                                  (let r (Prod T Tac) (childR 3 vars kts (append hyps (single nm)))
                                    (pair
                                      (and (isSome (hypAt at1))
                                        (and (namesOk 3 1 at2) (and (fresh (single nm)) (fst r))))
                                      (lam ((G Globals) (E (List Entry)) (base NRs))
                                        (withHolds (getD (hypAt at1) 0) ((snd r) G E base))))))
                                (if (form nd (quote (0 reduced)) 3)
                                  (let r (Prod T Tac) (childR 2 vars kts hyps)
                                    (pair (and (isSome (depthOf at1)) (fst r))
                                      (lam ((G Globals) (E (List Entry)) (base NRs))
                                        (byNF G E n base (getD (depthOf at1) 0)
                                          ((snd r) G E base)))))
                                  (if (form nd (quote (0 test-cases)) 6)
                                    (let pat Ts (children at1)
                                      (let fnI T
                                        (if (Source.isAtom (at pat 0))
                                          (Source.indexOf (Source.nameOf (at pat 0)) defs)
                                          none)
                                        (let specs Ts
                                          (mapT
                                            (lam ((a T))
                                              (if (word a (quote (0 any))) none
                                                (some (getD (rd a) mStar))))
                                            (drop 1 pat))
                                          (let rounds T (number at2)
                                            (let lk T (lemmaOf eb thms (at es 3))
                                              (let trueAt (Arrow T (Prod T Tac))
                                                (lam ((j T))
                                                  (childR 4 (append (blanks (add (mul 3 j) 5)) vars)
                                                    (append (nones (add (mul 3 j) 5)) kts)
                                                    (append hyps (single unnamed))))
                                                (let restAt (Arrow T (Prod T Tac))
                                                  (lam ((j T))
                                                    (childR 5 (append (blanks (mul 3 j)) vars)
                                                      (append (nones (mul 3 j)) kts)
                                                      hyps))
                                                  (pair
                                                    (and (Source.isList at1)
                                                      (and (lt 1 (length pat))
                                                        (and (isSome fnI)
                                                          (and
                                                            (allT
                                                              (lam ((a T))
                                                                (or (word a (quote (0 any)))
                                                                  (isSome (rd a))))
                                                              (drop 1 pat))
                                                            (and (isSome rounds)
                                                              (and (isSome lk)
                                                                (and
                                                                  (allT
                                                                    (lam ((j T)) (fst (trueAt j)))
                                                                    (range (getD rounds 0)))
                                                                  (allT
                                                                    (lam ((j T)) (fst (restAt j)))
                                                                    (range
                                                                      (add (getD rounds 0)
                                                                        1))))))))))
                                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                                      (byTests G E n
                                                        (add (LD.length lib) (getD fnI 0))
                                                        specs
                                                        (getD lk 0)
                                                        base
                                                        (lam ((j T)) ((snd (trueAt j)) G E base))
                                                        (lam ((j T)) ((snd (restAt j)) G E base))
                                                        (getD rounds 0)))))))))))
                                    (if (form nd (quote (0 mask-hypotheses)) 5)
                                      (let ab T (lemmaOf eb thms at1)
                                        (let cs T (lemmaOf eb thms at2)
                                          (let rounds T (number (at es 3))
                                            (let level (Arrow T (Prod T Tac))
                                              (lam ((j T))
                                                (childR 4 vars kts (append hyps (blanks j))))
                                              (pair
                                                (and (isSome ab)
                                                  (and (isSome cs)
                                                    (and (isSome rounds)
                                                      (allT (lam ((j T)) (fst (level j)))
                                                        (range (add (getD rounds 0) 1))))))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (byMaskSubs G E (getD ab 0) (getD cs 0) base
                                                    (getD rounds 0)
                                                    (lam ((extra NRs))
                                                      ((snd (level (Rules.length extra))) G E
                                                       (Rules.append extra base))))))))))
                                      (if (headed nd (quote (0 auto-conditions)))
                                        (let lk T (lemmaOf eb thms at2)
                                          (pair
                                            (and (lt 2 k)
                                              (and (isSome (number at1))
                                                (and (isSome lk)
                                                  (allT (ruleOk 3 defs ovars hyps thms)
                                                    (drop 3 es)))))
                                            (lam ((G Globals) (E (List Entry)) (base NRs))
                                              (byAutoC G E n (getD lk 0)
                                                (rulesIn E
                                                  (rulesFrom eb defs ovars hyps thms (drop 3 es))
                                                  base)
                                                (getD (number at1) 0)))))
                                        (script3 3 eb gt defs ovars thms nd vars kts
                                          hyps))))))))))))))))))))
  ; The uniqueness of a fold with premises that scripts prove, the instance of a theorem, and the
  ; argument that is a successor, which version 3 adds. The uniqueness of a list's fold,
  ; (fold-uniqueness x (y ys r) STEP SCRIPT SCRIPT), proves the goal by induction on its innermost
  ; variable x: by the first script at the empty list, and by the second, for each side, that the
  ; side at a head y before a list ys is STEP, in which r is that side at ys. The uniqueness of a
  ; tree's fold, (tree-fold-uniqueness x (l cs rs) STEP SCRIPT), proves a goal in the one variable
  ; x by the script's proof, for each side, that the side at the node of a label l and children cs
  ; is STEP, in which rs is the list of that side at the children. The instance of a theorem,
  ; (instance LEMMA (TERM ...) (TERM ...) DEPTH RULE ...), proves a goal whose sides have, at the
  ; depth, the normal forms of the sides of LEMMA, which equates two functions, at its objects and
  ; at the first terms for its variables, applied to the second terms. The argument that is a
  ; successor, (succ-pred THEOREM SCRIPT), proves an equation of two applications by the script's
  ; proof of it at the left side of THEOREM, at the two innermost variables, for each argument:
  ; THEOREM equates the successor of the predecessor of a bit before a bitstring with it. The
  ; rules of a script, (with-rules (RULE ...) SCRIPT), prove the goal by the script with the rules
  ; before the language's and the unfolding of the definitions, in place of the rules a script
  ; around it gives, so that every reduction of the script, those of hypotheses and of their
  ; instances among them, rewrites by them. A rule (folded NAME ...) keeps folded the definitions
  ; it names, of the program by their names and of the translation's library as (lib NAME).
  (defn script5
    ((eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR)) (vars Ts) (kts Ts)
     (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let ns Ts (mapT Source.nameOf (children (at es 2)))
              (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
                (let rd (Arrow T T) (lam ((e T)) (iterm 3 gt defs ovars e vars kts))
                  (let rest Ts (drop 1 vars)
                    (if (form nd (quote (0 fold-uniqueness)) 6)
                      (let s T
                        (iterm 3 gt defs ovars (at es 3) (cons (at ns 2) (cons (at ns 0) rest))
                          (cons none (cons (listElem (at kts 0)) (drop 1 kts))))
                        (let r0 (Prod T Tac) (childR 4 rest (drop 1 kts) hyps)
                          (let r1 (Prod T Tac)
                            (childR 5 (cons (at ns 1) (cons (at ns 0) rest))
                              (cons (at kts 0) (cons (listElem (at kts 0)) (drop 1 kts)))
                              hyps)
                            (pair
                              (and (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                (and (namesOk 3 3 (at es 2))
                                  (and (distinctFrom (append rest (append hyps thms)) ns)
                                    (and (isSome s) (and (fst r0) (fst r1))))))
                              (lam ((G Globals) (E (List Entry)) (base NRs))
                                (byListFold G n (getD s mStar) ((snd r0) G E base)
                                  ((snd r1) G E base)))))))
                      (if (form nd (quote (0 tree-fold-uniqueness)) 5)
                        (let s T
                          (iterm 3 gt defs ovars (at es 3) (cons (at ns 2) (cons (at ns 0) (nil T)))
                            (cons none (cons none (nil T))))
                          (let r (Prod T Tac)
                            (childR 4 (cons (at ns 1) (cons (at ns 0) (nil T)))
                              (cons (mapO (lam ((kt T)) (node Label.tyList (single kt))) (at kts 0))
                                (cons none (nil T)))
                              (nil T))
                            (pair
                              (and (and (eq (length vars) 1) (word at1 (at vars 0)))
                                (and (isEmpty hyps)
                                  (and (namesOk 3 3 (at es 2))
                                    (and (distinctFrom thms ns) (and (isSome s) (fst r))))))
                              (lam ((G Globals) (E (List Entry)) (base NRs))
                                (byRoseIndWith G n (getD s mStar) ((snd r) G E base))))))
                        (if (form nd (quote (0 succ-pred)) 3)
                          (let j T (lemmaOf eb thms at1)
                            (let r (Prod T Tac) (childR 2 vars kts hyps)
                              (pair (and (isSome j) (fst r))
                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                  (bySuccPred E (getD j 0) ((snd r) G E base))))))
                          (if (form nd (quote (0 with-rules)) 3)
                            (let r (Prod T Tac) (childR 2 vars kts hyps)
                              (pair
                                (and (Source.isList at1)
                                  (and (allT (ruleOk 3 defs ovars hyps thms) (children at1))
                                    (fst r)))
                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                  ((snd r) G E
                                   (rulesIn E (rulesFrom eb defs ovars hyps thms (children at1))
                                     (languageRules base))))))
                            (if (headed nd (quote (0 instance)))
                              (let j T (lemmaOf eb thms (if (Source.isAtom at1) at1 (child at1 0)))
                                (let th T
                                  (allSomeT
                                    (mapT (itype ovars)
                                      (if (Source.isAtom at1) (nil T) (drop 1 (children at1)))))
                                  (let sg T (allSomeT (mapT rd (children (at es 2))))
                                    (let al T (allSomeT (mapT rd (children (at es 3))))
                                      (pair
                                        (and (lt 4 k)
                                          (and (isSome j)
                                            (and (isSome th)
                                              (and (Source.isList (at es 2))
                                                (and (isSome sg)
                                                  (and (Source.isList (at es 3))
                                                    (and (isSome al)
                                                      (and (isSome (depthOf (at es 4)))
                                                        (allT (ruleOk 3 defs ovars hyps thms)
                                                          (drop 5 es))))))))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byInstance G E n (getD j 0)
                                            (children (getD th (node 0 (nil T))))
                                            (children (getD sg (node 0 (nil T))))
                                            (children (getD al (node 0 (nil T))))
                                            (rulesIn E
                                              (rulesFrom eb defs ovars hyps thms (drop 5 es))
                                              base)
                                            (getD (depthOf (at es 4)) 0))))))))
                              (script6 eb gt defs ovars thms nd rs vars kts hyps)))))))))))))))
  ; The case analysis of a bitstring to a number of bits, (bits-cases x BITS SCRIPT (LABEL ...)
  ; SCRIPT ...): the goal at each bitstring of fewer bits for the variable x, and at each of that
  ; number of bits before a bitstring, by the first script; and at the bitstring of each label
  ; listed before a later script, a numeral of fewer bits, by that script in its place. A script
  ; is read at each number of bits it proves at, in the variables and hypotheses of that case. The
  ; label of the bits taken so far is one less than the number whose binary digits, the least
  ; significant first, are those bits and then a one.
  (defn scriptBits ((n T) (es Ts) (childR (Arrow T SR)) (vars Ts) (kts Ts) (hyps Ts)) (Prod T Tac)
    (let k T (length es)
      (let blanks (Arrow T Ts) (lam ((m T)) (mapT (lam ((q T)) unnamed) (range m)))
        (let i T (if (Source.isAtom (at es 1)) (Source.indexOf (Source.nameOf (at es 1)) vars) none)
          (let bits T (number (at es 2))
            (let levelAt (Arrow T (Arrow T (Prod T Tac)))
              (lam ((s T) (j T))
                (childR s (append (blanks (mul 3 j)) vars)
                  (append (mapT (lam ((q T)) none) (range (mul 3 j))) kts)
                  (append hyps (blanks j))))
              (let pairs Ts (range (div (sub k 4) 2))
                (let labelsAt (Arrow T Ts)
                  (lam ((c T))
                    (mapT (lam ((e T)) (getD (number e) 0)) (children (at es (add 4 (mul 2 c))))))
                  (let scriptFor (Arrow T T)
                    (lam ((lbl T))
                      (foldr T T
                        (lam ((c T) (acc T)) (if (has lbl (labelsAt c)) (add 5 (mul 2 c)) acc))
                        3
                        pairs))
                    (pair
                      (and (lt 3 k)
                        (and (eq (mod k 2) 0)
                          (and (isSome i)
                            (and (isSome bits)
                              (and
                                (allT (lam ((j T)) (fst (levelAt 3 j)))
                                  (range (add (getD bits 0) 1)))
                                (allT
                                  (lam ((c T))
                                    (let ls T (at es (add 4 (mul 2 c)))
                                      (and (Source.isList ls)
                                        (allT
                                          (lam ((e T))
                                            (and (isSome (number e))
                                              (let d T (log2 (add (getD (number e) 0) 1))
                                                (and (lt d (getD bits 0))
                                                  (fst (levelAt (add 5 (mul 2 c)) d))))))
                                          (children ls)))))
                                  pairs))))))
                      (lam ((G Globals) (E (List Entry)) (base NRs))
                        ((foldr T (Arrow T (Arrow T Pv))
                           (lam ((j T) (deeper (Arrow T (Arrow T Pv))) (pos T) (p T))
                             (let w T (iter T (lam ((a T)) (mul 2 a)) 1 j)
                               (byListSplit G n pos
                                 ((snd (levelAt (scriptFor (sub p 1)) j)) G E base)
                                 (bySplit2 3 4 1 (deeper 1 (add p w))
                                   (deeper 1 (add p (mul 2 w)))))))
                           (lam ((pos T) (p T)) ((snd (levelAt 3 (getD bits 0))) G E base))
                           (range (getD bits 0))) (getD i 0) 1))))))))))))
  ; The tactics version 3 adds. The induction on a tree, (tree-induction x (l cs ih) SCRIPT),
  ; proves a goal without hypotheses by its proof at the node of a label l and children cs for
  ; its innermost variable x, under the hypothesis ih that the goal holds at each child: the
  ; equation of the list of the goal's formulas at the children with the list of as many truths.
  ; The hypotheses at the children, (child-hypotheses DEPTH ih (CHILD ...) SCRIPT), cut in the
  ; formula of ih at each of the first children, as many as the CHILDs, of a list of children
  ; that is a construction to that number; each CHILD, ((NAME TERM ...) ...), names the instances
  ; of its formula, an equation of functions, at terms for their arguments, reduced to the depth.
  ; The instances of a hypothesis that equates functions,
  ; (instances DEPTH h ((NAME TERM ...) ...) SCRIPT), are named so. The introduction of an
  ; implication, (assume h SCRIPT), proves a goal whose sides reduce to the implication of an
  ; equation and to truth by the proof of the equation under the antecedent, named h. The
  ; elimination, (modus-ponens h (NAME ...) SCRIPT), gives each hypothesis named, the equation
  ; with truth of an implication whose antecedent is the hypothesis h, to its conclusion. The
  ; case analysis (revert-cases h x (y ys) SCRIPT SCRIPT) of a list variable x that the
  ; hypothesis h mentions proves the goal at the empty list and at a head y before a list ys,
  ; under h at each. The alternative, (first SCRIPT SCRIPT), proves the goal by its first script
  ; or, where that one does not prove it, by its second. The case analysis of a bitstring to a
  ; number of bits, (bits-cases x BITS SCRIPT (LABEL ...) SCRIPT ...), proves the goal at each
  ; bitstring of fewer bits for the variable x, and at each of that number of bits before a
  ; bitstring, by its first script or by the script of the bitstring's label
  ; ({geb}`Authoring.scriptBits`), read at each number of bits in the variables and hypotheses of
  ; that case: for each bit a head, a list and the element of the bit's injection, and the goal at
  ; the list, none of them named.
  ; The connectives' rules are the first entries of a development of version 3.
  (defn script4
    ((eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR)) (vars Ts) (kts Ts)
     (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let n T (length ovars)
        (let o T (connectivesAt defs)
          (let at1 T (at es 1)
            (let at2 T (at es 2)
              (let at3 T (at es 3)
                (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
                  (let rd (Arrow T T) (lam ((e T)) (iterm 3 gt defs ovars e vars kts))
                    (let fresh (Arrow Ts T)
                      (lam ((xs Ts)) (distinctFrom (append vars (append hyps thms)) xs))
                      (let hypAt (Arrow T T)
                        (lam ((e T))
                          (if (Source.isAtom e) (Source.indexOf (Source.nameOf e) hyps) none))
                        (let without (Arrow Ts Ts)
                          (lam ((xs Ts)) (mapT (lam ((x T)) (if (has x xs) unnamed x)) hyps))
                          (let blanks (Arrow T Ts)
                            (lam ((k T)) (mapT (lam ((i T)) unnamed) (range k)))
                            (if (form nd (quote (0 tree-induction)) 4)
                              (let ns Ts (mapT Source.nameOf (children at2))
                                (let rest Ts (drop 1 vars)
                                  (let r (Prod T Tac)
                                    (childR 3 (cons (at ns 1) (cons (at ns 0) rest))
                                      (cons
                                        (mapO (lam ((kt T)) (node Label.tyList (single kt)))
                                          (at kts 0))
                                        (cons none (drop 1 kts)))
                                      (single (at ns 2)))
                                    (pair
                                      (and (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                        (and (isEmpty hyps)
                                          (and (namesOk 3 3 at2)
                                            (and (distinctFrom (append rest thms) ns) (fst r)))))
                                      (lam ((G Globals) (E (List Entry)) (base NRs))
                                        (byRoseIndHyp 2 0 1 ((snd r) G E base)))))))
                              (if (form nd (quote (0 child-hypotheses)) 5)
                                (let kids Ts (children at3)
                                  (let names Ts
                                    (foldr T Ts
                                      (lam ((c T) (acc Ts)) (append (instanceNames c) acc))
                                      (nil T)
                                      kids)
                                    (let cut Ts
                                      (foldr T Ts
                                        (lam ((c T) (acc Ts))
                                          (append (blanks (add 2 (length (children c)))) acc))
                                        (nil T)
                                        kids)
                                      (let r (Prod T Tac)
                                        (childR 4 vars kts (append hyps (append cut names)))
                                        (let args (List Tss)
                                          (foldr T (List Tss)
                                            (lam ((c T) (acc (List Tss)))
                                              (cons (instanceArgs rd c) acc))
                                            (nil Tss)
                                            kids)
                                          (pair
                                            (and (isSome (depthOf at1))
                                              (and (isSome (hypAt at2))
                                                (and (Source.isList at3)
                                                  (and (not (isEmpty kids))
                                                    (and (allT (instancesOk rd) kids)
                                                      (and (fresh names) (fst r)))))))
                                            (lam ((G Globals) (E (List Entry)) (base NRs))
                                              (withChildHyps G E n base (getD (hypAt at2) 0)
                                                (range (length kids))
                                                (lam ((p T)) (Kids.atOr (nil Ts) args p))
                                                (lam ((insts Ts))
                                                  (withWeakHyps G E n base insts
                                                    (lam ((extra NRs)) ((snd r) G E base))
                                                    (getD (depthOf at1) 0)))))))))))
                                (if (form nd (quote (0 instances)) 5)
                                  (let names Ts (instanceNames at3)
                                    (let r (Prod T Tac)
                                      (childR 4 vars kts
                                        (append hyps (append (blanks (length names)) names)))
                                      (pair
                                        (and (isSome (depthOf at1))
                                          (and (isSome (hypAt at2))
                                            (and (instancesOk rd at3)
                                              (and (not (isEmpty names))
                                                (and (fresh names) (fst r))))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (withInsts G E n base (getD (hypAt at2) 0)
                                            (instanceArgs rd at3)
                                            (lam ((extra NRs)) ((snd r) G E base))
                                            (getD (depthOf at1) 0))))))
                                  (if (form nd (quote (0 assume)) 3)
                                    (let r (Prod T Tac)
                                      (childR 2 vars kts
                                        (append hyps (l2 unnamed (Source.nameOf at1))))
                                      (pair
                                        (and (bindable 3 at1)
                                          (and (fresh (single (Source.nameOf at1))) (fst r)))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byImpI G E o 0 ((snd r) G E base)))))
                                    (if (form nd (quote (0 modus-ponens)) 4)
                                      (let names Ts (mapT Source.nameOf (children at2))
                                        (let r (Prod T Tac)
                                          (childR 3 vars kts (append (without names) names))
                                          (pair
                                            (and (isSome (hypAt at1))
                                              (and (Source.isList at2)
                                                (and (not (isEmpty names))
                                                  (and
                                                    (allT (lam ((x T)) (isSome (hypAt x)))
                                                      (children at2))
                                                    (and (distinctFrom (nil T) names) (fst r))))))
                                            (lam ((G Globals) (E (List Entry)) (base NRs))
                                              (withImpElim o 0 (getD (hypAt at1) 0)
                                                (mapT (lam ((x T)) (getD (Source.indexOf x hyps) 0))
                                                  names)
                                                (lam ((extra NRs)) ((snd r) G E base)))))))
                                      (if (form nd (quote (0 revert-cases)) 6)
                                        (let ns Ts (mapT Source.nameOf (children at3))
                                          (let hn T (Source.nameOf at1)
                                            (let i T
                                              (if (Source.isAtom at2)
                                                (Source.indexOf (Source.nameOf at2) vars)
                                                none)
                                              (let kt T (at kts (getD i 0))
                                                (let kept Ts (without (single hn))
                                                  (let r0 (Prod T Tac)
                                                    (childR 4 vars kts
                                                      (append kept (l2 unnamed hn)))
                                                    (let r1 (Prod T Tac)
                                                      (childR 5
                                                        (cons (at ns 1) (cons (at ns 0) vars))
                                                        (cons kt (cons (listElem kt) kts))
                                                        (append kept (l3 unnamed unnamed hn)))
                                                      (pair
                                                        (and (isSome (hypAt at1))
                                                          (and (isSome i)
                                                            (and (namesOk 3 2 at3)
                                                              (and (fresh ns)
                                                                (and (fst r0) (fst r1))))))
                                                        (lam
                                                          ((G Globals) (E (List Entry)) (base NRs))
                                                          (revertCase G n o 0 (getD i 0)
                                                            (getD (hypAt at1) 0)
                                                            ((snd r0) G E base)
                                                            ((snd r1) G E base)))))))))))
                                        (if (form nd (quote (0 first)) 3)
                                          (let r0 (Prod T Tac) (childR 1 vars kts hyps)
                                            (let r1 (Prod T Tac) (childR 2 vars kts hyps)
                                              (pair (and (fst r0) (fst r1))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (lam ((g Ts) (hs Ts) (t T) (u T))
                                                    (let found T ((snd r0) G E base g hs t u)
                                                      (if (isSome found) found
                                                        ((snd r1) G E base g hs t u))))))))
                                          (if (headed nd (quote (0 bits-cases)))
                                            (scriptBits n es childR vars kts hyps)
                                            (script5 eb gt defs ovars thms nd rs vars kts
                                              hyps))))))))))))))))))))))
  ; The tactics version 2 adds. The uniqueness of a list's fold, (fold-induction x (y r) STEP FUEL
  ; RULE ...), proves the goal by induction on its innermost variable where both sides at a head y
  ; before a list are STEP at their values r at the list. The uniqueness of a tree's fold,
  ; (tree-fold-induction x (l rs) STEP FUEL RULE ...), proves a goal in the one variable x where
  ; both sides at the node of a label l are STEP at the list rs of their values at the children.
  ; The case analysis of a coproduct, (sum-cases x (y) SCRIPT SCRIPT), proves the goal at each
  ; injection of a new variable y, and of a tree, (tree-cases x (l cs) LEMMA SCRIPT), at the node
  ; of a new label l and children cs, LEMMA naming the theorem that a tree is the node of its
  ; unfolding. The search (auto-trees DEPTH SPLITS LEMMA RULE ...) reduces to a depth and splits
  ; the list, coproduct or tree variable the reduction is stuck on. The generalization
  ; (generalize (y A) TERM SCRIPT) proves the goal with a new variable y for the occurrences of a
  ; term of the type A.
  (defn script2
    ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR)) (vars Ts) (kts Ts)
     (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let ns Ts (mapT Source.nameOf (children (at es 2)))
              (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
                (let rulesAt (Arrow T NRs)
                  (lam ((i T)) (rulesFrom eb defs ovars hyps thms (drop i es)))
                  (let rulesOkAt (Arrow T T)
                    (lam ((i T)) (allT (ruleOk 2 defs ovars hyps thms) (drop i es)))
                    (let fresh (Arrow Ts (Arrow Ts T))
                      (lam ((scope Ts) (xs Ts)) (distinctFrom (append scope (append hyps thms)) xs))
                      (let i T (Source.indexOf (Source.nameOf at1) vars)
                        (let fuel T (number (at es 4))
                          (if (headed nd (quote (0 fold-induction)))
                            (let rest Ts (drop 1 vars)
                              (let s T
                                (iterm v gt defs ovars (at es 3)
                                  (cons (at ns 1) (cons (at ns 0) rest))
                                  (cons none (cons none (drop 1 kts))))
                                (pair
                                  (and (lt 4 k)
                                    (and (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                      (and (namesOk v 2 (at es 2))
                                        (and (fresh rest ns)
                                          (and (isSome s) (and (isSome fuel) (rulesOkAt 5)))))))
                                  (lam ((G Globals) (E (List Entry)) (base NRs))
                                    (byListInd G E n 0 1 (getD s mStar) (rulesIn E (rulesAt 5) base)
                                      (getD fuel 0))))))
                            (if (headed nd (quote (0 tree-fold-induction)))
                              (let s T
                                (iterm v gt defs ovars (at es 3)
                                  (cons (at ns 1) (cons (at ns 0) (nil T)))
                                  (cons none (cons none (nil T))))
                                (pair
                                  (and (lt 4 k)
                                    (and (and (eq (length vars) 1) (word at1 (at vars 0)))
                                      (and (isEmpty hyps)
                                        (and (namesOk v 2 (at es 2))
                                          (and (fresh (nil T) ns)
                                            (and (isSome s) (and (isSome fuel) (rulesOkAt 5))))))))
                                  (lam ((G Globals) (E (List Entry)) (base NRs))
                                    (lam ((g Ts) (hs Ts) (t T) (u T))
                                      (byRoseInd G E n 2 0 1 (getD s mStar)
                                        (rulesIn E (rulesAt 5) base)
                                        (getD fuel 0)
                                        g
                                        t
                                        u)))))
                              (if (form nd (quote (0 sum-cases)) 5)
                                (let r0 (Prod T Tac)
                                  (childR 3 (cons (at ns 0) vars) (cons none kts) hyps)
                                  (let r1 (Prod T Tac)
                                    (childR 4 (cons (at ns 0) vars) (cons none kts) hyps)
                                    (pair
                                      (and (isSome i)
                                        (and (namesOk v 1 (at es 2))
                                          (and (fresh vars ns) (and (fst r0) (fst r1)))))
                                      (lam ((G Globals) (E (List Entry)) (base NRs))
                                        (bySplit2 3 4 (getD i 0) ((snd r0) G E base)
                                          ((snd r1) G E base))))))
                                (if (form nd (quote (0 tree-cases)) 5)
                                  (let r (Prod T Tac)
                                    (childR 4 (cons (at ns 1) (cons (at ns 0) vars))
                                      (cons none (cons none kts))
                                      hyps)
                                    (let lk T (lemmaOf eb thms (at es 3))
                                      (pair
                                        (and (isSome i)
                                          (and (namesOk v 2 (at es 2))
                                            (and (fresh vars ns) (and (isSome lk) (fst r)))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byTreeSplit (getD lk 0) (getD i 0)
                                            ((snd r) G E base))))))
                                  (if (headed nd (quote (0 auto-trees)))
                                    (let lk T (lemmaOf eb thms (at es 3))
                                      (pair
                                        (and (lt 3 k)
                                          (and (isSome (depthOf at1))
                                            (and (isSome (number (at es 2)))
                                              (and (isSome lk) (rulesOkAt 4)))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byAutoT G E n (getD lk 0) (rulesIn E (rulesAt 4) base)
                                            (getD (number (at es 2)) 0)
                                            (getD (depthOf at1) 0)))))
                                    (if (form nd (quote (0 generalize)) 4)
                                      (let a T (itype ovars (child at1 1))
                                        (let c T (iterm v gt defs ovars (at es 2) vars kts)
                                          (let y T (Source.nameOf (child at1 0))
                                            (let r (Prod T Tac)
                                              (childR 3 (cons y vars)
                                                (cons (kernelType defs (child at1 1)) kts)
                                                hyps)
                                              (pair
                                                (and (ibinder v ovars at1)
                                                  (and (fresh vars (single y))
                                                    (and (isSome c) (fst r))))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (byGeneralize (getD a one) (getD c mStar)
                                                    ((snd r) G E base))))))))
                                      (if (lt 2 v)
                                        (script4 eb gt defs ovars thms nd rs vars kts hyps)
                                        (script3 v eb gt defs ovars thms nd vars kts
                                          hyps))))))))))))))))))))
  (defn scriptStep ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR))) SR
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
              (lam ((vars Ts) (kts Ts) (hyps Ts))
                (let rulesAt (Arrow T NRs)
                  (lam ((i T)) (rulesFrom eb defs ovars hyps thms (drop i es)))
                  (let rulesOkAt (Arrow T T)
                    (lam ((i T)) (allT (ruleOk v defs ovars hyps thms) (drop i es)))
                    (let fresh (Arrow Ts (Arrow Ts T))
                      (lam ((scope Ts) (xs Ts))
                        (and (allT (lam ((y T)) (if (lt 1 v) (bindable v y) (declared y))) xs)
                          (distinctFrom (append scope (append hyps thms)) (mapT Source.nameOf xs))))
                      (if (not (Source.isList nd)) (pair 0 failTac)
                        (if (headed nd (quote (0 normalize)))
                          (pair (and (lt 1 k) (and (isSome (number at1)) (rulesOkAt 2)))
                            (lam ((G Globals) (E (List Entry)) (base NRs))
                              (lam ((g Ts) (hs Ts) (t T) (u T))
                                (byNormW G E n (rulesIn E (rulesAt 2) base) (getD (number at1) 0) g
                                  hs
                                  t
                                  u))))
                          (if (headed nd (quote (0 reduce)))
                            (pair (and (lt 1 k) (and (isSome (depthOf at1)) (rulesOkAt 2)))
                              (lam ((G Globals) (E (List Entry)) (base NRs))
                                (byMode (getD (depthOf at1) 0) G E n (rulesIn E (rulesAt 2) base))))
                            (if (headed nd (quote (0 auto)))
                              (pair
                                (and (lt 2 k)
                                  (and (isSome (depthOf at1))
                                    (and (isSome (number (at es 2))) (rulesOkAt 3))))
                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                  (byAuto G E n (rulesIn E (rulesAt 3) base)
                                    (getD (number (at es 2)) 0)
                                    (getD (depthOf at1) 0))))
                              (if (form nd (quote (0 extensionality)) 3)
                                (let r (Prod T Tac)
                                  (childR 2 (cons (Source.nameOf at1) vars) (cons none kts) hyps)
                                  (pair (and (fresh vars (single at1)) (fst r))
                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                      (byFunExt G n ((snd r) G E base)))))
                                (let ns Ts (children (at es 2))
                                  (let n0 T (Source.nameOf (at ns 0))
                                    (let n1 T (Source.nameOf (at ns 1))
                                      (if (form nd (quote (0 induction)) 5)
                                        (let rest Ts (drop 1 vars)
                                          (let r0 (Prod T Tac) (childR 3 rest (drop 1 kts) hyps)
                                            (let r1 (Prod T Tac)
                                              (childR 4 (cons n1 (cons n0 rest))
                                                (cons (at kts 0)
                                                  (cons (listElem (at kts 0)) (drop 1 kts)))
                                                (append hyps (single (Source.nameOf (at ns 2)))))
                                              (pair
                                                (and
                                                  (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                                  (and (Source.isList (at es 2))
                                                    (and (eq (length ns) 3)
                                                      (and (fresh rest ns)
                                                        (and (fst r0) (fst r1))))))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (byListIndWith G n 0 1 ((snd r0) G E base)
                                                    ((snd r1) G E base)))))))
                                        (if (form nd (quote (0 cases)) 5)
                                          (let i T (Source.indexOf (Source.nameOf at1) vars)
                                            (let kt T (at kts (getD i 0))
                                              (let r0 (Prod T Tac) (childR 3 vars kts hyps)
                                                (let r1 (Prod T Tac)
                                                  (childR 4 (cons n1 (cons n0 vars))
                                                    (cons kt (cons (listElem kt) kts))
                                                    (append hyps (single (node 0 (nil T)))))
                                                  (pair
                                                    (and (Source.isAtom at1)
                                                      (and (isSome i)
                                                        (and (Source.isList (at es 2))
                                                          (and (eq (length ns) 2)
                                                            (and (fresh vars ns)
                                                              (and (fst r0) (fst r1)))))))
                                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                                      (byListSplit G n (getD i 0)
                                                        ((snd r0) G E base)
                                                        ((snd r1) G E base))))))))
                                          (if (form nd (quote (0 reduce-hypotheses)) 4)
                                            (let hns Ts (mapT Source.nameOf (children (at es 2)))
                                              (let r (Prod T Tac)
                                                (childR 3 vars kts
                                                  (append
                                                    (mapT
                                                      (lam ((x T))
                                                        (if (has x hns) (node 0 (nil T)) x))
                                                      hyps)
                                                    hns))
                                                (pair
                                                  (and (isSome (depthOf at1))
                                                    (and (Source.isList (at es 2))
                                                      (and (not (isEmpty hns))
                                                        (and
                                                          (allT
                                                            (lam ((h T))
                                                              (and (Source.isAtom h)
                                                                (has (Source.nameOf h) hyps)))
                                                            (children (at es 2)))
                                                          (and (distinctFrom (nil T) hns)
                                                            (fst r))))))
                                                  (lam ((G Globals) (E (List Entry)) (base NRs))
                                                    (withWeakHyps G E n base
                                                      (mapT
                                                        (lam ((x T))
                                                          (getD (Source.indexOf x hyps) 0))
                                                        hns)
                                                      (lam ((extra NRs)) ((snd r) G E base))
                                                      (getD (depthOf at1) 0))))))
                                            (if (lt 1 v)
                                              (script2 v eb gt defs ovars thms nd rs vars kts hyps)
                                              (pair 0 failTac)))))))))))))))))))))))
  (defn readScript ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (s T)) SR
    (para SR (scriptStep v eb gt defs ovars thms) s))

  ; A source theorem carries its name, its statement, its script and the version of its document.
  (data Request (request T Statement T T T))
  (defn requestName ((q Request)) T (case q ((request n s c w k) n)))
  (defn requestThm ((q Request)) Thm
    (case q ((request n s c w k) (case s ((statement os vs ks hs a) a)))))
  ; The normal form of a theorem's companion, (normal DEPTH RULE ...), which a theorem of version
  ; 3 may state after its script: the depth of the reduction of the companion's sides, and the
  ; rules it rewrites by before those that unfold the definitions, which name the statement's
  ; hypotheses and the theorems before it. A theorem without the form has the companion of the
  ; weak normal form. A request keeps the form, where there is one.
  (defn normalOk ((v T) (defs Ts) (ovars Ts) (hyps Ts) (thms Ts) (spec T)) T
    (if (isSome spec)
      (let f T (get spec)
        (and (lt 1 (length (children f)))
          (and (isSome (depthOf (child f 1)))
            (allT (ruleOk v defs ovars hyps thms) (drop 2 (children f))))))
      1))
  (defn normalDepth ((q Request)) T
    (case q ((request n s c w spec) (if (isSome spec) (getD (depthOf (child (get spec) 1)) 1) 1))))
  (defn normalRules ((eb T) (defs Ts) (thms Ts) (q Request)) NRs
    (case q
      ((request n s c w spec)
       (case s
         ((statement os vs ks hs a)
          (if (isSome spec)
            (rulesFrom eb defs (children os) (children hs) thms (drop 2 (children (get spec))))
            (nil NormRule)))))))
  ; What rejects a development: a reason and the name of the theorem it concerns, or the empty
  ; name. The reasons: 0, a document is not a proof document of a version this reader reads, or
  ; the documents' versions do not combine; 1, a theorem's name is declared before; 2, a
  ; theorem's form or statement does not read; 3, its script does not read; 4, its script does
  ; not prove it; 5, its sides have no weak normal forms within the budget; 6, the derivation its
  ; script gives, or its companion's, does not check.
  (defn failure ((why T) (name T)) T (node 2 (l2 why name)))
  ; A request read, or the reason it is not.
  (data ReadRequest (requestOk Request) (requestBad T))
  ; The theorems of version 0: an equation of two definitions' names, proved by normalization.
  (defn version0 ((defs Ts) (e T)) T
    (let eqn T (child e 2)
      (let script T (child e 3)
        (and (form eqn (quote (0 equal)) 3)
          (and (and (Source.isAtom (child eqn 1)) (has (Source.nameOf (child eqn 1)) defs))
            (and (and (Source.isAtom (child eqn 2)) (has (Source.nameOf (child eqn 2)) defs))
              (and (form script (quote (0 by)) 2)
                (form (child script 1) (quote (0 normalize)) 2))))))))
  (defn theoremName ((e T)) T
    (if (and (Source.isList e) (lt 1 (length (children e)))) (Source.nameOf (child e 1))
      (node 0 (nil T))))
  (defn readRequest ((v T) (G Globals) (gt Ts) (defs Ts) (names Ts) (thms Ts) (e T)) ReadRequest
    (if
      (and
        (or (form e (quote (0 theorem)) 4)
          (and (lt 2 v)
            (and (form e (quote (0 theorem)) 5) (headed (child e 4) (quote (0 normal))))))
        (and (Source.isAtom (child e 1))
          (and (not (isEmpty (children (child e 1))))
            (and (form (child e 3) (quote (0 by)) 2) (or (lt 0 v) (version0 defs e))))))
      (case (readStatement v G gt defs (append defs names) (child e 2))
        ((OSt.nothing) (requestBad 2))
        ((OSt.just st)
         (case st
           ((statement os vs ks hs a)
            (let script T (child (child e 3) 1)
              (let spec T (if (form e (quote (0 theorem)) 5) (some (child e 4)) none)
                (if
                  (and
                    (fst
                      (readScript v 0 gt defs (children os) thms script (children vs) (children ks)
                        (children hs)))
                    (normalOk v defs (children os) (children hs) thms spec))
                  (requestOk (request (Source.nameOf (child e 1)) st script v spec))
                  (requestBad 3))))))))
      (requestBad 2)))

  ; Abbreviations. A document of version 3 abbreviates by forms (abbreviation NAME ITEM ...), each
  ; naming one or more items: in the forms after it, the atom NAME in a list stands for the items
  ; in its place, as they are written, the abbreviations before it expanded in them. An
  ; abbreviation states nothing: the theorems of a document are those of its forms with the
  ; abbreviations expanded, and the names in an item are read where the item stands.
  (defn expandItems ((table Ts) (e T)) Ts
    (para Ts
      (lam ((nd T) (rs (List Ts)))
        (if (Source.isAtom nd)
          (let r T (Source.lookupAbbrev (Source.nameOf nd) table)
            (if (isSome r) (children (get r)) (single nd)))
          (single
            (node (label nd) (foldr Ts Ts (lam ((x Ts) (acc Ts)) (append x acc)) (nil T) rs)))))
      e))
  (defn expandForms ((v T) (fs Ts)) Ts
    (reverse
      (snd
        (foldr T (Prod Ts Ts)
          (lam ((f T) (st (Prod Ts Ts)))
            (if
              (and (lt 2 v)
                (and (headed f (quote (0 abbreviation)))
                  (and (lt 2 (length (children f))) (declared (child f 1)))))
              (pair
                (cons
                  (node 0
                    (l2 (Source.nameOf (child f 1))
                      (node 0
                        (foldr T Ts (lam ((x T) (acc Ts)) (append (expandItems (fst st) x) acc))
                          (nil T)
                          (drop 2 (children f))))))
                  (fst st))
                (snd st))
              (pair (fst st) (append (expandItems (fst st) f) (snd st)))))
          (pair (nil T) (nil T))
          (reverse fs)))))

  ; A proof document's version and the forms of its theorems. From version 2 the forms
  ; (import PATH) and (program NAME), which the host resolves, are left out.
  (data Document (document T & T))
  (import (Option Document) as ODoc)
  (defn readDocument ((source T)) ODoc.Maybe
    (let parsed T (Source.readSExps (children source))
      (let root T (child (get parsed) 0)
        (let v T (number (child root 1))
          (if
            (and (isSome parsed)
              (and (eq (length (children (get parsed))) 1)
                (and (Source.isList root)
                  (and (word (child root 0) (quote (0 proofs))) (and (isSome v) (lt (get v) 4))))))
            (let fs Ts
              (expandForms (get v)
                (foldr T Ts
                  (lam ((f T) (acc Ts))
                    (if
                      (and (lt 1 (get v))
                        (or (form f (quote (0 import)) 2) (form f (quote (0 program)) 2)))
                      acc
                      (cons f acc)))
                  (nil T)
                  (drop 2 (children root))))
              (if (isEmpty fs) ODoc.nothing (ODoc.just (document (get v) fs))))
            ODoc.nothing)))))
  ; The theorems of a development's documents in order, each with the version of its document, and
  ; the version of the last document: every document reads, and where there are several, none is
  ; of version 0, which saves no companion to cite, or of a version after the last document's.
  (data Forms (formList T & TPair))
  (import (Option Forms) as OForms)
  (import (Seq TPair) as Items)
  (import (Map T TPair) as ItemsOf)
  (import (Map TPair T) as ItemOut)
  (defn readDocuments ((sources Ts)) OForms.Maybe
    (foldr T OForms.Maybe
      (lam ((source T) (acc OForms.Maybe))
        (case acc ((OForms.nothing) OForms.nothing)
          ((OForms.just fs)
           (case fs
             ((formList last items)
              (case (readDocument source) ((ODoc.nothing) OForms.nothing)
                ((ODoc.just d)
                 (case d
                   ((document v xs)
                    (if
                      (or (and (eq v 0) (lt 1 (length sources)))
                        (and (lt 0 (Items.length items)) (lt last v)))
                      OForms.nothing
                      (OForms.just
                        (formList (if (eq (Items.length items) 0) v last)
                          (Items.append (ItemsOf.map (lam ((f T)) (pr v f)) xs) items)))))))))))))
      (if (isEmpty sources) OForms.nothing (OForms.just (formList 0 (nil TPair))))
      sources))

  ; Requests are read before proving, with distinct names and the version of the development's
  ; last document, which fixes the globals its statements are read in and the layout of its
  ; certificate, and which the list of requests keeps; the first form that does not read rejects
  ; the development.
  (import (Seq Request) as Requests)
  (data RequestList (requests T & Request))
  (data Read (readOk RequestList) (readBad T T))
  (defn firstRepeated ((names Ts)) T
    (snd
      (foldr T (Prod Ts T)
        (lam ((x T) (s (Prod Ts T))) (pair (cons x (fst s)) (if (has x (fst s)) (some x) (snd s))))
        (pair (nil T) none)
        (reverse names))))
  (defn readSources ((gt Ts) (defs Ts) (ds (List LDefn)) (sources Ts)) Read
    (case (readDocuments sources) ((OForms.nothing) (readBad 0 (node 0 (nil T))))
      ((OForms.just fs)
       (case fs
         ((formList v items)
          (let G Globals (globalsFor v ds)
            (let names Ts (ItemOut.map (lam ((p TPair)) (theoremName (p2 p))) items)
              (let twice T (firstRepeated names)
                (if (isSome twice) (readBad 1 (get twice))
                  (foldr T Read
                    (lam ((i T) (acc Read))
                      (let p TPair (Items.atOr (pr 0 0) items i)
                        (case (readRequest (p1 p) G gt defs names (take i names) (p2 p))
                          ((requestBad why) (readBad why (at names i)))
                          ((requestOk q)
                           (case acc ((readBad why name) acc)
                             ((readOk qs)
                              (case qs ((requests w xs) (readOk (requests w (cons q xs)))))))))))
                    (readOk (requests v (nil Request)))
                    (range (length names))))))))))))

  ; A saved development contains the checked declarations and their source names. In version 3 it
  ; begins with the connectives' rules, under no name. Each theorem is
  ; proved with the declarations before it as the development's entries. After version 0 it is
  ; followed by its companion of the same name: the theorem with its sides in weak normal form,
  ; derived from the theorem at its own objects, variables and hypotheses. The reductions rewrite
  ; a term whose head they have reduced, so a rule rewrites by a theorem's companion, as a theorem
  ; the Lean developments state in weak normal form. Version 0 cites no theorem and saves no
  ; companion.
  (data Results (results T & Decl))
  (data Progress (proving Results EntryList) (stuck T T))
  (import (Option EntryList) as OEntries)
  ; The entries after a declaration, where the checker of developments admits it.
  (defn admit ((G Globals) (E (List Entry)) (d Decl)) OEntries.Maybe
    (case (declStep G E d) ((ODevState.nothing) OEntries.nothing)
      ((ODevState.just st) (case st ((devState G2 es) (OEntries.just es))))))
  (defn derive
    ((G Globals) (E (List Entry)) (rs NRs) (eb T) (gt Ts) (defs Ts) (thms Ts) (q Request))
    T
    (case q
      ((request n s script w k)
       (case s
         ((statement os vs ks hs a)
          (case a
            ((mkThm ar c h f)
             (case c
               ((objs g)
                (case h
                  ((terms hyps)
                   (case (eqParts f) ((OTPair.nothing) none)
                     ((OTPair.just tu)
                      ((snd
                         (readScript w eb gt defs (children os) thms script (children vs)
                           (children ks)
                           (children hs))) G E rs g hyps (p1 tu) (p2 tu)))))))))))))))
  (defn companion ((G Globals) (E (List Entry)) (rs NRs) (m T) (j T) (a Thm)) T
    (case a
      ((mkThm ar c h f)
       (case c
         ((objs g)
          (case h
            ((terms hyps)
             (case (eqParts f) ((OTPair.nothing) none)
               ((OTPair.just lr)
                (bindNT (eval G E ar rs 4096 m g hyps (p1 lr))
                  (lam ((nl NFR))
                    (bindNT (eval G E ar rs 4096 m g hyps (p2 lr))
                      (lam ((nr NFR))
                        (some
                          (node 0
                            (l3 (nfTerm nl) (nfTerm nr)
                              (dNode 24 (single f)
                                (l2
                                  (dNode 2 (nil T)
                                    (l2 (mDeriv (nfMarked nl)) (mDeriv (nfMarked nr))))
                                  (dNode 27
                                    (l3 j (node 0 (mapT x (range ar)))
                                      (node 0 (mapT var (range (length g)))))
                                    (mapT (lam ((i T)) (dNode 21 (single i) (nil T)))
                                      (range (length hyps))))))))))))))))))))))
  (defn withSides ((a Thm) (l T) (r T)) Thm (case a ((mkThm ar c h f) (mkThm ar c h (mEq l r)))))
  (defn sourceNames ((v T) (ns Ts)) Ts
    (if (eq v 0) ns
      (let xs Ts (drop (entryBase v) ns)
        (mapT (lam ((i T)) (at xs (mul 2 i))) (range (div (length xs) 2))))))
  ; The development before its first theorem: in version 3 the connectives' rules, checked.
  (defn begin ((G Globals) (v T) (o T)) Progress
    (let ds (List Decl) (if (lt 2 v) (connectiveRules o 0) (nil Decl))
      (case (checkDev G (nil Entry) ds) ((ODevState.nothing) (stuck 6 unnamed))
        ((ODevState.just st)
         (case st
           ((devState G2 el)
            (proving (results (node 0 (mapT (lam ((i T)) unnamed) (range (Decls.length ds)))) ds)
              el)))))))
  (defn advance ((G Globals) (rs NRs) (gt Ts) (defs Ts) (v T) (q Request) (st Progress)) Progress
    (case st ((stuck why name) st)
      ((proving a el)
       (case a
         ((results ns ds)
          (case el
            ((entries E)
             (let d T (derive G E rs (entryBase v) gt defs (sourceNames v (children ns)) q)
               (if (isSome d)
                 (let decl Decl (declLang (requestThm q) (get d))
                   (case (admit G E decl) ((OEntries.nothing) (stuck 6 (requestName q)))
                     ((OEntries.just el1)
                      (case el1
                        ((entries E1)
                         (let ds1 (List Decl) (Decls.append ds (Decls.single decl))
                           (if (eq v 0)
                             (proving
                               (results (node 0 (append (children ns) (single (requestName q))))
                                 ds1)
                               el1)
                             (let w T
                               (companion G E1
                                 (rulesIn E1
                                   (normalRules (entryBase v) defs (sourceNames v (children ns)) q)
                                   rs)
                                 (normalDepth q)
                                 (Decls.length ds)
                                 (requestThm q))
                               (if (isSome w)
                                 (let cs Ts (children (get w))
                                   (let decl2 Decl
                                     (declLang (withSides (requestThm q) (at cs 0) (at cs 1))
                                       (at cs 2))
                                     (case (admit G E1 decl2)
                                       ((OEntries.nothing) (stuck 6 (requestName q)))
                                       ((OEntries.just el2)
                                        (proving
                                          (results
                                            (node 0
                                              (append (children ns)
                                                (l2 (requestName q) (requestName q))))
                                            (Decls.append ds1 (Decls.single decl2)))
                                          el2)))))
                                 (stuck 5 (requestName q)))))))))))
                 (stuck 4 (requestName q)))))))))))
  ; The development's certificate, the present tree, or its failure.
  (defn proveWith ((gt Ts) (names Ts) (ds (List LDefn)) (sources Ts)) T
    (case (readSources gt names ds sources) ((readBad why name) (failure why name))
      ((readOk qs)
       (case qs
         ((requests v xs)
          (let G Globals (globalsFor v ds)
            (let o T (add (LD.length lib) (LD.length ds))
              (let rs NRs (rulesOf v o)
                (case
                  ((foldr Request (Arrow Progress Progress)
                     (lam ((q Request) (k (Arrow Progress Progress)) (st Progress))
                       (k (advance G rs gt names v q st)))
                     (lam ((st Progress)) st)
                     xs) (begin G v o))
                  ((stuck why name) (failure why name))
                  ((proving a el) (some (rep a))))))))))))
  ; The sources of a development are the children of a node, each the node of a document's
  ; characters.
  (defn prove ((bundle T) (sources T)) T
    (case (program (children (child bundle 0))) ((OTrState.nothing) none)
      ((OTrState.just st)
       (case st
         ((trState gt ds)
          (case gt
            ((ktys gs)
             (case ds
               ((ldefns xs)
                (proveWith gs (children (child bundle 1)) xs (children sources)))))))))))

  ; Replay requires the statements and names of the sources and checks the saved derivations.
  ; It does not search, and it does not require the current prover to produce the same derivation.
  ; Each source theorem is matched by its declaration under its name, and after version 0 by a
  ; companion under the same name, whose statement is the one its checked derivation proves; in
  ; version 3 the theorems follow as many declarations as the connectives' rules.
  (defn stated ((d Decl)) T (case d ((declLang a dv) (some (rep a))) (else none)))
  (defn matches ((v T) (xs (List Request)) (ds (List Decl)) (ns Ts)) T
    (and (eq (mul (if (eq v 0) 1 2) (Requests.length xs)) (Decls.length ds))
      (and (eq (Decls.length ds) (length ns))
        ((foldr Request (Arrow (List Decl) (Arrow Ts T))
           (lam ((q Request) (k (Arrow (List Decl) (Arrow Ts T))) (rest (List Decl)) (names Ts))
             (lcase Decl T rest 0
               (lam ((d Decl) (tail (List Decl)))
                 (and (equal (stated d) (some (rep (requestThm q))))
                   (and (equal (requestName q) (at names 0))
                     (if (eq v 0) (k tail (drop 1 names))
                       (lcase Decl T tail 0
                         (lam ((e Decl) (tail2 (List Decl)))
                           (and (isSome (stated e))
                             (and (equal (requestName q) (at names 1))
                               (k tail2 (drop 2 names))))))))))))
           (lam ((rest (List Decl)) (names Ts)) 1)
           xs) ds ns))))
  (defn replayWith ((gt Ts) (names Ts) (ds (List LDefn)) (sources Ts) (saved T)) T
    (case (readSources gt names ds sources) ((readBad why name) 0)
      ((readOk qs)
       (case qs
         ((requests v xs)
          (decode Results saved
            (lam ((a Results))
              (case a
                ((results ns decls)
                 (if
                   (matches v xs (Decls.drop (entryBase v) decls)
                     (drop (entryBase v) (children ns)))
                   (case (checkDev (globalsFor v ds) (nil Entry) decls) ((ODevState.nothing) 0)
                     ((ODevState.just st) 1))
                   0))))
            0))))))
  (defn replay ((bundle T) (sources T) (saved T)) T
    (case (program (children (child bundle 0))) ((OTrState.nothing) 0)
      ((OTrState.just st)
       (case st
         ((trState gt ds)
          (case gt
            ((ktys gs)
             (case ds
               ((ldefns xs)
                (replayWith gs (children (child bundle 1)) xs (children sources) saved))))))))))

  ; The version of the last document of a development that the program's statements read, which
  ; fixes the layout of its certificate, the present tree, or the failure of its reading.
  (defn version ((bundle T) (sources T)) T
    (case (program (children (child bundle 0))) ((OTrState.nothing) none)
      ((OTrState.just st)
       (case st
         ((trState gt ds)
          (case gt
            ((ktys gs)
             (case ds
               ((ldefns xs)
                (case (readSources gs (children (child bundle 1)) xs (children sources))
                  ((readBad why name) (failure why name))
                  ((readOk qs) (case qs ((requests v ys) (some v)))))))))))))))
