                                                     (dNode 2 (nil T)
                                                       (l2 d (dNode 0 (nil T) (nil T)))))
                                                   (dNode 16 (l4 j (node 0 th) (node 0 sg) 0)
                                                     (nil T))
                                                   al)
                                                 (dNode 0 (nil T) (nil T)))))))))
                                   none)))))))))))))))))
  ; The pointwise form of an earlier theorem that equates two functions: its instance at its own
  ; objects and variables, applied to the goal's innermost variable.
  (defn byPointwise ((G Globals) (E (List Entry)) (n T) (j T) (rs NRs) (m T)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (case (thmAt E j) ((OThm.nothing) none)
        ((OThm.just b)
         (byInstance G E n j (mapT x (range n))
           (mapT (lam ((i T)) (var (add i 1))) (range (length (thCtx b))))
           (single (var 0))
           rs
           m
           g
           hs
           t
           u)))))
  ; The uniqueness of a list's fold with a step, each premise by a prover: the sides at the empty
  ; list by the first, and by the second each side at a head before a list as the step at that
  ; side at the list.
  (defn byListFold ((G Globals) (n T) (s T) (p0 Pv) (p1v Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (lcase T T g none
