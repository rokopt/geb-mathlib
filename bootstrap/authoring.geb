  (defn rulesFrom ((eb T) (defs Ts) (ovars Ts) (hyps Ts) (thms Ts) (es Ts)) NRs
    (foldr T NRs (lam ((e T) (acc NRs)) (cons (ruleOf eb defs ovars hyps thms e) acc))
      (nil NormRule)
