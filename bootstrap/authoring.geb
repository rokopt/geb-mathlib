; Proof sources for theorems about the named definitions of a checked program. A proof document
; is (proofs V FORM ...), each form (theorem NAME STATEMENT (by SCRIPT)). Version 0 admits only
; the theorems (theorem NAME (equal LEFT RIGHT) (by (normalize FUEL))) whose sides name
; definitions, whose statements it reads as version 1 does and whose normalization keeps its own
; rules. Version 1 states theorems over the kernel's types and terms. Version 2 states them also
; over the internal language, in object variables, and adds the tactics of trees and coproducts,
; rules at objects, and two forms the host resolves: (import PATH), which name the documents
; whose theorems a document cites, a development being the documents a document imports, in the
; order the host resolves them, followed by the document; and (program NAME), which names the
; program a document is proved against where the host is given none. Version 3 adds truth and
; implication to the terms of the internal language, the definitions of {geb}`Logic.connectives`
; after the program's, whose rules a development of that version begins with, and the tactics of
; the induction on trees with the hypothesis at each child, of the instances of a hypothesis, of
; implications, of the alternative of two scripts and of the case analysis of a bitstring to a
; number of bits. Statements and scripts are read before any proof is searched; every derivation
; is checked by {geb}`Derivation.declStep`, the step of the checker of developments, as it is
; found, and replay checks a saved development by {geb}`Derivation.checkDev`.

(module Authoring (export prove replay version) (import Prelude) (import Base) (import Theory)
  (import Language)
  (import PartialHorn)
  (import Derivation)
  (import Translation)
  (import Prover)
  (import Tactics)
  (import Logic)
  (import Reader as Source)
  (import (Seq LDefn) as LD)
  (import (Seq OpSig) as OS)
  (import (Few Primitive) as PF)
  (import (Map LDefn Definition) as DL)
  (import (Seq Decl) as Decls)
  (import (Seq NormRule) as Rules)

  ; Exact form and atom tests: malformed input is rejected before any field is read.
  (defn word ((e T) (s T)) T (and (Source.isAtom e) (equal (Source.nameOf e) s)))
  (defn form ((e T) (s T) (n T)) T
    (and (Source.isList e) (and (eq (length (children e)) n) (word (child e 0) s))))
  (defn headed ((e T) (s T)) T
    (and (Source.isList e) (and (lt 0 (length (children e))) (word (child e 0) s))))
  (defn number ((e T)) T (if (Source.isAtom e) (Source.numeral (children e)) none))
  (defn has ((x T) (xs Ts)) T (isSome (Source.indexOf x xs)))
  ; A name an author declares is a nonempty atom that is neither a numeral nor reserved.
  (defn declared ((e T)) T
    (and (Source.isAtom e)
      (and (not (isEmpty (children e)))
        (and (not (isSome (number e))) (not (has (Source.nameOf e) Source.reservedNames))))))
  ; The keywords of the internal language's terms that the kernel's reader does not reserve. A
  ; name declared where those terms are read is none of them.
  (def internalNames
    (children (quote (0 (0 inl) (0 inr) (0 case) (0 list-rec) (0 rose-rec) (0 lib) (0 kernel)))))
  ; The keywords of the connectives, which version 3 reads: a name declared where it reads terms
  ; of the internal language is neither.
  (def connectiveNames (children (quote (0 (0 true) (0 implies)))))
  (defn bindable ((v T) (e T)) T
    (and (declared e)
      (and (not (has (Source.nameOf e) internalNames))
        (not (and (lt 2 v) (has (Source.nameOf e) connectiveNames))))))
  ; Names are distinct from one another and from the names already taken.
  (defn distinctFrom ((taken Ts) (xs Ts)) T
    ((foldr T (Arrow Ts T)
       (lam ((x T) (k (Arrow Ts T)) (seen Ts)) (and (not (has x seen)) (k (cons x seen))))
       (lam ((seen Ts)) 1)
       xs) taken))
  ; A list of a number of names that may be declared.
  (defn namesOk ((v T) (n T) (e T)) T
    (and (Source.isList e) (and (eq (length (children e)) n) (allT (bindable v) (children e)))))

  ; The translation's globals, with its library before the program's definitions. In version 3
  ; the connectives' definitions follow the program's, from the index of the first, and their
  ; rules are the first entries of a development.
  (defn globalsOf ((ds (List LDefn))) Globals
    (globals (prims (PF.l6 nilPrim consPrim lnodePrim inlPrim inrPrim casePrim))
      (defs (DL.map defLang (LD.append lib ds)))
      (OS.length sig)))
  (defn connectivesAt ((defs Ts)) T (add (LD.length lib) (length defs)))
  (defn globalsFor ((v T) (ds (List LDefn))) Globals
    (globalsOf (if (lt 2 v) (LD.append ds (connectives (add (LD.length lib) (LD.length ds)))) ds)))
  (def ruleCount (Decls.length (connectiveRules 0 0)))
  (defn entryBase ((v T)) T (if (lt 2 v) ruleCount 0))
  ; The rules of the reductions, unfolding the definitions below an index: in version 0, β and the
  ; components of pairs; in the later versions, also the folds of lists and rose trees at their
  ; constructions, the case analysis of a coproduct at its injections and the element of the
  ; terminal type, as the Lean developments reduce.
  (defn rulesOf ((v T) (n T)) NRs
    (let unfold NRs (Rules.single (nrBelow n (terms (nil T))))
      (cons (nrRule 3 (terms (nil T)))
        (cons (nrRule 4 (terms (nil T)))
          (cons (nrRule 5 (terms (nil T)))
            (if (eq v 0) unfold
              (cons (nrRule 11 (terms (single 0)))
                (cons (nrRule 12 (terms (single 1)))
                  (cons (nrRule 13 (terms (l3 2 0 1)))
                    (cons (nrRule 14 (terms (l2 5 3)))
                      (cons (nrRule 15 (terms (l2 5 4))) (cons nrUnit unfold))))))))))))

  ; Types. A kernel type is read as the type of an empty list by the Geb reader. A type of the
  ; internal language is a kernel type's translation, the bits, the bitstrings, the truth values,
  ; a coproduct, the rose trees over a type of labels, or an object variable by its name.
  (defn kernelType ((defs Ts) (a T)) T
    (let r T (Source.resolve (nil T) defs (node 2 (l2 (node 1 (children Source.kwNil)) a)) (nil T))
      (if (isSome r) (some (child (get r) 0)) none)))
  (defn itype ((ovars Ts) (e T)) T
    (para T
      (lam ((nd T) (rs Ts))
        (let k T (length rs)
          (let h T (child nd 0)
            (let bin (Arrow (Arrow T (Arrow T T)) T)
              (lam ((f (Arrow T (Arrow T T))))
                (if (eq k 3) (bindO (at rs 1) (lam ((a T)) (mapO (f a) (at rs 2)))) none))
              (let un (Arrow (Arrow T T) T)
                (lam ((f (Arrow T T))) (if (eq k 2) (mapO f (at rs 1)) none))
                (if (Source.isAtom nd)
                  (let n T (Source.nameOf nd)
                    (if (equal n Source.kwT) (some treeTy)
                      (if (equal n Source.kwUnit) (some one)
                        (if (equal n (quote (0 Bit))) (some (coprod one one))
                          (if (equal n (quote (0 Bits))) (some bitsTy)
                            (if (equal n (quote (0 Omega))) (some omega)
                              (mapO x (Source.indexOf n ovars))))))))
                  (if (not (Source.isList nd)) none
                    (if (word h Source.kwProd) (bin prod)
                      (if (word h (quote (0 Sum))) (bin coprod)
                        (if (word h Source.kwArrow) (bin exp)
                          (if (word h Source.kwList) (un list)
                            (if (word h (quote (0 Rose))) (un lrose) none))))))))))))
      e))
  ; The element type of a kernel list type, where a kernel type is one.
  (defn listElem ((kt T)) T
    (if (isSome kt)
      (if (and (eq (label (get kt)) Label.tyList) (eq (arity (get kt)) 1)) (some (child (get kt) 0))
        none)
      none))

  ; Terms. A term is read in the names of the variables in scope, the innermost first, beside the
  ; kernel type of each that has one. A term of the kernel is read by the Geb reader in the
  ; variables that have kernel types and translated as the program's definitions are. A term of
  ; the internal language is a variable, the element of the terminal type, a definition of the
  ; program by its name, a pair or a component, an abstraction, a primitive arrow at its objects,
  ; a fold of a list or of a rose tree, an equation, a definition of the translation's library at
  ; its objects, a term of the kernel, or an application; in version 3, also truth, or the
  ; implication of a formula by another, (implies P Q).
  (defn ikernel ((gt Ts) (defs Ts) (e T) (scope Ts) (kts Ts)) T
    (let idxs Ts
      (foldr T Ts (lam ((i T) (acc Ts)) (if (isSome (at kts i)) (cons i acc) acc)) (nil T)
        (range (length scope)))
      (bindO (Source.resolve (nil T) defs e (mapT (at scope) idxs))
        (lam ((kt T))
          (case (term gt (mapT (lam ((i T)) (get (at kts i))) idxs) kt) ((OTPair.nothing) none)
            ((OTPair.just p)
             (some
               (if (eq (length idxs) (length scope)) (p2 p)
                 (rename (p2 p) (lam ((j T)) (at idxs j)))))))))))
  ; The library's definitions by their names.
  (defn libEntry ((n T) (j T)) T (node 0 (l2 n j)))
  (def libTable
    (append
      (l6 (libEntry (quote (0 bnil)) D.bnil) (libEntry (quote (0 b0)) D.b0)
        (libEntry (quote (0 b1)) D.b1)
        (libEntry (quote (0 lab)) D.lab)
        (libEntry (quote (0 unnode)) D.unnode)
        (libEntry (quote (0 children)) D.children))
      (append
        (l6 (libEntry (quote (0 cond)) D.cond) (libEntry (quote (0 tail)) D.tail)
          (libEntry (quote (0 headD)) D.headD)
          (libEntry (quote (0 lcase)) D.lcase)
          (libEntry (quote (0 isNil)) D.isNil)
          (libEntry (quote (0 succ)) D.succ))
        (append
          (l6 (libEntry (quote (0 length)) D.length) (libEntry (quote (0 pred)) D.pred)
            (libEntry (quote (0 dbl)) D.dbl)
            (libEntry (quote (0 add)) D.add)
            (libEntry (quote (0 cmp)) D.cmp)
            (libEntry (quote (0 ltB)) D.ltB))
          (append
            (l6 (libEntry (quote (0 eqB)) D.eqB) (libEntry (quote (0 subE)) D.subE)
              (libEntry (quote (0 sub)) D.sub)
              (libEntry (quote (0 mul)) D.mul)
              (libEntry (quote (0 divMod)) D.divMod)
              (libEntry (quote (0 log2)) D.log2))
            (l5 (libEntry (quote (0 iter)) D.iter) (libEntry (quote (0 mapApp)) D.mapApp)
              (libEntry (quote (0 and)) D.and)
              (libEntry (quote (0 allZip)) D.allZip)
              (libEntry (quote (0 equal)) D.equal)))))))
  ; A definition of the library applied: (lib NAME TYPE ... TERM ...), with an object for each of
  ; its object parameters and a term for each of its parameters; the terms are those of the form's
  ; elements at their positions.
  (defn ilib ((ovars Ts) (es Ts) (arg (Arrow T T))) T
    (bindO
      (if (Source.isAtom (at es 1)) (Source.lookupAbbrev (Source.nameOf (at es 1)) libTable) none)
      (lam ((j T))
        (case (OLDefn.nthOf lib j) ((OLDefn.nothing) none)
          ((OLDefn.just d)
           (case d
             ((ldefn m ps a b)
              (case ps
                ((objs xs)
                 (if (eq (length es) (add 2 (add m (length xs))))
                   (bindO (allSomeT (mapT (lam ((i T)) (itype ovars (at es (add 2 i)))) (range m)))
                     (lam ((th T))
                       (mapO (lam ((ts T)) (call j (children th) (children ts)))
                         (allSomeT
                           (mapT (lam ((i T)) (arg (add (add 2 m) i))) (range (length xs)))))))
                   none))))))))))
  (deftype IR (Arrow Ts (Arrow Ts T)))
  (import (Seq IR) as IRs)
  (def failIR (lam ((scope Ts) (kts Ts)) none))
  (defn map2 ((f (Arrow T (Arrow T T))) (a T) (b T)) T (bindO a (lam ((x T)) (mapO (f x) b))))
  ; A binder (x A) of an abstraction.
  (defn binderName ((b T)) T (Source.nameOf (child b 0)))
  (defn ibinder ((v T) (ovars Ts) (b T)) T
    (and (Source.isList b)
      (and (eq (length (children b)) 2)
        (and (bindable v (child b 0)) (isSome (itype ovars (child b 1)))))))
  (defn ilam ((v T) (defs Ts) (ovars Ts) (bs Ts) (body IR) (scope Ts) (kts Ts)) T
    (if (and (not (isEmpty bs)) (allT (ibinder v ovars) bs))
      (mapO
        (lam ((b T))
          (foldr T T (lam ((y T) (acc T)) (mLam (getD (itype ovars (child y 1)) one) acc)) b bs))
        (body (append (reverse (mapT binderName bs)) scope)
          (append (reverse (mapT (lam ((y T)) (kernelType defs (child y 1))) bs)) kts)))
      none))
  ; An atom: a variable, the element of the terminal type, in version 3 truth, or a definition of
  ; the program.
  (defn iatom ((v T) (defs Ts) (n T) (scope Ts)) T
    (let i T (Source.indexOf n scope)
      (if (isSome i) (some (var (get i)))
        (if (equal n Source.kwUnitValue) (some mStar)
          (if (and (lt 2 v) (equal n (quote (0 true)))) (some (ttL (connectivesAt defs)))
            (mapO (lam ((j T)) (call (add (LD.length lib) j) (nil T) (nil T)))
              (Source.indexOf n defs)))))))
  ; The forms of the primitive arrows, each at its objects: the empty list, a head before a list,
  ; the node of a label and children, the injections and the case analysis of a coproduct.
  (defn iprim ((ovars Ts) (es Ts) (arg (Arrow T T))) T
    (let k T (length es)
      (let h T (at es 0)
        (let ty (Arrow T T) (lam ((i T)) (itype ovars (at es i)))
          (if (word h Source.kwNil)
            (if (eq k 2) (mapO (lam ((a T)) (mArr 0 (single a) mStar)) (ty 1)) none)
            (if (word h Source.kwCons)
              (if (eq k 4)
                (bindO (ty 1)
                  (lam ((a T))
                    (map2 (lam ((y T) (ys T)) (mArr 1 (single a) (mPair y ys))) (arg 2) (arg 3))))
                none)
              (if (word h (quote (0 node)))
                (if (eq k 3) (map2 (lam ((a T) (p T)) (mArr 2 (single a) p)) (ty 1) (arg 2)) none)
                (if (or (word h (quote (0 inl))) (word h (quote (0 inr))))
                  (if (eq k 4)
                    (bindO (ty 1)
                      (lam ((a T))
                        (map2
                          (lam ((b T) (t T)) (mArr (if (word h (quote (0 inl))) 3 4) (l2 a b) t))
                          (ty 2)
                          (arg 3))))
                    none)
                  (if (eq k 5)
                    (bindO (ty 1)
                      (lam ((a T))
                        (bindO (ty 2)
                          (lam ((b T))
                            (map2 (lam ((c T) (p T)) (mArr 5 (l3 a b c) p)) (ty 3) (arg 4))))))
                    none)))))))))
  (defn primHead ((h T)) T
    (or (word h Source.kwNil)
      (or (word h Source.kwCons)
        (or (word h (quote (0 node)))
          (or (word h (quote (0 inl))) (or (word h (quote (0 inr))) (word h (quote (0 case)))))))))
  (defn itermStep ((v T) (gt Ts) (defs Ts) (ovars Ts) (nd T) (rs (List IR))) IR
    (let es Ts (children nd)
      (let k T (length es)
        (let h T (at es 0)
          (lam ((scope Ts) (kts Ts))
            (let kid (Arrow T IR) (lam ((i T)) (IRs.atOr failIR rs i))
              (let arg (Arrow T T) (lam ((i T)) (kid i scope kts))
                (let ns Ts (mapT Source.nameOf (children (at es 2)))
                  (if (Source.isAtom nd) (iatom v defs (Source.nameOf nd) scope)
                    (if (not (Source.isList nd)) none
                      (if (word h Source.kwPair) (if (eq k 3) (map2 mPair (arg 1) (arg 2)) none)
                        (if (word h Source.kwFst) (if (eq k 2) (mapO mFst (arg 1)) none)
                          (if (word h Source.kwSnd) (if (eq k 2) (mapO mSnd (arg 1)) none)
                            (if (word h (quote (0 equal)))
                              (if (eq k 3) (map2 mEq (arg 1) (arg 2)) none)
                              (if (word h Source.kwLam)
                                (if (and (eq k 3) (Source.isList (at es 1)))
                                  (ilam v defs ovars (children (at es 1)) (kid 2) scope kts)
                                  none)
                                (if (and (lt 2 v) (word h (quote (0 implies))))
                                  (if (eq k 3)
                                    (map2 (lam ((p T) (q T)) (impL (connectivesAt defs) p q))
                                      (arg 1)
                                      (arg 2))
                                    none)
                                  (if (primHead h) (iprim ovars es arg)
                                    (if (word h (quote (0 list-rec)))
                                      (if (and (eq k 5) (namesOk v 2 (at es 2)))
                                        (bindO (arg 1)
                                          (lam ((z T))
                                            (bindO
                                              (kid 3 (cons (at ns 1) (cons (at ns 0) scope))
                                                (cons none (cons none kts)))
                                              (lam ((s T)) (mapO (mListRec z s) (arg 4))))))
                                        none)
                                      (if (word h (quote (0 rose-rec)))
                                        (if (and (eq k 5) (namesOk v 1 (at es 2)))
                                          (bindO (itype ovars (at es 1))
                                            (lam ((c T))
                                              (bindO (kid 3 (cons (at ns 0) scope) (cons none kts))
                                                (lam ((s T)) (mapO (mRoseRec c s) (arg 4))))))
                                          none)
                                        (if (word h (quote (0 lib))) (ilib ovars es arg)
                                          (if (word h (quote (0 kernel)))
                                            (if (eq k 2) (ikernel gt defs (at es 1) scope kts) none)
                                            (if (lt 1 k)
                                              (bindO (arg 0)
                                                (lam ((f T))
                                                  (mapO (lam ((xs T)) (apps f (children xs)))
                                                    (allSomeT (mapT arg (drop 1 (range k)))))))
                                              none))))))))))))))))))))))
  (defn iterm ((v T) (gt Ts) (defs Ts) (ovars Ts) (e T)) IR (para IR (itermStep v gt defs ovars) e))

  ; Statements. A statement over the kernel is (forall ((x A) ...) P) or P, each A a kernel type
  ; and P an equation of terms of the kernel or its implication by named hypotheses. A statement
  ; over the internal language, in version 2, is (internal (X ...) Q): it binds its object
  ; variables, and Q is of the same form with the types and the terms of the internal language. An
  ; equation's sides have one type in the context.
  (defn readEqn ((G Globals) (n T) (ctx Ts) (rd (Arrow T T)) (e T)) T
    (if (form e (quote (0 equal)) 3)
      (bindO (rd (child e 1))
        (lam ((l T))
          (bindO (rd (child e 2))
            (lam ((r T))
              (let a T (typeIn G n ctx l)
                (if (and (isSome a) (equal a (typeIn G n ctx r))) (some (mEq l r)) none))))))
      none))
  ; A statement keeps the names of its object variables, of its variables, the innermost first,
  ; the kernel type of each variable that has one, and the names of its hypotheses, in their
  ; order, each list as the children of a node, beside its theorem of the metalogic.
  (data Statement (statement T T T T Thm))
  (import (Option Statement) as OSt)
  (defn binderOk ((v T) (defs Ts) (ovars Ts) (internal T) (b T)) T
    (and (Source.isList b)
      (and (eq (length (children b)) 2)
        (if internal (and (bindable v (child b 0)) (isSome (itype ovars (child b 1))))
          (and (declared (child b 0)) (isSome (kernelType defs (child b 1))))))))
  (defn hypOk ((v T) (internal T) (h T)) T
    (and (Source.isList h)
      (and (eq (length (children h)) 2)
        (if internal (bindable v (child h 0)) (declared (child h 0))))))
  (defn readQuantified
    ((v T) (G Globals) (gt Ts) (defs Ts) (taken Ts) (ovars Ts) (internal T) (e T))
    OSt.Maybe
    (let quant T (form e (quote (0 forall)) 3)
      (let bs Ts (if quant (children (child e 1)) (nil T))
        (let body T (if quant (child e 2) e)
          (let k T (length (children body))
            (let hyp T (and (headed body (quote (0 implies))) (lt 2 k))
              (let hs Ts (if hyp (take (sub k 2) (drop 1 (children body))) (nil T))
                (let concl T (if hyp (at (children body) (sub k 1)) body)
                  (let vars Ts (reverse (mapT binderName bs))
                    (let hnames Ts (mapT binderName hs)
                      (let n T (length ovars)
                        (if
                          (and (or (not quant) (and (Source.isList (child e 1)) (not (isEmpty bs))))
                            (and (allT (binderOk v defs ovars internal) bs)
                              (and (allT (hypOk v internal) hs)
                                (distinctFrom taken (append vars hnames)))))
                          (let ctx Ts
                            (reverse (mapT (lam ((b T)) (getD (itype ovars (child b 1)) one)) bs))
                            (let kts Ts
                              (reverse (mapT (lam ((b T)) (kernelType defs (child b 1))) bs))
                              (let rd (Arrow T T)
                                (lam ((t T))
                                  (if internal (iterm v gt defs ovars t vars kts)
                                    (ikernel gt defs t vars kts)))
                                (let hfs T
                                  (allSomeT
                                    (mapT (lam ((h T)) (readEqn G n ctx rd (child h 1))) hs))
                                  (let f T (readEqn G n ctx rd concl)
                                    (if (and (isSome hfs) (isSome f))
                                      (OSt.just
                                        (statement (node 0 ovars) (node 0 vars) (node 0 kts)
                                          (node 0 hnames)
                                          (mkThm n (objs ctx) (terms (children (get hfs)))
                                            (get f))))
                                      OSt.nothing))))))
                          OSt.nothing))))))))))))
  (defn readStatement ((v T) (G Globals) (gt Ts) (defs Ts) (taken Ts) (e T)) OSt.Maybe
    (if (and (lt 1 v) (form e (quote (0 internal)) 3))
      (let ovars Ts (mapT Source.nameOf (children (child e 1)))
        (if
          (and (Source.isList (child e 1))
            (and (allT (bindable v) (children (child e 1))) (distinctFrom taken ovars)))
          (readQuantified v G gt defs (append taken ovars) ovars 1 (child e 2))
          OSt.nothing))
      (readQuantified v G gt defs taken (nil T) 0 e)))

  ; Scripts. A script is read in the names of its goal's variables, with the kernel type of each
  ; that has one, and of its hypotheses, which the tactics that introduce variables or hypotheses
  ; name, and with the names of the theorems before it; reading it gives whether it is well formed
  ; and its tactic, a prover of the goal's equation given the globals, the entries before it and
  ; the rules that unfold the definitions.
  (deftype Tac (Arrow Globals (Arrow (List Entry) (Arrow NRs Pv))))
  (deftype SR (Arrow Ts (Arrow Ts (Arrow Ts (Prod T Tac)))))
  (import (Seq SR) as SRs)
  (def failTac (lam ((G Globals) (E (List Entry)) (base NRs) (g Ts) (hs Ts) (t T) (u T)) none))
  (def failSR (lam ((vars Ts) (kts Ts) (hyps Ts)) (pair 0 failTac)))
  ; A rule names a hypothesis, rewriting by it, or an earlier theorem, rewriting by the instances of
  ; its companion, the declaration after it. In version 2 a theorem in object variables is named
  ; with an object for each, (NAME TYPE ...). The theorems of a development follow eb entries, the
  ; connectives' rules in version 3.
  (defn ruleOk ((v T) (ovars Ts) (hyps Ts) (thms Ts) (e T)) T
    (if (Source.isAtom e) (or (has (Source.nameOf e) hyps) (has (Source.nameOf e) thms))
      (and (lt 1 v)
        (and (Source.isList e)
          (and (Source.isAtom (child e 0))
            (and (has (Source.nameOf (child e 0)) thms)
              (allT (lam ((a T)) (isSome (itype ovars a))) (drop 1 (children e)))))))))
  (defn ruleOf ((eb T) (ovars Ts) (hyps Ts) (thms Ts) (e T)) NormRule
    (let i T (if (Source.isAtom e) (Source.indexOf (Source.nameOf e) hyps) none)
      (if (isSome i) (nrHyp (get i))
        (nrThm
          (add eb
            (add
              (mul 2
                (getD (Source.indexOf (Source.nameOf (if (Source.isAtom e) e (child e 0))) thms) 0))
              1))
          (objs
            (if (Source.isAtom e) (nil T)
              (mapT (lam ((a T)) (getD (itype ovars a) one)) (drop 1 (children e)))))))))
  (defn rulesFrom ((eb T) (ovars Ts) (hyps Ts) (thms Ts) (es Ts)) NRs
    (foldr T NRs (lam ((e T) (acc NRs)) (cons (ruleOf eb ovars hyps thms e) acc)) (nil NormRule)
      es))
  (defn depthOf ((e T)) T
    (if (word e (quote (0 head))) (some 0)
      (if (word e (quote (0 weak))) (some 1)
        (if (word e (quote (0 open))) (some 2) (if (word e (quote (0 full))) (some 3) none)))))
  ; The index of the declaration of a theorem a tactic cites as it is stated.
  (defn lemmaOf ((eb T) (thms Ts) (e T)) T
    (if (Source.isAtom e)
      (mapO (lam ((i T)) (add eb (mul 2 i))) (Source.indexOf (Source.nameOf e) thms))
      none))
  ; The pointwise form of an earlier theorem that equates two functions: where the goal's sides
  ; and the applications of the theorem's sides to the innermost variable have the same normal
  ; forms at a depth, the goal follows from the theorem by rewriting the function applied.
  (defn byPointwise ((G Globals) (E (List Entry)) (n T) (j T) (rs NRs) (m T)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (case (thmAt E j) ((OThm.nothing) none)
        ((OThm.just b)
         (bindPT (eqParts (thConcl b))
           (lam ((FH TPair))
             (let F1 T (app (weaken1 (p1 FH)) (var 0))
               (let H1 T (app (weaken1 (p2 FH)) (var 0))
                 (bindNT (eval G E n rs 4096 m g hs F1)
                   (lam ((rf NFR))
                     (bindNT (eval G E n rs 4096 m g hs H1)
                       (lam ((rh NFR))
                         (bindNT (eval G E n rs 4096 m g hs t)
                           (lam ((rt NFR))
                             (bindNT (eval G E n rs 4096 m g hs u)
                               (lam ((ru NFR))
                                 (if
                                   (and (equal (nfTerm rt) (nfTerm rf))
                                     (equal (nfTerm ru) (nfTerm rh)))
                                   (some
                                     (dNode 23 (nil T)
                                       (l2
                                         (dNode 2 (nil T)
                                           (l2 (mDeriv (nfMarked rt)) (mDeriv (nfMarked ru))))
                                         (dNode 24 (single (mEq F1 H1))
                                           (l2
                                             (dNode 2 (nil T)
                                               (l2 (mDeriv (nfMarked rf)) (mDeriv (nfMarked rh))))
                                             (dNode 18 (nil T)
                                               (l2
                                                 (dNode 2 (nil T)
                                                   (l2
                                                     (dNode 16
                                                       (l4 j (node 0 (mapT x (range n)))
                                                         (node 0
                                                           (mapT (lam ((i T)) (var (add i 1)))
                                                             (range (length (thCtx b)))))
                                                         0)
                                                       (nil T))
                                                     (dNode 0 (nil T) (nil T))))
                                                 (dNode 0 (nil T) (nil T)))))))))
                                   none)))))))))))))))))
  ; The pointwise form, (pointwise THEOREM DEPTH RULE ...), and the rewriting under a test,
  ; (mask-rewrite A B ABSORB LEMMA (TERM ...) TEST ELSE OLD NEW OTHER BRANCH): in the branch a
  ; conditional on TEST selects, of the type A, the occurrences of OLD, of the type B, are
  ; replaced by NEW, which LEMMA at its objects, (LEMMA TYPE ...), and at the terms for its
  ; variables equates with OLD under the same test and against OTHER; ABSORB names the theorem
  ; that a conditional on the test of a branch is its first branch there.
  (defn script3
    ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (vars Ts) (kts Ts) (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let rd (Arrow T T) (lam ((e T)) (iterm v gt defs ovars e vars kts))
              (if (headed nd (quote (0 pointwise)))
                (let j T (lemmaOf eb thms at1)
                  (pair
                    (and (lt 2 k)
                      (and (isSome j)
                        (and (isSome (depthOf (at es 2)))
                          (allT (ruleOk 2 ovars hyps thms) (drop 3 es)))))
                    (lam ((G Globals) (E (List Entry)) (base NRs))
                      (byPointwise G E n (getD j 0)
                        (Rules.append (rulesFrom eb ovars hyps thms (drop 3 es)) base)
                        (getD (depthOf (at es 2)) 0)))))
                (if (form nd (quote (0 mask-rewrite)) 12)
                  (let a T (itype ovars at1)
                    (let b T (itype ovars (at es 2))
                      (let ab T (lemmaOf eb thms (at es 3))
                        (let le T (at es 4)
                          (let j T (lemmaOf eb thms (if (Source.isAtom le) le (child le 0)))
                            (let th T
                              (allSomeT
                                (mapT (itype ovars)
                                  (if (Source.isAtom le) (nil T) (drop 1 (children le)))))
                              (let sg T (allSomeT (mapT rd (children (at es 5))))
                                (let ts T (allSomeT (mapT rd (drop 6 es)))
                                  (pair
                                    (and (isSome a)
                                      (and (isSome b)
                                        (and (isSome ab)
                                          (and (isSome j)
                                            (and (isSome th)
                                              (and (Source.isList (at es 5))
                                                (and (isSome sg) (isSome ts))))))))
                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                      (lam ((g Ts) (hs Ts) (t T) (u T))
                                        (let xs Ts (children (getD ts (node 0 (nil T))))
                                          (some
                                            (maskRw (getD a one) (getD b one) (getD ab 0) (getD j 0)
                                              (children (getD th (node 0 (nil T))))
                                              (children (getD sg (node 0 (nil T))))
                                              (at xs 0)
                                              (at xs 1)
                                              (at xs 2)
                                              (at xs 3)
                                              (at xs 4)
                                              (at xs 5)))))))))))))))
                  (pair 0 failTac)))))))))
  ; The instances a script takes of a hypothesis that equates functions, ((NAME TERM ...) ...):
  ; each names the hypothesis's instance at its terms, one for each argument of the functions.
  (deftype Tss (List Ts))
  (import (Seq Tss) as Kids)
  (def unnamed (node 0 (nil T)))
  (defn instancesOk ((rd (Arrow T T)) (e T)) T
    (and (Source.isList e)
      (allT
        (lam ((x T))
          (and (Source.isList x)
            (and (lt 0 (length (children x)))
              (and (bindable 3 (child x 0))
                (allT (lam ((a T)) (isSome (rd a))) (drop 1 (children x)))))))
        (children e))))
  (defn instanceNames ((e T)) Ts (mapT (lam ((x T)) (Source.nameOf (child x 0))) (children e)))
  (defn instanceArgs ((rd (Arrow T T)) (e T)) Tss
    (foldr T Tss
      (lam ((x T) (acc Tss))
        (cons (mapT (lam ((a T)) (getD (rd a) mStar)) (drop 1 (children x))) acc))
      (nil Ts)
      (children e)))
  ; The tactics version 3 adds. The induction on a tree, (tree-induction x (l cs ih) SCRIPT),
  ; proves a goal without hypotheses by its proof at the node of a label l and children cs for
  ; its innermost variable x, under the hypothesis ih that the goal holds at each child: the
  ; equation of the list of the goal's formulas at the children with the list of as many truths.
  ; The hypotheses at the children, (child-hypotheses DEPTH ih (CHILD ...) SCRIPT), cut in the
  ; formula of ih at each of the first children, as many as the CHILDs, of a list of children
  ; that is a construction to that number; each CHILD, ((NAME TERM ...) ...), names the instances
  ; of its formula, an equation of functions, at terms for their arguments, reduced to the depth.
  ; The instances of a hypothesis that equates functions,
  ; (instances DEPTH h ((NAME TERM ...) ...) SCRIPT), are named so. The introduction of an
  ; implication, (assume h SCRIPT), proves a goal whose sides reduce to the implication of an
  ; equation and to truth by the proof of the equation under the antecedent, named h. The
  ; elimination, (modus-ponens h (NAME ...) SCRIPT), gives each hypothesis named, the equation
  ; with truth of an implication whose antecedent is the hypothesis h, to its conclusion. The
  ; case analysis (revert-cases h x (y ys) SCRIPT SCRIPT) of a list variable x that the
  ; hypothesis h mentions proves the goal at the empty list and at a head y before a list ys,
  ; under h at each. The alternative, (first SCRIPT SCRIPT), proves the goal by its first script
  ; or, where that one does not prove it, by its second. The case analysis of a bitstring to a
  ; number of bits, (bits-cases x BITS SCRIPT), proves the goal at each bitstring of fewer bits
  ; for the variable x, and at each of that number of bits before a bitstring, by the one script,
  ; read at each number of bits in the variables and hypotheses of that case: for each bit a head,
  ; a list and the element of the bit's injection, and the goal at the list, none of them named.
  ; The connectives' rules are the first entries of a development of version 3.
  (defn script4
    ((eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR)) (vars Ts) (kts Ts)
     (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let n T (length ovars)
        (let o T (connectivesAt defs)
          (let at1 T (at es 1)
            (let at2 T (at es 2)
              (let at3 T (at es 3)
                (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
                  (let rd (Arrow T T) (lam ((e T)) (iterm 3 gt defs ovars e vars kts))
                    (let fresh (Arrow Ts T)
                      (lam ((xs Ts)) (distinctFrom (append vars (append hyps thms)) xs))
                      (let hypAt (Arrow T T)
                        (lam ((e T))
                          (if (Source.isAtom e) (Source.indexOf (Source.nameOf e) hyps) none))
                        (let without (Arrow Ts Ts)
                          (lam ((xs Ts)) (mapT (lam ((x T)) (if (has x xs) unnamed x)) hyps))
                          (let blanks (Arrow T Ts)
                            (lam ((k T)) (mapT (lam ((i T)) unnamed) (range k)))
                            (if (form nd (quote (0 tree-induction)) 4)
                              (let ns Ts (mapT Source.nameOf (children at2))
                                (let rest Ts (drop 1 vars)
                                  (let r (Prod T Tac)
                                    (childR 3 (cons (at ns 1) (cons (at ns 0) rest))
                                      (cons
                                        (mapO (lam ((kt T)) (node Label.tyList (single kt)))
                                          (at kts 0))
                                        (cons none (drop 1 kts)))
                                      (single (at ns 2)))
                                    (pair
                                      (and (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                        (and (isEmpty hyps)
                                          (and (namesOk 3 3 at2)
                                            (and (distinctFrom (append rest thms) ns) (fst r)))))
                                      (lam ((G Globals) (E (List Entry)) (base NRs))
                                        (byRoseIndHyp 2 0 1 ((snd r) G E base)))))))
                              (if (form nd (quote (0 child-hypotheses)) 5)
                                (let kids Ts (children at3)
                                  (let names Ts
                                    (foldr T Ts
                                      (lam ((c T) (acc Ts)) (append (instanceNames c) acc))
                                      (nil T)
                                      kids)
                                    (let cut Ts
                                      (foldr T Ts
                                        (lam ((c T) (acc Ts))
                                          (append (blanks (add 2 (length (children c)))) acc))
                                        (nil T)
                                        kids)
                                      (let r (Prod T Tac)
                                        (childR 4 vars kts (append hyps (append cut names)))
                                        (let args (List Tss)
                                          (foldr T (List Tss)
                                            (lam ((c T) (acc (List Tss)))
                                              (cons (instanceArgs rd c) acc))
                                            (nil Tss)
                                            kids)
                                          (pair
                                            (and (isSome (depthOf at1))
                                              (and (isSome (hypAt at2))
                                                (and (Source.isList at3)
                                                  (and (not (isEmpty kids))
                                                    (and (allT (instancesOk rd) kids)
                                                      (and (fresh names) (fst r)))))))
                                            (lam ((G Globals) (E (List Entry)) (base NRs))
                                              (withChildHyps G E n base (getD (hypAt at2) 0)
                                                (range (length kids))
                                                (lam ((p T)) (Kids.atOr (nil Ts) args p))
                                                (lam ((insts Ts))
                                                  (withWeakHyps G E n base insts
                                                    (lam ((extra NRs)) ((snd r) G E base))
                                                    (getD (depthOf at1) 0)))))))))))
                                (if (form nd (quote (0 instances)) 5)
                                  (let names Ts (instanceNames at3)
                                    (let r (Prod T Tac)
                                      (childR 4 vars kts
                                        (append hyps (append (blanks (length names)) names)))
                                      (pair
                                        (and (isSome (depthOf at1))
                                          (and (isSome (hypAt at2))
                                            (and (instancesOk rd at3)
                                              (and (not (isEmpty names))
                                                (and (fresh names) (fst r))))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (withInsts G E n base (getD (hypAt at2) 0)
                                            (instanceArgs rd at3)
                                            (lam ((extra NRs)) ((snd r) G E base))
                                            (getD (depthOf at1) 0))))))
                                  (if (form nd (quote (0 assume)) 3)
                                    (let r (Prod T Tac)
                                      (childR 2 vars kts
                                        (append hyps (l2 unnamed (Source.nameOf at1))))
                                      (pair
                                        (and (bindable 3 at1)
                                          (and (fresh (single (Source.nameOf at1))) (fst r)))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byImpI G E o 0 ((snd r) G E base)))))
                                    (if (form nd (quote (0 modus-ponens)) 4)
                                      (let names Ts (mapT Source.nameOf (children at2))
                                        (let r (Prod T Tac)
                                          (childR 3 vars kts (append (without names) names))
                                          (pair
                                            (and (isSome (hypAt at1))
                                              (and (Source.isList at2)
                                                (and (not (isEmpty names))
                                                  (and
                                                    (allT (lam ((x T)) (isSome (hypAt x)))
                                                      (children at2))
                                                    (and (distinctFrom (nil T) names) (fst r))))))
                                            (lam ((G Globals) (E (List Entry)) (base NRs))
                                              (withImpElim o 0 (getD (hypAt at1) 0)
                                                (mapT (lam ((x T)) (getD (Source.indexOf x hyps) 0))
                                                  names)
                                                (lam ((extra NRs)) ((snd r) G E base)))))))
                                      (if (form nd (quote (0 revert-cases)) 6)
                                        (let ns Ts (mapT Source.nameOf (children at3))
                                          (let hn T (Source.nameOf at1)
                                            (let i T
                                              (if (Source.isAtom at2)
                                                (Source.indexOf (Source.nameOf at2) vars)
                                                none)
                                              (let kt T (at kts (getD i 0))
                                                (let kept Ts (without (single hn))
                                                  (let r0 (Prod T Tac)
                                                    (childR 4 vars kts
                                                      (append kept (l2 unnamed hn)))
                                                    (let r1 (Prod T Tac)
                                                      (childR 5
                                                        (cons (at ns 1) (cons (at ns 0) vars))
                                                        (cons kt (cons (listElem kt) kts))
                                                        (append kept (l3 unnamed unnamed hn)))
                                                      (pair
                                                        (and (isSome (hypAt at1))
                                                          (and (isSome i)
                                                            (and (namesOk 3 2 at3)
                                                              (and (fresh ns)
                                                                (and (fst r0) (fst r1))))))
                                                        (lam
                                                          ((G Globals) (E (List Entry)) (base NRs))
                                                          (revertCase G n o 0 (getD i 0)
                                                            (getD (hypAt at1) 0)
                                                            ((snd r0) G E base)
                                                            ((snd r1) G E base)))))))))))
                                        (if (form nd (quote (0 first)) 3)
                                          (let r0 (Prod T Tac) (childR 1 vars kts hyps)
                                            (let r1 (Prod T Tac) (childR 2 vars kts hyps)
                                              (pair (and (fst r0) (fst r1))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (lam ((g Ts) (hs Ts) (t T) (u T))
                                                    (let found T ((snd r0) G E base g hs t u)
                                                      (if (isSome found) found
                                                        ((snd r1) G E base g hs t u))))))))
                                          (if (form nd (quote (0 bits-cases)) 4)
                                            (let i T
                                              (if (Source.isAtom at1)
                                                (Source.indexOf (Source.nameOf at1) vars)
                                                none)
                                              (let bits T (number at2)
                                                (let level (Arrow T (Prod T Tac))
                                                  (lam ((j T))
                                                    (childR 3 (append (blanks (mul 3 j)) vars)
                                                      (append
                                                        (mapT (lam ((q T)) none) (range (mul 3 j)))
                                                        kts)
                                                      (append hyps (blanks j))))
                                                  (pair
                                                    (and (isSome i)
                                                      (and (isSome bits)
                                                        (allT (lam ((j T)) (fst (level j)))
                                                          (range (add (getD bits 0) 1)))))
                                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                                      ((foldr T (Arrow T Pv)
                                                         (lam ((j T) (deeper (Arrow T Pv)) (pos T))
                                                           (byListSplit G n pos
                                                             ((snd (level j)) G E base)
                                                             (bySplit2 3 4 1 (deeper 1)
                                                               (deeper 1))))
                                                         (lam ((pos T))
                                                           ((snd (level (getD bits 0))) G E base))
                                                         (range (getD bits 0))) (getD i 0)))))))
                                            (script3 3 eb gt defs ovars thms nd vars kts
                                              hyps))))))))))))))))))))))
  ; The tactics version 2 adds. The uniqueness of a list's fold, (fold-induction x (y r) STEP FUEL
  ; RULE ...), proves the goal by induction on its innermost variable where both sides at a head y
  ; before a list are STEP at their values r at the list. The uniqueness of a tree's fold,
  ; (tree-fold-induction x (l rs) STEP FUEL RULE ...), proves a goal in the one variable x where
  ; both sides at the node of a label l are STEP at the list rs of their values at the children.
  ; The case analysis of a coproduct, (sum-cases x (y) SCRIPT SCRIPT), proves the goal at each
  ; injection of a new variable y, and of a tree, (tree-cases x (l cs) LEMMA SCRIPT), at the node
  ; of a new label l and children cs, LEMMA naming the theorem that a tree is the node of its
  ; unfolding. The search (auto-trees DEPTH SPLITS LEMMA RULE ...) reduces to a depth and splits
  ; the list, coproduct or tree variable the reduction is stuck on. The generalization
  ; (generalize (y A) TERM SCRIPT) proves the goal with a new variable y for the occurrences of a
  ; term of the type A.
  (defn script2
    ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR)) (vars Ts) (kts Ts)
     (hyps Ts))
    (Prod T Tac)
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let ns Ts (mapT Source.nameOf (children (at es 2)))
              (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
                (let rulesAt (Arrow T NRs) (lam ((i T)) (rulesFrom eb ovars hyps thms (drop i es)))
                  (let rulesOkAt (Arrow T T)
                    (lam ((i T)) (allT (ruleOk 2 ovars hyps thms) (drop i es)))
                    (let fresh (Arrow Ts (Arrow Ts T))
                      (lam ((scope Ts) (xs Ts)) (distinctFrom (append scope (append hyps thms)) xs))
                      (let i T (Source.indexOf (Source.nameOf at1) vars)
                        (let fuel T (number (at es 4))
                          (if (headed nd (quote (0 fold-induction)))
                            (let rest Ts (drop 1 vars)
                              (let s T
                                (iterm v gt defs ovars (at es 3)
                                  (cons (at ns 1) (cons (at ns 0) rest))
                                  (cons none (cons none (drop 1 kts))))
                                (pair
                                  (and (lt 4 k)
                                    (and (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                      (and (namesOk v 2 (at es 2))
                                        (and (fresh rest ns)
                                          (and (isSome s) (and (isSome fuel) (rulesOkAt 5)))))))
                                  (lam ((G Globals) (E (List Entry)) (base NRs))
                                    (byListInd G E n 0 1 (getD s mStar)
                                      (Rules.append (rulesAt 5) base)
                                      (getD fuel 0))))))
                            (if (headed nd (quote (0 tree-fold-induction)))
                              (let s T
                                (iterm v gt defs ovars (at es 3)
                                  (cons (at ns 1) (cons (at ns 0) (nil T)))
                                  (cons none (cons none (nil T))))
                                (pair
                                  (and (lt 4 k)
                                    (and (and (eq (length vars) 1) (word at1 (at vars 0)))
                                      (and (isEmpty hyps)
                                        (and (namesOk v 2 (at es 2))
                                          (and (fresh (nil T) ns)
                                            (and (isSome s) (and (isSome fuel) (rulesOkAt 5))))))))
                                  (lam ((G Globals) (E (List Entry)) (base NRs))
                                    (lam ((g Ts) (hs Ts) (t T) (u T))
                                      (byRoseInd G E n 2 0 1 (getD s mStar)
                                        (Rules.append (rulesAt 5) base)
                                        (getD fuel 0)
                                        g
                                        t
                                        u)))))
                              (if (form nd (quote (0 sum-cases)) 5)
                                (let r0 (Prod T Tac)
                                  (childR 3 (cons (at ns 0) vars) (cons none kts) hyps)
                                  (let r1 (Prod T Tac)
                                    (childR 4 (cons (at ns 0) vars) (cons none kts) hyps)
                                    (pair
                                      (and (isSome i)
                                        (and (namesOk v 1 (at es 2))
                                          (and (fresh vars ns) (and (fst r0) (fst r1)))))
                                      (lam ((G Globals) (E (List Entry)) (base NRs))
                                        (bySplit2 3 4 (getD i 0) ((snd r0) G E base)
                                          ((snd r1) G E base))))))
                                (if (form nd (quote (0 tree-cases)) 5)
                                  (let r (Prod T Tac)
                                    (childR 4 (cons (at ns 1) (cons (at ns 0) vars))
                                      (cons none (cons none kts))
                                      hyps)
                                    (let lk T (lemmaOf eb thms (at es 3))
                                      (pair
                                        (and (isSome i)
                                          (and (namesOk v 2 (at es 2))
                                            (and (fresh vars ns) (and (isSome lk) (fst r)))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byTreeSplit (getD lk 0) (getD i 0)
                                            ((snd r) G E base))))))
                                  (if (headed nd (quote (0 auto-trees)))
                                    (let lk T (lemmaOf eb thms (at es 3))
                                      (pair
                                        (and (lt 3 k)
                                          (and (isSome (depthOf at1))
                                            (and (isSome (number (at es 2)))
                                              (and (isSome lk) (rulesOkAt 4)))))
                                        (lam ((G Globals) (E (List Entry)) (base NRs))
                                          (byAutoT G E n (getD lk 0) (Rules.append (rulesAt 4) base)
                                            (getD (number (at es 2)) 0)
                                            (getD (depthOf at1) 0)))))
                                    (if (form nd (quote (0 generalize)) 4)
                                      (let a T (itype ovars (child at1 1))
                                        (let c T (iterm v gt defs ovars (at es 2) vars kts)
                                          (let y T (Source.nameOf (child at1 0))
                                            (let r (Prod T Tac)
                                              (childR 3 (cons y vars)
                                                (cons (kernelType defs (child at1 1)) kts)
                                                hyps)
                                              (pair
                                                (and (ibinder v ovars at1)
                                                  (and (fresh vars (single y))
                                                    (and (isSome c) (fst r))))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (byGeneralize (getD a one) (getD c mStar)
                                                    ((snd r) G E base))))))))
                                      (if (lt 2 v)
                                        (script4 eb gt defs ovars thms nd rs vars kts hyps)
                                        (script3 v eb gt defs ovars thms nd vars kts
                                          hyps))))))))))))))))))))
  (defn scriptStep ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (nd T) (rs (List SR))) SR
    (let es Ts (children nd)
      (let k T (length es)
        (let n T (length ovars)
          (let at1 T (at es 1)
            (let childR (Arrow T SR) (lam ((i T)) (SRs.atOr failSR rs i))
              (lam ((vars Ts) (kts Ts) (hyps Ts))
                (let rulesAt (Arrow T NRs) (lam ((i T)) (rulesFrom eb ovars hyps thms (drop i es)))
                  (let rulesOkAt (Arrow T T)
                    (lam ((i T)) (allT (ruleOk v ovars hyps thms) (drop i es)))
                    (let fresh (Arrow Ts (Arrow Ts T))
                      (lam ((scope Ts) (xs Ts))
                        (and (allT (lam ((y T)) (if (lt 1 v) (bindable v y) (declared y))) xs)
                          (distinctFrom (append scope (append hyps thms)) (mapT Source.nameOf xs))))
                      (if (not (Source.isList nd)) (pair 0 failTac)
                        (if (headed nd (quote (0 normalize)))
                          (pair (and (lt 1 k) (and (isSome (number at1)) (rulesOkAt 2)))
                            (lam ((G Globals) (E (List Entry)) (base NRs))
                              (lam ((g Ts) (hs Ts) (t T) (u T))
                                (byNormW G E n (Rules.append (rulesAt 2) base) (getD (number at1) 0)
                                  g
                                  hs
                                  t
                                  u))))
                          (if (headed nd (quote (0 reduce)))
                            (pair (and (lt 1 k) (and (isSome (depthOf at1)) (rulesOkAt 2)))
                              (lam ((G Globals) (E (List Entry)) (base NRs))
                                (byMode (getD (depthOf at1) 0) G E n
                                  (Rules.append (rulesAt 2) base))))
                            (if (headed nd (quote (0 auto)))
                              (pair
                                (and (lt 2 k)
                                  (and (isSome (depthOf at1))
                                    (and (isSome (number (at es 2))) (rulesOkAt 3))))
                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                  (byAuto G E n (Rules.append (rulesAt 3) base)
                                    (getD (number (at es 2)) 0)
                                    (getD (depthOf at1) 0))))
                              (if (form nd (quote (0 extensionality)) 3)
                                (let r (Prod T Tac)
                                  (childR 2 (cons (Source.nameOf at1) vars) (cons none kts) hyps)
                                  (pair (and (fresh vars (single at1)) (fst r))
                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                      (byFunExt G n ((snd r) G E base)))))
                                (let ns Ts (children (at es 2))
                                  (let n0 T (Source.nameOf (at ns 0))
                                    (let n1 T (Source.nameOf (at ns 1))
                                      (if (form nd (quote (0 induction)) 5)
                                        (let rest Ts (drop 1 vars)
                                          (let r0 (Prod T Tac) (childR 3 rest (drop 1 kts) hyps)
                                            (let r1 (Prod T Tac)
                                              (childR 4 (cons n1 (cons n0 rest))
                                                (cons (at kts 0)
                                                  (cons (listElem (at kts 0)) (drop 1 kts)))
                                                (append hyps (single (Source.nameOf (at ns 2)))))
                                              (pair
                                                (and
                                                  (and (not (isEmpty vars)) (word at1 (at vars 0)))
                                                  (and (Source.isList (at es 2))
                                                    (and (eq (length ns) 3)
                                                      (and (fresh rest ns)
                                                        (and (fst r0) (fst r1))))))
                                                (lam ((G Globals) (E (List Entry)) (base NRs))
                                                  (byListIndWith G n 0 1 ((snd r0) G E base)
                                                    ((snd r1) G E base)))))))
                                        (if (form nd (quote (0 cases)) 5)
                                          (let i T (Source.indexOf (Source.nameOf at1) vars)
                                            (let kt T (at kts (getD i 0))
                                              (let r0 (Prod T Tac) (childR 3 vars kts hyps)
                                                (let r1 (Prod T Tac)
                                                  (childR 4 (cons n1 (cons n0 vars))
                                                    (cons kt (cons (listElem kt) kts))
                                                    (append hyps (single (node 0 (nil T)))))
                                                  (pair
                                                    (and (Source.isAtom at1)
                                                      (and (isSome i)
                                                        (and (Source.isList (at es 2))
                                                          (and (eq (length ns) 2)
                                                            (and (fresh vars ns)
                                                              (and (fst r0) (fst r1)))))))
                                                    (lam ((G Globals) (E (List Entry)) (base NRs))
                                                      (byListSplit G n (getD i 0)
                                                        ((snd r0) G E base)
                                                        ((snd r1) G E base))))))))
                                          (if (form nd (quote (0 reduce-hypotheses)) 4)
                                            (let hns Ts (mapT Source.nameOf (children (at es 2)))
                                              (let r (Prod T Tac)
                                                (childR 3 vars kts
                                                  (append
                                                    (mapT
                                                      (lam ((x T))
                                                        (if (has x hns) (node 0 (nil T)) x))
                                                      hyps)
                                                    hns))
                                                (pair
                                                  (and (isSome (depthOf at1))
                                                    (and (Source.isList (at es 2))
                                                      (and (not (isEmpty hns))
                                                        (and
                                                          (allT
                                                            (lam ((h T))
                                                              (and (Source.isAtom h)
                                                                (has (Source.nameOf h) hyps)))
                                                            (children (at es 2)))
                                                          (and (distinctFrom (nil T) hns)
                                                            (fst r))))))
                                                  (lam ((G Globals) (E (List Entry)) (base NRs))
                                                    (withWeakHyps G E n base
                                                      (mapT
                                                        (lam ((x T))
                                                          (getD (Source.indexOf x hyps) 0))
                                                        hns)
                                                      (lam ((extra NRs)) ((snd r) G E base))
                                                      (getD (depthOf at1) 0))))))
                                            (if (lt 1 v)
                                              (script2 v eb gt defs ovars thms nd rs vars kts hyps)
                                              (pair 0 failTac)))))))))))))))))))))))
  (defn readScript ((v T) (eb T) (gt Ts) (defs Ts) (ovars Ts) (thms Ts) (s T)) SR
    (para SR (scriptStep v eb gt defs ovars thms) s))

  ; A source theorem carries its name, its statement, its script and the version of its document.
  (data Request (request T Statement T T))
  (defn requestName ((q Request)) T (case q ((request n s c w) n)))
  (defn requestThm ((q Request)) Thm
    (case q ((request n s c w) (case s ((statement os vs ks hs a) a)))))
  ; What rejects a development: a reason and the name of the theorem it concerns, or the empty
  ; name. The reasons: 0, a document is not a proof document of a version this reader reads, or
  ; the documents' versions do not combine; 1, a theorem's name is declared before; 2, a
  ; theorem's form or statement does not read; 3, its script does not read; 4, its script does
  ; not prove it; 5, its sides have no weak normal forms within the budget; 6, the derivation its
  ; script gives, or its companion's, does not check.
  (defn failure ((why T) (name T)) T (node 2 (l2 why name)))
  ; A request read, or the reason it is not.
  (data ReadRequest (requestOk Request) (requestBad T))
  ; The theorems of version 0: an equation of two definitions' names, proved by normalization.
  (defn version0 ((defs Ts) (e T)) T
    (let eqn T (child e 2)
      (let script T (child e 3)
        (and (form eqn (quote (0 equal)) 3)
          (and (and (Source.isAtom (child eqn 1)) (has (Source.nameOf (child eqn 1)) defs))
            (and (and (Source.isAtom (child eqn 2)) (has (Source.nameOf (child eqn 2)) defs))
              (and (form script (quote (0 by)) 2)
                (form (child script 1) (quote (0 normalize)) 2))))))))
  (defn theoremName ((e T)) T
    (if (and (Source.isList e) (lt 1 (length (children e)))) (Source.nameOf (child e 1))
      (node 0 (nil T))))
  (defn readRequest ((v T) (G Globals) (gt Ts) (defs Ts) (names Ts) (thms Ts) (e T)) ReadRequest
    (if
      (and (form e (quote (0 theorem)) 4)
        (and (Source.isAtom (child e 1))
          (and (not (isEmpty (children (child e 1))))
            (and (form (child e 3) (quote (0 by)) 2) (or (lt 0 v) (version0 defs e))))))
      (case (readStatement v G gt defs (append defs names) (child e 2))
        ((OSt.nothing) (requestBad 2))
        ((OSt.just st)
         (case st
           ((statement os vs ks hs a)
            (let script T (child (child e 3) 1)
              (if
                (fst
                  (readScript v 0 gt defs (children os) thms script (children vs) (children ks)
                    (children hs)))
                (requestOk (request (Source.nameOf (child e 1)) st script v))
                (requestBad 3)))))))
      (requestBad 2)))

  ; A proof document's version and the forms of its theorems. From version 2 the forms
  ; (import PATH) and (program NAME), which the host resolves, are left out.
  (data Document (document T & T))
  (import (Option Document) as ODoc)
  (defn readDocument ((source T)) ODoc.Maybe
    (let parsed T (Source.readSExps (children source))
      (let root T (child (get parsed) 0)
        (let v T (number (child root 1))
          (if
            (and (isSome parsed)
              (and (eq (length (children (get parsed))) 1)
                (and (Source.isList root)
                  (and (word (child root 0) (quote (0 proofs))) (and (isSome v) (lt (get v) 4))))))
            (let fs Ts
              (foldr T Ts
                (lam ((f T) (acc Ts))
                  (if
                    (and (lt 1 (get v))
                      (or (form f (quote (0 import)) 2) (form f (quote (0 program)) 2)))
                    acc
                    (cons f acc)))
                (nil T)
                (drop 2 (children root)))
              (if (isEmpty fs) ODoc.nothing (ODoc.just (document (get v) fs))))
            ODoc.nothing)))))
  ; The theorems of a development's documents in order, each with the version of its document, and
  ; the version of the last document: every document reads, and where there are several, none is
  ; of version 0, which saves no companion to cite, or of a version after the last document's.
  (data Forms (formList T & TPair))
  (import (Option Forms) as OForms)
  (import (Seq TPair) as Items)
  (import (Map T TPair) as ItemsOf)
  (import (Map TPair T) as ItemOut)
  (defn readDocuments ((sources Ts)) OForms.Maybe
    (foldr T OForms.Maybe
      (lam ((source T) (acc OForms.Maybe))
        (case acc ((OForms.nothing) OForms.nothing)
          ((OForms.just fs)
           (case fs
             ((formList last items)
              (case (readDocument source) ((ODoc.nothing) OForms.nothing)
                ((ODoc.just d)
                 (case d
                   ((document v xs)
                    (if
                      (or (and (eq v 0) (lt 1 (length sources)))
                        (and (lt 0 (Items.length items)) (lt last v)))
                      OForms.nothing
                      (OForms.just
                        (formList (if (eq (Items.length items) 0) v last)
                          (Items.append (ItemsOf.map (lam ((f T)) (pr v f)) xs) items)))))))))))))
      (if (isEmpty sources) OForms.nothing (OForms.just (formList 0 (nil TPair))))
      sources))

  ; Requests are read before proving, with distinct names and the version of the development's
  ; last document, which fixes the globals its statements are read in and the layout of its
  ; certificate, and which the list of requests keeps; the first form that does not read rejects
  ; the development.
  (import (Seq Request) as Requests)
  (data RequestList (requests T & Request))
  (data Read (readOk RequestList) (readBad T T))
  (defn firstRepeated ((names Ts)) T
    (snd
      (foldr T (Prod Ts T)
        (lam ((x T) (s (Prod Ts T))) (pair (cons x (fst s)) (if (has x (fst s)) (some x) (snd s))))
        (pair (nil T) none)
        (reverse names))))
  (defn readSources ((gt Ts) (defs Ts) (ds (List LDefn)) (sources Ts)) Read
    (case (readDocuments sources) ((OForms.nothing) (readBad 0 (node 0 (nil T))))
      ((OForms.just fs)
       (case fs
         ((formList v items)
          (let G Globals (globalsFor v ds)
            (let names Ts (ItemOut.map (lam ((p TPair)) (theoremName (p2 p))) items)
              (let twice T (firstRepeated names)
                (if (isSome twice) (readBad 1 (get twice))
                  (foldr T Read
                    (lam ((i T) (acc Read))
                      (let p TPair (Items.atOr (pr 0 0) items i)
                        (case (readRequest (p1 p) G gt defs names (take i names) (p2 p))
                          ((requestBad why) (readBad why (at names i)))
                          ((requestOk q)
                           (case acc ((readBad why name) acc)
                             ((readOk qs)
                              (case qs ((requests w xs) (readOk (requests w (cons q xs)))))))))))
                    (readOk (requests v (nil Request)))
                    (range (length names))))))))))))

  ; A saved development contains the checked declarations and their source names. In version 3 it
  ; begins with the connectives' rules, under no name. Each theorem is
  ; proved with the declarations before it as the development's entries. After version 0 it is
  ; followed by its companion of the same name: the theorem with its sides in weak normal form,
  ; derived from the theorem at its own objects, variables and hypotheses. The reductions rewrite
  ; a term whose head they have reduced, so a rule rewrites by a theorem's companion, as a theorem
  ; the Lean developments state in weak normal form. Version 0 cites no theorem and saves no
  ; companion.
  (data Results (results T & Decl))
  (data Progress (proving Results EntryList) (stuck T T))
  (import (Option EntryList) as OEntries)
  ; The entries after a declaration, where the checker of developments admits it.
  (defn admit ((G Globals) (E (List Entry)) (d Decl)) OEntries.Maybe
    (case (declStep G E d) ((ODevState.nothing) OEntries.nothing)
      ((ODevState.just st) (case st ((devState G2 es) (OEntries.just es))))))
  (defn derive
    ((G Globals) (E (List Entry)) (rs NRs) (eb T) (gt Ts) (defs Ts) (thms Ts) (q Request))
    T
    (case q
      ((request n s script w)
       (case s
         ((statement os vs ks hs a)
          (case a
            ((mkThm ar c h f)
             (case c
               ((objs g)
                (case h
                  ((terms hyps)
                   (case (eqParts f) ((OTPair.nothing) none)
                     ((OTPair.just tu)
                      ((snd
                         (readScript w eb gt defs (children os) thms script (children vs)
                           (children ks)
                           (children hs))) G E rs g hyps (p1 tu) (p2 tu)))))))))))))))
  (defn companion ((G Globals) (E (List Entry)) (rs NRs) (j T) (a Thm)) T
    (case a
      ((mkThm ar c h f)
       (case c
         ((objs g)
          (case h
            ((terms hyps)
             (case (eqParts f) ((OTPair.nothing) none)
               ((OTPair.just lr)
                (bindNT (eval G E ar rs 4096 1 g hyps (p1 lr))
                  (lam ((nl NFR))
                    (bindNT (eval G E ar rs 4096 1 g hyps (p2 lr))
                      (lam ((nr NFR))
                        (some
                          (node 0
                            (l3 (nfTerm nl) (nfTerm nr)
                              (dNode 24 (single f)
                                (l2
                                  (dNode 2 (nil T)
                                    (l2 (mDeriv (nfMarked nl)) (mDeriv (nfMarked nr))))
                                  (dNode 27
                                    (l3 j (node 0 (mapT x (range ar)))
                                      (node 0 (mapT var (range (length g)))))
                                    (mapT (lam ((i T)) (dNode 21 (single i) (nil T)))
                                      (range (length hyps))))))))))))))))))))))
  (defn withSides ((a Thm) (l T) (r T)) Thm (case a ((mkThm ar c h f) (mkThm ar c h (mEq l r)))))
  (defn sourceNames ((v T) (ns Ts)) Ts
    (if (eq v 0) ns
      (let xs Ts (drop (entryBase v) ns)
        (mapT (lam ((i T)) (at xs (mul 2 i))) (range (div (length xs) 2))))))
  ; The development before its first theorem: in version 3 the connectives' rules, checked.
  (defn begin ((G Globals) (v T) (o T)) Progress
    (let ds (List Decl) (if (lt 2 v) (connectiveRules o 0) (nil Decl))
      (case (checkDev G (nil Entry) ds) ((ODevState.nothing) (stuck 6 unnamed))
        ((ODevState.just st)
         (case st
           ((devState G2 el)
            (proving (results (node 0 (mapT (lam ((i T)) unnamed) (range (Decls.length ds)))) ds)
              el)))))))
  (defn advance ((G Globals) (rs NRs) (gt Ts) (defs Ts) (v T) (q Request) (st Progress)) Progress
    (case st ((stuck why name) st)
      ((proving a el)
       (case a
         ((results ns ds)
          (case el
            ((entries E)
             (let d T (derive G E rs (entryBase v) gt defs (sourceNames v (children ns)) q)
               (if (isSome d)
                 (let decl Decl (declLang (requestThm q) (get d))
                   (case (admit G E decl) ((OEntries.nothing) (stuck 6 (requestName q)))
                     ((OEntries.just el1)
                      (case el1
                        ((entries E1)
                         (let ds1 (List Decl) (Decls.append ds (Decls.single decl))
                           (if (eq v 0)
                             (proving
                               (results (node 0 (append (children ns) (single (requestName q))))
                                 ds1)
                               el1)
                             (let w T (companion G E1 rs (Decls.length ds) (requestThm q))
                               (if (isSome w)
                                 (let cs Ts (children (get w))
                                   (let decl2 Decl
                                     (declLang (withSides (requestThm q) (at cs 0) (at cs 1))
                                       (at cs 2))
                                     (case (admit G E1 decl2)
                                       ((OEntries.nothing) (stuck 6 (requestName q)))
                                       ((OEntries.just el2)
                                        (proving
                                          (results
                                            (node 0
                                              (append (children ns)
                                                (l2 (requestName q) (requestName q))))
                                            (Decls.append ds1 (Decls.single decl2)))
                                          el2)))))
                                 (stuck 5 (requestName q)))))))))))
                 (stuck 4 (requestName q)))))))))))
  ; The development's certificate, the present tree, or its failure.
  (defn proveWith ((gt Ts) (names Ts) (ds (List LDefn)) (sources Ts)) T
    (case (readSources gt names ds sources) ((readBad why name) (failure why name))
      ((readOk qs)
       (case qs
         ((requests v xs)
          (let G Globals (globalsFor v ds)
            (let o T (add (LD.length lib) (LD.length ds))
              (let rs NRs (rulesOf v o)
                (case
                  ((foldr Request (Arrow Progress Progress)
                     (lam ((q Request) (k (Arrow Progress Progress)) (st Progress))
                       (k (advance G rs gt names v q st)))
                     (lam ((st Progress)) st)
                     xs) (begin G v o))
                  ((stuck why name) (failure why name))
                  ((proving a el) (some (rep a))))))))))))
  ; The sources of a development are the children of a node, each the node of a document's
  ; characters.
  (defn prove ((bundle T) (sources T)) T
    (case (program (children (child bundle 0))) ((OTrState.nothing) none)
      ((OTrState.just st)
       (case st
         ((trState gt ds)
          (case gt
            ((ktys gs)
             (case ds
               ((ldefns xs)
                (proveWith gs (children (child bundle 1)) xs (children sources)))))))))))

  ; Replay requires the statements and names of the sources and checks the saved derivations.
  ; It does not search, and it does not require the current prover to produce the same derivation.
  ; Each source theorem is matched by its declaration under its name, and after version 0 by a
  ; companion under the same name, whose statement is the one its checked derivation proves; in
  ; version 3 the theorems follow as many declarations as the connectives' rules.
  (defn stated ((d Decl)) T (case d ((declLang a dv) (some (rep a))) (else none)))
  (defn matches ((v T) (xs (List Request)) (ds (List Decl)) (ns Ts)) T
    (and (eq (mul (if (eq v 0) 1 2) (Requests.length xs)) (Decls.length ds))
      (and (eq (Decls.length ds) (length ns))
        ((foldr Request (Arrow (List Decl) (Arrow Ts T))
           (lam ((q Request) (k (Arrow (List Decl) (Arrow Ts T))) (rest (List Decl)) (names Ts))
             (lcase Decl T rest 0
               (lam ((d Decl) (tail (List Decl)))
                 (and (equal (stated d) (some (rep (requestThm q))))
                   (and (equal (requestName q) (at names 0))
                     (if (eq v 0) (k tail (drop 1 names))
                       (lcase Decl T tail 0
                         (lam ((e Decl) (tail2 (List Decl)))
                           (and (isSome (stated e))
                             (and (equal (requestName q) (at names 1))
                               (k tail2 (drop 2 names))))))))))))
           (lam ((rest (List Decl)) (names Ts)) 1)
           xs) ds ns))))
  (defn replayWith ((gt Ts) (names Ts) (ds (List LDefn)) (sources Ts) (saved T)) T
    (case (readSources gt names ds sources) ((readBad why name) 0)
      ((readOk qs)
       (case qs
         ((requests v xs)
          (decode Results saved
            (lam ((a Results))
              (case a
                ((results ns decls)
                 (if
                   (matches v xs (Decls.drop (entryBase v) decls)
                     (drop (entryBase v) (children ns)))
                   (case (checkDev (globalsFor v ds) (nil Entry) decls) ((ODevState.nothing) 0)
                     ((ODevState.just st) 1))
                   0))))
            0))))))
  (defn replay ((bundle T) (sources T) (saved T)) T
    (case (program (children (child bundle 0))) ((OTrState.nothing) 0)
      ((OTrState.just st)
       (case st
         ((trState gt ds)
          (case gt
            ((ktys gs)
             (case ds
               ((ldefns xs)
                (replayWith gs (children (child bundle 1)) xs (children sources) saved))))))))))

  ; The version of the last document of a development that the program's statements read, which
  ; fixes the layout of its certificate, the present tree, or the failure of its reading.
  (defn version ((bundle T) (sources T)) T
    (case (program (children (child bundle 0))) ((OTrState.nothing) none)
      ((OTrState.just st)
       (case st
         ((trState gt ds)
          (case gt
            ((ktys gs)
             (case ds
               ((ldefns xs)
                (case (readSources gs (children (child bundle 1)) xs (children sources))
                  ((readBad why name) (failure why name))
                  ((readOk qs) (case qs ((requests v ys) (some v)))))))))))))))
