  ; The rules a script names before the rules given, each theorem's matching prepared, so that a
  ; rule is tried only where the root of its left side occurs.
  ; A rule (folded NAME ...) among them names the definitions kept folded, in place of those the
  ; rules given keep: the rule of the unfolding of the definitions below an index then unfolds
  ; every other.
  (defn foldedOf ((named NRs)) OTerms.Maybe
    (foldr NormRule OTerms.Maybe
      (lam ((r NormRule) (acc OTerms.Maybe))
        (case r ((nrBelow m exc) (if (eq m 0) (OTerms.just exc) acc)) (else acc)))
      OTerms.nothing
      named))
  (defn refold ((exc Terms) (r NormRule)) NormRule
    (case r ((nrBelow m old) (if (lt 0 m) (nrBelow m exc) r)) (else r)))
  ; The rules given without those that name a theorem, a hypothesis or folded definitions: the
  ; language's rules, and the unfolding of every definition.
  (defn languageRules ((given NRs)) NRs
    (foldr NormRule NRs
      (lam ((r NormRule) (acc NRs))
        (case r ((nrThm j th) acc) ((nrThmAt j th q k) acc) ((nrHyp h) acc)
          ((nrBelow m exc) (if (eq m 0) acc (cons (nrBelow m (terms (nil T))) acc)))
          (else (cons r acc))))
      (nil NormRule)
      given))
  (defn rulesIn ((E (List Entry)) (named NRs) (given NRs)) NRs
    (Rules.append (prepareRules E named)
      (case (foldedOf named) ((OTerms.nothing) given)
        ((OTerms.just exc)
         (foldr NormRule NRs (lam ((r NormRule) (acc NRs)) (cons (refold exc r) acc)) (nil NormRule)
           given)))))
  (defn depthOf ((e T)) T
    (if (word e (quote (0 head))) (some 0)
      (if (word e (quote (0 weak))) (some 1)
        (if (word e (quote (0 open))) (some 2) (if (word e (quote (0 full))) (some 3) none)))))
  ; The index of the declaration of a theorem a tactic cites as it is stated.
  (defn lemmaOf ((eb T) (thms Ts) (e T)) T
    (if (Source.isAtom e)
      (mapO (lam ((i T)) (add eb (mul 2 i))) (Source.indexOf (Source.nameOf e) thms))
      none))
  ; The instance of an earlier theorem that equates two functions, at objects and at terms for its
  ; variables, applied to arguments: where the goal's sides and the applications of the instance's
  ; sides to the arguments have the same normal forms at a depth, the goal follows from the
  ; theorem by rewriting the function applied.
  (defn byInstance ((G Globals) (E (List Entry)) (n T) (j T) (th Ts) (sg Ts) (al Ts) (rs NRs) (m T))
    Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (case (thmAt E j) ((OThm.nothing) none)
        ((OThm.just b)
         (bindPT (eqParts (thConcl b))
           (lam ((FH TPair))
             (let F1 T (apps (instTerm th sg (p1 FH)) al)
               (let H1 T (apps (instTerm th sg (p2 FH)) al)
                 (bindNT (eval G E n rs 4096 m g hs F1)
                   (lam ((rf NFR))
                     (bindNT (eval G E n rs 4096 m g hs H1)
                       (lam ((rh NFR))
                         (bindNT (eval G E n rs 4096 m g hs t)
                           (lam ((rt NFR))
                             (bindNT (eval G E n rs 4096 m g hs u)
                               (lam ((ru NFR))
                                 (if
                                   (and (equal (nfTerm rt) (nfTerm rf))
                                     (equal (nfTerm ru) (nfTerm rh)))
                                   (some
                                     (dNode 23 (nil T)
                                       (l2
                                         (dNode 2 (nil T)
                                           (l2 (mDeriv (nfMarked rt)) (mDeriv (nfMarked ru))))
