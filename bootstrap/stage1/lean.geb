;
; The Lean backend: a checked program's bundle to a Lean module defining each of its
; definitions, in order and under its name, as its denotation written with the functions of
; Geb.Kernel.Const, referred to by qualified names, which no definition's name can capture. A
; variable is named by its binding depth, and a binder whose variable its body does not use is
; written _. The text is laid out in groups, each printed on one line when it and the text
; following it fit within 100 columns and within 70 columns beyond the indentation, and over
; indented lines when they do not. mainLean is the compiler with this backend in place of the
; image. Requires the stage-1 compiler's other sources.

(module LeanBackend (export Doc nest line text ms layout atomic compound ap closed emitLean)
  (import Prelude)
  (import Reader)
  (import Datatype)
  (import Compile)
  ; documents: text with its width in columns and its bytes, a concatenation, the line breaks of
  ; a document indented by two more columns, a line break or, in a flat group, a space, a group,
  ; and the line breaks of a document indented to the column where it starts
  (data Bytes (bytes & T))
  (data Doc (txt T Bytes) (cat & Doc) (nest Doc) (line) (grp Doc) (align Doc))
  (import (Seq Doc) as Docs)
  (defn cols ((bs Ts)) T
    (foldr T T (lam ((b T) (n T)) (if (and (lt 127 b) (lt b 192)) n (add n 1))) 0 bs))
  (defn text ((bs Ts)) Doc (txt (cols bs) (bytes bs)))
  (defn cat2 ((a Doc) (b Doc)) Doc (cat (cons a (Docs.single b))))
  (defn cat3 ((a Doc) (b Doc) (c Doc)) Doc (cat (cons a (cons b (Docs.single c)))))
  (defn cat5 ((a Doc) (b Doc) (c Doc) (d Doc) (e Doc)) Doc
    (cat (cons a (cons b (cons c (cons d (Docs.single e)))))))
  (defn indented ((d Doc)) Doc (nest (cat2 line d)))
  (defn joinWith ((sep Doc) (ds (List Doc))) Doc
    (cat
      (lcase Doc (List Doc) ds (nil Doc)
        (lam ((d Doc) (r (List Doc)))
          (cons d
            (foldr Doc (List Doc) (lam ((x Doc) (acc (List Doc))) (cons sep (cons x acc))) (nil Doc)
              r))))))

  ; the text the backend writes
  (def tLp (text (children (quote (0 "(")))))
  (def tRp (text (children (quote (0 ")")))))
  (def tComma (text (children (quote (0 ",")))))
  (def tColon (text (children (quote (0 " : ")))))
  (def tUnder (text (children (quote (0 _)))))
  (def tFun (text (children (quote (0 "fun ")))))
  (def tDoubleArrow (text (children (quote (0 " =>")))))
  (def tT (text (children (quote (0 T)))))
  (def tUnitTy (text (children (quote (0 Unit)))))
  (def tTimes (text (children (quote (0 " ×")))))
  (def tTo (text (children (quote (0 " →")))))
  (def tList (text (children (quote (0 List)))))
  (def tLet (text (children (quote (0 "let ")))))
  (def tSemi (text (children (quote (0 ";")))))
  (def tUnitV (text (children (quote (0 "()")))))
  (def tDot1 (text (children (quote (0 ").1")))))
  (def tDot2 (text (children (quote (0 ").2")))))
  (def tIf (text (children (quote (0 "if (")))))
  (def tThen (text (children (quote (0 ").label ≠ 0 then")))))
  (def tElse (text (children (quote (0 else)))))
  (def tFold (text (children (quote (0 Const.fold)))))
  (def tIter (text (children (quote (0 Const.iter)))))
  (def tFoldr (text (children (quote (0 Const.foldr)))))
  (def tLcase (text (children (quote (0 Const.lcase)))))
  (def tPara (text (children (quote (0 Const.para)))))
  (def tConstDot (text (children (quote (0 Const.)))))
  (def tAlpha (text (children (quote (0 "α")))))
  (def tBeta (text (children (quote (0 "β")))))
  (def tColonEq (text (children (quote (0 " := ")))))
  (def tNilLp (text (children (quote (0 "([] : List ")))))
  (def tConsOp (text (children (quote (0 " ::")))))
  (def tLeaf (text (children (quote (0 "leaf ")))))
  (def tMk (text (children (quote (0 "mk ")))))
  (def tSpLb (text (children (quote (0 " [")))))
  (def tRb (text (children (quote (0 "]")))))
  (def tLg (text (children (quote (0 "«")))))
  (def tRg (text (children (quote (0 "»")))))
  (def tDef (text (children (quote (0 "def «")))))
  (def tAssign (text (children (quote (0 "» :=")))))
  (def tHeader
    (text
      (children
        (quote
          (0
            "module

public import Geb.Prototypes.Kernel.Reader

/-! Generated from a Geb program by `bootstrap/stage1/lean.geb`. -/

@[expose] public section

open Geb.Kernel
open Geb.Kernel renaming Tree → T

namespace GebBoot")))))
  (def tFooter (text (children (quote (0 "

end GebBoot

end
")))))

  ; layout: a document's measure, its flat width, whether it holds a line break outside any
  ; group, and the width of its text up to the first such break, or its flat width when it holds
  ; none; and its printing as a function of the indentation, whether it is printed flat, the
  ; width of the text following it up to the next break, and the state of the column and the
  ; bytes printed, in reverse. A group counts as unbroken in the measures of what contains it.
  (deftype St (Prod T Ts))
  (deftype Pr (Arrow T (Arrow T (Arrow T (Arrow St St)))))
  (deftype Ms (Prod T (Prod T T)))
  (deftype WP (Prod Ms Pr))
  (defn wOf ((x WP)) T (fst (fst x)))
  (defn hbOf ((x WP)) T (fst (snd (fst x))))
  (defn ldOf ((x WP)) T (snd (snd (fst x))))
  (defn ms ((w T) (hb T) (ld T)) Ms (pair w (pair hb ld)))
  (defn revOnto ((bs Ts) (acc Ts)) Ts
    ((foldr T Endo (lam ((b T) (k Endo) (a Ts)) (k (cons b a))) (lam ((a Ts)) a) bs) acc))
  ; a document followed by another: the first is followed by the second's text up to its first
  ; break, and by the text following both when the second holds no break
  (defn catWP ((x WP) (y WP)) WP
    (pair
      (ms (add (wOf x) (wOf y)) (or (hbOf x) (hbOf y))
        (if (hbOf x) (ldOf x) (add (wOf x) (ldOf y))))
      (lam ((i T) (f T) (t T) (s St))
        ((snd y) i f t ((snd x) i f (add (ldOf y) (if (hbOf y) 0 t)) s)))))
  (defn layout ((d Doc)) T
    (let r WP
      (cata Doc WP d
        ((txt w bs)
         (pair (ms w 0 w)
           (lam ((i T) (f T) (t T) (s St))
             (pair (add (fst s) w) (revOnto (case bs ((bytes cs) cs)) (snd s))))))
        ((cat xs) (foldr WP WP catWP (pair (ms 0 0 0) (lam ((i T) (f T) (t T) (s St)) s)) xs))
        ((nest x) (pair (fst x) (lam ((i T) (f T) (t T) (s St)) ((snd x) (add i 2) f t s))))
        ((line)
         (pair (ms 1 1 0)
           (lam ((i T) (f T) (t T) (s St))
             (if f (pair (add (fst s) 1) (cons 32 (snd s)))
               (pair i (revOnto (replicate i 32) (cons 10 (snd s))))))))
        ; a group is printed flat inside a flat group, or when it and the text following it fit
        ; within 100 columns and within 70 columns beyond the indentation
        ((grp x)
         (pair (ms (wOf x) 0 (wOf x))
           (lam ((i T) (f T) (t T) (s St))
             ((snd x) i
              (or f
                (and (lt (add (fst s) (add (wOf x) t)) 101)
                  (lt (add (sub (fst s) i) (add (wOf x) t)) 71)))
              t
              s))))
        ((align x) (pair (fst x) (lam ((i T) (f T) (t T) (s St)) ((snd x) (fst s) f t s)))))
      (node 0 (reverse (snd ((snd r) 0 0 0 (pair 0 (nil T))))))))

  ; a term's shape: text that needs no parentheses as an argument, text that does, a run of
  ; abstractions with its binders and body, or a run of applications with its head and arguments
  (data Param (param Doc Doc))
  (data Params (params & Param))
  (import (Seq Param) as Ps)
  (data Sh (atomic Doc) (compound Doc) (fn Params Doc) (ap Doc & Doc))
  (defn binderDocs ((bs Params)) Doc
    (case bs
      ((params xs)
       (joinWith line
         (foldr Param (List Doc)
           (lam ((x Param) (acc (List Doc)))
             (case x ((param n ty) (cons (cat5 tLp n tColon ty tRp) acc))))
           (nil Doc)
           xs)))))
  (defn shDoc ((s Sh)) Doc
    (case s ((atomic d) d) ((compound d) d)
      ((fn bs b)
       (grp (cat2 (align (grp (cat3 tFun (nest (binderDocs bs)) tDoubleArrow))) (indented b))))
      ((ap h as)
       (grp
         (cat2 h
           (nest
             (cat
               (foldr Doc (List Doc) (lam ((a Doc) (acc (List Doc))) (cons line (cons a acc)))
                 (nil Doc)
                 as))))))))
  (defn argDoc ((s Sh)) Doc (case s ((atomic d) d) (else (cat3 tLp (shDoc s) tRp))))
  (defn valDoc ((s Sh)) Doc
    (case s ((atomic d) d) ((ap h as) (shDoc s)) (else (cat3 tLp (shDoc s) tRp))))
  (defn opDoc ((s Sh)) Doc (case s ((compound d) (cat3 tLp d tRp)) (else (shDoc s))))

  ; kernel types and terms, by label
  (data Kt (ktT) (ktUnit) (ktProd Kt Kt) (ktArrow Kt Kt) (ktList Kt) (kt5) (kt6) (kt7) (kVar T)
    (kLam Kt Kt)
    (kApp Kt Kt)
    (kUnit)
    (kPair Kt Kt)
    (kFst Kt)
    (kSnd Kt)
    (kQuote T)
    (kIf Kt Kt Kt)
    (kFold Kt)
    (kIter Kt)
    (kNil Kt)
    (kCons Kt Kt)
    (kFoldr Kt Kt)
    (kPrim T)
    (kRef T)
    (kLcase Kt Kt)
    (kPara Kt))

  ; a type or term emitted: the free variables it uses, as a list whose entry at a de Bruijn
  ; index is 1 when that variable occurs, and its shape as a function of the binding depth
  (deftype Em (Prod Ts (Arrow T Sh)))
  (defn orList ((xs Ts) (ys Ts)) Ts
    ((foldr T Endo
       (lam ((x T) (k Endo) (zs Ts))
         (lcase T Ts zs (cons x (k (nil T))) (lam ((z T) (r Ts)) (cons (or x z) (k r)))))
       (lam ((zs Ts)) zs)
       xs) ys))
  (defn closedSh ((s Sh)) Em (pair (nil T) (lam ((k T)) s)))
  (defn closed ((d Doc)) Em (closedSh (atomic d)))
  (defn tyDoc ((e Em)) Doc (shDoc ((snd e) 0)))
  (defn varDoc ((v T)) Doc (text (cons 120 (decimalChars v))))
  (defn namedArg ((n Doc) (e Em)) Doc (cat5 tLp n tColonEq (tyDoc e) tRp))
  (defn quoteDoc ((q T)) Doc
    (fold Doc
      (lam ((l T) (rs (List Doc)))
        (if (lt 0 (Docs.length rs))
          (grp
            (cat
              (cons tMk
                (cons (text (decimalChars l))
                  (cons tSpLb (cons (nest (joinWith (cat2 tComma line) rs)) (Docs.single tRb)))))))
          (cat2 tLeaf (text (decimalChars l)))))
      q))
  ; an abstraction applied to a value, as a let binding its first binder; Lean requires the
  ; lines continuing a let to start to the right of it, so they are indented from its column
  (defn letDoc ((bs (List Param)) (body Doc) (v Sh)) Doc
    (let rest (List Param) (Ps.tail bs)
      (case (Ps.atOr (param tUnder tUnder) bs 0)
        ((param n ty)
         (align
           (grp
             (cat
               (cons tLet
                 (cons n
                   (cons tColon
                     (cons ty
                       (cons tColonEq
                         (cons (valDoc v)
                           (cons tSemi
                             (cons line
                               (Docs.single
                                 (if (lt 0 (Ps.length rest)) (shDoc (fn (params rest) body))
                                   body)))))))))))))))))
  (defn emTerm ((nm T) (t Kt)) Em
    (cata Kt Em t ((ktT) (closed tT)) ((ktUnit) (closed tUnitTy))
      ((ktProd a b)
       (closedSh (compound (grp (cat3 (opDoc ((snd a) 0)) tTimes (indented (opDoc ((snd b) 0))))))))
      ((ktArrow a b)
       (closedSh (compound (grp (cat3 (opDoc ((snd a) 0)) tTo (indented (tyDoc b)))))))
      ((ktList a) (closedSh (ap tList (Docs.single (argDoc ((snd a) 0))))))
      ((kVar i)
       (pair (append (replicate (label i) 0) (single 1))
         (lam ((d T)) (atomic (varDoc (sub (sub d 1) (label i)))))))
      ((kLam a b)
       (pair (tail (fst b))
         (lam ((d T))
           (let used T (lcase T T (fst b) 0 (lam ((x T) (r Ts)) x))
             (let bd Param (param (if used (varDoc d) tUnder) (tyDoc a))
               (let sb Sh ((snd b) (add d 1))
                 (case sb ((fn bs body) (case bs ((params xs) (fn (params (cons bd xs)) body))))
                   (else (fn (params (Ps.single bd)) (shDoc sb))))))))))
      ((kApp f x)
       (pair (orList (fst f) (fst x))
         (lam ((d T))
           (let sf Sh ((snd f) d)
             (let sx Sh ((snd x) d)
               (case sf ((ap h as) (ap h (Docs.append as (Docs.single (argDoc sx)))))
                 ((fn bs body) (compound (case bs ((params xs) (letDoc xs body sx)))))
                 (else (ap (argDoc sf) (Docs.single (argDoc sx))))))))))
      ((kUnit) (closed tUnitV))
      ((kPair a b)
       (pair (orList (fst a) (fst b))
         (lam ((d T))
           (atomic
             (grp (cat5 tLp (shDoc ((snd a) d)) tComma (indented (shDoc ((snd b) d))) tRp))))))
      ((kFst p) (pair (fst p) (lam ((d T)) (atomic (cat3 tLp (shDoc ((snd p) d)) tDot1)))))
      ((kSnd p) (pair (fst p) (lam ((d T)) (atomic (cat3 tLp (shDoc ((snd p) d)) tDot2)))))
      ((kQuote q) (pair (nil T) (lam ((d T)) (compound (quoteDoc q)))))
      ((kIf c a b)
       (pair (orList (fst c) (orList (fst a) (fst b)))
         (lam ((d T))
           (compound
             (grp
               (cat
                 (cons tIf
                   (cons (shDoc ((snd c) d))
                     (cons tThen
                       (cons (indented (shDoc ((snd a) d)))
                         (cons line
                           (cons tElse (Docs.single (indented (shDoc ((snd b) d))))))))))))))))
      ((kFold a) (pair (nil T) (lam ((d T)) (ap tFold (Docs.single (namedArg tAlpha a))))))
      ((kIter a) (pair (nil T) (lam ((d T)) (ap tIter (Docs.single (namedArg tAlpha a))))))
      ((kNil a) (closed (cat3 tNilLp (argDoc ((snd a) 0)) tRp)))
      ((kCons x xs)
       (pair (orList (fst x) (fst xs))
         (lam ((d T))
           (atomic
             (grp (cat5 tLp (argDoc ((snd x) d)) tConsOp (indented (argDoc ((snd xs) d))) tRp))))))
      ((kFoldr a b)
       (pair (nil T)
         (lam ((d T)) (ap tFoldr (cons (namedArg tAlpha a) (Docs.single (namedArg tBeta b)))))))
      ((kPrim k) (closed (cat2 tConstDot (text (children (at primNames (label k)))))))
      ((kRef j) (closed (cat3 tLg (text (children (child nm (label j)))) tRg)))
      ((kLcase a b)
       (pair (nil T)
         (lam ((d T)) (ap tLcase (cons (namedArg tAlpha a) (Docs.single (namedArg tBeta b)))))))
      ((kPara a) (pair (nil T) (lam ((d T)) (ap tPara (Docs.single (namedArg tAlpha a))))))
      (else (closed tUnder))))

  ; a bundle's module: the header, each definition under its name, and the footer, the bundle's
  ; terms decoded as kernel terms
  (defn defDoc ((name T) (body Doc)) Doc
    (cat3 line line
      (grp
        (cat
          (cons tDef (cons (text (children name)) (cons tAssign (Docs.single (indented body)))))))))
  (defn emitLean ((b T)) T
    (let nm T (child b 1)
      (let ds Ts (children (child b 0))
        (let n T (length ds)
          (layout
            (cat
              (cons tHeader
                (Docs.append
                  (snd
                    (foldr T (Prod T (List Doc))
                      (lam ((t T) (acc (Prod T (List Doc))))
                        (pair (add (fst acc) 1)
                          (cons
                            (defDoc (child nm (sub (sub n 1) (fst acc)))
                              (decode Kt t (lam ((k Kt)) (shDoc ((snd (emTerm nm k)) 0))) tUnder))
                            (snd acc))))
                      (pair 0 (nil Doc))
                      ds))
                  (Docs.single tFooter))))))))))
(defn mainLean ((file T)) T (Compile.compileWith LeanBackend.emitLean file))
