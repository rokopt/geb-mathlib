; Authors: Terence Rokop
;
; The expansion of the datatype language written in the datatype language: the function of a
; program's forms that bootstrap/datatype.geb, written in the kernel's syntax, computes, on every
; program the typing accepts, with datatypes for the forms, names and declarations, case analysis
; and structural recursion in place of tests of labels and folds, and functions with result
; types. The expansion first writes the program's forms with their datatypes, the coercions it
; knows to hold marked by nodes no reader writes; the typing (bootstrap/stage1/typing.geb) checks
; them; and their erasure is the program the stage-0 expansion writes. A program's forms are
; decoded once, where the stage-0 compiler's front end gives them as trees, and the names of
; keywords, numerals and recognizers the kernel's modules share stay trees. The stage-1 compiler
; is the stage-0 compiler with this expansion in place of that one; built by the stage-0
; compiler, it produces the image the stage-0 compiler produces of it. Requires the prelude, the
; reader, the lists of bootstrap/seq.geb and the typing.

(module Datatype
  (export kwData kwTreeData kwCase kwCata kwRep kwDecode kwDatum kwDefn decimalChars memberName
    expandProgram
    typeErrorOfForms
    typeErrorOf)
  (import Prelude)
  (import Reader)
  (import Typing)
  (import (Seq Tx) as Txs)
  (import (Option Tx) as OTx)
  (deftype MTx OTx.Maybe)
  (import (Seq MTx) as MTxs)
  (defn sameName ((a Name) (b Name)) T (equal (rep a) (rep b)))
  (defn atomName ((x Tx)) Name (case x ((tAtom cs) (name cs)) (else (name (nil T)))))
  (defn isAtomTx ((x Tx)) T (case x ((tAtom cs) 1) (else 0)))
  (defn isListTx ((x Tx)) T (case x ((tList xs) 1) (else 0)))
  (defn namedTx ((x Tx) (kw T)) T (named (rep x) kw))
  (defn elems ((x Tx)) (List Tx) (case x ((tList xs) xs) (else (nil Tx))))
  (defn nthTx ((xs (List Tx)) (i T)) Tx (Txs.atOr tx0 xs i))

  ; forms under construction
  (defn sx1 ((a Tx)) Tx (tList (Txs.single a)))
  (defn sx2 ((a Tx) (b Tx)) Tx (tList (cons a (Txs.single b))))
  (defn sx3 ((a Tx) (b Tx) (c Tx)) Tx (tList (cons a (cons b (Txs.single c)))))
  (defn sx4 ((a Tx) (b Tx) (c Tx) (d Tx)) Tx (tList (cons a (cons b (cons c (Txs.single d))))))
  (defn sx5 ((a Tx) (b Tx) (c Tx) (d Tx) (e Tx)) Tx
    (tList (cons a (cons b (cons c (cons d (Txs.single e)))))))
  (defn sx6 ((a Tx) (b Tx) (c Tx) (d Tx) (e Tx) (f Tx)) Tx
    (tList (cons a (cons b (cons c (cons d (cons e (Txs.single f))))))))

  ; the atoms of the expansion
  (def aLet (datum Tx (1 let)))
  (def aIf (datum Tx (1 if)))
  (def aLam (datum Tx (1 lam)))
  (def aPair (datum Tx (1 pair)))
  (def aFst (datum Tx (1 fst)))
  (def aSnd (datum Tx (1 snd)))
  (def aCons (datum Tx (1 cons)))
  (def aNil (datum Tx (1 nil)))
  (def aIter (datum Tx (1 iter)))
  (def aLcase (datum Tx (1 lcase)))
  (def aFoldr (datum Tx (1 foldr)))
  (def aPara (datum Tx (1 para)))
  (def aDef (datum Tx (1 def)))
  (def aDeftype (datum Tx (1 deftype)))
  (def aUnitV (datum Tx (1 unit)))
  (def aQuote (datum Tx (1 quote)))
  (def aLabel (datum Tx (1 label)))
  (def aChild (datum Tx (1 child)))
  (def aChildren (datum Tx (1 children)))
  (def aNode (datum Tx (1 node)))
  (def aEq (datum Tx (1 eq)))
  (def aT (datum Tx (1 T)))
  (def aUnit (datum Tx (1 Unit)))
  (def aProd (datum Tx (1 Prod)))
  (def aArrow (datum Tx (1 Arrow)))
  (def aList (datum Tx (1 List)))
  (def aZero (datum Tx (1 48)))
  (def aS (datum Tx (1 "%s")))
  (def aO (datum Tx (1 "%o")))
  (def aA (datum Tx (1 "%a")))
  (def aH (datum Tx (1 "%h")))
  (def aTl (datum Tx (1 "%t")))
  (def aX (datum Tx (1 "%x")))
  (def aU (datum Tx (1 "%u")))
  (def aR (datum Tx (1 "%r")))
  (def aD (datum Tx (1 "%d")))
  (def aRest (datum Tx (1 "%rest")))
  (def aK (datum Tx (1 "%k")))
  (def aE (datum Tx (1 "%e")))
  (def kwData (quote (0 data)))
  (def kwTreeData (quote (0 tree-data)))
  (def kwCase (quote (0 case)))
  (def kwCata (quote (0 cata)))
  (def kwDefn (quote (0 defn)))
  (def kwElse (quote (0 else)))
  (def kwRep (quote (0 rep)))
  (def kwDecode (quote (0 decode)))
  (def kwDatum (quote (0 datum)))
  (def kwGeneric (quote (0 "%generic")))
  (def kwSort (quote (0 "%sort")))
  (def kwPostulate (quote (0 "%postulate")))
  (def kwAmp (quote (0 &)))

  ; a numeral's characters and atom
  (defn decimalChars ((n T)) Ts
    (if (eq n 0) (single 48)
      (let k T
        (fst
          (iter (Prod T T)
            (lam ((s (Prod T T))) (if (eq (snd s) 0) s (pair (add (fst s) 1) (div (snd s) 10))))
            (pair 0 n)
            (add (log2 n) 1)))
        (foldr T Ts (lam ((d T) (acc Ts)) (cons (add d 48) acc)) (nil T) (digitsMsb 10 n k)))))
  (defn numAtom ((n T)) Tx (tAtom (decimalChars n)))
  ; the name of a datatype's recognizer: the datatype's atom followed by .member
  (defn memberName ((d T)) T (node 1 (append (children d) (children (quote (1 .member))))))
  (defn memberAtom ((d Tx)) Tx (tAtom (append (children (rep d)) (children (quote (1 .member))))))
  (defn fieldAtom ((k T)) Tx (tAtom (cons 37 (cons 102 (decimalChars k)))))
  (defn qAtom ((k T)) Tx (tAtom (cons 37 (cons 113 (decimalChars k)))))

  ; types and expressions under construction
  (defn sList ((a Tx)) Tx (sx2 aList a))
  (defn sProd ((a Tx) (b Tx)) Tx (sx3 aProd a b))
  (defn sArrow ((a Tx) (b Tx)) Tx (sx3 aArrow a b))
  (defn sLet ((x Tx) (a Tx) (e Tx) (b Tx)) Tx (sx5 aLet x a e b))
  (defn sIf ((c Tx) (a Tx) (b Tx)) Tx (sx4 aIf c a b))
  (defn sLam1 ((x Tx) (a Tx) (b Tx)) Tx (sx3 aLam (sx1 (sx2 x a)) b))
  (defn sLam2 ((x Tx) (a Tx) (y Tx) (b Tx) (e Tx)) Tx (sx3 aLam (sx2 (sx2 x a) (sx2 y b)) e))
  ; the function dropping a list's head, at the elements' type, and a list without its first n
  ; elements
  (defn sTail ((a Tx)) Tx
    (sLam1 aX (sList a) (sx6 aLcase a (sList a) aX (sx2 aNil a) (sLam2 aH a aTl (sList a) aTl))))
  (defn sDrop ((a Tx) (xs Tx) (n T)) Tx (sx5 aIter (sList a) (sTail a) xs (numAtom n)))
  ; the expansion's coercions, which no reader writes: a term of a type's erasure at the type,
  ; where the expansion knows it to be a member, and a term of a type at its erasure
  (defn asTy ((ty Tx) (e Tx)) Tx (tAs ty e))
  (defn ofTy ((ty Tx) (e Tx)) Tx (tOf ty e))

  ; lists by position and conjunctions
  (defn dropLast ((xs (List Tx))) (List Tx) (Txs.reverse (Txs.tail (Txs.reverse xs))))
  (defn allTrue ((xs Ts)) T (foldr T T (lam ((x T) (r T)) (and x r)) 1 xs))

  ; declarations: a constructor with its name, position, datatype, the list of its field types,
  ; whether a last field takes the remaining children, and that field's type; a datatype with
  ; its name; a type abbreviation with its name and its type, abbreviations expanded
  (data Decl (ctorD Name T Name Tx T Tx) (dataD Name) (aliasD Name Tx))
  (import (Seq Decl) as Decls)
  (import (Option Decl) as ODecl)
  (defn findCtor ((n Name) (env (List Decl))) ODecl.Maybe
    (foldr Decl ODecl.Maybe
      (lam ((e Decl) (r ODecl.Maybe))
        (case e ((ctorD m j d fs v w) (if (sameName m n) (ODecl.just e) r)) (else r)))
      ODecl.nothing
      env))
  (defn isData ((n Name) (env (List Decl))) T
    (foldr Decl T (lam ((e Decl) (r T)) (case e ((dataD m) (or (sameName m n) r)) (else r))) 0 env))
  (defn findAlias ((n Name) (env (List Decl))) MTx
    (foldr Decl MTx
      (lam ((e Decl) (r MTx)) (case e ((aliasD m ty) (if (sameName m n) (OTx.just ty) r)) (else r)))
      OTx.nothing
      env))
  (defn ctorsOf ((d Name) (env (List Decl))) (List Decl)
    (foldr Decl (List Decl)
      (lam ((e Decl) (r (List Decl)))
        (case e ((ctorD m j dd fs v w) (if (sameName dd d) (cons e r) r)) (else r)))
      (nil Decl)
      env))
  (defn ctorName ((c Decl)) Name (case c ((ctorD m j d fs v w) m) ((dataD m) m) ((aliasD m ty) m)))
  (defn ctorData ((c Decl)) Name (case c ((ctorD m j d fs v w) d) ((dataD m) m) ((aliasD m ty) m)))

  ; a type with its abbreviations expanded, and a value of each type, at the trees and at a
  ; datatype the leaf zero, given to a datatype by the expansion's coercion: a structural recursion
  ; takes it only at a node with fewer children than its constructor has fields, which no member is
  (defn expandAliases ((env (List Decl)) (ty Tx)) Tx
    (cata Tx Tx ty
      ((tAtom cs) (case (findAlias (name cs) env) ((OTx.just a) a) ((OTx.nothing) (tAtom cs))))
      ((tList rs) (tList rs))
      (else tx0)))
  (deftype TT (Prod Tx Tx))
  (import (Seq TT) as TTs)
  (defn defaultOf ((ty Tx)) Tx
    (snd
      (cata Tx TT ty
        ((tAtom cs)
         (pair (tAtom cs) (if (namedTx (tAtom cs) kwUnit) aUnitV (asTy (tAtom cs) aZero))))
        ((tList rs)
         (let fs (List Tx)
           (foldr TT (List Tx) (lam ((r TT) (a (List Tx))) (cons (fst r) a)) (nil Tx) rs)
           (let v (Arrow T Tx) (lam ((i T)) (snd (TTs.atOr (pair tx0 aZero) rs i)))
             (let h Tx (nthTx fs 0)
               (pair (tList fs)
                 (if (namedTx h kwProd) (sx3 aPair (v 1) (v 2))
                   (if (namedTx h kwArrow) (sLam1 aD (nthTx fs 1) (v 2))
                     (if (namedTx h kwList) (sx2 aNil (nthTx fs 1)) aZero))))))))
        (else (pair tx0 aZero)))))

  ; the bindings of a clause's variables, from the innermost out: fb binds a field at a position
  ; with its type, and vb binds the remaining children after the fixed fields
  (deftype Binder (Arrow T (Arrow Tx (Arrow Tx (Arrow Tx Tx)))))
  (deftype XT (Prod T Tx))
  (defn bindWith ((fb Binder) (vb Binder) (ctor Decl) (vars (List Tx)) (body Tx)) MTx
    (case ctor
      ((ctorD m j d fs isVar w)
       (let fields (List Tx) (elems fs)
         (let nf T (Txs.length fields)
           (let nv T (Txs.length vars)
             (if
               (and (eq nv (add nf isVar))
                 (allTrue (foldr Tx Ts (lam ((v Tx) (r Ts)) (cons (isAtomTx v) r)) (nil T) vars)))
               (OTx.just
                 (snd
                   (foldr Tx XT
                     (lam ((v Tx) (acc XT))
                       (let k T (sub (sub nv 1) (fst acc))
                         (pair (add (fst acc) 1)
                           (if (lt k nf) (fb k (nthTx fields k) v (snd acc))
                             (vb nf w v (snd acc))))))
                     (pair 0 body)
                     vars)))
               OTx.nothing)))))
      (else OTx.nothing)))

  ; the constructor a clause names, when it is declared
  (defn clauseCtor ((env (List Decl)) (c Tx)) ODecl.Maybe
    (case (nthTx (elems c) 0) ((tList ps) (findCtor (atomName (nthTx ps 0)) env))
      (else ODecl.nothing)))

  ; the chain of tests of a clause list: each clause, with its constructor and its expansion,
  ; binds its variables and tests the scrutinee's label, the last without an else untested
  (deftype CL (Prod Tx (Prod Decl Tx)))
  (deftype Chain (Prod T (Prod T Tx)))
  (deftype Bind (Arrow Decl (Arrow (List Tx) (Arrow Tx MTx))))
  (defn testChain ((sv Tx) (clauses (List CL)) (base MTx) (bind Bind)) MTx
    (let r Chain
      (foldr CL Chain
        (lam ((p CL) (acc Chain))
          (let ctor Decl (fst (snd p))
            (case
              (bind ctor (Txs.tail (elems (nthTx (elems (fst p)) 0)))
                (nthTx (elems (snd (snd p))) 1))
              ((OTx.just b)
               (if (fst acc)
                 (pair 1
                   (pair 1
                     (if (fst (snd acc))
                       (case ctor
                         ((ctorD m j d fs v w)
                          (sIf (sx3 aEq (sx2 aLabel sv) (numAtom j)) b (snd (snd acc))))
                         (else b))
                       b)))
                 (pair 0 (pair 0 tx0))))
              ((OTx.nothing) (pair 0 (pair 0 tx0))))))
        (case base ((OTx.just b) (pair 1 (pair 1 b))) ((OTx.nothing) (pair 1 (pair 0 tx0))))
        clauses)
      (if (and (fst r) (fst (snd r))) (OTx.just (snd (snd r))) OTx.nothing)))

  ; a clause list's chain, given the datatype, or nothing to take it from the first clause: every
  ; clause names a constructor of that datatype, and without a last else clause every
  ; constructor is named
  (import (Seq ODecl.Maybe) as ODecls)
  (defn clauseChain
    ((env (List Decl)) (d0 OName.Maybe) (cls (List Tx)) (xo (Prod T (List Tx))) (sv Tx) (bind Bind))
    MTx
    (if (and (fst xo) (lt 0 (Txs.length cls)))
      (let xs (List Tx) (snd xo)
        (let n T (Txs.length cls)
          (let lastC Tx (nthTx cls (sub n 1))
            (let hasElse T
              (and (isListTx lastC)
                (and (eq (Txs.length (elems lastC)) 2) (namedTx (nthTx (elems lastC) 0) kwElse)))
              (let ncls (List Tx) (if hasElse (dropLast cls) cls)
                (let nxs (List Tx) (if hasElse (dropLast xs) xs)
                  (let base MTx
                    (if hasElse (OTx.just (nthTx (elems (nthTx xs (sub n 1))) 1)) OTx.nothing)
                    (let ctors (List ODecl.Maybe)
                      (foldr Tx (List ODecl.Maybe)
                        (lam ((c Tx) (acc (List ODecl.Maybe))) (cons (clauseCtor env c) acc))
                        (nil ODecl.Maybe)
                        ncls)
                      (let d Name
                        (case d0 ((OName.just dd) dd)
                          ((OName.nothing)
                           (case (ODecls.atOr ODecl.nothing ctors 0) ((ODecl.just c0) (ctorData c0))
                             ((ODecl.nothing) (name (nil T))))))
                        (let valid T
                          (allTrue
                            (foldr Tx Ts
                              (lam ((c Tx) (acc Ts))
                                (cons
                                  (and (eq (Txs.length (elems c)) 2)
                                    (case (clauseCtor env c)
                                      ((ODecl.just e) (sameName (ctorData e) d))
                                      ((ODecl.nothing) 0)))
                                  acc))
                              (nil T)
                              ncls))
                          (let names (List Name)
                            (foldr ODecl.Maybe (List Name)
                              (lam ((c ODecl.Maybe) (acc (List Name)))
                                (case c ((ODecl.just e) (cons (ctorName e) acc))
                                  ((ODecl.nothing) acc)))
                              (nil Name)
                              ctors)
                            (let covered T
                              (or hasElse
                                (allTrue
                                  (foldr Decl Ts
                                    (lam ((e Decl) (acc Ts))
                                      (cons
                                        (foldr Name T
                                          (lam ((m Name) (r T)) (or (sameName m (ctorName e)) r))
                                          0
                                          names)
                                        acc))
                                    (nil T)
                                    (ctorsOf d env))))
                              (if (and valid covered)
                                (let m T (Txs.length ncls)
                                  (testChain sv
                                    (snd
                                      (foldr Tx (Prod T (List CL))
                                        (lam ((c Tx) (acc (Prod T (List CL))))
                                          (let i T (sub (sub m 1) (fst acc))
                                            (pair (add (fst acc) 1)
                                              (case (ODecls.atOr ODecl.nothing ctors i)
                                                ((ODecl.just e)
                                                 (cons (pair c (pair e (nthTx nxs i))) (snd acc)))
                                                ((ODecl.nothing) (snd acc))))))
                                        (pair 0 (nil CL))
                                        ncls))
                                    base
                                    bind))
                                OTx.nothing)))))))))))))
      OTx.nothing))

  ; the subterms of a form with their expansions as functions of the declarations
  (deftype XR (Prod Tx (Arrow (List Decl) MTx)))
  (import (Seq XR) as XRs)
  (defn xrForms ((rs (List XR))) (List Tx)
    (foldr XR (List Tx) (lam ((r XR) (a (List Tx))) (cons (fst r) a)) (nil Tx) rs))
  (defn xrAt ((rs (List XR)) (i T) (env (List Decl))) MTx
    ((snd (XRs.atOr (pair tx0 (lam ((e (List Decl))) OTx.nothing)) rs i)) env))
  (defn xrFrom ((rs (List XR)) (i T) (env (List Decl))) (Prod T (List Tx))
    (OTx.allJust
      (foldr XR (List MTx) (lam ((r XR) (a (List MTx))) (cons ((snd r) env) a)) (nil MTx)
        (XRs.drop i rs))))

  ; case analysis: the scrutinee bound once, its label tested, its children bound to the clause's
  ; variables
  (defn caseField ((k T) (ty Tx) (v Tx) (b Tx)) Tx
    (sLet v ty (asTy ty (sx3 aChild aS (numAtom k))) b))
  (defn caseRest ((nf T) (ty Tx) (v Tx) (b Tx)) Tx
    (sLet v (sList ty) (asTy (sList ty) (sDrop aT (sx2 aChildren aS) nf)) b))
  (defn expandCase ((env (List Decl)) (fs (List Tx)) (rs (List XR))) MTx
    (let cls (List Tx) (Txs.drop 2 fs)
      (let chain MTx
        (clauseChain env OName.nothing cls (xrFrom rs 2 env) aS (bindWith caseField caseRest))
        (let d Tx
          (case (clauseCtor env (nthTx cls 0))
            ((ODecl.just c) (tAtom (children (rep (ctorData c)))))
            ((ODecl.nothing) aT))
          (case (xrAt rs 1 env)
            ((OTx.just s)
             (case chain ((OTx.just c) (OTx.just (sLet aS aT (ofTy d s) c)))
               ((OTx.nothing) OTx.nothing)))
            ((OTx.nothing) OTx.nothing))))))

  ; structural recursion: the kernel's fold of trees whose step sees the node itself, at the
  ; suspended result; the clause's fields take the children's suspended results in order, one
  ; binding each, so that each is used once; a recursive field is bound to its forced result, any
  ; other to the node's child
  (defn thTy ((r Tx)) Tx (sArrow aUnit r))
  (defn splitTy ((r Tx)) Tx (sProd (thTy r) (sList (thTy r))))
  ; the suspended results remaining at field k
  (defn resultsAt ((k T)) Tx (if (eq k 0) aK (sx2 aSnd (qAtom (sub k 1)))))
  (defn cataField ((d Name) (r Tx) (dr Tx) (k T) (ty Tx) (v Tx) (b Tx)) Tx
    (sLet (qAtom k) (splitTy r)
      (sx6 aLcase (thTy r) (splitTy r) (resultsAt k)
        (sx3 aPair (sLam1 aU aUnit dr) (sx2 aNil (thTy r)))
        (sLam2 aH (thTy r) aTl (sList (thTy r)) (sx3 aPair aH aTl)))
      (if (named (rep ty) (rep d)) (sLet v r (sx2 (sx2 aFst (qAtom k)) aUnitV) b)
        (sLet v ty (asTy ty (sx3 aChild aO (numAtom k))) b))))
  (defn cataRest ((d Name) (r Tx) (nf T) (ty Tx) (v Tx) (b Tx)) Tx
    (if (named (rep ty) (rep d))
      (sLet v (sList r)
        (sx6 aFoldr (thTy r) (sList r)
          (sLam2 aH (thTy r) aA (sList r) (sx3 aCons (sx2 aH aUnitV) aA))
          (sx2 aNil r)
          (resultsAt nf))
        b)
      (sLet v (sList ty) (asTy (sList ty) (sDrop aT (sx2 aChildren aO) nf)) b)))
  (defn expandCata ((env (List Decl)) (fs (List Tx)) (rs (List XR))) MTx
    (let d Name (atomName (nthTx fs 1))
      (let r Tx (nthTx fs 2)
        (let chain MTx
          (if (and (isAtomTx (nthTx fs 1)) (isData d env))
            (clauseChain env (OName.just d) (Txs.drop 4 fs) (xrFrom rs 4 env) aO
              (bindWith (cataField d r (defaultOf (expandAliases env r))) (cataRest d r)))
            OTx.nothing)
          (case (xrAt rs 3 env)
            ((OTx.just s)
             (case chain
               ((OTx.just c)
                (OTx.just
                  (sx2
                    (sx4 aPara (thTy r) (sLam2 aO aT aK (sList (thTy r)) (sLam1 aU aUnit c))
                      (ofTy (nthTx fs 1) s))
                    aUnitV)))
               ((OTx.nothing) OTx.nothing)))
            ((OTx.nothing) OTx.nothing))))))

  ; an expression expanded, given the declarations before it: each form's result is the form with
  ; its expansion as a function of the declarations
  (defn expandExpr ((env (List Decl)) (e Tx)) MTx
    ((snd
       (cata Tx XR e ((tAtom cs) (pair (tAtom cs) (lam ((env (List Decl))) (OTx.just (tAtom cs)))))
         ((tList rs)
          (let fs (List Tx) (xrForms rs)
            (pair (tList fs)
              (lam ((env (List Decl)))
                (let h Tx (nthTx fs 0)
                  (let k T (XRs.length rs)
                    (if (and (namedTx h kwCase) (lt 2 k)) (expandCase env fs rs)
                      (if (and (namedTx h kwCata) (lt 4 k)) (expandCata env fs rs)
                        (let a (Prod T (List Tx)) (xrFrom rs 0 env)
                          (if (fst a) (OTx.just (tList (snd a))) OTx.nothing))))))))))
         (else (pair tx0 (lam ((env (List Decl))) (OTx.just tx0)))))) env))

  ; a datatype declaration: its declarations and kernel forms, the datatype's declaration, as a
  ; type distinct from the trees or as their abbreviation, and one definition for each
  ; constructor
  (deftype CD (Prod Decl Tx))
  (defn ctorDecl ((d Name) (j T) (c Tx)) (Prod T CD)
    (let es (List Tx) (elems c)
      (let rest (List Tx) (Txs.tail es)
        (let nr T (Txs.length rest)
          (let isVar T (and (lt 1 nr) (namedTx (nthTx rest (sub nr 2)) kwAmp))
            (let fields (List Tx) (if isVar (dropLast (dropLast rest)) rest)
              (let nf T (Txs.length fields)
                (let vt Tx (if isVar (nthTx rest (sub nr 1)) tx0)
                  (let ps (List Tx)
                    (snd
                      (foldr Tx (Prod T (List Tx))
                        (lam ((f Tx) (acc (Prod T (List Tx))))
                          (pair (add (fst acc) 1)
                            (cons (sx2 (fieldAtom (sub (sub nf 1) (fst acc))) f) (snd acc))))
                        (pair 0 (nil Tx))
                        fields))
                    (let listE Tx
                      (snd
                        (foldr Tx (Prod T Tx)
                          (lam ((f Tx) (acc (Prod T Tx)))
                            (pair (add (fst acc) 1)
                              (sx3 aCons (ofTy f (fieldAtom (sub (sub nf 1) (fst acc))))
                                (snd acc))))
                          (pair 0 (if isVar (ofTy (sList vt) aRest) (sx2 aNil aT)))
                          fields))
                      (let allPs (List Tx)
                        (if isVar (Txs.append ps (Txs.single (sx2 aRest (sList vt)))) ps)
                        (let body Tx (asTy (tAtom (children (rep d))) (sx3 aNode (numAtom j) listE))
                          (pair (and (isListTx c) (isAtomTx (nthTx es 0)))
                            (pair (ctorD (atomName (nthTx es 0)) j d (tList fields) isVar vt)
                              (sx3 aDef (nthTx es 0)
                                (if (lt 0 (Txs.length allPs)) (sx3 aLam (tList allPs) body)
                                  body))))))))))))))))
  (deftype DS (Prod T (Prod (List Decl) (List Tx))))
  (defn dataDecl ((e Tx)) DS
    (let es (List Tx) (elems e)
      (let d Name (atomName (nthTx es 1))
        (let cs (List Tx) (Txs.drop 2 es)
          (let nc T (Txs.length cs)
            (let r (Prod T DS)
              (foldr Tx (Prod T DS)
                (lam ((c Tx) (acc (Prod T DS)))
                  (let x (Prod T CD) (ctorDecl d (sub (sub nc 1) (fst acc)) c)
                    (pair (add (fst acc) 1)
                      (pair (and (fst x) (fst (snd acc)))
                        (pair (cons (fst (snd x)) (fst (snd (snd acc))))
                          (cons (snd (snd x)) (snd (snd (snd acc)))))))))
                (pair 0 (pair 1 (pair (nil Decl) (nil Tx))))
                cs)
              (pair (and (fst (snd r)) (isAtomTx (nthTx es 1)))
                (pair (cons (dataD d) (fst (snd (snd r))))
                  (cons (sx3 aDeftype (nthTx es 1) aT) (snd (snd (snd r))))))))))))

  ; the marker the recognizers read of a datatype the keyword data declares: the node of label 9
  ; over its atom and, for each constructor, the node over its position, its field types, whether
  ; a last field takes the remaining children, and that field's type, abbreviations expanded
  (defn marker ((env (List Decl)) (d Tx) (ds (List Decl))) Tx
    (tMarker
      (cons (rep d)
        (foldr Decl Ts
          (lam ((c Decl) (acc Ts))
            (case c
              ((ctorD m j dd fs v w)
               (cons
                 (node 0
                   (cons j
                     (cons
                       (node 0
                         (foldr Tx Ts (lam ((ty Tx) (a Ts)) (cons (rep (expandAliases env ty)) a))
                           (nil T)
                           (elems fs)))
                       (cons v (single (rep (expandAliases env w)))))))
                 acc))
              (else acc)))
          (nil T)
          ds))))

  ; a program's forms expanded: the state is whether every form has expanded, the declarations,
  ; and the kernel forms, the most recent first
  (deftype XP (Prod T (Prod (List Decl) (List Tx))))
  (deftype XPK (Arrow XP XP))
  (def xpFail (pair 0 (pair (nil Decl) (nil Tx))))
  (defn xpStep ((s XP) (e Tx)) XP
    (if (and (fst s) (isListTx e))
      (let env (List Decl) (fst (snd s))
        (let out (List Tx) (snd (snd s))
          (let es (List Tx) (elems e)
            (let h Tx (nthTx es 0)
              (let k T (Txs.length es)
                (if (or (namedTx h kwData) (namedTx h kwTreeData))
                  (let dd DS (dataDecl e)
                    (if (fst dd)
                      (let ds (List Decl) (fst (snd dd))
                        (let forms (List Tx) (snd (snd dd))
                          (pair 1
                            (pair (Decls.append env ds)
                              (Txs.append
                                (Txs.reverse
                                  (if (namedTx h kwData)
                                    (Txs.append (cons (tData (nthTx es 1)) (Txs.tail forms))
                                      (Txs.single (marker env (nthTx es 1) ds)))
                                    forms))
                                out)))))
                      xpFail))
                  (if (and (namedTx h kwDefn) (eq k 5))
                    (case (expandExpr env (nthTx es 4))
                      ((OTx.just b)
                       (let body Tx (sLet aR (nthTx es 3) b aR)
                         (pair 1
                           (pair env
                             (cons
                               (sx3 aDef (nthTx es 1)
                                 (if (eq (Txs.length (elems (nthTx es 2))) 0) body
                                   (sx3 aLam (nthTx es 2) body)))
                               out)))))
                      ((OTx.nothing) xpFail))
                    (if (and (namedTx h kwDef) (eq k 3))
                      (case (expandExpr env (nthTx es 2))
                        ((OTx.just b) (pair 1 (pair env (cons (sx3 aDef (nthTx es 1) b) out))))
                        ((OTx.nothing) xpFail))
                      (if (and (namedTx h kwDeftype) (eq k 3))
                        (pair 1
                          (pair
                            (Decls.append env
                              (Decls.single
                                (aliasD (atomName (nthTx es 1)) (expandAliases env (nthTx es 2)))))
                            (cons e out)))
                        (if (and (namedTx h kwDefnum) (eq k 3)) (pair 1 (pair env (cons e out)))
                          xpFail))))))))))
      xpFail))
  ; the instance of a template at opaque arguments that module elaboration writes, (%generic ...):
  ; its forms expanded with the declarations before it, the declarations of its arguments kept,
  ; and the instance written for the typing, the declarations after it unchanged; an instance
  ; nested in one is not expanded
  (defn genericStep ((s XP) (e Tx)) XP
    (if (fst s)
      (let r XP
        ((foldr Tx XPK
           (lam ((f Tx) (k XPK) (t XP))
             (k
               (if (and (fst t) (isListTx f))
                 (let h Tx (nthTx (elems f) 0)
                   (if (or (namedTx h kwSort) (namedTx h kwPostulate))
                     (pair 1 (pair (fst (snd t)) (cons f (snd (snd t)))))
                     (if (namedTx h kwGeneric) xpFail (xpStep t f))))
                 xpFail)))
           (lam ((t XP)) t)
           (Txs.tail (elems e))) (pair 1 (pair (fst (snd s)) (nil Tx))))
        (if (fst r)
          (pair 1 (pair (fst (snd s)) (cons (tGeneric (Txs.reverse (snd (snd r)))) (snd (snd s)))))
          xpFail))
      s))
  ; a program's forms expanded with their datatypes, before they are checked
  (defn expandTyped ((es (List Tx))) (Prod T (List Tx))
    (let s XP
      ((foldr Tx XPK
         (lam ((e Tx) (k XPK) (s XP))
           (k
             (if (and (isListTx e) (namedTx (nthTx (elems e) 0) kwGeneric)) (genericStep s e)
               (xpStep s e))))
         (lam ((s XP)) s)
         es) (pair 1 (pair (nil Decl) (nil Tx))))
      (pair (fst s) (Txs.reverse (snd (snd s))))))

  ; the erasure of a checked program: the declaration of a datatype becomes its abbreviation for
  ; the trees; the coercions and representations become the terms they apply to; decoding binds
  ; the tree once, tests it by the datatype's recognizer and gives it to the function when it is a
  ; member; and the datum of a member, the quotation of the tree
  (defn eraseExpr ((e Tx)) Tx
    (cata Tx Tx e ((tAs a b) b) ((tOf a b) b) ((tAtom cs) (tAtom cs))
      ((tList rs)
       (let k T (Txs.length rs)
         (let h Tx (nthTx rs 0)
           (if (and (namedTx h kwRep) (eq k 2)) (nthTx rs 1)
             (if (and (namedTx h kwDecode) (eq k 5))
               (sLet aE aT (nthTx rs 2)
                 (sIf (sx2 (memberAtom (nthTx rs 1)) aE) (sx2 (nthTx rs 3) aE) (nthTx rs 4)))
               (if (and (namedTx h kwDatum) (eq k 3)) (sx2 aQuote (nthTx rs 2)) (tList rs)))))))
      (else tx0)))
  (defn eraseForm ((f Tx)) Tx
    (case f ((tData d) (sx3 aDeftype d aT))
      ((tList xs)
       (if (and (eq (Txs.length xs) 3) (namedTx (nthTx xs 0) kwDef))
         (sx3 (nthTx xs 0) (nthTx xs 1) (eraseExpr (nthTx xs 2)))
         f))
      (else f)))
  ; a program's forms expanded with their datatypes, checked and erased, the templates' instances
  ; at opaque arguments dropped, when they expand and check
  (defn expandChecked ((es (List Tx))) MTx
    (let x (Prod T (List Tx)) (expandTyped es)
      (if (fst x)
        (case (checkForms (snd x)) ((OName.just n) OTx.nothing)
          ((OName.nothing)
           (OTx.just
             (tList
               (foldr Tx (List Tx)
                 (lam ((f Tx) (acc (List Tx)))
                   (case f ((tGeneric gs) acc) (else (cons (eraseForm f) acc))))
                 (nil Tx)
                 (snd x))))))
        OTx.nothing)))
  ; a program's forms, as the front end gives them, expanded, when they expand and check
  (defn expandProgram ((es Ts)) T
    (decode Tx (node 2 es)
      (lam ((x Tx))
        (case (expandChecked (elems x)) ((OTx.just y) (some (node 0 (children (rep y)))))
          ((OTx.nothing) none)))
      none))
  ; the name of the first definition of a program's forms, or of its text, that does not check,
  ; or the empty tree
  (defn typeErrorOfForms ((es Ts)) T
    (decode Tx (node 2 es)
      (lam ((x Tx))
        (let r (Prod T (List Tx)) (expandTyped (elems x))
          (if (fst r)
            (case (checkForms (snd r)) ((OName.just n) (rep n)) ((OName.nothing) (node 0 (nil T))))
            (node 0 (nil T)))))
      (node 0 (nil T))))
  (defn typeErrorOf ((file T)) T
    (let sx T (readSExps (children file))
      (if (isSome sx) (typeErrorOfForms (children (get sx))) (node 0 (nil T))))))
