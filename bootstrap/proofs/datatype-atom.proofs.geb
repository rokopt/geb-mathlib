  ; The pipeline's functions at an atom; the rules of the soundness at an atom; and the folded
  ; definitions without the typing's and the reader's steps at an atom.
  (abbreviation atom-rules expand-atom erase-atom syn-atom nums-atom resolve-atom src-atom)
  (abbreviation atom-kit atom-rules lookup-kit)
  (abbreviation unfolding-atoms
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
      Reader.resolveList
      Typing.synList
      Datatype.expandCase
      Datatype.expandCata
      Datatype.expandExpr
      Typing.synCase
      Typing.synCata
      Typing.synIn
      Datatype.eraseCase
      Datatype.eraseCata
      Datatype.eraseExpr
      Reader.expandNums
      Reader.resolve
      Reader.lookupAbbrev
      Reader.indexOf
      Reader.numeral
      Typing.lookupName
      Typing.hasName
      srcForm
      charsFixed
      Typing.keywordTx
      Typing.boundNames
      Reader.primNames
      Reader.reservedNames
      Typing.memberOf
      Typing.nameOk))
  ; The soundness at an atom. The characters are fixed by the expansion of numeral abbreviations, by
  ; the test of source forms; the coherences and the definitions' relation are taken at the atom's
  ; name; and the typing's tests are decided in its order, each with the reader's: a keyword and a
  ; name the erasure binds have no type; a numeral, and a name that abbreviates one, resolve to a
  ; quotation; a name with an index in the scope is a variable, whose entry in the named context the
  ; scope's agreement gives, and a name with a type in the context has such an index; a name with a
  ; type among the definitions is a reference, whose evaluation converges by the definitions'
  ; relation; a name with an index among the definitions' names and no type has no type, being no
  ; primitive's and not the unit value's; a primitive's name has one of the primitives' indices, and
  ; is the primitive of that index, related at its type; the unit value's is the unit value; and any
  ; other has no type.
