  ; A quotation is related at the type of trees, and the unit value at the unit type.
  (theorem typed-quote
    (internal () (forall ((R Ctx) (t T)) ((typed-related R Typing.tyT) (Eval.valQuote t))))
    (by (with-rules ((unfold typed-related) kit) (reduced full (exists-intro t (reduce full)))))
    (normal full kit))
  (theorem typed-unit
    (internal () (forall ((R Ctx)) ((typed-related R Typing.tyUnit) Eval.valUnit)))
    (by (with-rules ((unfold typed-related) kit) (reduced full (formula (reduce full)))))
    (normal full kit))
  ; The folded definitions without the primitives' names.
  (abbreviation unfolding-names
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
      Reader.resolveAtom
      Reader.resolveList
      Typing.synAtom
      Typing.synList
      Datatype.expandCase
      Datatype.expandCata
      Datatype.expandExpr
      Typing.synCase
      Typing.synCata
      Typing.synIn
      Datatype.eraseCase
      Datatype.eraseCata
      Datatype.eraseExpr
      Reader.expandNums
      Reader.resolve
      Reader.lookupAbbrev
      Reader.indexOf
      Reader.numeral
      Typing.lookupName
      Typing.hasName
      srcForm
      charsFixed
      Typing.keywordTx
      Typing.boundNames
      Reader.reservedNames
      Typing.memberOf
      Typing.nameOk))
  ; A name with an index among the primitives' names has the index of one of them: the name's
  ; equality with each primitive's name is decided in order, the first that holds giving its index
  ; and none refuting the index.
  (theorem prim-index-cases
    (internal ()
      (forall ((m T))
        (implies
          (lib cond Omega (lib lab (Prelude.isSome (Reader.indexOf m Reader.primNames))) true false)
          (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 0)))
            (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 1)))
              (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 2)))
                (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 3)))
                  (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 4)))
                    (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 5)))
                      (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 6)))
                        (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 7)))
                          (or (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 8)))
                            (or
                              (equal (Reader.indexOf m Reader.primNames) (kernel (Prelude.some 9)))
                              (or
                                (equal (Reader.indexOf m Reader.primNames)
                                  (kernel (Prelude.some 10)))
                                (or
                                  (equal (Reader.indexOf m Reader.primNames)
                                    (kernel (Prelude.some 11)))
                                  (or
                                    (equal (Reader.indexOf m Reader.primNames)
                                      (kernel (Prelude.some 12)))
                                    (equal (Reader.indexOf m Reader.primNames)
                                      (kernel (Prelude.some 13)))))))))))))))))))
    (by
      (with-rules (lookup-kit)
        (assume h
          (obtain dc85 list-cases (Bit) ((lib equal m (kernel (quote (0 label)))))
            (or-elim dc85 (dz86 du87)
              (reduce-hypothesis dz86 df92 full ()
                (obtain dc94 list-cases (Bit) ((lib equal m (kernel (quote (0 arity)))))
                  (or-elim dc94 (dz95 du96)
                    (reduce-hypothesis dz95 df101 full (df92)
                      (obtain dc103 list-cases (Bit) ((lib equal m (kernel (quote (0 child)))))
                        (or-elim dc103 (dz104 du105)
                          (reduce-hypothesis dz104 df110 full (df101 df92)
                            (obtain dc112 list-cases (Bit) ((lib equal m (kernel (quote (0 node)))))
                              (or-elim dc112 (dz113 du114)
                                (reduce-hypothesis dz113 df119 full (df110 df101 df92)
                                  (obtain dc121 list-cases (Bit)
                                    ((lib equal m (kernel (quote (0 children)))))
                                    (or-elim dc121 (dz122 du123)
                                      (reduce-hypothesis dz122 df128 full (df119 df110 df101 df92)
                                        (obtain dc130 list-cases (Bit)
                                          ((lib equal m (kernel (quote (0 add)))))
                                          (or-elim dc130 (dz131 du132)
                                            (reduce-hypothesis dz131 df137 full
                                              (df128 df119 df110 df101 df92)
                                              (obtain dc139 list-cases (Bit)
                                                ((lib equal m (kernel (quote (0 sub)))))
                                                (or-elim dc139 (dz140 du141)
                                                  (reduce-hypothesis dz140 df146 full
                                                    (df137 df128 df119 df110 df101 df92)
                                                    (obtain dc148 list-cases (Bit)
                                                      ((lib equal m (kernel (quote (0 mul)))))
                                                      (or-elim dc148 (dz149 du150)
                                                        (reduce-hypothesis dz149 df155 full
                                                          (df146 df137 df128 df119 df110 df101 df92)
                                                          (obtain dc157 list-cases (Bit)
                                                            ((lib equal m (kernel (quote (0 div)))))
                                                            (or-elim dc157 (dz158 du159)
                                                              (reduce-hypothesis dz158 df164 full
                                                                (df155 df146 df137 df128 df119 df110
                                                                  df101
                                                                  df92)
                                                                (obtain dc166 list-cases (Bit)
                                                                  ((lib equal m
                                                                     (kernel (quote (0 mod)))))
                                                                  (or-elim dc166 (dz167 du168)
                                                                    (reduce-hypothesis dz167 df173
                                                                      full
                                                                      (df164 df155 df146 df137 df128
                                                                        df119
                                                                        df110
