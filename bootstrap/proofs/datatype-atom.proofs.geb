; The soundness of the datatype language's typing at an atom, about the translation of the program
; of bootstrap/datatype-soundness.manifest: the stage-1 compiler's typing and expansion with the
; reader, the kernel's type checker, the recognizers and the evaluator. The soundness at a source
; form states that if the form expands, its expansion has a type in the typing, and the expansion's
; erasure, its numeral abbreviations expanded, resolves in the scope of a named context's names,
; then the resolved term's evaluation converges to a value related at the type, under hypotheses
; that relate the environment to the named context and the definitions to the typing environment's
; and that state the reader's coherence with the typing. The relation is the fundamental lemma's, of
; normalization-base.proofs.geb, extended at the datatypes, whose values are their members'
; quotations. The document declares the relation and the hypotheses, proves the equations of the
; pipeline's functions at an atom, the reflexivity of the equality of trees, the agreement of the
; reader's scope with a named context at a name, and the relation of each primitive at its type in
; the typing, and from them the soundness at an atom, the development of
; GebTests/Prototypes/FreeTopos/DatatypeBase.lean. Each theorem states the normal form of its
; companion with the pipeline's functions kept folded: a companion in the weak normal form that
; unfolds them has no bound on its size.

(proofs 8 (program datatype-soundness) (import normalization-rel.proofs.geb)
  ; The types of lists of trees, of the typing's environments as the kernel reads them, of the
  ; relation's contexts, the program's definitions with the markers of its datatypes, of predicates
  ; on values, of the relation's fold, and of the evaluator's functions.
  (abbreviation Ts (List T))
  (abbreviation Env (Prod Ts (Prod Ts (Prod Ts (Prod Ts (Prod Ts Ts))))))
  (abbreviation Ctx (Prod Ts Ts))
  (abbreviation Pred (Arrow T Omega))
  (abbreviation RelC (Prod T (Arrow Ctx Pred)))
  (abbreviation Ord (Sum Unit Bit))
  (abbreviation Ev (Arrow Ts (Arrow T T)))
  (abbreviation Ap (Arrow T (Arrow T T)))
  (abbreviation Fns (Prod Ev Ap))
  (abbreviation EvE (Arrow Ts T))
  ; The numerals of the labels of the types and of an atom.
  (abbreviation n0 (lib bnil))
  (abbreviation n1 (lib b0 (lib bnil)))
  (abbreviation n2 (lib b1 (lib bnil)))
  (abbreviation n3 (lib b0 (lib b0 (lib bnil))))
  (abbreviation n4 (lib b1 (lib b0 (lib bnil))))
  (abbreviation n5 (lib b0 (lib b1 (lib bnil))))
  (abbreviation n6 (lib b1 (lib b1 (lib bnil))))
  ; The first and the second child of a tree, the name and the type of a named context's entry, as
  ; functions, which a term under the binder of a fold of lists applies.
  (abbreviation first-of (kernel (lam ((e T)) (child e 0))))
  (abbreviation second-of (kernel (lam ((e T)) (child e 1))))
  ; The relations at the first two children of a type's node n, each a pair of the child rebuilt and
  ; its relation; the pair of the leaf 0 and the relation that holds of nothing where a child is
  ; absent.
  (abbreviation relc-false (pair (node Bits (pair (lib bnil) (nil T))) (lam ((d Ctx) (x T)) false)))
  (abbreviation relc-kids (list-rec (pair relc-false relc-false) (y r) (pair y (fst r)) (snd n)))
  ; The relation at a type of the datatype language, a predicate on values, in a context: by the
  ; fold of the type whose value at a node pairs the node rebuilt with the relation. At the types of
  ; trees, the unit, products, functions and lists it is the fundamental lemma's; at a datatype it
  ; holds of the quotations of the datatype's members, by the typing's membership in the markers'
  ; datatypes, the datatype's atom read off its name; and at a sort it is the relation at the trees,
  ; the sort's erasure.
  (definition typed-related ((R Ctx) (A T)) Pred
    ((snd
       (rose-rec RelC (n)
         (pair (node Bits (pair (fst n) (list-rec (nil T) (c r) (cons T (fst c) r) (snd n))))
           (lam ((d Ctx) (x T))
             (lib cond Omega (lib eqB (fst n) n0)
               (exists T (lam ((t T)) (equal x (Eval.valQuote t))))
               (lib cond Omega (lib eqB (fst n) n1) (equal x Eval.valUnit)
                 (lib cond Omega (lib eqB (fst n) n2)
                   (exists T
                     (lam ((a T))
                       (exists T
                         (lam ((b T))
                           (and (equal x (Eval.valPair a b))
                             (and ((snd (fst relc-kids)) d a) ((snd (snd relc-kids)) d b)))))))
                   (lib cond Omega (lib eqB (fst n) n3)
                     (all T
                       (lam ((a T))
                         (implies ((snd (fst relc-kids)) d a)
                           (converges (lam ((k Nat)) ((snd (level-at (fst d) k)) x a))
                             (lam ((w T)) ((snd (snd relc-kids)) d w))))))
                     (lib cond Omega (lib eqB (fst n) n4)
                       (and (lib cond Omega (lib lab (Prelude.isSome (Eval.listOf x))) true false)
                         (all-of (lam ((a T)) ((snd (fst relc-kids)) d a))
                           (lib children (Prelude.get (Eval.listOf x)))))
                       (lib cond Omega (lib eqB (fst n) n5)
                         (exists T
                           (lam ((t T))
                             (and (equal x (Eval.valQuote t))
                               (lib cond Omega
                                 (lib lab
                                   (Typing.memberOf (snd d)
                                     (node Bits (pair n1 (lib children (fst (fst relc-kids)))))
                                     t))
                                 true
                                 false))))
                         (lib cond Omega (lib eqB (fst n) n6)
                           (exists T (lam ((t T)) (equal x (Eval.valQuote t))))
                           false)))))))))
         A)) R))
  ; The relation of an environment to a named context: at each index where the context has an entry
  ; whose name is none the erasure binds, the environment has some value related at the entry's
  ; type.
  (definition typed-env-related ((R Ctx) (cx Ts) (env Ts)) Omega
    (all T
      (lam ((i T))
        (implies (lib cond Omega (lib lab (Prelude.isSome (Prelude.nth cx i))) true false)
          (implies
            (implies
              (lib cond Omega
                (lib lab
                  (Prelude.isSome
                    (Reader.indexOf (first-of (Prelude.get (Prelude.nth cx i))) Typing.boundNames)))
                true
                false)
              false)
            (exists T
              (lam ((w T))
                (and (equal (Prelude.nth env i) (Prelude.some w))
                  ((typed-related R (second-of (Prelude.get (Prelude.nth cx i)))) w)))))))))
  ; The relation of the definitions to the typing environment's: at each name the environment gives
  ; a type, the reader's names give an index, at which the definitions have a term whose evaluation
  ; in the empty environment converges to a value related at that type.
  (definition typed-globals-related ((R Ctx) (E Env) (names Ts)) Omega
    (all T
      (lam ((m T))
        (implies
          (lib cond Omega (lib lab (Prelude.isSome (Typing.lookupName m (Typing.envDefs E)))) true
            false)
          (exists T
            (lam ((i T))
              (and (equal (Reader.indexOf m names) (Prelude.some i))
                (exists T
                  (lam ((b T))
                    (and (equal (Prelude.nth (fst R) i) (Prelude.some b))
                      (converges (lam ((k Nat)) ((fst (level-at (fst R) k)) (nil T) b))
                        (typed-related R
                          (Prelude.get (Typing.lookupName m (Typing.envDefs E)))))))))))))))
  ; The recognizers of the typing environment's datatypes among the definitions: at each datatype
  ; whose recognizer's name has an index, the definition there evaluates to a function whose
  ; application to the quotation of a tree converges to the quotation of a tree that is true exactly
  ; when the tree is a member of the datatype.
  (definition recognizers-related ((R Ctx) (E Env) (names Ts)) Omega
    (all T
      (lam ((dt T))
        (implies (lib cond Omega (lib lab (Typing.hasName dt (Typing.envNoms E))) true false)
          (implies
            (lib cond Omega
              (lib lab (Prelude.isSome (Reader.indexOf (Typing.recognizerName dt) names)))
              true
              false)
            (exists T
              (lam ((i T))
                (and (equal (Reader.indexOf (Typing.recognizerName dt) names) (Prelude.some i))
                  (exists T
                    (lam ((b T))
                      (and (equal (Prelude.nth (fst R) i) (Prelude.some b))
                        (converges (lam ((k Nat)) ((fst (level-at (fst R) k)) (nil T) b))
                          (lam ((g T))
                            (all T
                              (lam ((t T))
                                (converges
                                  (lam ((k Nat)) ((snd (level-at (fst R) k)) g (Eval.valQuote t)))
                                  (lam ((w T))
                                    (exists T
                                      (lam ((u T))
                                        (and (equal w (Eval.valQuote u))
                                          (and
                                            (implies (lib cond Omega (lib lab u) true false)
                                              (lib cond Omega
                                                (lib lab
                                                  (Typing.memberOf (snd R)
                                                    (node Bits (pair n1 (lib children dt)))
                                                    t))
                                                true
                                                false))
                                            (implies
                                              (lib cond Omega
                                                (lib lab
                                                  (Typing.memberOf (snd R)
                                                    (node Bits (pair n1 (lib children dt)))
                                                    t))
                                                true
                                                false)
                                              (lib cond Omega (lib lab u) true
                                                false)))))))))))))))))))))))
  ; The coherence of the reader's numeral abbreviations with the typing environment's: a name the
  ; environment has abbreviates the atom of a numeral, and a name abbreviated is one the environment
  ; has.
  (definition numerals-coherent ((E Env) (nums Ts)) Omega
    (all T
      (lam ((m T))
        (and
          (implies (lib cond Omega (lib lab (Typing.hasName m (Typing.envNums E))) true false)
            (exists Ts
              (lam ((ds Ts))
                (and (equal (Reader.lookupAbbrev m nums) (Prelude.some (node Bits (pair n1 ds))))
                  (lib cond Omega (lib lab (Prelude.isSome (Reader.numeral ds))) true false)))))
          (implies
            (lib cond Omega (lib lab (Prelude.isSome (Reader.lookupAbbrev m nums))) true false)
            (lib cond Omega (lib lab (Typing.hasName m (Typing.envNums E))) true false))))))
  ; The reader's names of definitions: no name with an index is a primitive's or the unit value's.
  (definition names-coherent ((names Ts)) Omega
    (all T
      (lam ((m T))
        (implies (lib cond Omega (lib lab (Prelude.isSome (Reader.indexOf m names))) true false)
          (implies
            (lib cond Omega
              (lib lab
                (Prelude.or (Prelude.isSome (Reader.indexOf m Reader.primNames))
                  (kernel (equal m Reader.kwUnitValue))))
              true
              false)
            false)))))
  ; The reader's numeral abbreviations and its keywords: no name abbreviated is reserved, the
  ; implementation's or a numeral.
  (definition keywords-coherent ((nums Ts)) Omega
    (all T
      (lam ((m T))
        (implies (lib cond Omega (lib lab (Prelude.isSome (Reader.lookupAbbrev m nums))) true false)
          (implies
            (lib cond Omega
              (lib lab
                (Prelude.or (Prelude.isSome (Reader.indexOf m Reader.reservedNames))
                  (Prelude.or (implName m) (Prelude.isSome (Reader.numeral (lib children m))))))
              true
              false)
            false)))))
  ; The names of a named context: each with a type is one the typing admits as a binder's, or the
  ; implementation's.
  (definition context-named ((E Env) (cx Ts)) Omega
    (all T
      (lam ((m T))
        (implies (lib cond Omega (lib lab (Prelude.isSome (Typing.lookupName m cx))) true false)
          (lib cond Omega (lib lab (Prelude.or (Typing.nameOk E m) (implName m))) true false)))))
  ; The terms of the statement at a form x: the scope the reader resolves in, the names of the named
  ; context's variables, each as the reader reads it; the form's optional expansion and the
  ; expansion; the typing's optional type of it; and the reader's optional resolution of its
  ; erasure, its numeral abbreviations expanded.
  (abbreviation the-scope (list-rec (nil T) (p r) (cons T (expName nums (first-of p)) r) cx))
  (abbreviation the-expansion (Datatype.expandExpr ds x))
  (abbreviation the-form (Prelude.get the-expansion))
  (abbreviation the-type (Typing.synIn E cx the-form))
  (abbreviation the-term
    (Reader.resolve tys names (Reader.expandNums nums (Datatype.eraseExpr the-form)) the-scope))
  ; The soundness of the datatype language's typing at a source form x: for all globals' types and
  ; contexts of the kernel, declarations of the expansion, typing environments, named contexts, type
  ; and numeral abbreviations and definitions' names of the reader, environments and contexts of the
  ; relation, if the definitions are related to the typing environment's and the environment to the
  ; named context, the numeral abbreviations cohere with the typing environment's, no definition
  ; takes a primitive's name, the expansion is a source form whose atoms' characters the expansion
  ; of numeral abbreviations fixes, the form expands, the expansion has a type, its erasure
  ; resolves, the resolved term has a type in the kernel, no numeral abbreviation is a keyword, the
  ; relation's markers are the typing environment's, the recognizers decide membership, and the
  ; context's names are binders', then the resolved term's evaluation in the environment converges
  ; to a value related at the type.
  (definition typing-sound-at ((x T)) Omega
    (all Ts
      (lam ((gt Ts))
        (all Ts
          (lam ((kc Ts))
            (all Ts
              (lam ((ds Ts))
                (all Env
                  (lam ((E Env))
                    (all Ts
                      (lam ((cx Ts))
                        (all Ts
                          (lam ((tys Ts))
                            (all Ts
                              (lam ((nums Ts))
                                (all Ts
                                  (lam ((names Ts))
                                    (all Ts
                                      (lam ((env Ts))
                                        (all Ctx
                                          (lam ((R Ctx))
                                            (implies (typed-globals-related R E names)
                                              (implies (typed-env-related R cx env)
                                                (implies (numerals-coherent E nums)
                                                  (implies (names-coherent names)
                                                    (implies
                                                      (lib cond Omega
                                                        (lib lab
                                                          (srcForm
                                                            (lam ((t T)) (Reader.expandNums nums t))
                                                            the-form))
                                                        true
                                                        false)
                                                      (implies
                                                        (lib cond Omega
                                                          (lib lab (Prelude.isSome the-expansion))
                                                          true
                                                          false)
                                                        (implies
                                                          (lib cond Omega
                                                            (lib lab (Prelude.isSome the-type))
                                                            true
                                                            false)
                                                          (implies
                                                            (lib cond Omega
                                                              (lib lab (Prelude.isSome the-term))
                                                              true
                                                              false)
                                                            (implies
                                                              (lib cond Omega
                                                                (lib lab
                                                                  (Prelude.isSome
                                                                    (Check.typeIn gt kc
                                                                      (Prelude.get the-term))))
                                                                true
                                                                false)
                                                              (implies (keywords-coherent nums)
                                                                (implies
                                                                  (equal (snd R) (Typing.envMs E))
                                                                  (implies
                                                                    (recognizers-related R E names)
                                                                    (implies (context-named E cx)
                                                                      (converges
                                                                        (lam ((k Nat))
                                                                          ((fst
                                                                             (level-at (fst R) k))
                                                                           env
                                                                           (Prelude.get the-term)))
                                                                        (typed-related R
                                                                          (Prelude.get
                                                                            the-type)))))))))))))))))))))))))))))))))))))
  ; The definitions the reductions keep folded: the equality of trees, the type checker and the
  ; evaluator's steps, as the fundamental lemma's proofs keep them, and the pipeline's functions,
  ; each decided by a node's label, with the lookups and the constants its tests read.
  (abbreviation kept
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
      Reader.resolveAtom
      Reader.resolveList
      Typing.synAtom
      Typing.synList
      Datatype.expandCase
      Datatype.expandCata
      Datatype.expandExpr
      Typing.synCase
      Typing.synCata
      Typing.synIn
      Datatype.eraseCase
      Datatype.eraseCata
      Datatype.eraseExpr
      Reader.expandNums
      Reader.resolve
      Reader.lookupAbbrev
      Reader.indexOf
      Reader.numeral
      Typing.lookupName
      Typing.hasName
      srcForm
      charsFixed
      Typing.keywordTx
      Typing.boundNames
      Reader.primNames
      Reader.reservedNames
      Typing.memberOf
      Typing.nameOk))
  ; The rules of the lemmas on folds: the rebuilding of trees and the folded definitions; and the
  ; proof by induction on the children cs, each side reduced with the hypothesis.
  (abbreviation tree-rules lambek unfold-rebuild map-id kept)
  (abbreviation by-list-induction
    (induction cs (y ys ih) (reduce full) (reduce-hypotheses full (ih) (reduce full ih))))
  ; The rules of the fundamental lemma's vocabulary, the definitions kept folded after them, and the
  ; rules of the deductions.
  (abbreviation rebuild-rules rebuild-succ-normal rebuild-add-normal rebuild-succ rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits))
  (abbreviation base-vocabulary apply-closure nth-cons-succ add-one-folded cmp-succ-folded
    lt-zero-succ-folded
    (rebuild-tail-folded T)
    (iter-succ-folded Ts)
    eval-first
    check-first
    (para-first T)
    (para-first EvE)
    check-fold-node
    eval-fold-node
    equal-fold
    equal-node
    succ-not-0
    succ-not-1
    succ-not-2
    succ-not-3
    type-in-fold
    next-fst
    next-snd
    level-succ
    lambek
    unfold-rebuild
    map-id
    check-node-var
    check-node-lam
    check-node-app
    check-node-unit
    check-node-pair
    check-node-fst
    check-node-snd
    check-node-quote
    check-node-cond
    check-node-fold
    check-node-iter
    check-node-nil
    check-node-cons
    check-node-foldr
    check-node-prim
    check-node-ref
    check-node-lcase
    check-node-para
    eval-step-var
    eval-step-lam
    eval-step-app
    eval-step-unit
    eval-step-pair
    eval-step-fst
    eval-step-snd
    eval-step-quote
    eval-step-cond
    eval-step-fold
    eval-step-iter
    eval-step-nil
    eval-step-cons
    eval-step-foldr
    eval-step-prim
    eval-step-ref
    eval-step-lcase
    eval-step-para
    related-tree
    related-unit
    related-prod
    related-arrow
    related-list
    rebuild-rules)
  (abbreviation kit plus-zero plus-succ zero-plus succ-plus plus-assoc base-vocabulary kept
    (unfold all-of)
    (rebuild-tail-folded Omega))
  ; The step of the fold of the equality of trees at a node n, the folds at the children cs, and the
  ; reflexivity of the equality at the tree t.
  (abbreviation equal-step
    (lam ((y T)) (lib and (lib eqB (fst n) (lib lab y)) (lib allZip (snd n) (lib children y)))))
  (abbreviation equal-kids
    (list-rec (nil (Arrow T Bits)) (c r)
      (cons (Arrow T Bits) (rose-rec (Arrow T Bits) (n) equal-step c) r)
      cs))
  (abbreviation reflexive-at (lib cond Omega (lib equal t t) true false))
  ; The equality of bitstrings is reflexive, by induction on the bitstring and the case analysis of
  ; its first bit.
  (theorem eq-bits-reflexive
    (internal () (forall ((x Bits)) (lib cond Omega (lib eqB x x) true false)))
    (by
      (with-rules (kit)
        (induction x (b bs ih) (reduce full)
          (holds ih (ihf)
            (obtain cb bit-cases () (b)
              (or-elim cb (bz bo) (matches ihf full bz) (matches ihf full bo)))))))
    (normal full kit))
  ; The elementwise equality of a list of trees with itself holds where the equality is reflexive at
  ; each element; by induction on the list.
  (theorem all-zip-reflexive
    (internal ()
      (forall ((cs Ts))
        (implies (all-of (lam ((t T)) reflexive-at) cs)
          (lib cond Omega (lib allZip equal-kids cs) true false))))
    (by
      (with-rules (kit)
        (induction cs (y ys ih) (assume ha (reduce full))
          (holds ih (ihf)
            (assume ha
              (reduce-hypothesis ha ha2 head ()
                (and-elim ha2 (py pys)
                  (imp-elim ihf (matches pys full) hz
                    (obtain ce list-cases (Bit) ((lib equal y y))
                      (or-elim ce (q0 q1) (reduce-hypotheses full (q0) (absurd py full q0))
                        (exists-elim q1 (qb q2)
                          (exists-elim q2 (qs q3)
                            (reduce-hypotheses full (q3) (matches hz full q3))))))))))))))
    (normal full kit))
  ; The hypothesis of the induction on trees at a list of children, for the reflexivity of the
  ; equality, is the reflexivity at every child.
  (theorem rose-all-reflexive
    (internal ()
      (forall ((cs Ts))
        (implies
          (equal (list-rec (nil Omega) (t r) (cons Omega (equal reflexive-at true) r) cs)
            (list-rec (nil Omega) (t r) (cons Omega (equal unit unit) r) cs))
          (all-of (lam ((t T)) reflexive-at) cs))))
    (by
      (with-rules (kit)
        (induction cs (y ys ih) (assume h (reduce full))
          (holds ih (ihf)
            (assume h
              (congruence h (g1 (z (List Omega)) (lib headD Omega (equal unit unit) z))
                (reduce-hypotheses full (g1)
                  (holds g1 (g2)
                    (holds g2 (g3)
                      (congruence h (g4 (z (List Omega)) (lib tail Omega z))
                        (reduce-hypotheses full (g4)
                          (imp-elim ihf (matches g4 full) hall
                            (reduced full
                              (and-intro (matches g3 full) (matches hall full)))))))))))))))
    (normal full kit))
  ; The equality of trees is reflexive, by induction on the tree: the labels' test by the
  ; reflexivity of the equality of bitstrings and the children's by the hypothesis.
  (theorem equal-reflexive (internal () (forall ((t T)) reflexive-at))
    (by
      (with-rules (kit)
        (tree-induction t (l cs ih)
          (obtain rl eq-bits-reflexive () (l)
            (obtain ra rose-all-reflexive () (cs)
              (imp-elim ra (hypothesis ih) hall
                (obtain za all-zip-reflexive () (cs)
                  (imp-elim za (hypothesis hall) hz
                    (obtain cl list-cases (Bit) ((lib eqB l l))
                      (or-elim cl (x0 x1) (reduce-hypotheses full (x0) (absurd rl full x0))
                        (exists-elim x1 (xb x2)
                          (exists-elim x2 (xs x3)
                            (reduce-hypotheses full (x3) (matches hz full x3))))))))))))))
    (normal full kit))
  ; The reader's index of a name among names at the empty list.
  (theorem index-of-nil
    (internal () (forall ((x T)) (equal (Reader.indexOf x (nil T)) Prelude.none)))
    (by
      (reduce full
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  ; The reader's index of a name in a construction, from the bitstring of the name's equality with
  ; the head and the name's optional index in the rest: the first index where the bitstring is not
  ; empty, and the successor of the rest's otherwise. A definition, so that the index among a list
  ; of names is not written with the rest's index at each of its occurrences.
  (definition index-after ((e Bits) (r T)) T
    (lib cond T e (kernel (Prelude.some 0))
      (lib cond T (lib lab (Prelude.isSome r)) (Prelude.some (kernel (add (Prelude.get r) 1)))
        Prelude.none)))
  ; The reader's index of a name at a construction, and the index from an equality that fails and
  ; from one that holds.
  (theorem index-of-cons
    (internal ()
      (forall ((x T) (y T) (ys Ts))
        (equal (Reader.indexOf x (cons T y ys))
          (index-after (lib equal x y) (Reader.indexOf x ys)))))
    (by
      (reduce full (unfold index-after)
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  (theorem index-after-nil
    (internal ()
      (forall ((r T))
        (equal (index-after (nil Bit) r)
          (kernel (if (Prelude.isSome r) (Prelude.some (add (Prelude.get r) 1)) Prelude.none)))))
    (by (reduce full (unfold index-after)))
    (normal full tree-rules))
  (theorem index-after-cons
    (internal ()
      (forall ((b Bit) (bs Bits) (r T))
        (equal (index-after (cons Bit b bs) r) (kernel (Prelude.some 0)))))
    (by (reduce full (unfold index-after)))
    (normal full tree-rules))
  ; The typing's type of a name among named types, at the empty list and at a construction.
  (theorem lookup-name-nil
    (internal () (forall ((m T)) (equal (Typing.lookupName m (nil T)) Prelude.none)))
    (by
      (reduce full
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.indexOf
          Reader.numeral
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  (theorem lookup-name-cons
    (internal ()
      (forall ((m T) (p T) (ps Ts))
        (equal (Typing.lookupName m (cons T p ps))
          (lib cond T (lib equal (first-of p) m) (Prelude.some (second-of p))
            (Typing.lookupName m ps)))))
    (by
      (with-rules
        (lambek unfold-rebuild map-id
          (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
            Reader.resolveAtom
            Reader.resolveList
            Typing.synAtom
            Typing.synList
            Datatype.expandCase
            Datatype.expandCata
            Datatype.expandExpr
            Typing.synCase
            Typing.synCata
            Typing.synIn
            Datatype.eraseCase
            Datatype.eraseCata
            Datatype.eraseExpr
            Reader.expandNums
            Reader.resolve
            Reader.lookupAbbrev
            Reader.indexOf
            Reader.numeral
            Typing.hasName
            srcForm
            charsFixed
            Typing.keywordTx
            Typing.boundNames
            Reader.primNames
            Reader.reservedNames
            Typing.memberOf
            Typing.nameOk))
        (tree-cases p (l cs) lambek
          (cases cs (a as) (reduce full) (cases as (b bs) (reduce full) (reduce full))))))
    (normal full tree-rules))
  ; The first field of a constructor's clause, which the erasure reads by the case analysis of the
  ; node's children, is the first child, the leaf 0 where there is none.
  (theorem walk-head
    (internal ()
      (forall ((xs Ts))
        (equal
          (lib lcase T T xs (lam ((u Unit)) (node Bits (pair (lib bnil) (nil T))))
            (lam ((h T)) (lam ((t Ts)) h)))
          ((kernel (lam ((ys (List T))) (child (node 0 ys) 0))) xs))))
    (by (with-rules (tree-rules) (cases xs (a as) (reduce full) (reduce full))))
    (normal full tree-rules))
  ; The reader's resolution as a fold: the result at a node, the pair of the node rebuilt and its
  ; optional resolution as a function of the scope; the kernel's step of the fold and the result of
  ; the rose tree's fold it translates to; that fold's step at a node n and the folds at the
  ; children cs; and the reader's step at the type abbreviations and the definitions' names tn, as
  ; bootstrap/reader.geb writes it.
  (abbreviation resolveR (Prod T (Arrow Ts T)))
  (abbreviation resolveStep (Arrow T (Arrow (List resolveR) resolveR)))
  (abbreviation resolveFold (Arrow resolveStep resolveR))
  (abbreviation resolve-fold-step
    (lam ((f resolveStep))
      (f (node Bits (pair (fst n) (nil T))) (lib mapApp resolveStep resolveR (snd n) f))))
  (abbreviation resolve-children
    (list-rec (nil resolveFold) (c r)
      (cons resolveFold (rose-rec resolveFold (n) resolve-fold-step c) r)
      cs))
  (abbreviation resolve-step
    (lam ((l T) (rs (List resolveR)))
      (let raw T (node l (Reader.rrTrees rs))
        (pair raw
          (lam ((s (List T)))
            (if (Reader.isAtom raw) (Reader.resolveAtom (snd tn) raw s)
              (if (Reader.isList raw) (Reader.resolveList (fst tn) raw rs s) Prelude.none)))))))
  (abbreviation TN (Prod Ts Ts))
  ; The fold of the resolution at a tree, and the list of the folds at the children cs.
  (definition resolve-fold ((tn TN) (x T)) resolveR (kernel (fold resolveR resolve-step x)))
  (abbreviation resolve-folds
    ((list-rec (lam ((g TN)) (nil resolveR)) (c r)
       (lam ((g TN)) (cons resolveR (resolve-fold g c) (r g)))
       cs) tn))
  ; The resolution is the second component of its fold; the map of the children's folds applied to
  ; the step is the list of the folds; the fold at a node is the step at the node's label and that
  ; list; and the first component of the fold at a tree is the tree, by the uniqueness of the tree's
  ; fold, so that the trees of the folds at the children are the children.
  (theorem resolve-is-fold
    (internal ()
      (forall ((tys Ts) (names Ts) (x T) (sc Ts))
        (equal (Reader.resolve tys names x sc) ((snd (resolve-fold (pair tys names) x)) sc))))
    (by
      (reduce full (unfold resolve-fold)
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.lookupAbbrev
          Reader.indexOf
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  (theorem resolve-children-folds
    (internal ()
      (forall ((tn TN) (cs Ts))
        (equal (lib mapApp resolveStep resolveR resolve-children (kernel resolve-step))
          resolve-folds)))
    (by (with-rules ((unfold resolve-fold) tree-rules) by-list-induction))
    (normal full tree-rules))
  (theorem resolve-fold-node
    (internal ()
      (forall ((tn TN) (l Bits) (cs Ts))
        (equal (resolve-fold tn (node Bits (pair l cs)))
          ((kernel resolve-step) (node Bits (pair l (nil T))) resolve-folds))))
    (by (with-rules (resolve-children-folds (unfold resolve-fold) tree-rules) (reduce full)))
    (normal full resolve-children-folds tree-rules))
  (theorem resolve-children-trees
    (internal ()
      (forall ((tn TN) (cs Ts))
        (equal (Reader.rrTrees resolve-folds)
          (lib mapApp TN T
            (list-rec (nil (Arrow TN T)) (c r)
              (cons (Arrow TN T) (lam ((g TN)) (fst (resolve-fold g c))) r)
              cs)
            tn))))
    (by (with-rules (resolve-fold-node tree-rules) by-list-induction))
    (normal full resolve-fold-node tree-rules))
  (theorem resolve-first-fn
    (internal () (forall ((t T)) (equal (lam ((g TN)) (fst (resolve-fold g t))) (lam ((g TN)) t))))
    (by
      (tree-fold-uniqueness t (l cs rs) (lam ((g TN)) (node Bits (pair l (lib mapApp TN T rs g))))
        (extensionality g
          (reduce full resolve-children-trees (map-app-constant TN) resolve-fold-node tree-rules))))
    (normal full resolve-fold-node tree-rules))
  (theorem resolve-first (internal () (forall ((t T) (tn TN)) (equal (fst (resolve-fold tn t)) t)))
    (by (with-rules (resolve-fold-node tree-rules) (pointwise resolve-first-fn full)))
    (normal full resolve-fold-node tree-rules))
  (theorem resolve-kids
    (internal () (forall ((tn TN) (cs Ts)) (equal (Reader.rrTrees resolve-folds) cs)))
    (by (with-rules (resolve-first resolve-fold-node tree-rules) by-list-induction))
    (normal full resolve-fold-node tree-rules))
  ; The resolution at an atom is the reader's resolution of one atom.
  (theorem resolve-atom
    (internal ()
      (forall ((tys Ts) (names Ts) (cs Ts) (sc Ts))
        (equal (Reader.resolve tys names (node Bits (pair n1 cs)) sc)
          (Reader.resolveAtom names (node Bits (pair n1 cs)) sc))))
    (by (reduce full resolve-is-fold resolve-kids resolve-fold-node tree-rules))
    (normal full tree-rules))
  ; The test of source forms as a fold into functions of a function on trees, each giving the pair
  ; of the tree rebuilt and the test; the step as bootstrap/proofs/datatype-soundness.geb writes it.
  (abbreviation SF (Prod T T))
  (abbreviation srcR (Arrow (Arrow T T) SF))
  (abbreviation srcStep (Arrow T (Arrow (List srcR) srcR)))
  (abbreviation srcFold (Arrow srcStep srcR))
  (abbreviation src-fold-step
    (lam ((f srcStep)) (f (node Bits (pair (fst n) (nil T))) (lib mapApp srcStep srcR (snd n) f))))
  (abbreviation src-children
    (list-rec (nil srcFold) (c r) (cons srcFold (rose-rec srcFold (n) src-fold-step c) r) cs))
  (abbreviation src-step
    (lam ((l T) (rs (List srcR)))
      (lam ((g (Arrow T T)))
        (let qs (List SF)
          (foldr srcR (List SF) (lam ((r srcR) (a (List SF))) (cons (r g) a)) (nil SF) rs)
          (let ks (List T)
            (foldr SF (List T) (lam ((q SF) (a (List T))) (cons (fst q) a)) (nil T) qs)
            (pair (node l ks)
              (if (eq l 1) (charsFixed g ks)
                (if (Prelude.or (eq l 2) (Prelude.or (eq l 13) (eq l 14)))
                  (foldr SF T (lam ((q SF) (a T)) (Prelude.and (snd q) a)) 1 qs)
                  0))))))))
  ; The fold of the test of source forms at a tree, the list of the folds at the children cs, and
  ; the trees of those folds at a function f, as the step computes them.
  (definition src-fold ((x T)) srcR (kernel (fold srcR src-step x)))
  (abbreviation src-folds (list-rec (nil srcR) (c r) (cons srcR (src-fold c) r) cs))
  (abbreviation src-trees
    ((kernel
       (lam ((rs (List srcR)) (g (Arrow T T)))
         (foldr SF (List T) (lam ((q SF) (a (List T))) (cons (fst q) a)) (nil T)
           (foldr srcR (List SF) (lam ((r srcR) (a (List SF))) (cons (r g) a)) (nil SF) rs))))
     src-folds
     f))
  ; The test of source forms is the second component of its fold at the function; the fold at a node
  ; is its step; and its first component at a tree is the tree, so that the trees of the folds at
  ; the children are the children.
  (theorem src-is-fold
    (internal () (forall ((f (Arrow T T)) (x T)) (equal (srcForm f x) (snd ((src-fold x) f)))))
    (by
      (reduce full (unfold src-fold)
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.indexOf
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  (theorem src-children-folds
    (internal ()
      (forall ((cs Ts)) (equal (lib mapApp srcStep srcR src-children (kernel src-step)) src-folds)))
    (by (with-rules ((unfold src-fold) tree-rules) by-list-induction))
    (normal full tree-rules))
  (theorem src-fold-node
    (internal ()
      (forall ((l Bits) (cs Ts))
        (equal (src-fold (node Bits (pair l cs)))
          ((kernel src-step) (node Bits (pair l (nil T))) src-folds))))
    (by (with-rules (src-children-folds (unfold src-fold) tree-rules) (reduce full)))
    (normal full src-children-folds tree-rules))
  (theorem src-children-trees
    (internal ()
      (forall ((f (Arrow T T)) (cs Ts))
        (equal src-trees
          (lib mapApp (Arrow T T) T
            (list-rec (nil (Arrow (Arrow T T) T)) (c r)
              (cons (Arrow (Arrow T T) T) (lam ((g (Arrow T T))) (fst ((src-fold c) g))) r)
              cs)
            f))))
    (by (with-rules (src-fold-node tree-rules) by-list-induction))
    (normal full src-fold-node tree-rules))
  (theorem src-first-fn
    (internal ()
      (forall ((t T))
        (equal (lam ((g (Arrow T T))) (fst ((src-fold t) g))) (lam ((g (Arrow T T))) t))))
    (by
      (tree-fold-uniqueness t (l cs rs)
        (lam ((g (Arrow T T))) (node Bits (pair l (lib mapApp (Arrow T T) T rs g))))
        (extensionality g
          (reduce full src-children-trees (map-app-constant (Arrow T T)) src-fold-node
            tree-rules))))
    (normal full src-fold-node tree-rules))
  (theorem src-first (internal () (forall ((t T) (f (Arrow T T))) (equal (fst ((src-fold t) f)) t)))
    (by (with-rules (src-fold-node tree-rules) (pointwise src-first-fn full)))
    (normal full src-fold-node tree-rules))
  (theorem src-kids (internal () (forall ((f (Arrow T T)) (cs Ts)) (equal src-trees cs)))
    (by (with-rules (src-first src-fold-node tree-rules) by-list-induction))
    (normal full src-fold-node tree-rules))
  ; The test of source forms at an atom is that the function fixes the atom's characters.
  (theorem src-atom
    (internal ()
      (forall ((f (Arrow T T)) (cs Ts))
        (equal (srcForm f (node Bits (pair n1 cs))) (charsFixed f cs))))
    (by (reduce full src-is-fold src-kids src-fold-node tree-rules))
    (normal full tree-rules))
  ; The kernel's step of a fold into trees, the result of the rose tree's fold it translates to,
  ; that fold's step at a node n and the folds at the children cs; the step of the expansion of
  ; numeral abbreviations at the abbreviations nums, as bootstrap/reader.geb writes it; and the
  ; characters cs, each expanded.
  (abbreviation TStep (Arrow T (Arrow Ts T)))
  (abbreviation TFold (Arrow TStep T))
  (abbreviation t-fold-step
    (lam ((s TStep)) (s (node Bits (pair (fst n) (nil T))) (lib mapApp TStep T (snd n) s))))
  (abbreviation t-children
    (list-rec (nil TFold) (c r) (cons TFold (rose-rec TFold (n) t-fold-step c) r) cs))
  (abbreviation nums-step
    (lam ((l T) (rs (List T)))
      (let raw T (node l rs)
        (if (Reader.isAtom raw)
          (let v T (Reader.lookupAbbrev (Reader.nameOf raw) nums)
            (if (Prelude.isSome v) (Prelude.get v) raw))
          raw))))
  (abbreviation expanded-chars (list-rec (nil T) (c r) (cons T (Reader.expandNums nums c) r) cs))
  ; The map of the children's folds applied to the step of the expansion of numeral abbreviations is
  ; the list of the expanded children; and the expansion at an atom is the abbreviation of the
  ; atom's name over the expanded characters, where it has one, and the atom over them otherwise.
  (theorem nums-children
    (internal ()
      (forall ((nums Ts) (cs Ts))
        (equal (lib mapApp TStep T t-children (kernel nums-step)) expanded-chars)))
    (by
      (with-rules
        (lambek unfold-rebuild map-id
          (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
            Reader.resolveAtom
            Reader.resolveList
            Typing.synAtom
            Typing.synList
            Datatype.expandCase
            Datatype.expandCata
            Datatype.expandExpr
            Typing.synCase
            Typing.synCata
            Typing.synIn
            Datatype.eraseCase
            Datatype.eraseCata
            Datatype.eraseExpr
            Reader.resolve
            Reader.lookupAbbrev
            Reader.indexOf
            Reader.numeral
            Typing.lookupName
            Typing.hasName
            srcForm
            charsFixed
            Typing.keywordTx
            Typing.boundNames
            Reader.primNames
            Reader.reservedNames
            Typing.memberOf
            Typing.nameOk))
        by-list-induction))
    (normal full tree-rules))
  (theorem nums-atom
    (internal ()
      (forall ((nums Ts) (cs Ts))
        (equal (Reader.expandNums nums (node Bits (pair n1 cs)))
          (lib cond T
            (lib lab
              (Prelude.isSome (Reader.lookupAbbrev (node Bits (pair n0 expanded-chars)) nums)))
            (Prelude.get (Reader.lookupAbbrev (node Bits (pair n0 expanded-chars)) nums))
            (node Bits (pair n1 expanded-chars))))))
    (by
      (with-rules
        (nums-children lambek unfold-rebuild map-id
          (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
            Reader.resolveAtom
            Reader.resolveList
            Typing.synAtom
            Typing.synList
            Datatype.expandCase
            Datatype.expandCata
            Datatype.expandExpr
            Typing.synCase
            Typing.synCata
            Typing.synIn
            Datatype.eraseCase
            Datatype.eraseCata
            Datatype.eraseExpr
            Reader.resolve
            Reader.lookupAbbrev
            Reader.indexOf
            Reader.numeral
            Typing.lookupName
            Typing.hasName
            srcForm
            charsFixed
            Typing.keywordTx
            Typing.boundNames
            Reader.primNames
            Reader.reservedNames
            Typing.memberOf
            Typing.nameOk))
        (reduce full)))
    (normal full tree-rules))
  ; The expansion, the erasure and the typing at an atom, each a structural recursion whose step
  ; sees the node: the children the step is given are the atom's characters.
  (theorem expand-atom
    (internal ()
      (forall ((ds Ts) (cs Ts))
        (equal (Datatype.expandExpr ds (node Bits (pair n1 cs)))
          (Prelude.some (node Bits (pair n1 cs))))))
    (by
      (reduce full (para-children-first (Arrow Unit (Prod T (Arrow Ts T)))) lambek unfold-rebuild
        map-id
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.indexOf
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  (theorem erase-atom
    (internal ()
      (forall ((cs Ts))
        (equal (Datatype.eraseExpr (node Bits (pair n1 cs))) (node Bits (pair n1 cs)))))
    (by
      (reduce full (para-children-first (Arrow Unit T)) lambek unfold-rebuild map-id
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Typing.synIn
          Datatype.eraseCase
          Datatype.eraseCata
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.indexOf
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  (theorem syn-atom
    (internal ()
      (forall ((E Env) (cx Ts) (cs Ts))
        (equal (Typing.synIn E cx (node Bits (pair n1 cs))) (Typing.synAtom E cs cx))))
    (by
      (reduce full (para-children-first (Arrow Unit (Prod T (Arrow Ts T)))) lambek unfold-rebuild
        map-id
        (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
          Reader.resolveAtom
          Reader.resolveList
          Typing.synAtom
          Typing.synList
          Datatype.expandCase
          Datatype.expandCata
          Datatype.expandExpr
          Typing.synCase
          Typing.synCata
          Datatype.eraseCase
          Datatype.eraseCata
          Datatype.eraseExpr
          Reader.expandNums
          Reader.resolve
          Reader.lookupAbbrev
          Reader.indexOf
          Reader.numeral
          Typing.lookupName
          Typing.hasName
          srcForm
          charsFixed
          Typing.keywordTx
          Typing.boundNames
          Reader.primNames
          Reader.reservedNames
          Typing.memberOf
          Typing.nameOk)))
    (normal full tree-rules))
  ; The characters of an atom mapped by the expansion of numeral abbreviations, as the test of
  ; source forms maps them, are the expanded characters; and where that test holds of the
  ; characters, the expansion fixes them, by the soundness of the equality of trees.
  (theorem chars-map
    (internal ()
      (forall ((nums Ts) (cs Ts))
        (equal
          ((kernel
             (lam ((nums (List T)) (xs (List T)))
               (foldr T (List T) (lam ((c T) (a (List T))) (cons (Reader.expandNums nums c) a))
                 (nil T)
                 xs))) nums cs)
          expanded-chars)))
    (by (with-rules (tree-rules) by-list-induction))
    (normal full tree-rules))
  (theorem chars-fixed
    (internal ()
      (forall ((nums Ts) (cs Ts))
        (implies
          (lib cond Omega (lib lab (charsFixed (lam ((t T)) (Reader.expandNums nums t)) cs)) true
            false)
          (equal expanded-chars cs))))
    (by
      (with-rules (chars-map tree-rules)
        (assume h
          (reduce-hypothesis h h2 full
            (lambek unfold-rebuild map-id
              (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next
                Reader.resolveAtom
                Reader.resolveList
                Typing.synAtom
                Typing.synList
                Datatype.expandCase
                Datatype.expandCata
                Datatype.expandExpr
                Typing.synCase
                Typing.synCata
                Typing.synIn
                Datatype.eraseCase
                Datatype.eraseCata
                Datatype.eraseExpr
                Reader.expandNums
                Reader.resolve
                Reader.lookupAbbrev
                Reader.indexOf
                Reader.numeral
                Typing.lookupName
                Typing.hasName
                srcForm
                Typing.keywordTx
                Typing.boundNames
                Reader.primNames
                Reader.reservedNames
                Typing.memberOf
                Typing.nameOk))
            (obtain es equal-sound () ((node Bits (pair n0 expanded-chars)))
              (all-elim es (node Bits (pair n0 cs)) es1
                (imp-elim es1 (matches h2 full) heq
                  (congruence heq (g (z T) (lib children z))
                    (reduce-hypotheses full (g) (reduce full g))))))))))
    (normal full tree-rules))
  ; The rules of the lookups before the rules of the deductions.
  (abbreviation lookup-kit index-of-nil index-of-cons index-after-nil index-after-cons
    lookup-name-nil
    lookup-name-cons
    kit)
  ; A name that is not abbreviated and has a type in a named context has an index in the reader's
  ; scope of the context's names: by induction on the context. At a construction whose head's name
  ; is the name, the scope's head is the name; at any other, the hypothesis gives the rest's index.
  (theorem scope-has-name
    (internal ()
      (forall ((cx Ts))
        (all Ts
          (lam ((nums Ts))
            (all T
              (lam ((m T))
                (implies
                  (implies
                    (lib cond Omega (lib lab (Prelude.isSome (Reader.lookupAbbrev m nums))) true
                      false)
                    false)
                  (implies
                    (lib cond Omega (lib lab (Prelude.isSome (Typing.lookupName m cx))) true false)
                    (lib cond Omega
                      (lib lab
                        (Prelude.isSome
                          (Reader.indexOf m
                            (list-rec (nil T) (p r) (cons T (expName nums (first-of p)) r) cx))))
                      true
                      false)))))))))
    (by
      (with-rules (lookup-kit)
        (induction cx (q qs ih)
          (all-intro nums (all-intro m (assume gAb (assume ht (absurd ht full)))))
          (holds ih (ihf)
            (all-intro nums
              (all-intro m
                (assume gAb
                  (assume ht
                    (obtain dc0 list-cases (Bit) ((lib equal (first-of q) m))
                      (or-elim dc0 (dz1 du2)
                        (reduce-hypothesis dz1 df7 full ()
                          (all-elim ihf nums i1
                            (all-elim i1 m i2
                              (imp-elim i2 (hypothesis gAb) i3
                                (imp-elim i3 (matches ht full df7) i4
                                  (obtain dc9 list-cases (Bit)
                                    ((lib equal m (expName nums (first-of q))))
                                    (or-elim dc9 (dz10 du11)
                                      (reduce-hypothesis dz10 df16 full (df7)
                                        (obtain sc18 some-test-label ()
                                          ((Reader.indexOf m
                                             (list-rec (nil T) (p r)
                                               (cons T (expName nums (first-of p)) r)
                                               qs)))
                                          (or-elim sc18 (sz19 so20)
                                            (reduce-hypothesis sz19 sf21 full (df16 df7)
                                              (absurd i4 full sf21 df16 df7))
                                            (reduce-hypothesis so20 sh22 full (df16 df7)
                                              (reduce full sh22 df16 df7)))))
                                      (exists-elim du11 (db12 dv13)
                                        (exists-elim dv13 (ds14 dt15)
                                          (reduce-hypothesis dt15 dh17 full (df7)
                                            (reduce full dh17 df7)))))))))))
                        (exists-elim du2 (db3 dv4)
                          (exists-elim dv4 (ds5 dt6)
                            (reduce-hypothesis dt6 dh8 full ()
                              (obtain es equal-sound () ((first-of q))
                                (all-elim es m es1
                                  (imp-elim es1 (reduce full dh8) heq
                                    (obtain sc23 some-test-label () ((Reader.lookupAbbrev m nums))
                                      (or-elim sc23 (sz24 so25)
                                        (reduce-hypothesis sz24 sf26 full (dh8)
                                          (obtain rf equal-reflexive () (m)
                                            (obtain dc28 list-cases (Bit) ((lib equal m m))
                                              (or-elim dc28 (dz29 du30)
                                                (reduce-hypothesis dz29 df35 full (sf26 dh8)
                                                  (absurd rf full df35 sf26 dh8))
                                                (exists-elim du30 (db31 dv32)
                                                  (exists-elim dv32 (ds33 dt34)
                                                    (reduce-hypothesis dt34 dh36 full (sf26 dh8)
                                                      (reduce-hypothesis heq rw37 full
                                                        (dh36 sf26 dh8)
                                                        (reduce full rw37 dh36 sf26 dh8)))))))))
                                        (reduce-hypothesis so25 sh27 full (dh8)
                                          (imp-elim gAb (reduce full sh27 dh8) hf
                                            (false-elim (hypothesis hf))))))))))))))))))))))
    (normal full kit))
  ; A name that is neither a numeral nor abbreviated and has an index in the reader's scope of a
  ; named context's names has in the context the type of the entry at that index, whose name it is:
  ; by induction on the context. Where the scope's head is the name, the head is not abbreviated, an
  ; abbreviated head's name in the scope being a numeral's, and the entry is the first; elsewhere
  ; the head's name is not the name, and the hypothesis gives the rest's entry.
  (theorem scope-entry
    (internal ()
      (forall ((cx Ts))
        (all Env
          (lam ((E Env))
            (all Ts
              (lam ((nums Ts))
                (all T
                  (lam ((m T))
                    (implies (numerals-coherent E nums)
                      (implies
                        (implies
                          (lib cond Omega
                            (lib lab (Prelude.isSome (Reader.numeral (lib children m))))
                            true
                            false)
                          false)
                        (implies
                          (implies
                            (lib cond Omega (lib lab (Prelude.isSome (Reader.lookupAbbrev m nums)))
                              true
                              false)
                            false)
                          (implies
                            (lib cond Omega
                              (lib lab
                                (Prelude.isSome
                                  (Reader.indexOf m
                                    (list-rec (nil T) (p r) (cons T (expName nums (first-of p)) r)
                                      cx))))
                              true
                              false)
                            (and
                              (equal (Typing.lookupName m cx)
                                (Prelude.some
                                  (second-of
                                    (Prelude.get
                                      (Prelude.nth cx
                                        (node Bits
                                          (pair
                                            (lib lab
                                              (Prelude.get
                                                (Reader.indexOf m
                                                  (list-rec (nil T) (p r)
                                                    (cons T (expName nums (first-of p)) r)
                                                    cx))))
                                            (nil T))))))))
                              (and
                                (lib cond Omega
                                  (lib lab
                                    (Prelude.isSome
                                      (Prelude.nth cx
                                        (node Bits
                                          (pair
                                            (lib lab
                                              (Prelude.get
                                                (Reader.indexOf m
                                                  (list-rec (nil T) (p r)
                                                    (cons T (expName nums (first-of p)) r)
                                                    cx))))
                                            (nil T))))))
                                  true
                                  false)
                                (equal
                                  (first-of
                                    (Prelude.get
                                      (Prelude.nth cx
                                        (node Bits
                                          (pair
                                            (lib lab
                                              (Prelude.get
                                                (Reader.indexOf m
                                                  (list-rec (nil T) (p r)
                                                    (cons T (expName nums (first-of p)) r)
                                                    cx))))
                                            (nil T))))))
                                  m)))))))))))))))
    (by
      (with-rules (lookup-kit)
        (induction cx (q qs ih)
          (all-intro E
            (all-intro nums
              (all-intro m (assume hN (assume gNum (assume gAb (assume hI (absurd hI full))))))))
          (holds ih (ihf)
            (all-intro E
              (all-intro nums
                (all-intro m
                  (assume hN
                    (assume gNum
                      (assume gAb
                        (assume hI
                          (obtain dc38 list-cases (Bit) ((lib equal m (expName nums (first-of q))))
                            (or-elim dc38 (dz39 du40)
                              (reduce-hypothesis dz39 df45 full ()
                                (obtain sc47 some-test-label ()
                                  ((Reader.indexOf m
                                     (list-rec (nil T) (p r) (cons T (expName nums (first-of p)) r)
                                       qs)))
                                  (or-elim sc47 (sz48 so49)
                                    (reduce-hypothesis sz48 sf50 full (df45)
                                      (absurd hI full sf50 df45))
                                    (reduce-hypothesis so49 sh51 full (df45)
                                      (obtain dc52 list-cases (Bit) ((lib equal (first-of q) m))
                                        (or-elim dc52 (dz53 du54)
                                          (reduce-hypothesis dz53 df59 full (sh51 df45)
                                            (all-elim ihf E j1
                                              (all-elim j1 nums j2
                                                (all-elim j2 m j3
                                                  (imp-elim j3 (hypothesis hN) j4
                                                    (imp-elim j4 (hypothesis gNum) j5
                                                      (imp-elim j5 (hypothesis gAb) j6
                                                        (imp-elim j6 (reduce full df59 sh51 df45) j7
                                                          (and-elim j7 (k1 k23)
                                                            (and-elim k23 (k2 k3)
                                                              (and-intro
                                                                (reduce-hypothesis k1 rw61 full
                                                                  (df59 sh51 df45)
                                                                  (reduce full rw61 df59 sh51 df45))
                                                                (and-intro
                                                                  (matches k2 full df59 sh51 df45)
                                                                  (matches k3 full df59 sh51
                                                                    df45)))))))))))))
                                          (exists-elim du54 (db55 dv56)
                                            (exists-elim dv56 (ds57 dt58)
                                              (reduce-hypothesis dt58 dh60 full (sh51 df45)
                                                (obtain es equal-sound () ((first-of q))
                                                  (all-elim es m es1
                                                    (imp-elim es1 (reduce full dh60 sh51 df45) heq
                                                      (obtain sc62 some-test-label ()
                                                        ((Reader.lookupAbbrev m nums))
                                                        (or-elim sc62 (sz63 so64)
                                                          (reduce-hypothesis sz63 sf65 full
                                                            (dh60 sh51 df45)
                                                            (reduce-hypothesis heq rw67 full
                                                              (sf65 dh60 sh51 df45)
                                                              (reduce-hypothesis df45 differs full
                                                                (rw67 sf65 dh60 sh51)
                                                                (obtain rf equal-reflexive () (m)
                                                                  (absurd rf full differs)))))
                                                          (reduce-hypothesis so64 sh66 full
                                                            (dh60 sh51 df45)
                                                            (imp-elim gAb
                                                              (reduce full sh66 dh60 sh51 df45)
                                                              hf
                                                              (false-elim
                                                                (hypothesis hf))))))))))))))))))
                              (exists-elim du40 (db41 dv42)
                                (exists-elim dv42 (ds43 dt44)
                                  (reduce-hypothesis dt44 dh46 full ()
                                    (obtain es equal-sound () (m)
                                      (all-elim es (expName nums (first-of q)) es1
                                        (imp-elim es1 (reduce full dh46) heq
                                          (obtain sc68 some-test-label ()
                                            ((Reader.lookupAbbrev (first-of q) nums))
                                            (or-elim sc68 (sz69 so70)
                                              (reduce-hypothesis sz69 sf71 full (dh46)
                                                (reduce-hypothesis heq rw73 full (sf71 dh46)
                                                  (obtain rf equal-reflexive () ((first-of q))
                                                    (obtain dc74 list-cases (Bit)
                                                      ((lib equal (first-of q) (first-of q)))
                                                      (or-elim dc74 (dz75 du76)
                                                        (reduce-hypothesis dz75 df81 full
                                                          (rw73 sf71 dh46)
                                                          (absurd rf full df81 rw73 sf71 dh46))
                                                        (exists-elim du76 (db77 dv78)
                                                          (exists-elim dv78 (ds79 dt80)
                                                            (reduce-hypothesis dt80 dh82 full
                                                              (rw73 sf71 dh46)
                                                              (and-intro
                                                                (reduce full dh82 rw73 sf71 dh46)
                                                                (and-intro
                                                                  (reduce full dh82 rw73 sf71 dh46)
                                                                  (reduce full dh82 rw73 sf71
                                                                    dh46)))))))))))
                                              (reduce-hypothesis so70 sh72 full (dh46)
                                                (unfold-hypothesis hN hN2
                                                  (all-elim hN2 (first-of q) hN3
                                                    (and-elim hN3 (a1 a2)
                                                      (imp-elim a2 (reduce full sh72 dh46) hh
                                                        (imp-elim a1 (hypothesis hh) hx
                                                          (exists-elim hx (dd hx2)
                                                            (and-elim hx2 (ea en)
                                                              (reduce-hypothesis ea rw83 full
                                                                (sh72 dh46)
                                                                (reduce-hypothesis heq rw84 full
                                                                  (rw83 sh72 dh46)
                                                                  (imp-elim gNum
                                                                    (matches en full rw84 rw83 sh72
                                                                      dh46)
                                                                    hf
                                                                    (false-elim
                                                                      (hypothesis
                                                                        hf))))))))))))))))))))))))))))))))))
    (normal full kit))
  ; Each primitive's constant is related at the primitive's type in the typing: the fundamental
  ; lemma's relation of it at the kernel's type, the two relations unfolded at the type to one
  ; formula.
  (theorem typed-prim-label
    (internal ()
      (forall ((R Ctx))
        ((typed-related R (Typing.tyArrow Typing.tyT Typing.tyT))
         (node Bits
           (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
             (cons T (node Bits (pair (lib bnil) (nil T))) (nil T)))))))
    (by
      (obtain rc related-prim-label () ((fst R))
        (with-rules ((unfold typed-related) kit) (matches rc full))))
    (normal full kit))
  (theorem typed-prim-arity
    (internal ()
      (forall ((R Ctx))
        ((typed-related R (Typing.tyArrow Typing.tyT Typing.tyT))
         (node Bits
           (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
             (cons T (node Bits (pair (lib b0 (lib bnil)) (nil T))) (nil T)))))))
    (by
      (obtain rc related-prim-arity () ((fst R))
        (with-rules ((unfold typed-related) kit) (matches rc full))))
    (normal full kit))
