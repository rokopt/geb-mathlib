;
; Theorems about a program in the Surface 1 forms, checked by bootstrap/metalogic/prove.geb,
; which expands the forms as the compiler does: a function by structural recursion over a
; declared datatype satisfies its recursion equations at the datatype's constructors.

; unary naturals, and addition by structural recursion on the first argument
(data Nat (zero) (succ Nat))
(defn plus ((m Nat) (n Nat)) Nat (cata Nat Nat m ((zero) n) ((succ r) (succ r))))

; the recursion equations of addition at zero and at a successor
(theorem plusZero ((n Nat)) (plus zero n) n
  (simp (unfold plus zero single) (rw labelNode childrenNode)))
(theorem plusSucc ((m Nat) (n Nat)) (plus (succ m) n) (succ (plus m n))
  (simp (unfold plus zero succ single) (rw labelNode childrenNode)))
