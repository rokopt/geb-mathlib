; The fundamental lemma of the evaluator written in Geb, about the program of
; normalization-base.proofs.geb: for all types of the globals, definitions, contexts and
; environments, if the definitions are related to the types and the environment to the context,
; a term that has some type in the context evaluates in the environment, from some level of fuel
; on, to one value, related at that type. By induction on the term, from the relations of the
; constants at their types, the lemmas of stability and of the lookups, the soundness of the
; equality of trees and the inversions of the type tests.

(proofs 6 (program normalization) (import normalization-rel.proofs.geb)
  ; The types of lists of trees, of the evaluation and the application at a level and of their
  ; pair, of predicates on values, of a value as a function of the environment and of a spine.
  (abbreviation Ts (List T))
  (abbreviation Ev (Arrow Ts (Arrow T T)))
  (abbreviation Ap (Arrow T (Arrow T T)))
  (abbreviation Fns (Prod Ev Ap))
  (abbreviation Pred (Arrow T Omega))
  (abbreviation EvE (Arrow Ts T))
  (abbreviation Sp (Prod T Ts))
  (abbreviation Ord (Sum Unit Bit))
  ; The numeral of the label of the type of trees.
  (abbreviation n0 (lib bnil))
  ; The rules of the first components of the library's folds of the successor, of addition, of
  ; the predecessor and of the case analysis of lists.
  (abbreviation rebuild-rules rebuild-succ-normal rebuild-add-normal rebuild-succ rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits))
  ; The rules of the base's vocabulary, the definitions it keeps folded last.
  (abbreviation vocabulary apply-closure nth-cons-succ add-one-folded cmp-succ-folded
    lt-zero-succ-folded
    (rebuild-tail-folded T)
    (iter-succ-folded Ts)
    eval-first
    check-first
    (para-first T)
    (para-first EvE)
    check-fold-node
    eval-fold-node
    equal-fold
    equal-node
    succ-not-0
    succ-not-1
    succ-not-2
    succ-not-3
    type-in-fold
    next-fst
    next-snd
    level-succ
    lambek
    unfold-rebuild
    map-id
    check-node-var
    check-node-lam
    check-node-app
    check-node-unit
    check-node-pair
    check-node-fst
    check-node-snd
    check-node-quote
    check-node-cond
    check-node-fold
    check-node-iter
    check-node-nil
    check-node-cons
    check-node-foldr
    check-node-prim
    check-node-ref
    check-node-lcase
    check-node-para
    eval-step-var
    eval-step-lam
    eval-step-app
    eval-step-unit
    eval-step-pair
    eval-step-fst
    eval-step-snd
    eval-step-quote
    eval-step-cond
    eval-step-fold
    eval-step-iter
    eval-step-nil
    eval-step-cons
    eval-step-foldr
    eval-step-prim
    eval-step-ref
    eval-step-lcase
    eval-step-para
    related-tree
    related-unit
    related-prod
    related-arrow
    related-list
    rebuild-succ-normal
    rebuild-add-normal
    rebuild-succ
    rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits)
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next))
  ; The rules of the deductions: the lemmas of addition before the vocabulary, the predicate of
  ; every element of a list unfolded, and the tail's rebuilding of lists of formulas.
  (abbreviation kit plus-zero plus-succ zero-plus succ-plus plus-assoc vocabulary (unfold all-of)
    (rebuild-tail-folded Omega))
  ; The fundamental lemma's formula at the term t: for all types of the globals, definitions,
  ; contexts and environments, if the definitions are related to the types, the environment to
  ; the context, and the term has some type in the context, then its evaluation in the
  ; environment converges to a value related at that type.
  (abbreviation fundamental-at
    (all Ts
      (lam ((GT Ts))
        (all Ts
          (lam ((D Ts))
            (all Ts
              (lam ((c Ts))
                (all Ts
                  (lam ((env Ts))
                    (implies (globals-related D GT)
                      (implies (env-related D c env)
                        (implies
                          (lib cond Omega (lib lab (Prelude.isSome (Check.typeIn GT c t))) true
                            false)
                          (converges (lam ((k Nat)) ((fst (level-at D k)) env t))
                            (related D (Prelude.get (Check.typeIn GT c t))))))))))))))))
  ; The rules of the deductions without the relation's equations at the nodes of the types,
  ; by which a relation at a type is compared with another and neither is unfolded.
  (abbreviation plain plus-zero plus-succ zero-plus succ-plus plus-assoc apply-closure nth-cons-succ
    add-one-folded
    cmp-succ-folded
    lt-zero-succ-folded
    (rebuild-tail-folded T)
    (iter-succ-folded Ts)
    eval-first
    check-first
    (para-first T)
    (para-first EvE)
    check-fold-node
    eval-fold-node
    equal-fold
    equal-node
    succ-not-0
    succ-not-1
    succ-not-2
    succ-not-3
    type-in-fold
    next-fst
    next-snd
    level-succ
    lambek
    unfold-rebuild
    map-id
    check-node-var
    check-node-lam
    check-node-app
    check-node-unit
    check-node-pair
    check-node-fst
    check-node-snd
    check-node-quote
    check-node-cond
    check-node-fold
    check-node-iter
    check-node-nil
    check-node-cons
    check-node-foldr
    check-node-prim
    check-node-ref
    check-node-lcase
    check-node-para
    eval-step-var
    eval-step-lam
    eval-step-app
    eval-step-unit
    eval-step-pair
    eval-step-fst
    eval-step-snd
    eval-step-quote
    eval-step-cond
    eval-step-fold
    eval-step-iter
    eval-step-nil
    eval-step-cons
    eval-step-foldr
    eval-step-prim
    eval-step-ref
    eval-step-lcase
    eval-step-para
    rebuild-succ-normal
    rebuild-add-normal
    rebuild-succ
    rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits)
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next)
    (unfold all-of)
    (rebuild-tail-folded Omega))
  ; The constant of the primitive of an index is related at the type the checker gives the
  ; index, where it gives one: by the case analysis of the index's bits, each index of a
  ; primitive by the primitive's relation, and any other refuting the type.
  (theorem prim-related
    (internal ()
      (forall ((x Bits))
        (all Ts
          (lam ((D Ts))
            (implies
              (lib cond Omega
                (lib lab
                  (Prelude.isSome (Prelude.nth Check.primTypes (node Bits (pair x (nil T))))))
                true
                false)
              ((related D (Prelude.get (Prelude.nth Check.primTypes (node Bits (pair x (nil T))))))
               (node Bits
                 (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                   (cons T (node Bits (pair x (nil T))) (nil T))))))))))
    (by
      (with-rules (kit)
        (bits-cases x 4 (reduced head (all-intro D (assume h (absurd h full)))) (0)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-label () (D) (with-rules (plain) (matches rc full))))))
          (1)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-arity () (D) (with-rules (plain) (matches rc full))))))
          (2)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-child () (D) (with-rules (plain) (matches rc full))))))
          (3)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-node () (D) (with-rules (plain) (matches rc full))))))
          (4)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-children () (D) (with-rules (plain) (matches rc full))))))
          (5)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-add () (D) (with-rules (plain) (matches rc full))))))
          (6)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-sub () (D) (with-rules (plain) (matches rc full))))))
          (7)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-mul () (D) (with-rules (plain) (matches rc full))))))
          (8)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-div () (D) (with-rules (plain) (matches rc full))))))
          (9)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-mod () (D) (with-rules (plain) (matches rc full))))))
          (10)
          (reduced head
            (all-intro D
              (assume h (obtain rc related-prim-eq () (D) (with-rules (plain) (matches rc full))))))
          (11)
          (reduced head
            (all-intro D
              (assume h (obtain rc related-prim-lt () (D) (with-rules (plain) (matches rc full))))))
          (12)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-equal () (D) (with-rules (plain) (matches rc full))))))
          (13)
          (reduced head
            (all-intro D
              (assume h
                (obtain rc related-prim-log2 () (D) (with-rules (plain) (matches rc full))))))))))
  ; The hypothesis of the induction on trees at a list of children, for the fundamental lemma, is
  ; the lemma's formula at every child.
  (theorem fundamental-all
    (internal ()
      (forall ((cs Ts))
        (implies
          (equal (list-rec (nil Omega) (t r) (cons Omega (equal fundamental-at true) r) cs)
            (list-rec (nil Omega) (t r) (cons Omega (equal unit unit) r) cs))
          (all-of (lam ((t T)) fundamental-at) cs))))
    (by
      (with-rules (kit)
        (induction cs (y ys ih) (assume h (reduce full))
          (holds ih (ihf)
            (assume h
              (congruence h (g1 (z (List Omega)) (lib headD Omega (equal unit unit) z))
                (reduce-hypotheses full (g1)
                  (holds g1 (g2)
                    (holds g2 (g3)
                      (congruence h (g4 (z (List Omega)) (lib tail Omega z))
                        (reduce-hypotheses full (g4)
                          (imp-elim ihf (matches g4 full) hall
                            (reduced full
                              (and-intro (matches g3 full) (matches hall full))))))))))))))))
  ; The fundamental lemma: by induction on the term. At a node the label's bits decide the
  ; checker's case and the evaluator's step, a label of no term refuting the typing; the children
  ; are split to the label's number, each other number refuting the typing; the tests of the
  ; checker's case are decided by their values, each failure refuting the typing, and the types
  ; they test inverted; and the value converges by the children's hypotheses, the thresholds'
  ; sum its threshold.
  (theorem fundamental (internal () (forall ((t T)) fundamental-at))
    (by
      (with-rules (kit)
        (tree-induction t (l cs ih)
          (obtain rall fundamental-all () (cs)
            (imp-elim rall (hypothesis ih) hall
              (bits-cases l 5
                (reduced head
                  (all-intro GT
                    (all-intro D
                      (all-intro c
                        (all-intro env
                          (assume hG
                            (assume hE
                              (assume hT
                                (absurd hT full
                                  (folded (lib equal) Check.typeIn Eval.evStep Eval.apStep
                                    Eval.next))))))))))
                (8)
                (reduced head
                  (all-intro GT
                    (all-intro D
                      (all-intro c
                        (all-intro env
                          (assume hG
                            (assume hE
                              (assume hT
                                (obtain kc0 list-cases (T) (cs)
                                  (or-elim kc0 (k00 k01)
                                    (reduce-hypotheses full (k00)
                                      (with-rules (k00 kit) (absurd hT full)))
                                    (exists-elim k01 (a k02)
                                      (exists-elim k02 (cs1 k03)
                                        (reduce-hypotheses full (k03)
                                          (with-rules (k03 kit)
                                            (obtain kc1 list-cases (T) (cs1)
                                              (or-elim kc1 (k10 k11)
                                                (reduce-hypotheses full (k10)
                                                  (with-rules (k03 k10 kit)
                                                    (unfold-hypothesis hE hE2
                                                      (all-elim hE2
                                                        (node Bits (pair (lib lab a) (nil T)))
                                                        x1
                                                        (imp-elim x1 (matches hT full) x2
                                                          (exists-elim x2 (w x3)
                                                            (and-elim x3 (ew rw)
                                                              (reduce-hypothesis ew ew2 full ()
                                                                (unfold-formula
                                                                  (exists-intro (succ zero)
                                                                    (exists-intro w
                                                                      (and-intro
                                                                        (all-intro k
                                                                          (reduce full ew2))
                                                                        (matches rw
                                                                          full)))))))))))))
                                                (exists-elim k11 (further k12)
                                                  (exists-elim k12 (cs2 k13)
                                                    (reduce-hypotheses full (k13)
                                                      (with-rules (k03 k13 kit)
                                                        (absurd hT full)))))))))))))))))))))
                (9)
                (reduced head
                  (all-intro GT
                    (all-intro D
                      (all-intro c
                        (all-intro env
                          (assume hG
                            (assume hE
                              (assume hT
                                (obtain kc0 list-cases (T) (cs)
                                  (or-elim kc0 (k00 k01)
                                    (reduce-hypotheses full (k00)
                                      (with-rules (k00 kit) (absurd hT full)))
                                    (exists-elim k01 (a k02)
                                      (exists-elim k02 (cs1 k03)
                                        (reduce-hypotheses full (k03)
                                          (with-rules (k03 kit)
                                            (obtain kc1 list-cases (T) (cs1)
                                              (or-elim kc1 (k10 k11)
                                                (reduce-hypotheses full (k10)
                                                  (with-rules (k03 k10 kit) (absurd hT full)))
                                                (exists-elim k11 (b k12)
                                                  (exists-elim k12 (cs2 k13)
                                                    (reduce-hypotheses full (k13)
                                                      (with-rules (k03 k13 kit)
                                                        (obtain kc2 list-cases (T) (cs2)
                                                          (or-elim kc2 (k20 k21)
                                                            (reduce-hypotheses full (k20)
                                                              (with-rules (k03 k13 k20 kit)
                                                                (obtain tyc list-cases (Bit)
                                                                  ((lib lab (Check.isTy a)))
                                                                  (or-elim tyc (ty0 ty1)
                                                                    (reduce-hypotheses full (ty0)
                                                                      (with-rules
                                                                        (k03 k13 k20 ty0 kit)
                                                                        (absurd hT full)))
                                                                    (exists-elim ty1 (tyb ty2)
                                                                      (exists-elim ty2 (tys ty3)
                                                                        (reduce-hypotheses full
                                                                          (ty3)
