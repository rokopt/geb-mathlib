                                                                                                                                        full))))))))))))))))))))))))))))))))))))))
                                                            (exists-elim k21 (further k22)
                                                              (exists-elim k22 (cs3 k23)
                                                                (reduce-hypotheses full (k23)
                                                                  (with-rules (k03 k13 k23 kit)
                                                                    (absurd hT
                                                                      full)))))))))))))))))))))))))))
                (10)
                (reduced head
                  (all-intro GT
                    (all-intro D
                      (all-intro c
                        (all-intro env
                          (assume hG
                            (assume hE
                              (assume hT
                                (obtain kc0 list-cases (T) (cs)
                                  (or-elim kc0 (k00 k01)
                                    (reduce-hypotheses full (k00)
                                      (with-rules (k00 kit) (absurd hT full)))
                                    (exists-elim k01 (a k02)
                                      (exists-elim k02 (cs1 k03)
                                        (reduce-hypotheses full (k03)
                                          (with-rules (k03 kit)
                                            (obtain kc1 list-cases (T) (cs1)
                                              (or-elim kc1 (k10 k11)
                                                (reduce-hypotheses full (k10)
                                                  (with-rules (k03 k10 kit) (absurd hT full)))
                                                (exists-elim k11 (b k12)
