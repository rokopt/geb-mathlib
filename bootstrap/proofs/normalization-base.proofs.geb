              (let l T (label nd)
                (let n T (arity nd)
                  (with-r0
                    (with-r1
                      (with-r2
                        (if (Prelude.and (eq l 9) (eq n 2))
                          (Prelude.some (Eval.valClo env (child nd 0) (child nd 1)))
                          Prelude.none)))))))))))
    (by (reduce weak))
    (normal full kept))
