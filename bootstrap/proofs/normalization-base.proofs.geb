                          (Eval.bindO (r0 env)
                            (lam ((vf T)) (Eval.bindO (r1 env) (lam ((vx T)) ((snd p) vf vx)))))
                          Prelude.none)))))))))))
    (by (reduce weak))
    (normal full kept))
