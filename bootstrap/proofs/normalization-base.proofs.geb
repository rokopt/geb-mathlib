                          (Eval.bindO (r0 env)
                            (lam ((vc T))
                              (Eval.bindO (Eval.unquote vc)
                                (lam ((t T)) (if (eq (label t) 0) (r2 env) (r1 env))))))
                          Prelude.none)))))))))))
