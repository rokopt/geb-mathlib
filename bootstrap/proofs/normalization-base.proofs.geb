  ; The evaluator's step at a node of each label of the kernel's terms, as bootstrap/eval.geb
  ; writes it.
  (theorem eval-step-var
    (internal ()
      (forall ((G Ts) (p Fns) (cs Ts) (rs (List EvE)) (env Ts))
        (equal (Eval.evStep G p (node Bits (pair (lib b1 (lib b0 (lib b0 (lib bnil)))) cs)) rs env)
          (kernel
            (let nd T (node 8 cs)
              (let l T (label nd)
                (let n T (arity nd)
                  (with-r0
                    (with-r1
                      (with-r2
                        (if (Prelude.and (eq l 8) (eq n 1)) (Prelude.nth env (label (child nd 0)))
                          Prelude.none)))))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem eval-step-lam
    (internal ()
      (forall ((G Ts) (p Fns) (cs Ts) (rs (List EvE)) (env Ts))
