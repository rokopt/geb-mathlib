; The base of the fundamental lemma of the evaluator written in Geb, about the translation of the
; prelude, the reader, the type checker, the traversal of kernel terms and the evaluator: the
; definitions the lemma states and the development it rests on. The definitions are the addition
; and the fuel of a natural number, the stable convergence of a function of the fuel, the relation
; at a type by the fold of the type into the predicates on values, the relations of an environment
; to a context and of a program's definitions to the types of its globals, the evaluator's
; functions at a level of fuel, and the folds of the type checker and of the evaluator, which
; their sources do not name. The development proves a vocabulary of equations, each used as a
; rewriting rule by its companion in normal form with the vocabulary kept folded: the folds at
; nodes and their rebuilding of trees, the checker's case and the evaluator's step at each label,
; and the relation at each type former; and from them the lemmas of stability, of the lookups in
; an extended environment, the soundness of the equality of trees, the inversions of the type
; tests, and the two labels of the test that an optional tree is some.

(proofs 6 (program normalization) (import weakening-lemmas.proofs.geb)
  ; The types of lists of trees, of the evaluation and the application at a level and of their
  ; pair, of predicates on values and of the relation as a function of the definitions.
  (abbreviation Ts (List T))
  (abbreviation Ev (Arrow Ts (Arrow T T)))
  (abbreviation Ap (Arrow T (Arrow T T)))
  (abbreviation Fns (Prod Ev Ap))
  (abbreviation Pred (Arrow T Omega))
  (abbreviation Rel (Arrow Ts Pred))
  ; The type checker's result at a node, the kernel's step of a fold into such results, and the
  ; result of the rose tree's fold that the kernel's fold translates to, a function of the step.
  (abbreviation RR (Prod T (Arrow Ts T)))
  (abbreviation RRStep (Arrow T (Arrow (List RR) RR)))
  (abbreviation RRFold (Arrow RRStep RR))
  ; The evaluator's value as a function of the environment, the kernel's step of the fold whose
  ; step sees the node, the result of the rose tree's fold that it translates to, the pair of the
  ; node rebuilt and the value, and that fold's type, of functions of the step.
  (abbreviation EvE (Arrow Ts T))
  (abbreviation EStep (Arrow T (Arrow (List EvE) EvE)))
  (abbreviation RE (Prod T EvE))
  (abbreviation REFold (Arrow EStep RE))
  ; The numerals of the labels of the types: of trees, the unit, products, functions and lists.
  (abbreviation n0 (lib bnil))
  (abbreviation n1 (lib b0 (lib bnil)))
  (abbreviation n2 (lib b1 (lib bnil)))
  (abbreviation n3 (lib b0 (lib b0 (lib bnil))))
  (abbreviation n4 (lib b1 (lib b0 (lib bnil))))
  ; The step of the rose tree's fold into the type checker's results at a node n: the kernel's
  ; step at the label and at the children's folds applied to it.
  (abbreviation rr-fold-step
    (lam ((f RRStep)) (f (node Bits (pair (fst n) (nil T))) (lib mapApp RRStep RR (snd n) f))))
  ; The step of the rose tree's fold that the evaluator's fold translates to, at a node n and a
  ; kernel's step f: the node rebuilt from the first components of the children's folds applied
  ; to the step, and the step at that node and at their second components.
  (abbreviation pe-kids (list-rec (nil T) (c r) (cons T (fst c) r) (lib mapApp EStep RE (snd n) f)))
  (abbreviation pe-values
    (list-rec (nil EvE) (c r) (cons EvE (snd c) r) (lib mapApp EStep RE (snd n) f)))
  (abbreviation pe-fold-step
    (lam ((f EStep))
      (pair (node Bits (pair (fst n) pe-kids)) (f (node Bits (pair (fst n) pe-kids)) pe-values))))
  ; The type checker's step at the types GT of the globals, as bootstrap/check.geb writes it,
  ; where no definition names it.
  (abbreviation check-step
    (lam ((l T) (rs (List RR)))
      (let raw T (node l (Reader.rrTrees rs))
        (pair raw (lam ((ctx (List T))) (Check.checkNode GT raw rs ctx))))))
  ; The relations at the first two children of a type's node n, of the pair of its label and the
  ; list of its children's relations; the relation that holds of nothing where a child is absent.
  (abbreviation rel-false (lam ((d Ts) (x T)) false))
  (abbreviation rel-kids (list-rec (pair rel-false rel-false) (y r) (pair y (fst r)) (snd n)))
  ; Addition, by recursion on the second summand into functions of the first.
  (definition plus ((m Nat) (n Nat)) Nat
    ((nat-rec (lam ((a Nat)) a) (r) (lam ((a Nat)) (succ (r a))) n) m))
  ; The fuel of a natural number: the leaf whose label is its bitstring.
  (definition fuel ((k Nat)) T (node Bits (pair (nat-rec (lib bnil) (r) (lib succ r) k) (nil T))))
  ; Convergence: from some fuel on, the function's value is one value the predicate holds of.
  (definition converges ((F (Arrow Nat T)) (Pr Pred)) Omega
    (exists Nat
      (lam ((n Nat))
        (exists T
          (lam ((w T))
            (and (all Nat (lam ((k Nat)) (equal (F (plus n k)) (Prelude.some w)))) (Pr w)))))))
  ; Every element of a list satisfies a predicate.
  (definition all-of ((Pr Pred) (xs Ts)) Omega
    ((list-rec (lam ((p Pred)) true) (y r) (lam ((p Pred)) (and (p y) (r p))) xs) Pr))
  ; The evaluator's functions at a level, by the fold of the level from the level zero.
  (definition level-at ((D Ts) (k Nat)) Fns
    ((nat-rec (lam ((d Ts)) (Eval.level d (node Bits (pair (lib bnil) (nil T))))) (r)
       (lam ((d Ts)) (Eval.next d (r d)))
       k) D))
  ; The relation at a type, a predicate on values, with the program's definitions: by the fold of
  ; the type, at the types of trees, the unit, products, functions and lists.
  (definition related ((D Ts) (A T)) Pred
    ((rose-rec Rel (n)
       (lam ((d Ts) (x T))
         (lib cond Omega (lib eqB (fst n) n0) (exists T (lam ((t T)) (equal x (Eval.valQuote t))))
           (lib cond Omega (lib eqB (fst n) n1) (equal x Eval.valUnit)
             (lib cond Omega (lib eqB (fst n) n2)
               (exists T
                 (lam ((a T))
                   (exists T
                     (lam ((b T))
                       (and (equal x (Eval.valPair a b))
                         (and ((fst rel-kids) d a) ((snd rel-kids) d b)))))))
               (lib cond Omega (lib eqB (fst n) n3)
                 (all T
                   (lam ((a T))
                     (implies ((fst rel-kids) d a)
                       (converges (lam ((k Nat)) ((snd (level-at d k)) x a))
                         (lam ((w T)) ((snd rel-kids) d w))))))
                 (lib cond Omega (lib eqB (fst n) n4)
                   (and (lib cond Omega (lib lab (Prelude.isSome (Eval.listOf x))) true false)
                     (all-of (lam ((a T)) ((fst rel-kids) d a))
                       (lib children (Prelude.get (Eval.listOf x)))))
                   false))))))
       A) D))
  ; The relation of an environment to a context: at each index where the context has some type,
  ; the environment has some value related at the type.
  (definition env-related ((D Ts) (c Ts) (env Ts)) Omega
    (all T
      (lam ((i T))
        (implies (lib cond Omega (lib lab (Prelude.isSome (Prelude.nth c i))) true false)
          (exists T
            (lam ((w T))
              (and (equal (Prelude.nth env i) (Prelude.some w))
                ((related D (Prelude.get (Prelude.nth c i))) w))))))))
  ; The relation of the definitions to the types of the globals: at each index where a global's
  ; type is some type, a definition is some term, whose evaluation in the empty environment
  ; converges to a value related at the type.
  (definition globals-related ((D Ts) (GT Ts)) Omega
    (all T
      (lam ((i T))
        (implies (lib cond Omega (lib lab (Prelude.isSome (Prelude.nth GT i))) true false)
          (exists T
            (lam ((d T))
              (and (equal (Prelude.nth D i) (Prelude.some d))
                (converges (lam ((k Nat)) ((fst (level-at D k)) (nil T) d))
                  (related D (Prelude.get (Prelude.nth GT i)))))))))))
  ; The type checker's fold at a tree, at the globals' types: the pair of the tree rebuilt and its
  ; type as a function of the context.
  (definition check-fold ((GT Ts) (x T)) RR (kernel (fold RR check-step x)))
  ; The evaluator's fold at a tree, at the definitions and the functions of the level below: the
  ; pair of the tree rebuilt and its value as a function of the environment.
  (definition eval-fold ((D Ts) (p Fns) (x T)) RE
    ((rose-rec REFold (n) pe-fold-step x) (Eval.evStep D p)))
  ; Zero is a right unit, and the sum at a successor on the right is the successor of the sum.
  (theorem plus-zero (internal () (forall ((n Nat)) (equal (plus n zero) n)))
    (by (reduce full (unfold plus))))
  (theorem plus-succ
    (internal () (forall ((m Nat) (n Nat)) (equal (plus m (succ n)) (succ (plus m n)))))
    (by (reduce full (unfold plus))))
  ; Zero is a left unit, and the sum at a successor on the left is the successor of the sum, by
  ; induction on the second summand.
  (theorem zero-plus (internal () (forall ((n Nat)) (equal (plus zero n) n)))
    (by (nat-induction n 4096 (unfold plus))))
  (theorem succ-plus
    (internal () (forall ((m Nat) (n Nat)) (equal (plus (succ m) n) (succ (plus m n)))))
    (by (nat-induction n 4096 (unfold plus))))
  ; Addition is associative, by induction on the last summand, and commutative, by induction on
  ; the second with the two lemmas before.
  (theorem plus-assoc
    (internal () (forall ((k Nat) (m Nat) (n Nat)) (equal (plus (plus k m) n) (plus k (plus m n)))))
    (by (nat-induction n 4096 (unfold plus))))
  (theorem plus-comm (internal () (forall ((m Nat) (n Nat)) (equal (plus m n) (plus n m))))
    (by (nat-induction n 4096 zero-plus succ-plus (unfold plus))))
  ; Stability: from a threshold on, a function of the fuel has one value. It holds from a later
  ; threshold, the sum with a number on the right or on the left.
  (theorem stable-right
    (internal ()
      (forall ((F (Arrow Nat T)) (w T) (n Nat) (j Nat))
        (assuming (h (all Nat (lam ((k Nat)) (equal (F (plus n k)) (Prelude.some w)))))
          (all Nat (lam ((k Nat)) (equal (F (plus (plus n j) k)) (Prelude.some w)))))))
    (by (all-intro k (all-elim h (plus j k) hk (reduce full hk plus-assoc)))))
  (theorem stable-left
    (internal ()
      (forall ((F (Arrow Nat T)) (w T) (n Nat) (j Nat))
        (assuming (h (all Nat (lam ((k Nat)) (equal (F (plus n k)) (Prelude.some w)))))
          (all Nat (lam ((k Nat)) (equal (F (plus (plus j n) k)) (Prelude.some w)))))))
    (by
      (all-intro k
        (all-elim h (plus j k) hk
          (obtain c plus-comm () (j n)
            (with-rules (c) (reduced full (reduce full hk plus-assoc))))))))
  ; A list is empty or a construction; a tree is a node; a bit is zero or one.
  (theorem list-cases
    (internal (X)
      (forall ((xs (List X)))
        (or (equal xs (nil X))
          (exists X
            (lam ((y X)) (exists (List X) (lam ((ys (List X))) (equal xs (cons X y ys)))))))))
    (by
      (induction xs (h t ih) (or-left (reduce weak))
        (or-right (exists-intro h (exists-intro t (reduce weak)))))))
  (theorem tree-node
    (internal ()
      (forall ((t T))
        (exists Bits
          (lam ((l Bits))
            (exists (List T) (lam ((cs (List T))) (equal t (node Bits (pair l cs)))))))))
    (by (tree-induction t (l cs ih) (exists-intro l (exists-intro cs (reduce weak))))))
  (theorem bit-cases
    (internal ()
      (forall ((b Bit)) (or (equal b (inl Unit Unit unit)) (equal b (inr Unit Unit unit)))))
    (by
      (sum-cases b (u) (reduced head (or-left (reduce weak)))
        (reduced head (or-right (reduce weak))))))
  ; The type of comparisons, and the rules of the first components of the library's folds of the
  ; successor, of addition, of the predecessor and of the case analysis of lists.
  (abbreviation Ord (Sum Unit Bit))
  (abbreviation rebuild-rules rebuild-succ-normal rebuild-add-normal rebuild-succ rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits))
  ; The successors of a bitstring differ from the numerals below their number, by the case
  ; analysis of the bitstring and of its first bit, each with the inequalities before.
  (theorem succ-not-0 (internal () (forall ((x Bits)) (equal (lib eqB (lib succ x) n0) (lib bnil))))
    (by
      (cases x (b bs) (reduce full rebuild-rules)
        (sum-cases b (u) (reduce full rebuild-rules) (reduce full rebuild-rules))))
    (normal full (folded (lib equal))))
  (theorem succ-not-1
    (internal () (forall ((x Bits)) (equal (lib eqB (lib succ (lib succ x)) n1) (lib bnil))))
    (by
      (cases x (b bs) (reduce full succ-not-0 rebuild-rules)
        (sum-cases b (u) (reduce full succ-not-0 rebuild-rules)
          (reduce full succ-not-0 rebuild-rules))))
    (normal full (folded (lib equal))))
  (theorem succ-not-2
    (internal ()
      (forall ((x Bits)) (equal (lib eqB (lib succ (lib succ (lib succ x))) n2) (lib bnil))))
    (by
      (cases x (b bs) (reduce full succ-not-0 succ-not-1 rebuild-rules)
        (sum-cases b (u) (reduce full succ-not-0 succ-not-1 rebuild-rules)
          (reduce full succ-not-0 succ-not-1 rebuild-rules))))
    (normal full (folded (lib equal))))
  (theorem succ-not-3
    (internal ()
      (forall ((x Bits))
        (equal (lib eqB (lib succ (lib succ (lib succ (lib succ x)))) n3) (lib bnil))))
    (by
      (cases x (b bs) (reduce full succ-not-0 succ-not-1 succ-not-2 rebuild-rules)
        (sum-cases b (u) (reduce full succ-not-0 succ-not-1 succ-not-2 rebuild-rules)
          (reduce full succ-not-0 succ-not-1 succ-not-2 rebuild-rules))))
    (normal full (folded (lib equal))))
  ; The values of the first three children among the values rs, as the evaluator's step binds them.
  (abbreviation with-r0 let r0 EvE
    (lcase EvE EvE rs (lam ((e (List T))) Prelude.none) (lam ((r EvE) (rest (List EvE))) r)))
  (abbreviation with-r1 let r1 EvE
    (lcase EvE EvE rs (lam ((e (List T))) Prelude.none)
      (lam ((r EvE) (rest (List EvE)))
        (lcase EvE EvE rest (lam ((e (List T))) Prelude.none)
          (lam ((r1 EvE) (rest1 (List EvE))) r1)))))
  (abbreviation with-r2 let r2 EvE
    (lcase EvE EvE rs (lam ((e (List T))) Prelude.none)
      (lam ((r EvE) (rest (List EvE)))
        (lcase EvE EvE rest (lam ((e (List T))) Prelude.none)
          (lam ((r1 EvE) (rest1 (List EvE)))
            (lcase EvE EvE rest1 (lam ((e (List T))) Prelude.none)
              (lam ((r2 EvE) (rest2 (List EvE))) r2)))))))
  ; The definitions the vocabulary keeps folded: the equality of trees, the type checker, its case
  ; at a node, the evaluator's step and application, and its functions at a level from those
  ; below.
  (abbreviation kept
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next))
  ; The step of the fold of the equality of trees at a node n, and the folds at the children cs.
  (abbreviation equal-step
    (lam ((y T)) (lib and (lib eqB (fst n) (lib lab y)) (lib allZip (snd n) (lib children y)))))
  (abbreviation equal-kids
    (list-rec (nil (Arrow T Bits)) (c r)
      (cons (Arrow T Bits) (rose-rec (Arrow T Bits) (n) equal-step c) r)
      cs))
  ; The fold of the equality of trees, applied, is the equality; and the equality at two nodes is
  ; the conjunction of the equality of their labels with the elementwise equality of their
  ; children.
  (theorem equal-fold
    (internal ()
      (forall ((a T) (b T)) (equal ((rose-rec (Arrow T Bits) (n) equal-step a) b) (lib equal a b))))
    (by (reduce full))
    (normal full kept))
  (theorem equal-node
    (internal ()
      (forall ((l Bits) (cs Ts) (m Bits) (ds Ts))
        (equal (lib equal (node Bits (pair l cs)) (node Bits (pair m ds)))
          (lib and (lib eqB l m) (lib allZip equal-kids ds)))))
    (by (reduce full unfold-rebuild lambek (folded (lib eqB) (lib allZip))))
    (normal full equal-fold kept))
  ; The checker's type of a term is the second component of its fold; the evaluation at a level
  ; is that of the evaluator's fold, and the application the step of application; and the
  ; functions at a successor level are those from the level below.
  (theorem type-in-fold
    (internal ()
      (forall ((G Ts) (ctx Ts) (t T)) (equal (Check.typeIn G ctx t) ((snd (check-fold G t)) ctx))))
    (by (reduce weak (unfold check-fold) (folded Check.checkNode)))
    (normal full kept))
  (theorem next-fst
    (internal ()
      (forall ((G Ts) (p Fns) (env Ts) (t T))
        (equal ((fst (Eval.next G p)) env t) ((snd (eval-fold G p t)) env))))
    (by (reduce full (unfold eval-fold) (folded Eval.evStep Eval.apStep)))
    (normal full kept))
  (theorem next-snd
    (internal ()
      (forall ((G Ts) (p Fns) (f T) (x T)) (equal ((snd (Eval.next G p)) f x) (Eval.apStep p f x))))
    (by (reduce weak (folded Eval.evStep Eval.apStep)))
    (normal full kept))
  (theorem level-succ
    (internal ()
      (forall ((D Ts) (k Nat)) (equal (level-at D (succ k)) (Eval.next D (level-at D k)))))
    (by (reduce weak (unfold level-at) (folded Eval.next)))
    (normal full kept))
  ; The checker's case at a node of each label of the kernel's terms, as bootstrap/check.geb
  ; writes it.
  (theorem check-node-var
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b0 (lib b0 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 8 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 1) (Prelude.nth ctx (label (Prelude.at es 0))) Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-lam
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b0 (lib b1 (lib b0 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 9 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 2)
                    (let A T (Prelude.at es 0)
                      (if (Check.isTy A)
                        (let b T (Reader.rrAt rs 1 (cons A ctx))
                          (if (Prelude.isSome b) (Prelude.some (Check.tyArrow A (Prelude.get b)))
                            Prelude.none))
                        Prelude.none))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-app
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b1 (lib b0 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 10 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 2)
                    (let f T (Reader.rrAt rs 0 ctx)
                      (let x T (Reader.rrAt rs 1 ctx)
                        (if (Reader.both f x)
                          (if (Check.isArrow (Prelude.get f))
                            (if (equal (Prelude.get x) (child (Prelude.get f) 0))
                              (Prelude.some (child (Prelude.get f) 1))
                              Prelude.none)
                            Prelude.none)
                          Prelude.none)))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-unit
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b0 (lib b0 (lib b1 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 11 cs)
              (let es (List T) (children raw)
                (let k T (arity raw) (if (eq k 0) (Prelude.some 1) Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-pair
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b0 (lib b1 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 12 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 2) (Reader.some2 2 (Reader.rrAt rs 0 ctx) (Reader.rrAt rs 1 ctx))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-fst
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b0 (lib b1 (lib b1 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 13 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 1)
                    (let p T (Reader.rrAt rs 0 ctx)
                      (if (Prelude.isSome p)
                        (if (Check.isProd (Prelude.get p)) (Prelude.some (child (Prelude.get p) 0))
                          Prelude.none)
                        Prelude.none))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-snd
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b1 (lib b1 (lib bnil)))) cs)) rs ctx)
          (kernel
            (let raw T (node 14 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 1)
                    (let p T (Reader.rrAt rs 0 ctx)
                      (if (Prelude.isSome p)
                        (if (Check.isProd (Prelude.get p)) (Prelude.some (child (Prelude.get p) 1))
                          Prelude.none)
                        Prelude.none))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-quote
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b0 (lib b0 (lib b0 (lib b0 (lib bnil))))) cs)) rs
            ctx)
          (kernel
            (let raw T (node 15 cs)
              (let es (List T) (children raw)
                (let k T (arity raw) (if (eq k 1) (Prelude.some 0) Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-cond
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b0 (lib b0 (lib b0 (lib bnil))))) cs)) rs
            ctx)
          (kernel
            (let raw T (node 16 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 3)
                    (let c T (Reader.rrAt rs 0 ctx)
                      (let a T (Reader.rrAt rs 1 ctx)
                        (let b T (Reader.rrAt rs 2 ctx)
                          (if (Reader.both c (Reader.both a b))
                            (if (equal (Prelude.get c) 0)
                              (if (equal (Prelude.get b) (Prelude.get a)) a Prelude.none)
                              Prelude.none)
                            Prelude.none))))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-fold
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b0 (lib b1 (lib b0 (lib b0 (lib bnil))))) cs)) rs
            ctx)
          (kernel
            (let raw T (node 17 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 1)
                    (if (Check.isTy (Prelude.at es 0))
                      (Prelude.some (Check.foldTy (Prelude.at es 0)))
                      Prelude.none)
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-iter
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) cs)) rs
            ctx)
          (kernel
            (let raw T (node 18 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 1)
                    (if (Check.isTy (Prelude.at es 0))
                      (Prelude.some (Check.iterTy (Prelude.at es 0)))
                      Prelude.none)
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-nil
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b0 (lib b0 (lib b1 (lib b0 (lib bnil))))) cs)) rs
            ctx)
          (kernel
            (let raw T (node 19 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 1)
                    (if (Check.isTy (Prelude.at es 0))
                      (Prelude.some (Check.tyList (Prelude.at es 0)))
                      Prelude.none)
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
  (theorem check-node-cons
    (internal ()
      (forall ((G Ts) (cs Ts) (rs (List RR)) (ctx Ts))
        (equal
          (Check.checkNode G (node Bits (pair (lib b1 (lib b0 (lib b1 (lib b0 (lib bnil))))) cs)) rs
            ctx)
          (kernel
            (let raw T (node 20 cs)
              (let es (List T) (children raw)
                (let k T (arity raw)
                  (if (eq k 2)
                    (let x T (Reader.rrAt rs 0 ctx)
                      (let xs T (Reader.rrAt rs 1 ctx)
                        (if (Reader.both x xs)
                          (if (Check.isListTy (Prelude.get xs))
                            (if (equal (Prelude.get x) (child (Prelude.get xs) 0))
                              (Prelude.some (Check.tyList (Prelude.get x)))
                              Prelude.none)
                            Prelude.none)
                          Prelude.none)))
                    Prelude.none))))))))
    (by (reduce weak))
    (normal full kept))
