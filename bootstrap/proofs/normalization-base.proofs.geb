                        (if
                          (Prelude.or
                            (Prelude.and (Prelude.or (eq l 17) (Prelude.or (eq l 25) (eq l 18)))
                              (eq n 1))
                            (Prelude.and (Prelude.or (eq l 21) (eq l 24)) (eq n 2)))
                          (Prelude.some nd)
                          Prelude.none)))))))))))
