  ; The relation at the node of each type: the quotations at the type of trees, the unit value at
  ; the unit type, the pairs of related values at a product, the values whose application to a
  ; related value converges to a related value at a function type, and the list values of
  ; related values at a list type.
  (theorem related-tree
    (internal ()
      (forall ((D Ts))
        (equal (related D (node Bits (pair n0 (nil T))))
          (lam ((x T)) (exists T (lam ((t T)) (equal x (Eval.valQuote t))))))))
    (by (reduce full (unfold related)))
    (normal full kept))
  (theorem related-unit
    (internal ()
      (forall ((D Ts))
        (equal (related D (node Bits (pair n1 (nil T)))) (lam ((x T)) (equal x Eval.valUnit)))))
    (by (reduce full (unfold related)))
    (normal full kept))
  (theorem related-prod
    (internal ()
      (forall ((D Ts) (A T) (B T))
        (equal (related D (node Bits (pair n2 (cons T A (cons T B (nil T))))))
          (lam ((x T))
            (exists T
              (lam ((a T))
                (exists T
                  (lam ((b T))
                    (and (equal x (Eval.valPair a b))
                      (and ((related D A) a) ((related D B) b)))))))))))
    (by (reduce full (unfold related)))
    (normal full kept))
  (theorem related-arrow
    (internal ()
      (forall ((D Ts) (A T) (B T))
        (equal (related D (node Bits (pair n3 (cons T A (cons T B (nil T))))))
          (lam ((x T))
            (all T
              (lam ((a T))
                (implies ((related D A) a)
                  (converges (lam ((k Nat)) ((snd (level-at D k)) x a))
                    (lam ((w T)) ((related D B) w))))))))))
    (by (reduce full (unfold related)))
    (normal full kept))
  (theorem related-list
    (internal ()
      (forall ((D Ts) (A T))
        (equal (related D (node Bits (pair n4 (cons T A (nil T)))))
          (lam ((x T))
            (and (lib cond Omega (lib lab (Prelude.isSome (Eval.listOf x))) true false)
              (all-of (lam ((a T)) ((related D A) a))
                (lib children (Prelude.get (Eval.listOf x)))))))))
    (by (reduce full (unfold related)))
    (normal full kept))
  ; The rules of the vocabulary so far, before the trees' unfoldings and the folds' first
  ; components.
  (abbreviation check-rules check-node-var check-node-lam check-node-app check-node-unit
    check-node-pair
    check-node-fst
    check-node-snd
    check-node-quote
    check-node-cond
    check-node-fold
    check-node-iter
    check-node-nil
    check-node-cons
    check-node-foldr
    check-node-prim
    check-node-ref
    check-node-lcase
    check-node-para)
  (abbreviation step-rules eval-step-var eval-step-lam eval-step-app eval-step-unit eval-step-pair
    eval-step-fst
    eval-step-snd
    eval-step-quote
    eval-step-cond
    eval-step-fold
    eval-step-iter
    eval-step-nil
    eval-step-cons
    eval-step-foldr
    eval-step-prim
    eval-step-ref
    eval-step-lcase
    eval-step-para)
  (abbreviation related-rules related-tree related-unit related-prod related-arrow related-list)
  (abbreviation v1 equal-fold equal-node succ-not-0 succ-not-1 succ-not-2 succ-not-3 type-in-fold
    next-fst
    next-snd
    level-succ
    lambek
    unfold-rebuild
    map-id
    check-rules
    step-rules
    related-rules
    rebuild-rules
    kept)
  ; The folds at the children cs as the fold at a node gives them to its step, unapplied, and the
  ; list of the folded folds at them, for the checker and for the evaluator.
  (abbreviation rr-children
    (list-rec (nil RRFold) (c r) (cons RRFold (rose-rec RRFold (n) rr-fold-step c) r) cs))
  (abbreviation check-folds
    ((list-rec (lam ((g Ts)) (nil RR)) (c r) (lam ((g Ts)) (cons RR (check-fold g c) (r g))) cs)
     GT))
  (abbreviation pe-children
    (list-rec (nil REFold) (c r) (cons REFold (rose-rec REFold (n) pe-fold-step c) r) cs))
  (abbreviation DP (Prod Ts Fns))
  (abbreviation eval-folds
    ((list-rec (lam ((dp DP)) (nil RE)) (c r)
       (lam ((dp DP)) (cons RE (eval-fold (fst dp) (snd dp) c) (r dp)))
       cs) (pair D p)))
  ; The map of the children's folds applied to the step is the list of the folded folds, by
  ; induction on the children; and each fold at a node is its step at the node's label and at
  ; that list.
  (theorem check-children-folds
    (internal ()
      (forall ((GT Ts) (cs Ts))
        (equal (lib mapApp RRStep RR rr-children (kernel check-step)) check-folds)))
    (by
      (with-rules (v1 (unfold check-fold))
        (induction cs (y ys ih) (reduce full) (reduce-hypotheses full (ih) (reduce full ih)))))
    (normal full v1))
  (theorem eval-children-folds
    (internal ()
      (forall ((D Ts) (p Fns) (cs Ts))
        (equal (lib mapApp EStep RE pe-children (Eval.evStep D p)) eval-folds)))
    (by
      (with-rules (v1 (unfold eval-fold))
        (induction cs (y ys ih) (reduce full) (reduce-hypotheses full (ih) (reduce full ih)))))
    (normal full v1))
  (theorem check-fold-node
    (internal ()
      (forall ((GT Ts) (l Bits) (cs Ts))
        (equal (check-fold GT (node Bits (pair l cs)))
          ((kernel check-step) (node Bits (pair l (nil T))) check-folds))))
    (by (with-rules (check-children-folds v1 (unfold check-fold)) (reduce full)))
    (normal full check-children-folds v1))
  (theorem eval-fold-node
    (internal ()
      (forall ((D Ts) (p Fns) (l Bits) (cs Ts))
        (equal (eval-fold D p (node Bits (pair l cs)))
          (pair (node Bits (pair l (list-rec (nil T) (c r) (cons T (fst c) r) eval-folds)))
            (Eval.evStep D p
              (node Bits (pair l (list-rec (nil T) (c r) (cons T (fst c) r) eval-folds)))
              (list-rec (nil EvE) (c r) (cons EvE (snd c) r) eval-folds))))))
    (by (with-rules (eval-children-folds v1 (unfold eval-fold)) (reduce full)))
    (normal full eval-children-folds v1))
  ; The first component of the checker's fold at a tree is the tree: the trees of the folded
  ; folds at the children are the applications of the first components as functions of the
  ; globals' types, by induction on the children, and the first component is the identity as a
  ; function of those types by the uniqueness of the tree's fold.
  (abbreviation v2 check-fold-node eval-fold-node v1)
  (abbreviation by-list-induction
    (induction cs (y ys ih) (reduce full) (reduce-hypotheses full (ih) (reduce full ih))))
  (theorem map-app-constant
    (internal (X)
      (forall ((v X) (cs Ts))
        (equal
          (lib mapApp X T (list-rec (nil (Arrow X T)) (c r) (cons (Arrow X T) (lam ((w X)) c) r) cs)
            v)
          cs)))
    (by (with-rules (v2) by-list-induction))
    (normal full v2))
  (theorem check-children-trees
    (internal ()
      (forall ((GT Ts) (cs Ts))
        (equal (Reader.rrTrees check-folds)
          (lib mapApp Ts T
            (list-rec (nil (Arrow Ts T)) (c r)
              (cons (Arrow Ts T) (lam ((g Ts)) (fst (check-fold g c))) r)
              cs)
            GT))))
    (by (with-rules (v2) by-list-induction))
    (normal full v2))
  (theorem check-first-fn
    (internal () (forall ((t T)) (equal (lam ((g Ts)) (fst (check-fold g t))) (lam ((g Ts)) t))))
    (by
      (tree-fold-uniqueness t (l cs rs) (lam ((g Ts)) (node Bits (pair l (lib mapApp Ts T rs g))))
        (extensionality g (reduce full check-children-trees (map-app-constant Ts) v2)))))
  (theorem check-first (internal () (forall ((t T) (GT Ts)) (equal (fst (check-fold GT t)) t)))
    (by (with-rules (v2) (pointwise check-first-fn full)))
    (normal full v2))
  ; The same of the rose tree's fold that the kernel's fold whose step sees the node translates
  ; to, into pairs of the node rebuilt and a value of the type X, at every step.
  (abbreviation PaStep (Arrow T (Arrow (List X) X)))
  (abbreviation PaR (Prod T X))
  (abbreviation PaFold (Arrow PaStep PaR))
  (abbreviation para-kids
    (list-rec (nil T) (c r) (cons T (fst c) r) (lib mapApp PaStep PaR (snd n) f)))
  (abbreviation para-values
    (list-rec (nil X) (c r) (cons X (snd c) r) (lib mapApp PaStep PaR (snd n) f)))
  (abbreviation para-fold-step
    (lam ((f PaStep))
      (pair (node Bits (pair (fst n) para-kids))
        (f (node Bits (pair (fst n) para-kids)) para-values))))
  (abbreviation para-children
    (list-rec (nil PaFold) (c r) (cons PaFold (rose-rec PaFold (n) para-fold-step c) r) cs))
  (theorem para-children-trees
    (internal (X)
      (forall ((F PaStep) (cs Ts))
        (equal (list-rec (nil T) (c r) (cons T (fst c) r) (lib mapApp PaStep PaR para-children F))
          (lib mapApp PaStep T
            (list-rec (nil (Arrow PaStep T)) (c r)
              (cons (Arrow PaStep T)
                (lam ((f PaStep)) (fst ((rose-rec PaFold (n) para-fold-step c) f)))
                r)
              cs)
            F))))
    (by (with-rules (v2) by-list-induction))
    (normal full v2))
  (theorem para-first-fn
    (internal (X)
      (forall ((t T))
        (equal (lam ((f PaStep)) (fst ((rose-rec PaFold (n) para-fold-step t) f)))
          (lam ((f PaStep)) t))))
    (by
      (tree-fold-uniqueness t (l cs rs)
        (lam ((f PaStep)) (node Bits (pair l (lib mapApp PaStep T rs f))))
        (extensionality f (reduce full (para-children-trees X) (map-app-constant PaStep) v2)))))
  (theorem para-first
    (internal (X)
      (forall ((t T) (F PaStep)) (equal (fst ((rose-rec PaFold (n) para-fold-step t) F)) t)))
    (by (with-rules (v2) (pointwise para-first-fn full)))
    (normal full v2))
  (theorem eval-first
    (internal () (forall ((D Ts) (p Fns) (t T)) (equal (fst (eval-fold D p t)) t)))
    (by (reduce full (unfold eval-fold) (para-first EvE) v2))
    (normal full v2))
  ; The vocabulary with the folds' first components.
  (abbreviation v3 eval-first check-first (para-first T) (para-first EvE) v2)
  ; The weakening proof's lemmas on successors, each with its companion in the vocabulary's normal
  ; form.
  (theorem rebuild-tail-folded
    (internal (X)
      (forall ((l (List X)))
        (equal (fst (list-rec (pair (nil X) (nil X)) (y r) (pair (cons X y (fst r)) (fst r)) l))
          l)))
    (by (use rebuild-tail (X) (l)))
    (normal full v3))
  (theorem iter-succ-folded
    (internal (X)
      (forall ((f (Arrow X X)) (n Bits) (z X))
        (equal (lib iter X (lib succ n) f z) (lib iter X n f (f z)))))
    (by (use iter-succ (X) (f n z)))
    (normal full v3))
  (theorem iter-comm-folded
    (internal (X)
      (forall ((f (Arrow X X)) (n Bits) (z X))
        (equal (lib iter X n f (f z)) (f (lib iter X n f z)))))
    (by (use iter-comm (X) (f n z)))
    (normal full v3))
  (theorem cmp-succ-folded
    (internal ()
      (forall ((n Bits) (m Bits)) (equal (lib cmp (lib succ m) (lib succ n)) (lib cmp m n))))
    (by (use cmp-succ () (n m)))
    (normal full v3))
  (theorem succ-of-pred-folded
    (internal ()
      (forall ((bs Bits) (b Bit)) (equal (lib succ (lib pred (cons Bit b bs))) (cons Bit b bs))))
    (by (use succ-of-pred () (bs b)))
    (normal full v3))
  (theorem add-one-folded
    (internal () (forall ((n Bits)) (equal (lib add n (lib b0 (lib bnil))) (lib succ n))))
    (by (use add-one () (n)))
    (normal full v3))
  (theorem lt-zero-succ-folded
    (internal () (forall ((n Bits)) (equal (lib ltB (lib bnil) (lib succ n)) (lib b0 (lib bnil)))))
    (by (use lt-zero-succ () (n)))
    (normal full v3))
  ; The rules of the lookups.
  (abbreviation lookup-rules add-one-folded cmp-succ-folded lt-zero-succ-folded
    (rebuild-tail-folded T)
    (iter-succ-folded Ts)
    v3)
  ; A bitstring is empty or a successor.
  (theorem bits-succ
    (internal ()
      (forall ((x Bits))
        (or (equal x (lib bnil)) (exists Bits (lam ((y Bits)) (equal x (lib succ y)))))))
    (by
      (induction x (b bs ih) (or-left (reduce full))
        (or-right (exists-intro (lib pred (cons Bit b bs)) (reduce full succ-of-pred-folded v3))))))
  ; The lookup in a construction at a successor's index is the lookup in the rest at the index.
  (theorem nth-cons-succ
    (internal ()
      (forall ((a T) (xs Ts) (i Bits))
        (equal (Prelude.nth (cons T a xs) (node Bits (pair (lib succ i) (nil T))))
          (Prelude.nth xs (node Bits (pair i (nil T)))))))
    (by (reduce full lookup-rules))
    (normal full lookup-rules))
  ; The application of a closure evaluates its body in its environment with the argument.
  (theorem apply-closure
    (internal ()
      (forall ((p Fns) (env Ts) (A T) (b T) (x T))
        (equal (Eval.apStep p (Eval.valClo env A b) x) ((fst p) (cons T x env) b))))
    (by (reduce full lambek unfold-rebuild map-id rebuild-rules))
    (normal full v3))
  ; The vocabulary with the lookups and the application of a closure.
  (abbreviation v4 apply-closure nth-cons-succ lookup-rules)
  ; The relation of environments extended: an environment related to a context and a value related
  ; at a type, the environment with the value is related to the context with the type.
  (theorem env-cons
    (internal ()
      (forall ((D Ts) (c Ts) (env Ts) (A T) (w T))
        (assuming (he (env-related D c env)) (hw ((related D A) w))
          (env-related D (cons T A c) (cons T w env)))))
    (by
      (with-rules (v4)
        (unfold-formula
          (all-intro i
            (assume hi
              (obtain cases bits-succ () ((lib lab i))
                (or-elim cases (e0 es)
                  (reduce-hypotheses full (e0)
                    (exists-intro w (and-intro (reduce full e0) (matches hw full e0))))
                  (exists-elim es (j ej)
                    (reduce-hypotheses full (ej)
                      (unfold-hypothesis he he2
                        (all-elim he2 (node Bits (pair j (nil T))) hj
                          (imp-elim hj (matches hi full ej) hx
                            (exists-elim hx (x hx2)
                              (and-elim hx2 (hx3 hx4)
                                (reduce-hypothesis hx3 hx5 full (ej)
                                  (exists-intro x
                                    (and-intro (reduce full ej hx5)
                                      (matches hx4 full ej hx5)))))))))))))))))))
  ; The rules of the deductions: the lemmas of addition before the vocabulary, the predicate of
  ; every element of a list unfolded, and the tail's rebuilding of lists of formulas.
  (abbreviation kit plus-zero plus-succ zero-plus succ-plus plus-assoc v4 (unfold all-of)
    (rebuild-tail-folded Omega))
  ; The equality of bitstrings is sound: bitstrings that test equal are equal; by induction on
  ; the second and the case analysis of the first and of their first bits.
  (theorem eq-bits-sound
    (internal ()
      (forall ((y Bits))
        (all Bits
          (lam ((x Bits)) (implies (lib cond Omega (lib eqB x y) true false) (equal x y))))))
    (by
      (with-rules (kit)
        (induction y (b ys ih)
          (all-intro x
            (assume h
              (obtain cx list-cases (Bit) (x)
                (or-elim cx (e0 e1) (reduce full e0)
                  (exists-elim e1 (c e2)
                    (exists-elim e2 (xs e3) (reduce-hypotheses full (e3) (absurd h full e3))))))))
          (holds ih (ihf)
            (all-intro x
              (assume h
                (obtain cx list-cases (Bit) (x)
                  (or-elim cx (e0 e1) (reduce-hypotheses full (e0) (absurd h full e0))
                    (exists-elim e1 (c e2)
                      (exists-elim e2 (xs e3)
                        (reduce-hypotheses full (e3)
                          (obtain cb bit-cases () (b)
                            (or-elim cb (b0 b1)
                              (obtain cc0 bit-cases () (c)
                                (or-elim cc0 (c00 c01)
                                  (first (absurd h full e3 b0 c00)
                                    (all-elim ihf xs hs
                                      (imp-elim hs (matches h full e3 b0 c00) hq
                                        (reduce full e3 b0 c00 hq))))
                                  (first (absurd h full e3 b0 c01)
                                    (all-elim ihf xs hs
                                      (imp-elim hs (matches h full e3 b0 c01) hq
                                        (reduce full e3 b0 c01 hq))))))
                              (obtain cc1 bit-cases () (c)
                                (or-elim cc1 (c10 c11)
                                  (first (absurd h full e3 b1 c10)
                                    (all-elim ihf xs hs
                                      (imp-elim hs (matches h full e3 b1 c10) hq
                                        (reduce full e3 b1 c10 hq))))
                                  (first (absurd h full e3 b1 c11)
                                    (all-elim ihf xs hs
                                      (imp-elim hs (matches h full e3 b1 c11) hq
                                        (reduce full e3 b1 c11 hq))))))))))))))))))))
  ; The soundness of the equality of trees at the tree t: it is every tree it tests equal to.
  (abbreviation sound-at
    (all T (lam ((u T)) (implies (lib cond Omega (lib equal t u) true false) (equal t u)))))
  ; The elementwise equality of lists of trees is sound where the equality is sound at each
  ; element of the first; by induction on the first and the case analysis of the second.
  (theorem all-zip-sound
    (internal ()
      (forall ((cs Ts))
        (all Ts
          (lam ((ds Ts))
            (implies (all-of (lam ((t T)) sound-at) cs)
              (implies (lib cond Omega (lib allZip equal-kids ds) true false) (equal cs ds)))))))
    (by
      (with-rules (kit)
        (induction cs (y ys ih)
          (all-intro ds
            (assume ha
              (assume hz
                (obtain cd list-cases (T) (ds)
                  (or-elim cd (e0 e1) (reduce full e0)
                    (exists-elim e1 (d e2)
                      (exists-elim e2 (ds2 e3)
                        (reduce-hypotheses full (e3) (absurd hz full e3)))))))))
          (holds ih (ihf)
            (all-intro ds
              (assume ha
                (assume hz
                  (obtain cd list-cases (T) (ds)
                    (or-elim cd (e0 e1) (reduce-hypotheses full (e0) (absurd hz full e0))
                      (exists-elim e1 (d e2)
                        (exists-elim e2 (ds2 e3)
                          (reduce-hypotheses full (e3)
                            (obtain ce list-cases (Bit) ((lib equal y d))
                              (or-elim ce (q0 q1)
                                (reduce-hypotheses full (q0) (absurd hz full e3 q0))
                                (exists-elim q1 (qb q2)
                                  (exists-elim q2 (qs q3)
                                    (reduce-hypotheses full (q3)
                                      (reduce-hypothesis ha ha2 head ()
                                        (and-elim ha2 (py pys)
                                          (reduce-hypothesis py py2 head ()
                                            (all-elim ihf ds2 hi1
                                              (imp-elim hi1 (matches pys full) hi2
                                                (imp-elim hi2 (matches hz full e3 q3) heq
                                                  (all-elim py2 d hd
                                                    (imp-elim hd (reduce full q3) hyd
                                                      (reduce full e3 heq
                                                        hyd)))))))))))))))))))))))))))
  ; The hypothesis of the induction on trees at a list of children, for the soundness of the
  ; equality, is that soundness at every child; by induction on the list, the head's soundness
  ; and the rest's hypothesis read off the hypothesis's equation of lists.
  (theorem rose-all-sound
    (internal ()
      (forall ((cs Ts))
        (implies
          (equal (list-rec (nil Omega) (t r) (cons Omega (equal sound-at true) r) cs)
            (list-rec (nil Omega) (t r) (cons Omega (equal unit unit) r) cs))
          (all-of (lam ((t T)) sound-at) cs))))
    (by
      (with-rules (kit)
        (induction cs (y ys ih) (assume h (reduce full))
          (holds ih (ihf)
            (assume h
              (congruence h (g1 (z (List Omega)) (lib headD Omega (equal unit unit) z))
                (reduce-hypotheses full (g1)
                  (holds g1 (g2)
                    (holds g2 (g3)
                      (congruence h (g4 (z (List Omega)) (lib tail Omega z))
                        (reduce-hypotheses full (g4)
                          (imp-elim ihf (matches g4 full) hall
                            (reduced full
                              (and-intro (matches g3 full) (matches hall full))))))))))))))))
  ; The equality of trees is sound: a tree is every tree it tests equal to; by induction on the
  ; tree, the other a node, the tests of the labels and of the children decided.
  (theorem equal-sound (internal () (forall ((t T)) sound-at))
    (by
      (with-rules (kit)
        (tree-induction t (l cs ih)
          (all-intro u
            (assume h
              (obtain nu tree-node () (u)
                (exists-elim nu (m e1)
                  (exists-elim e1 (ds eu)
                    (reduce-hypotheses full (eu)
                      (obtain cl list-cases (Bit) ((lib eqB l m))
                        (or-elim cl (x0 x1) (reduce-hypotheses full (x0) (absurd h full eu x0))
                          (exists-elim x1 (xb x2)
                            (exists-elim x2 (xs x3)
                              (reduce-hypotheses full (x3)
                                (obtain cz list-cases (Bit) ((lib allZip equal-kids ds))
                                  (or-elim cz (z0 z1)
                                    (reduce-hypotheses full (z0) (absurd h full eu x3 z0))
                                    (exists-elim z1 (zb z2)
                                      (exists-elim z2 (zs z3)
                                        (reduce-hypotheses full (z3)
                                          (obtain sb eq-bits-sound () (m)
                                            (all-elim sb l hb
                                              (imp-elim hb (reduce full x3) hlm
                                                (obtain ra rose-all-sound () (cs)
                                                  (imp-elim ra (hypothesis ih) hall
                                                    (obtain za all-zip-sound () (cs)
                                                      (all-elim za ds hz1
                                                        (imp-elim hz1 (hypothesis hall) hz2
                                                          (imp-elim hz2 (reduce full z3) hcd
                                                            (reduce full eu hlm
                                                              hcd))))))))))))))))))))))))))))))
  ; A tree the test of a function type holds of is the node of that label over two trees.
  (theorem arrow-type-inversion
    (internal ()
      (forall ((t T))
        (implies (lib cond Omega (lib lab (Check.isArrow t)) true false)
          (exists T
            (lam ((a T))
              (exists T
                (lam ((b T)) (equal t (node Bits (pair n3 (cons T a (cons T b (nil T)))))))))))))
    (by
      (with-rules (kit)
        (assume h
          (obtain nt tree-node () (t)
            (exists-elim nt (l e1)
              (exists-elim e1 (cs et)
                (reduce-hypotheses full (et)
                  (obtain cl list-cases (Bit) ((lib eqB l n3))
                    (or-elim cl (x0 x1) (reduce-hypotheses full (x0) (absurd h full et x0))
                      (exists-elim x1 (xb x2)
                        (exists-elim x2 (xs x3)
                          (reduce-hypotheses full (x3)
                            (obtain sb eq-bits-sound () (n3)
                              (all-elim sb l hb
                                (imp-elim hb (reduce full x3) hl
                                  (obtain c0 list-cases (T) (cs)
                                    (or-elim c0 (k00 k01)
                                      (reduce-hypotheses full (k00) (absurd h full et hl k00))
                                      (exists-elim k01 (a k02)
                                        (exists-elim k02 (cs1 k03)
                                          (reduce-hypotheses full (k03)
                                            (obtain c1 list-cases (T) (cs1)
                                              (or-elim c1 (k10 k11)
                                                (reduce-hypotheses full (k10)
                                                  (absurd h full et hl k03 k10))
                                                (exists-elim k11 (b k12)
                                                  (exists-elim k12 (cs2 k13)
                                                    (reduce-hypotheses full (k13)
                                                      (obtain c2 list-cases (T) (cs2)
                                                        (or-elim c2 (k20 k21)
                                                          (reduce-hypotheses full (k20)
                                                            (exists-intro a
                                                              (exists-intro b
                                                                (reduce full et hl k03 k13 k20))))
                                                          (exists-elim k21 (further k22)
                                                            (exists-elim k22 (cs3 k23)
                                                              (reduce-hypotheses full (k23)
                                                                (absurd h full et hl k03 k13
                                                                  k23))))))))))))))))))))))))))))))))
  ; A tree the test of a product type holds of is the node of that label over two trees.
  (theorem product-type-inversion
    (internal ()
      (forall ((t T))
        (implies (lib cond Omega (lib lab (Check.isProd t)) true false)
          (exists T
            (lam ((a T))
              (exists T
                (lam ((b T)) (equal t (node Bits (pair n2 (cons T a (cons T b (nil T)))))))))))))
    (by
      (with-rules (kit)
        (assume h
          (obtain nt tree-node () (t)
            (exists-elim nt (l e1)
              (exists-elim e1 (cs et)
                (reduce-hypotheses full (et)
                  (obtain cl list-cases (Bit) ((lib eqB l n2))
                    (or-elim cl (x0 x1) (reduce-hypotheses full (x0) (absurd h full et x0))
                      (exists-elim x1 (xb x2)
                        (exists-elim x2 (xs x3)
                          (reduce-hypotheses full (x3)
                            (obtain sb eq-bits-sound () (n2)
                              (all-elim sb l hb
                                (imp-elim hb (reduce full x3) hl
                                  (obtain c0 list-cases (T) (cs)
                                    (or-elim c0 (k00 k01)
                                      (reduce-hypotheses full (k00) (absurd h full et hl k00))
                                      (exists-elim k01 (a k02)
                                        (exists-elim k02 (cs1 k03)
                                          (reduce-hypotheses full (k03)
                                            (obtain c1 list-cases (T) (cs1)
                                              (or-elim c1 (k10 k11)
                                                (reduce-hypotheses full (k10)
                                                  (absurd h full et hl k03 k10))
                                                (exists-elim k11 (b k12)
                                                  (exists-elim k12 (cs2 k13)
                                                    (reduce-hypotheses full (k13)
                                                      (obtain c2 list-cases (T) (cs2)
                                                        (or-elim c2 (k20 k21)
                                                          (reduce-hypotheses full (k20)
                                                            (exists-intro a
                                                              (exists-intro b
                                                                (reduce full et hl k03 k13 k20))))
                                                          (exists-elim k21 (further k22)
                                                            (exists-elim k22 (cs3 k23)
                                                              (reduce-hypotheses full (k23)
                                                                (absurd h full et hl k03 k13
                                                                  k23))))))))))))))))))))))))))))))))
  ; A tree the test of a list type holds of is the node of that label over one tree.
  (theorem list-type-inversion
    (internal ()
      (forall ((t T))
        (implies (lib cond Omega (lib lab (Check.isListTy t)) true false)
          (exists T (lam ((a T)) (equal t (node Bits (pair n4 (cons T a (nil T))))))))))
    (by
      (with-rules (kit)
        (assume h
          (obtain nt tree-node () (t)
            (exists-elim nt (l e1)
              (exists-elim e1 (cs et)
                (reduce-hypotheses full (et)
                  (obtain cl list-cases (Bit) ((lib eqB l n4))
                    (or-elim cl (x0 x1) (reduce-hypotheses full (x0) (absurd h full et x0))
                      (exists-elim x1 (xb x2)
                        (exists-elim x2 (xs x3)
                          (reduce-hypotheses full (x3)
                            (obtain sb eq-bits-sound () (n4)
                              (all-elim sb l hb
                                (imp-elim hb (reduce full x3) hl
                                  (obtain c0 list-cases (T) (cs)
                                    (or-elim c0 (k00 k01)
                                      (reduce-hypotheses full (k00) (absurd h full et hl k00))
                                      (exists-elim k01 (a k02)
                                        (exists-elim k02 (cs1 k03)
                                          (reduce-hypotheses full (k03)
                                            (obtain c1 list-cases (T) (cs1)
                                              (or-elim c1 (k10 k11)
                                                (reduce-hypotheses full (k10)
                                                  (exists-intro a (reduce full et hl k03 k10)))
                                                (exists-elim k11 (further k12)
                                                  (exists-elim k12 (cs2 k13)
                                                    (reduce-hypotheses full (k13)
                                                      (absurd h full et hl k03
                                                        k13)))))))))))))))))))))))))))
  ; The test that an optional tree is some has the empty label or the numeral one's; by the case
  ; analysis of the tree's label, of its first bit and of the bits after it.
  (theorem some-test-label
    (internal ()
      (forall ((m T))
        (or (equal (lib lab (Prelude.isSome m)) (lib bnil))
          (equal (lib lab (Prelude.isSome m)) n1))))
    (by
      (with-rules (kit)
        (obtain cl list-cases (Bit) ((lib lab m))
          (or-elim cl (e0 e1) (reduce-hypotheses full (e0) (or-left (reduce full e0)))
            (exists-elim e1 (b e2)
              (exists-elim e2 (r e3)
                (reduce-hypotheses full (e3)
                  (obtain cb bit-cases () (b)
                    (or-elim cb (bz bo)
                      (obtain cr list-cases (Bit) (r)
                        (or-elim cr (r0 r1) (or-right (reduce full e3 bz r0))
                          (exists-elim r1 (rb r2)
                            (exists-elim r2 (rs r3) (or-left (reduce full e3 bz r3))))))
                      (or-left (reduce full e3 bo)))))))))))))
