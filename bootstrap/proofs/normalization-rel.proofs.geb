; The relations of the kernel's constants at their types, for the fundamental lemma of the
; evaluator written in Geb, about the program of normalization-base.proofs.geb: the constants of
; the folds, by the folds' convergence; the right fold of lists and iteration, each converging at
; arguments related at theirs, by induction on the values and on the count's bits, and their
; constants; the case analysis of lists; and each primitive, an argument related at the type of
; trees being a quotation.

(proofs 6 (program normalization) (import normalization-const.proofs.geb)
  ; The types of lists of trees, of the evaluation and the application at a level and of their
  ; pair, of predicates on values, of a value as a function of the environment and of a spine.
  (abbreviation Ts (List T))
  (abbreviation Ev (Arrow Ts (Arrow T T)))
  (abbreviation Ap (Arrow T (Arrow T T)))
  (abbreviation Fns (Prod Ev Ap))
  (abbreviation Pred (Arrow T Omega))
  (abbreviation EvE (Arrow Ts T))
  (abbreviation Sp (Prod T Ts))
  (abbreviation Ord (Sum Unit Bit))
  ; The numeral of the label of the type of trees.
  (abbreviation n0 (lib bnil))
  ; The rules of the first components of the library's folds of the successor, of addition, of
  ; the predecessor and of the case analysis of lists.
  (abbreviation rebuild-rules rebuild-succ-normal rebuild-add-normal rebuild-succ rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits))
  ; The rules of the base's vocabulary, the definitions it keeps folded last.
  (abbreviation vocabulary apply-closure nth-cons-succ add-one-folded cmp-succ-folded
    lt-zero-succ-folded
    (rebuild-tail-folded T)
    (iter-succ-folded Ts)
    eval-first
    check-first
    (para-first T)
    (para-first EvE)
    check-fold-node
    eval-fold-node
    equal-fold
    equal-node
    succ-not-0
    succ-not-1
    succ-not-2
    succ-not-3
    type-in-fold
    next-fst
    next-snd
    level-succ
    lambek
    unfold-rebuild
    map-id
    check-node-var
    check-node-lam
    check-node-app
    check-node-unit
    check-node-pair
    check-node-fst
    check-node-snd
    check-node-quote
    check-node-cond
    check-node-fold
    check-node-iter
    check-node-nil
    check-node-cons
    check-node-foldr
    check-node-prim
    check-node-ref
    check-node-lcase
    check-node-para
    eval-step-var
    eval-step-lam
    eval-step-app
    eval-step-unit
    eval-step-pair
    eval-step-fst
    eval-step-snd
    eval-step-quote
    eval-step-cond
    eval-step-fold
    eval-step-iter
    eval-step-nil
    eval-step-cons
    eval-step-foldr
    eval-step-prim
    eval-step-ref
    eval-step-lcase
    eval-step-para
    related-tree
    related-unit
    related-prod
    related-arrow
    related-list
    rebuild-succ-normal
    rebuild-add-normal
    rebuild-succ
    rebuild-pred
    (rebuild-lcase Bit Ord)
    (rebuild-lcase Bit Bits)
    (folded (lib equal) Check.typeIn Check.checkNode Eval.evStep Eval.apStep Eval.next))
  ; The rules of the deductions: the lemmas of addition before the vocabulary, the predicate of
  ; every element of a list unfolded, and the tail's rebuilding of lists of formulas.
  (abbreviation kit plus-zero plus-succ zero-plus succ-plus plus-assoc vocabulary (unfold all-of)
    (rebuild-tail-folded Omega))
  ; The numerals of the labels of the fold, of the fold whose step sees the node, of the empty
  ; list and of a construction.
  (abbreviation n17 (lib b0 (lib b1 (lib b0 (lib b0 (lib bnil))))))
  (abbreviation n25 (lib b0 (lib b1 (lib b0 (lib b1 (lib bnil))))))
  (abbreviation n19 (lib b0 (lib b0 (lib b1 (lib b0 (lib bnil))))))
  (abbreviation n20 (lib b1 (lib b0 (lib b1 (lib b0 (lib bnil))))))
  ; The applications of the constants of the right fold of lists, of iteration and of the case
  ; analysis of lists to their arguments.
  (theorem apply-foldr-0
    (internal ()
      (forall ((p Fns) (A T) (B T) (g T))
        (equal
          (Eval.apStep p
            (node Bits
              (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil))))) (cons T A (cons T B (nil T)))))
            g)
          (Prelude.some
            (Eval.valApp
              (node Bits
                (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil))))) (cons T A (cons T B (nil T)))))
              g)))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-foldr-1
    (internal ()
      (forall ((p Fns) (A T) (B T) (g T) (z T))
        (equal
          (Eval.apStep p
            (Eval.valApp
              (node Bits
                (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil))))) (cons T A (cons T B (nil T)))))
              g)
            z)
          (Prelude.some
            (Eval.valApp
              (Eval.valApp
                (node Bits
                  (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                    (cons T A (cons T B (nil T)))))
                g)
              z)))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-foldr-2
    (internal ()
      (forall ((p Fns) (A T) (B T) (g T) (z T) (x T))
        (equal
          (Eval.apStep p
            (Eval.valApp
              (Eval.valApp
                (node Bits
                  (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                    (cons T A (cons T B (nil T)))))
                g)
              z)
            x)
          (Eval.bindO (Eval.listOf x)
            (lam ((vsN T)) (Eval.foldrVal (snd p) g z (lib children vsN)))))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-iter-0
    (internal ()
      (forall ((p Fns) (A T) (s T))
        (equal
          (Eval.apStep p
            (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T))))
            s)
          (Prelude.some
            (Eval.valApp
              (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T))))
              s)))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-iter-1
    (internal ()
      (forall ((p Fns) (A T) (s T) (z T))
        (equal
          (Eval.apStep p
            (Eval.valApp
              (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T))))
              s)
            z)
          (Prelude.some
            (Eval.valApp
              (Eval.valApp
                (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T))))
                s)
              z)))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-iter-2
    (internal ()
      (forall ((p Fns) (A T) (s T) (z T) (x T))
        (equal
          (Eval.apStep p
            (Eval.valApp
              (Eval.valApp
                (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T))))
                s)
              z)
            x)
          (Eval.bindO (Eval.unquote x)
            (lam ((c T)) (Eval.iterVal (snd p) s z (node Bits (pair (lib lab c) (nil T)))))))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-lcase-0
    (internal ()
      (forall ((p Fns) (A T) (B T) (x T))
        (equal
          (Eval.apStep p
            (node Bits
              (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil))))) (cons T A (cons T B (nil T)))))
            x)
          (Prelude.some
            (Eval.valApp
              (node Bits
                (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil))))) (cons T A (cons T B (nil T)))))
              x)))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-lcase-1
    (internal ()
      (forall ((p Fns) (A T) (B T) (x T) (z T))
        (equal
          (Eval.apStep p
            (Eval.valApp
              (node Bits
                (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil))))) (cons T A (cons T B (nil T)))))
              x)
            z)
          (Prelude.some
            (Eval.valApp
              (Eval.valApp
                (node Bits
                  (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil)))))
                    (cons T A (cons T B (nil T)))))
                x)
              z)))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  (theorem apply-lcase-2
    (internal ()
      (forall ((p Fns) (A T) (B T) (x T) (z T) (c T))
        (equal
          (Eval.apStep p
            (Eval.valApp
              (Eval.valApp
                (node Bits
                  (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil)))))
                    (cons T A (cons T B (nil T)))))
                x)
              z)
            c)
          (Eval.lcaseVal (snd p) x z c))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
  ; The constant of the fold is related at the fold's type: applied to a step it converges at
  ; once to the partial application, and applied to a quoted tree as well, as the fold does at
  ; the tree, one level below.
  (theorem related-fold
    (internal ()
      (forall ((D Ts) (A T))
        ((related D (Check.foldTy A)) (node Bits (pair n17 (cons T A (nil T)))))))
    (by
      (with-rules (apply-fold-0 apply-fold-1 (para-first Sp) kit)
        (reduced full
          (all-intro f
            (assume hf
              (unfold-formula
                (exists-intro (succ zero)
                  (exists-intro (Eval.valApp (node Bits (pair n17 (cons T A (nil T)))) f)
                    (and-intro (all-intro k (reduce full))
                      (reduced full
                        (all-intro x
                          (assume hx
                            (reduce-hypothesis hx hx2 full ()
                              (exists-elim hx2 (t ex)
                                (obtain fc fold-converges () (t)
                                  (all-elim fc D fc1
                                    (all-elim fc1 A fc2
                                      (all-elim fc2 f fc3
                                        (imp-elim fc3 (matches hf full) fc4
                                          (unfold-hypothesis fc4 fc5
                                            (exists-elim fc5 (m fc6)
                                              (exists-elim fc6 (w fc7)
                                                (and-elim fc7 (s rw)
                                                  (unfold-formula
                                                    (exists-intro (succ m)
                                                      (exists-intro w
                                                        (and-intro
                                                          (all-intro k
                                                            (all-elim s k sk
                                                              (reduce-hypothesis sk skn full ()
                                                                (reduce full ex skn))))
                                                          (matches rw
                                                            full)))))))))))))))))))))))))))))
  ; The constant of the fold whose step sees the node is related at the fold's type, as the
  ; fold's is.
  (theorem related-para
    (internal ()
      (forall ((D Ts) (A T))
        ((related D (Check.foldTy A)) (node Bits (pair n25 (cons T A (nil T)))))))
    (by
      (with-rules (apply-para-0 apply-para-1 (para-first Sp) kit)
        (reduced full
          (all-intro f
            (assume hf
              (unfold-formula
                (exists-intro (succ zero)
                  (exists-intro (Eval.valApp (node Bits (pair n25 (cons T A (nil T)))) f)
                    (and-intro (all-intro k (reduce full))
                      (reduced full
                        (all-intro x
                          (assume hx
                            (reduce-hypothesis hx hx2 full ()
                              (exists-elim hx2 (t ex)
                                (obtain fc para-converges () (t)
                                  (all-elim fc D fc1
                                    (all-elim fc1 A fc2
                                      (all-elim fc2 f fc3
                                        (imp-elim fc3 (matches hf full) fc4
                                          (unfold-hypothesis fc4 fc5
                                            (exists-elim fc5 (m fc6)
                                              (exists-elim fc6 (w fc7)
                                                (and-elim fc7 (s rw)
                                                  (unfold-formula
                                                    (exists-intro (succ m)
                                                      (exists-intro w
                                                        (and-intro
                                                          (all-intro k
                                                            (all-elim s k sk
                                                              (reduce-hypothesis sk skn full ()
                                                                (reduce full ex skn))))
                                                          (matches rw
                                                            full)))))))))))))))))))))))))))))
  ; The convergence of the right fold of a list of values at the values vs: for all
  ; definitions, types, steps and starts related at theirs, if every value is related at the
  ; element type, the right fold of the values converges to a value related at the result type.
  (abbreviation foldr-converges-at
    (all Ts
      (lam ((D Ts))
        (all T
          (lam ((A T))
            (all T
              (lam ((B T))
                (all T
                  (lam ((g T))
                    (all T
                      (lam ((z T))
                        (implies ((related D (Check.tyArrow A (Check.tyArrow B B))) g)
                          (implies ((related D B) z)
                            (implies (all-of (lam ((x T)) ((related D A) x)) vs)
                              (converges (lam ((k Nat)) (Eval.foldrVal (snd (level-at D k)) g z vs))
                                (related D B))))))))))))))))
  ; The right fold computes at a step and a start related at theirs: by induction on the values,
  ; the rest's fold converging by the induction hypothesis, the step's application to the head
  ; and then to the rest's value each converging.
  (theorem foldr-converges (internal () (forall ((vs Ts)) foldr-converges-at))
    (by
      (with-rules (kit)
        (induction vs (y ys ih)
          (all-intro D
            (all-intro A
              (all-intro B
                (all-intro g
                  (all-intro z
                    (assume hg
                      (assume hz
                        (assume hall
                          (unfold-formula
                            (exists-intro zero
                              (exists-intro z
                                (and-intro (all-intro k (reduce full)) (matches hz full)))))))))))))
          (holds ih (ihf)
            (all-intro D
              (all-intro A
                (all-intro B
                  (all-intro g
                    (all-intro z
                      (assume hg
                        (assume hz
                          (assume hall
                            (reduce-hypothesis hall hall2 full ()
                              (and-elim hall2 (hx hr)
                                (all-elim ihf D i1
                                  (all-elim i1 A i2
                                    (all-elim i2 B i3
                                      (all-elim i3 g i4
                                        (all-elim i4 z i5
                                          (imp-elim i5 (matches hg full) i6
                                            (imp-elim i6 (matches hz full) i7
                                              (imp-elim i7 (matches hr full) i8
                                                (unfold-hypothesis i8 e1a
                                                  (exists-elim e1a (m1 e1b)
                                                    (exists-elim e1b (a e1c)
                                                      (and-elim e1c (s1 ra)
                                                        (reduce-hypothesis hg hg2 full ()
                                                          (all-elim hg2 y j1
                                                            (imp-elim j1 (matches hx full) j2
                                                              (unfold-hypothesis j2 e2a
                                                                (exists-elim e2a (m2 e2b)
                                                                  (exists-elim e2b (g1 e2c)
                                                                    (and-elim e2c (s2 rg)
                                                                      (reduce-hypothesis rg rg2 full
                                                                        ()
                                                                        (all-elim rg2 a j3
                                                                          (imp-elim j3
                                                                            (matches ra full)
                                                                            j4
                                                                            (unfold-hypothesis j4
                                                                              e3a
                                                                              (exists-elim e3a
                                                                                (m3 e3b)
                                                                                (exists-elim e3b
                                                                                  (w e3c)
                                                                                  (and-elim e3c
                                                                                    (s3 rw)
                                                                                    (obtain q1
                                                                                      stable-right
                                                                                      ()
                                                                                      ((lam
                                                                                         ((k Nat))
                                                                                         (Eval.foldrVal
                                                                                           (snd
                                                                                             (level-at
                                                                                               D
                                                                                               k))
                                                                                           g
                                                                                           z
                                                                                           ys)) a m1
                                                                                       m2)
                                                                                      (matches s1
                                                                                        full)
                                                                                      (obtain q2
                                                                                        stable-right
                                                                                        ()
                                                                                        ((lam
                                                                                           ((k Nat))
                                                                                           (Eval.foldrVal
                                                                                             (snd
                                                                                               (level-at
                                                                                                 D
                                                                                                 k))
                                                                                             g
                                                                                             z
                                                                                             ys)) a
                                                                                         (plus m1
                                                                                           m2)
                                                                                         m3)
                                                                                        (matches q1
                                                                                          full)
                                                                                        (obtain q3
                                                                                          stable-left
                                                                                          ()
                                                                                          ((lam
                                                                                             ((k
                                                                                                Nat))
                                                                                             ((snd
                                                                                                (level-at
                                                                                                  D
                                                                                                  k))
                                                                                              g
                                                                                              y)) g1
                                                                                           m2
                                                                                           m1)
                                                                                          (matches
                                                                                            s2
                                                                                            full)
                                                                                          (obtain q4
                                                                                            stable-right
                                                                                            ()
                                                                                            ((lam
                                                                                               ((k
                                                                                                  Nat))
                                                                                               ((snd
                                                                                                  (level-at
                                                                                                    D
                                                                                                    k))
                                                                                                g
                                                                                                y))
                                                                                             g1
                                                                                             (plus
                                                                                               m1
                                                                                               m2)
                                                                                             m3)
                                                                                            (matches
                                                                                              q3
                                                                                              full)
                                                                                            (obtain
                                                                                              q5
                                                                                              stable-left
                                                                                              ()
                                                                                              ((lam
                                                                                                 ((k
                                                                                                    Nat))
                                                                                                 ((snd
                                                                                                    (level-at
                                                                                                      D
                                                                                                      k))
                                                                                                  g1
                                                                                                  a))
                                                                                               w
                                                                                               m3
                                                                                               (plus
                                                                                                 m1
                                                                                                 m2))
                                                                                              (matches
                                                                                                s3
                                                                                                full)
                                                                                              (unfold-formula
                                                                                                (exists-intro
                                                                                                  (plus
                                                                                                    (plus
                                                                                                      m1
                                                                                                      m2)
                                                                                                    m3)
                                                                                                  (exists-intro
                                                                                                    w
                                                                                                    (and-intro
                                                                                                      (all-intro
                                                                                                        k
                                                                                                        (all-elim
                                                                                                          q2
                                                                                                          k
                                                                                                          qi0
                                                                                                          (reduce-hypothesis
                                                                                                            qi0
                                                                                                            qn0
                                                                                                            full
                                                                                                            ()
                                                                                                            (all-elim
                                                                                                              q4
                                                                                                              k
                                                                                                              qi1
                                                                                                              (reduce-hypothesis
                                                                                                                qi1
                                                                                                                qn1
                                                                                                                full
                                                                                                                ()
                                                                                                                (all-elim
                                                                                                                  q5
                                                                                                                  k
                                                                                                                  qi2
                                                                                                                  (reduce-hypothesis
                                                                                                                    qi2
                                                                                                                    qn2
                                                                                                                    full
                                                                                                                    ()
                                                                                                                    (reduce
                                                                                                                      full
                                                                                                                      qn0
                                                                                                                      qn1
                                                                                                                      qn2))))))))
                                                                                                      (matches
                                                                                                        rw
                                                                                                        full)))))))))))))))))))))))))))))))))))))))))))))))))))
  ; The convergence of iteration at the count n, a bitstring: for all definitions, types, steps
  ; related at the type's endofunctions and starts related at the type, the iteration of the step
  ; the count's number of times from the start converges to a value related at the type.
  (abbreviation iter-converges-at
    (all Ts
      (lam ((D Ts))
        (all T
          (lam ((A T))
            (all T
              (lam ((s T))
                (all T
                  (lam ((z T))
                    (implies ((related D (Check.tyArrow A A)) s)
                      (implies ((related D A) z)
                        (converges
                          (lam ((k Nat))
                            (Eval.iterVal (snd (level-at D k)) s z (node Bits (pair n (nil T)))))
                          (related D A)))))))))))))
  ; Iteration computes at a step and a start related at theirs: by induction on the count's
  ; bits, the rest's iteration converging from the start and then from its value, by the
  ; induction hypothesis at each start, and the step applied once or twice.
  (theorem iter-converges (internal () (forall ((n Bits)) iter-converges-at))
    (by
      (with-rules (kit)
        (induction n (b bs ih)
          (all-intro D
            (all-intro A
              (all-intro s
                (all-intro z
                  (assume hs
                    (assume hz
                      (unfold-formula
                        (exists-intro zero
                          (exists-intro z
                            (and-intro (all-intro k (reduce full)) (matches hz full)))))))))))
          (holds ih (ihf)
            (all-intro D
              (all-intro A
                (all-intro s
                  (all-intro z
                    (assume hs
                      (assume hz
                        (all-elim ihf D x1
                          (all-elim x1 A x2
                            (all-elim x2 s x3
                              (all-elim x3 z x4
                                (imp-elim x4 (matches hs full) x5
                                  (imp-elim x5 (matches hz full) x6
                                    (unfold-hypothesis x6 xea
                                      (exists-elim xea (m1 xeb)
                                        (exists-elim xeb (w1 xec)
                                          (and-elim xec (s1 r1)
                                            (all-elim ihf D y1
                                              (all-elim y1 A y2
                                                (all-elim y2 s y3
                                                  (all-elim y3 w1 y4
                                                    (imp-elim y4 (matches hs full) y5
                                                      (imp-elim y5 (matches r1 full) y6
                                                        (unfold-hypothesis y6 yea
                                                          (exists-elim yea (m2 yeb)
                                                            (exists-elim yeb (w2 yec)
                                                              (and-elim yec (s2 r2)
                                                                (obtain cb bit-cases () (b)
                                                                  (or-elim cb (bz bo)
                                                                    (reduce-hypothesis hs pbz1 full
                                                                      ()
                                                                      (all-elim pbz1 w2 pbz2
                                                                        (imp-elim pbz2
                                                                          (matches r2 full)
                                                                          pbz3
                                                                          (unfold-hypothesis pbz3
                                                                            pbzea
                                                                            (exists-elim pbzea
                                                                              (m3 pbzeb)
                                                                              (exists-elim pbzeb
                                                                                (w3 pbzec)
                                                                                (and-elim pbzec
                                                                                  (s3 r3)
                                                                                  (obtain obz1
                                                                                    stable-right
                                                                                    ()
                                                                                    ((lam ((k Nat))
                                                                                       (Eval.iterVal
                                                                                         (snd
                                                                                           (level-at
                                                                                             D
                                                                                             k))
                                                                                         s
                                                                                         z
                                                                                         (node Bits
                                                                                           (pair bs
                                                                                             (nil
                                                                                               T)))))
                                                                                     w1
                                                                                     m1
                                                                                     m2)
                                                                                    (matches s1
                                                                                      full)
                                                                                    (obtain obz2
                                                                                      stable-right
                                                                                      ()
                                                                                      ((lam
                                                                                         ((k Nat))
                                                                                         (Eval.iterVal
                                                                                           (snd
                                                                                             (level-at
                                                                                               D
                                                                                               k))
                                                                                           s
                                                                                           z
                                                                                           (node
                                                                                             Bits
                                                                                             (pair
                                                                                               bs
                                                                                               (nil
                                                                                                 T)))))
                                                                                       w1
                                                                                       (plus m1 m2)
                                                                                       m3)
                                                                                      (matches obz1
                                                                                        full)
                                                                                      (obtain obz3
