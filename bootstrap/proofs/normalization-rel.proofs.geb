  ; The type of trees.
  (abbreviation tree-type (node Bits (pair n0 (nil T))))
  ; The quotations of a list of trees are each related at the type of trees; by induction on
  ; the list.
  (theorem quote-all
    (internal ()
      (forall ((ws Ts))
        (all Ts
          (lam ((D Ts))
            (all-of (related D tree-type) (Eval.mapT (lam ((x T)) (Eval.valQuote x)) ws))))))
    (by
      (with-rules (kit)
        (induction ws (y ys ih) (all-intro D (reduce full))
          (holds ih (ihf)
            (all-intro D
              (reduced full
                (and-intro (exists-intro y (reduce full))
                  (all-elim ihf D hi (matches hi full))))))))))
  ; Values each related at the type of trees are quotations, so their unquotations are all
  ; present: some list of the quoted trees; by induction on the list.
  (theorem unquote-all
    (internal ()
      (forall ((ws Ts))
        (all Ts
          (lam ((D Ts))
            (implies (all-of (lam ((x T)) ((related D tree-type) x)) ws)
              (exists T
                (lam ((r T))
                  (equal (Eval.allSomeT (Eval.mapT (lam ((x T)) (Eval.unquote x)) ws))
                    (Prelude.some r)))))))))
    (by
      (with-rules (kit)
        (induction ws (y ys ih)
          (all-intro D (assume h (exists-intro (node Bits (pair n0 (nil T))) (reduce full))))
          (holds ih (ihf)
            (all-intro D
              (assume h
                (reduce-hypothesis h h2 full ()
                  (and-elim h2 (hq hr)
                    (exists-elim hq (u eu)
                      (all-elim ihf D i1
                        (imp-elim i1 (matches hr full) i2
                          (exists-elim i2 (r er)
                            (reduce-hypotheses full (er)
                              (exists-intro (node Bits (pair n0 (cons T u (lib children r))))
                                (reduce full eu er))))))))))))))))
  ; The applications of the constants of the primitives to their arguments.
  (theorem apply-prim-label-0
    (internal ()
      (forall ((p Fns) (x T))
        (equal
          (Eval.apStep p
            (node Bits
              (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                (cons T (node Bits (pair (lib bnil) (nil T))) (nil T))))
            x)
          (Eval.primApply (node Bits (pair (lib bnil) (nil T))) (cons T x (nil T))))))
    (by (reduce full (para-first Sp) lambek unfold-rebuild map-id rebuild-rules))
    (normal full vocabulary))
