  ; The right fold of lists is related at its type: applied to a step and a start it converges
  ; at once to the partial applications, and applied to a list value as well, to the right fold
  ; of the list's values.
  (theorem related-foldr
    (internal ()
      (forall ((D Ts) (A T) (B T))
        ((related D (Check.foldrTy A B))
         (node Bits
           (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil))))) (cons T A (cons T B (nil T))))))))
    (by
      (with-rules (apply-foldr-0 apply-foldr-1 apply-foldr-2 (para-first Sp) kit)
        (reduced full
          (all-intro g
            (assume hg
              (unfold-formula
                (exists-intro (succ zero)
                  (exists-intro
                    (Eval.valApp
                      (node Bits
                        (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                          (cons T A (cons T B (nil T)))))
                      g)
                    (and-intro (all-intro k (reduce full))
                      (reduced full
                        (all-intro z
                          (assume hz
                            (unfold-formula
                              (exists-intro (succ zero)
                                (exists-intro
                                  (Eval.valApp
                                    (Eval.valApp
                                      (node Bits
                                        (pair (lib b0 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                                          (cons T A (cons T B (nil T)))))
                                      g)
                                    z)
                                  (and-intro (all-intro k (reduce full))
                                    (reduced full
                                      (all-intro xs
                                        (assume hxs
                                          (reduce-hypothesis hxs hxs2 full ()
                                            (and-elim hxs2 (t1 t2)
                                              (obtain cq list-cases (Bit)
                                                ((lib lab (Prelude.isSome (Eval.listOf xs))))
                                                (or-elim cq (q0 q1)
                                                  (reduce-hypotheses full (q0) (absurd t1 full q0))
                                                  (exists-elim q1 (qb q2)
                                                    (exists-elim q2 (qs q3)
                                                      (reduce-hypotheses full (q3)
                                                        (obtain fr foldr-converges ()
                                                          ((lib children
                                                             (Prelude.get (Eval.listOf xs))))
                                                          (all-elim fr D fra0
                                                            (all-elim fra0 A fra1
                                                              (all-elim fra1 B fra2
                                                                (all-elim fra2 g fra3
                                                                  (all-elim fra3 z fra4
                                                                    (imp-elim fra4 (matches hg full)
                                                                      fri0
                                                                      (imp-elim fri0
                                                                        (matches hz full)
                                                                        fri1
                                                                        (imp-elim fri1
                                                                          (matches t2 full)
                                                                          fri2
                                                                          (unfold-hypothesis fri2
                                                                            frea
                                                                            (exists-elim frea
                                                                              (m freb)
                                                                              (exists-elim freb
                                                                                (w frec)
                                                                                (and-elim frec
                                                                                  (sq rw)
                                                                                  (unfold-formula
                                                                                    (exists-intro
                                                                                      (succ m)
                                                                                      (exists-intro
                                                                                        w
                                                                                        (and-intro
                                                                                          (all-intro
                                                                                            k
                                                                                            (all-elim
                                                                                              sq
                                                                                              k
                                                                                              frfi0
                                                                                              (reduce-hypothesis
                                                                                                frfi0
                                                                                                frfn0
                                                                                                full
                                                                                                ()
                                                                                                (reduce
                                                                                                  full
                                                                                                  q3
                                                                                                  frfn0))))
                                                                                          (matches
                                                                                            rw
                                                                                            full)))))))))))))))))))))))))))))))))))))))))))))
  ; Iteration is related at its type: applied to a step and a start it converges at once to the
  ; partial applications, and applied to a quoted count as well, to the iteration at the count's
  ; label.
  (theorem related-iter
    (internal ()
      (forall ((D Ts) (A T))
        ((related D (Check.iterTy A))
         (node Bits (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T)))))))
    (by
      (with-rules (apply-iter-0 apply-iter-1 apply-iter-2 (para-first Sp) kit)
        (reduced full
          (all-intro s
            (assume hs
              (unfold-formula
                (exists-intro (succ zero)
                  (exists-intro
                    (Eval.valApp
                      (node Bits
                        (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil))))) (cons T A (nil T))))
                      s)
                    (and-intro (all-intro k (reduce full))
                      (reduced full
                        (all-intro z
                          (assume hz
                            (unfold-formula
                              (exists-intro (succ zero)
                                (exists-intro
                                  (Eval.valApp
                                    (Eval.valApp
                                      (node Bits
                                        (pair (lib b1 (lib b1 (lib b0 (lib b0 (lib bnil)))))
                                          (cons T A (nil T))))
                                      s)
                                    z)
                                  (and-intro (all-intro k (reduce full))
                                    (reduced full
                                      (all-intro x
                                        (assume hx
                                          (reduce-hypothesis hx hx2 full ()
                                            (exists-elim hx2 (t ex)
                                              (obtain ir iter-converges () ((lib lab t))
                                                (all-elim ir D ira0
                                                  (all-elim ira0 A ira1
                                                    (all-elim ira1 s ira2
                                                      (all-elim ira2 z ira3
                                                        (imp-elim ira3 (matches hs full) iri0
                                                          (imp-elim iri0 (matches hz full) iri1
                                                            (unfold-hypothesis iri1 irea
                                                              (exists-elim irea (m ireb)
                                                                (exists-elim ireb (w irec)
                                                                  (and-elim irec (sq rw)
                                                                    (unfold-formula
                                                                      (exists-intro (succ m)
                                                                        (exists-intro w
                                                                          (and-intro
                                                                            (all-intro k
                                                                              (all-elim sq k irfi0
                                                                                (reduce-hypothesis
                                                                                  irfi0
                                                                                  irfn0
                                                                                  full
                                                                                  ()
                                                                                  (reduce full ex
                                                                                    irfn0))))
                                                                            (matches rw
                                                                              full))))))))))))))))))))))))))))))))))))))
  ; Case analysis of lists is related at its type: applied to a list value and a value it
  ; converges at once to the partial applications, and applied to a function as well, by the list
  ; value's label and children: the empty list's value the second argument, and a construction's
  ; the function applied to the head and then to the rest.
  (theorem related-lcase
    (internal ()
      (forall ((D Ts) (A T) (B T))
        ((related D (Check.lcaseTy A B))
         (node Bits
           (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil))))) (cons T A (cons T B (nil T))))))))
    (by
      (with-rules (apply-lcase-0 apply-lcase-1 apply-lcase-2 (para-first Sp) kit)
        (reduced full
          (all-intro xs
            (assume hxs
              (unfold-formula
                (exists-intro (succ zero)
                  (exists-intro
                    (Eval.valApp
                      (node Bits
                        (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil)))))
                          (cons T A (cons T B (nil T)))))
                      xs)
                    (and-intro (all-intro k (reduce full))
                      (reduced full
                        (all-intro z
                          (assume hz
                            (unfold-formula
                              (exists-intro (succ zero)
                                (exists-intro
                                  (Eval.valApp
                                    (Eval.valApp
                                      (node Bits
                                        (pair (lib b1 (lib b0 (lib b0 (lib b1 (lib bnil)))))
                                          (cons T A (cons T B (nil T)))))
                                      xs)
                                    z)
                                  (and-intro (all-intro k (reduce full))
                                    (reduced full
                                      (all-intro c
                                        (assume hc
                                          (reduce-hypothesis hxs hxs2 full ()
                                            (and-elim hxs2 (t1 t2)
                                              (obtain nx tree-node () (xs)
                                                (exists-elim nx (l e1)
                                                  (exists-elim e1 (cs ex)
                                                    (reduce-hypotheses full (ex)
                                                      (obtain cn list-cases (Bit) ((lib eqB l n19))
                                                        (or-elim cn (u0 u1)
                                                          (reduce-hypotheses full (u0)
                                                            (obtain cc list-cases (Bit)
                                                              ((lib eqB l n20))
                                                              (or-elim cc (d0 d1)
                                                                (reduce-hypotheses full (d0)
                                                                  (absurd t1 full ex u0 d0))
                                                                (exists-elim d1 (db d2)
                                                                  (exists-elim d2 (ds d3)
                                                                    (reduce-hypotheses full (d3)
                                                                      (obtain sb eq-bits-sound ()
                                                                        (n20)
                                                                        (all-elim sb l hb
                                                                          (imp-elim hb
                                                                            (reduce full d3)
                                                                            hl
                                                                            (obtain kcc0 list-cases
                                                                              (T)
                                                                              (cs)
                                                                              (or-elim kcc0
                                                                                (kc00 kc01)
                                                                                (reduce-hypotheses
                                                                                  full
                                                                                  (kc00)
                                                                                  (absurd t1 full ex
                                                                                    hl
                                                                                    kc00))
                                                                                (exists-elim kc01
                                                                                  (h kc02)
                                                                                  (exists-elim kc02
                                                                                    (cs1 kc03)
                                                                                    (reduce-hypotheses
                                                                                      full
                                                                                      (kc03)
                                                                                      (obtain kcc1
                                                                                        list-cases
                                                                                        (T)
                                                                                        (cs1)
                                                                                        (or-elim
                                                                                          kcc1
                                                                                          (kc10
                                                                                            kc11)
                                                                                          (reduce-hypotheses
                                                                                            full
                                                                                            (kc10)
                                                                                            (absurd
                                                                                              t1
                                                                                              full
                                                                                              ex
                                                                                              hl
                                                                                              kc03
                                                                                              kc10))
                                                                                          (exists-elim
                                                                                            kc11
                                                                                            (tl
                                                                                              kc12)
                                                                                            (exists-elim
                                                                                              kc12
                                                                                              (cs2
                                                                                                kc13)
                                                                                              (reduce-hypotheses
                                                                                                full
                                                                                                (kc13)
                                                                                                (obtain
                                                                                                  kcc2
                                                                                                  list-cases
                                                                                                  (T)
                                                                                                  (cs2)
                                                                                                  (or-elim
                                                                                                    kcc2
                                                                                                    (kc20
                                                                                                      kc21)
                                                                                                    (reduce-hypotheses
                                                                                                      full
                                                                                                      (kc20)
                                                                                                      (obtain
                                                                                                        cq
                                                                                                        list-cases
                                                                                                        (Bit)
                                                                                                        ((lib
                                                                                                           lab
                                                                                                           (Prelude.isSome
                                                                                                             (Eval.listOf
                                                                                                               tl))))
                                                                                                        (or-elim
                                                                                                          cq
                                                                                                          (q0
                                                                                                            q1)
                                                                                                          (reduce-hypotheses
                                                                                                            full
                                                                                                            (q0)
                                                                                                            (absurd
                                                                                                              t1
                                                                                                              full
                                                                                                              ex
                                                                                                              hl
                                                                                                              kc03
                                                                                                              kc13
                                                                                                              kc20
                                                                                                              q0))
                                                                                                          (exists-elim
                                                                                                            q1
                                                                                                            (qb
                                                                                                              q2)
                                                                                                            (exists-elim
                                                                                                              q2
                                                                                                              (qs
                                                                                                                q3)
