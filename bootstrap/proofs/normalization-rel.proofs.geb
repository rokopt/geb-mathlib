  ; Each primitive is related at its type: an argument related at the type of trees is a
  ; quotation, the list argument of the node primitive a list value whose test and whose elements'
  ; unquotations are decided; the value is the evaluator's at fuel one, related at the type of
  ; trees as a quotation, or, for the children primitive, at the list type as the list value of
  ; quotations.
  (theorem related-prim-label
    (internal ()
      (forall ((D Ts))
        ((related D (Check.tyArrow tree-type tree-type))
         (node Bits
           (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
             (cons T (node Bits (pair (lib bnil) (nil T))) (nil T)))))))
    (by
      (with-rules (apply-prim-label-0 (para-first Sp) kit)
        (reduced full
          (all-intro x
            (assume hx
              (reduce-hypothesis hx hx2 full ()
                (exists-elim hx2 (t ex)
                  (with-rules (ex apply-prim-label-0 (para-first Sp) kit)
                    (unfold-formula
                      (exists-intro (succ zero)
                        (exists-intro
                          (Prelude.get
                            ((snd (level-at D (succ zero)))
                             (node Bits
                               (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                                 (cons T (node Bits (pair (lib bnil) (nil T))) (nil T))))
                             x))
                          (and-intro (all-intro k (reduce full))
                            (reduced full
                              (exists-intro
                                ((kernel (lam ((v T)) (child v 0)))
                                 (Prelude.get
                                   ((snd (level-at D (succ zero)))
                                    (node Bits
                                      (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                                        (cons T (node Bits (pair (lib bnil) (nil T))) (nil T))))
                                    x)))
                                (reduce full))))))))))))))))
