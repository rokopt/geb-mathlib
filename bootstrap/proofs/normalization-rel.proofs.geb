  (theorem related-prim-node
    (internal ()
      (forall ((D Ts))
        ((related D (Check.tyArrow tree-type (Check.tyArrow (Check.tyList tree-type) tree-type)))
         (node Bits
           (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
             (cons T (node Bits (pair (lib b0 (lib b0 (lib bnil))) (nil T))) (nil T)))))))
    (by
      (with-rules (apply-prim-node-0 apply-prim-node-1 (para-first Sp) kit)
        (reduced full
          (all-intro x
            (assume hx
              (reduce-hypothesis hx hx2 full ()
                (exists-elim hx2 (t ex)
                  (with-rules (ex apply-prim-node-0 apply-prim-node-1 (para-first Sp) kit)
                    (unfold-formula
                      (exists-intro (succ zero)
                        (exists-intro
                          (Eval.valApp
                            (node Bits
                              (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
                                (cons T (node Bits (pair (lib b0 (lib b0 (lib bnil))) (nil T)))
                                  (nil T))))
                            x)
                          (and-intro (all-intro k (reduce full))
                            (reduced full
                              (all-intro cs
                                (assume hcs
                                  (reduce-hypothesis hcs hcs2 full ()
                                    (and-elim hcs2 (t1 t2)
                                      (obtain cq list-cases (Bit)
                                        ((lib lab (Prelude.isSome (Eval.listOf cs))))
                                        (or-elim cq (q0 q1)
                                          (reduce-hypotheses full (q0) (absurd t1 full q0))
                                          (exists-elim q1 (qb q2)
                                            (exists-elim q2 (qs q3)
                                              (reduce-hypotheses full (q3)
                                                (obtain ua unquote-all ()
                                                  ((lib children (Prelude.get (Eval.listOf cs))))
                                                  (all-elim ua D ua1
                                                    (imp-elim ua1 (matches t2 full) ua2
                                                      (exists-elim ua2 (r er)
                                                        (reduce-hypotheses full (er)
                                                          (with-rules
                                                            (ex q3 er apply-prim-node-0
                                                              apply-prim-node-1
                                                              (para-first Sp)
                                                              kit)
                                                            (unfold-formula
                                                              (exists-intro (succ zero)
                                                                (exists-intro
                                                                  (Prelude.get
                                                                    ((snd (level-at D (succ zero)))
                                                                     (Eval.valApp
                                                                       (node Bits
                                                                         (pair
                                                                           (lib b1
                                                                             (lib b1
                                                                               (lib b1
                                                                                 (lib b0
                                                                                   (lib bnil)))))
                                                                           (cons T
                                                                             (node Bits
                                                                               (pair
                                                                                 (lib b0
                                                                                   (lib b0
                                                                                     (lib bnil)))
                                                                                 (nil T)))
                                                                             (nil T))))
                                                                       x)
                                                                     cs))
                                                                  (and-intro
                                                                    (all-intro k (reduce full))
                                                                    (reduced full
                                                                      (exists-intro
                                                                        ((kernel
                                                                           (lam ((v T))
                                                                             (child v 0)))
                                                                         (Prelude.get
                                                                           ((snd
                                                                              (level-at D
                                                                                (succ zero)))
                                                                            (Eval.valApp
                                                                              (node Bits
                                                                                (pair
                                                                                  (lib b1
                                                                                    (lib b1
                                                                                      (lib b1
                                                                                        (lib b0
                                                                                          (lib
                                                                                            bnil)))))
                                                                                  (cons T
                                                                                    (node Bits
                                                                                      (pair
                                                                                        (lib b0
                                                                                          (lib b0
                                                                                            (lib
                                                                                              bnil)))
                                                                                        (nil T)))
                                                                                    (nil T))))
                                                                              x)
                                                                            cs)))
                                                                        (reduce
                                                                          full))))))))))))))))))))))))))))))))))))
  (theorem related-prim-children
    (internal ()
      (forall ((D Ts))
        ((related D (Check.tyArrow tree-type (Check.tyList tree-type)))
         (node Bits
           (pair (lib b1 (lib b1 (lib b1 (lib b0 (lib bnil)))))
