;
; The first rung of the metalogic's proof checker, written in Surface 1: the conclusion of a
; certificate, given a program's definitions, theorems about it, the types of the global
; environment the definitions load, a context, innermost first, and a list of hypotheses, or
; nothing when the certificate does not check, deciding as Geb.Metalogic.check decides. An
; equation is the node of label 0 over its type and its two sides, and a theorem the node of
; label 0 over the node of its context and its equation; an optional equation is represented as
; the reader represents optional trees. Requires the prelude, the reader and the checker.

; the labels of the certificates' rules, as Geb.Metalogic.Rule names them
(defnum Rule.hyp 0)
(defnum Rule.refl 1)
(defnum Rule.symm 2)
(defnum Rule.trans 3)
(defnum Rule.congApp 4)
(defnum Rule.congLam 5)
(defnum Rule.congPair 6)
(defnum Rule.congFst 7)
(defnum Rule.congSnd 8)
(defnum Rule.congCons 9)
(defnum Rule.congCond 10)
(defnum Rule.beta 11)
(defnum Rule.eta 12)
(defnum Rule.betaFst 13)
(defnum Rule.betaSnd 14)
(defnum Rule.etaPair 15)
(defnum Rule.etaUnit 16)
(defnum Rule.delta 17)
(defnum Rule.weaken 18)
(defnum Rule.cut 19)
(defnum Rule.instVar 20)
(defnum Rule.foldrNil 21)
(defnum Rule.foldrCons 22)
(defnum Rule.indList 23)
(defnum Rule.lcaseNil 24)
(defnum Rule.lcaseCons 25)
(defnum Rule.iterZero 26)
(defnum Rule.iterSucc 27)
(defnum Rule.foldNode 28)
(defnum Rule.indTree 29)
(defnum Rule.indLabel 30)
(defnum Rule.unfold 31)
(defnum Rule.condQuote 32)
(defnum Rule.ax 33)
(defnum Rule.iterLabel 34)
(defnum Rule.condIter 35)
(defnum Rule.thm 36)

(data Eqn (eqn T T T))
(defn eqTy ((q T)) T (case q ((eqn a s t) a)))
(defn eqLhs ((q T)) T (case q ((eqn a s t) s)))
(defn eqRhs ((q T)) T (case q ((eqn a s t) t)))

; optional trees: the result of a function at the tree an optional tree holds
(defn bindO ((m T) (f (Arrow T T))) T (if (isSome m) (f (get m)) none))

; the disjunction of two tests
(def or (lam ((a T) (b T)) (if a 1 b)))

; lists of trees: a function at every element, and whether a test holds at every element
(defn mapT ((f (Arrow T T)) (xs Ts)) Ts (foldr T Ts (lam ((x T) (r Ts)) (cons (f x) r)) (nil T) xs))
(defn allT ((f (Arrow T T)) (xs Ts)) T (foldr T T (lam ((x T) (r T)) (and (f x) r)) 1 xs))

; kernel terms and types
(defn mk1 ((l T) (a T)) T (node l (single a)))
(defn mk3 ((l T) (a T) (b T) (c T)) T (node l (cons a (cons b (single c)))))
(defn var ((i T)) T (mk1 Label.var i))
(defn app2 ((f T) (x T) (y T)) T (app (app f x) y))
(defn app3 ((f T) (x T) (y T) (z T)) T (app (app (app f x) y) z))
(defn hasType ((G Ts) (ctx Ts) (t T) (a T)) T
  (let r T (typeIn G ctx t) (if (isSome r) (equal (get r) a) 0)))

; the traversal of a term replacing each variable: the variable of index i under k binders
; becomes v k i, and every other node is rebuilt, descending only into the children that are
; terms, the body of an abstraction at one more binder
(deftype TR (Prod T (Arrow T T)))
(deftype TRs (List TR))
(defn trTrees ((rs TRs)) Ts (foldr TR Ts (lam ((r TR) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn trAll ((rs TRs) (k T)) Ts
  (foldr TR Ts (lam ((r TR) (acc Ts)) (cons ((snd r) k) acc)) (nil T) rs))
(defn termNode ((l T)) T
  (or (eq l Label.app) (or (eq l Label.unit) (or (eq l Label.pair) (or (eq l Label.fst)
    (or (eq l Label.snd) (or (eq l Label.cond) (eq l Label.cons))))))))
(defn trav ((v (Arrow T (Arrow T T))) (t T) (k0 T)) T
  ((snd (fold TR
     (lam ((l T) (rs TRs))
       (let cs Ts (trTrees rs)
         (let n T (length cs)
           (pair (node l cs)
             (lam ((k T))
               (if (and (eq l Label.var) (eq n 1)) (v k (label (at cs 0)))
               (if (and (eq l Label.lam) (eq n 2))
                   (node2 Label.lam (at cs 0) (at (trAll rs (add k 1)) 1))
               (if (termNode l) (node l (trAll rs k)) (node l cs)))))))))
     t))
   k0))

; weakening by n variables below k bound ones, and substitution for the innermost variable
(defn wkVar ((n T) (k T) (i T)) T (var (if (lt i k) i (add i n))))
(defn wk ((n T) (t T)) T (trav (wkVar n) t 0))
(defn wkAt ((k T) (n T) (t T)) T (trav (wkVar n) t k))
(defn substVar ((u T) (k T) (i T)) T (if (lt i k) (var i) (if (eq i k) (wk k u) (var (sub i 1)))))
(defn subst ((u T) (t T)) T (trav (substVar u) t 0))

; equations weakened, lowered below their innermost variable, and typed in a context
(defn eqWk ((n T) (q T)) T (eqn (eqTy q) (wk n (eqLhs q)) (wk n (eqRhs q))))
(defn eqLower ((q T)) T
      (eqn (eqTy q) (subst (mk1 Label.quote 0) (eqLhs q)) (subst (mk1 Label.quote 0) (eqRhs q))))
(defn typedIn ((G Ts) (ctx Ts) (q T)) T
  (and (hasType G ctx (eqLhs q) (eqTy q)) (hasType G ctx (eqRhs q) (eqTy q))))
; whether hypotheses are the weakenings of equations typed in the context below
(defn weakens ((G Ts) (ctx Ts) (h0 Ts) (hs Ts)) T
  (and (equal (node 0 (mapT (eqWk 1) h0)) (node 0 hs)) (allT (typedIn G ctx) h0)))

; the list of a function's values at the elements of a list, by the right fold
(defn mapBy ((a T) (b T) (body T) (xs T)) T
  (app3 (node2 Label.foldr a (tyList b))
        (node2 Label.lam a (node2 Label.lam (tyList b) (node2 Label.cons body (var 0))))
        (mk1 Label.nil b) xs))

; literals: a quoted tree, and a list of quoted trees, whose trees are held by a node over them
(defn isQuote ((t T)) T (and (eq (label t) Label.quote) (eq (arity t) 1)))
(defn listElems ((t T)) T
  (snd (fold RT
    (lam ((l T) (rs RTs))
      (let cs Ts (rtTrees rs)
        (let n T (length cs)
          (pair (node l cs)
            (if (and (eq l Label.nil) (eq n 1)) (some (node 0 (nil T)))
            (if (and (eq l Label.cons) (eq n 2))
              (let r T (at (rtValues rs) 1)
                (if (and (isQuote (at cs 0)) (isSome r))
                  (some (node 0 (cons (child (at cs 0) 0) (children (get r)))))
                  none))
              none))))))
    t)))
(defn isLit ((t T)) T (or (isQuote t) (isSome (listElems t))))
(defn litValue ((t T)) T (if (isQuote t) (child t 0) (get (listElems t))))
(defn listLit ((xs Ts)) T
      (foldr T T (lam ((x T) (r T)) (node2 Label.cons (mk1 Label.quote x) r))
             (mk1 Label.nil Label.tyTree) xs))

; the value of the primitive of index k at the values of literals, a list as a node over it
(defn delta ((k T) (a T) (b T)) T
  (if (eq k Prim.label) (label a) (if (eq k Prim.arity) (arity a) (if (eq k Prim.child) (child a b)
  (if (eq k Prim.node) (node a (children b))
      (if (eq k Prim.children) (node 0 (children a)) (if (eq k Prim.add) (add a b)
  (if (eq k Prim.sub) (sub a b)
      (if (eq k Prim.mul) (mul a b) (if (eq k Prim.div) (div a b) (if (eq k Prim.mod) (mod a b)
  (if (eq k Prim.eq) (eq a b)
      (if (eq k Prim.lt) (lt a b) (if (eq k Prim.equal) (equal a b) (log2 a)))))))))))))))

; theorems, and an equation at terms for its variables: each term, weakened past the variables
; after it, replaces the innermost variable in turn
(defn thm ((ctx Ts) (q T)) T (node2 0 (node 0 ctx) q))
(defn eqSubst ((u T) (q T)) T (eqn (eqTy q) (subst u (eqLhs q)) (subst u (eqRhs q))))
(defn eqWkAt ((k T) (n T) (q T)) T (eqn (eqTy q) (wkAt k n (eqLhs q)) (wkAt k n (eqRhs q))))
(deftype IK (Prod T (Arrow T T)))
(defn instAll ((us Ts) (q T)) T
  ((snd (foldr T IK
     (lam ((u T) (r IK)) (pair (add (fst r) 1) (lam ((q T)) ((snd r) (eqSubst (wk (fst r) u) q)))))
     (pair 0 (lam ((q T)) q)) us))
   q))
; whether terms have the types of a context, one for each
(defn typesMatch ((G Ts) (ctx Ts) (us Ts) (as Ts)) T
  (and (eq (length us) (length as))
    ((foldr T (Arrow Ts T)
       (lam ((u T) (k (Arrow Ts T)) (as Ts))
         (lcase T T as 0 (lam ((a T) (rest Ts)) (and (hasType G ctx u a) (k rest)))))
       (lam ((as Ts)) 1) us)
     as)))
; a theorem cited in a context at terms for its variables: its instance there, when the terms
; have the types of its context, as Geb.Metalogic.Thm.cite computes it
(defn cite ((G Ts) (ctx Ts) (us Ts) (th T)) T
  (let tctx Ts (children (child th 0))
    (if (typesMatch G ctx us tctx)
      (some (instAll us (eqWkAt (length tctx) (length ctx) (child th 1))))
      none)))

; the defining equations of the primitives, as Geb.Metalogic.axioms states them
(def tyT2 (node2 Label.tyProd Label.tyTree Label.tyTree))
(def tyLT (tyList Label.tyTree))
(defn num ((n T)) T (mk1 Label.quote n))
(defn prim ((k T) (xs Ts)) T (apps (mk1 Label.prim k) xs))
(defn prim1 ((k T) (a T)) T (prim k (single a)))
(defn prim2 ((k T) (a T) (b T)) T (prim k (cons a (single b))))
(defn succT ((t T)) T (prim2 Prim.add t (num 1)))
(def v0 (var 0))
(def v1 (var 1))
(def v2 (var 2))
(def ctxT (single Label.tyTree))
(def ctxTT (cons Label.tyTree (single Label.tyTree)))
(def ctxTL (cons Label.tyTree (single tyLT)))
(def axLabelNode
  (thm ctxTL (eqn Label.tyTree (prim1 Prim.label (prim2 Prim.node v0 v1)) (prim1 Prim.label v0))))
(def axChildrenNode (thm ctxTL (eqn tyLT (prim1 Prim.children (prim2 Prim.node v0 v1)) v1)))
(def axNodeEta
  (thm ctxT (eqn Label.tyTree (prim2 Prim.node (prim1 Prim.label v0) (prim1 Prim.children v0)) v0)))
(def axChildrenLabel
  (thm ctxT (eqn tyLT (prim1 Prim.children (prim1 Prim.label v0)) (mk1 Label.nil Label.tyTree))))
(def axLabelSucc (thm ctxT (eqn Label.tyTree (prim1 Prim.label (succT v0)) (succT v0))))
(def axAddIter
  (thm ctxTT (eqn Label.tyTree (prim2 Prim.add v0 v1)
    (app3 (mk1 Label.iter Label.tyTree) (node2 Label.lam Label.tyTree (succT v0))
          (prim1 Prim.label v0) v1))))
(def axPredIter
  (thm ctxT (eqn Label.tyTree (prim2 Prim.sub v0 (num 1))
    (mk1 Label.fst
      (app3 (mk1 Label.iter tyT2)
            (node2 Label.lam tyT2 (node2 Label.pair (mk1 Label.snd v0) (succT (mk1 Label.snd v0))))
            (node2 Label.pair (num 0) (num 0)) v0)))))
(def axSubIter
  (thm ctxTT (eqn Label.tyTree (prim2 Prim.sub v0 v1)
    (app3 (mk1 Label.iter Label.tyTree) (node2 Label.lam Label.tyTree (prim2 Prim.sub v0 (num 1)))
          (prim1 Prim.label v0) v1))))
(def axMulIter
  (thm ctxTT (eqn Label.tyTree (prim2 Prim.mul v0 v1)
    (app3 (mk1 Label.iter Label.tyTree) (node2 Label.lam Label.tyTree (prim2 Prim.add v0 v1))
          (num 0) v1))))
(def divMod
  (app3 (mk1 Label.iter tyT2)
    (node2 Label.lam tyT2
      (mk3 Label.cond (prim2 Prim.eq (succT (mk1 Label.snd v0)) v2)
           (node2 Label.pair (succT (mk1 Label.fst v0)) (num 0))
           (node2 Label.pair (mk1 Label.fst v0) (succT (mk1 Label.snd v0)))))
    (node2 Label.pair (num 0) (num 0)) v0))
(def axDivIter (thm ctxTT (eqn Label.tyTree (prim2 Prim.div v0 v1) (mk1 Label.fst divMod))))
(def axModIter (thm ctxTT (eqn Label.tyTree (prim2 Prim.mod v0 v1) (mk1 Label.snd divMod))))
(def axEqDef
  (thm ctxTT (eqn Label.tyTree (prim2 Prim.eq v0 v1)
    (app3 (mk1 Label.iter Label.tyTree) (node2 Label.lam Label.tyTree (num 0)) (num 1)
          (prim2 Prim.add (prim2 Prim.sub v0 v1) (prim2 Prim.sub v1 v0))))))
(def axLtDef
  (thm ctxTT (eqn Label.tyTree (prim2 Prim.lt v0 v1)
    (app3 (mk1 Label.iter Label.tyTree) (node2 Label.lam Label.tyTree (num 1)) (num 0)
          (prim2 Prim.sub v1 v0)))))
(def axLog2Def
  (thm ctxT (eqn Label.tyTree (prim1 Prim.log2 v0)
    (mk3 Label.cond (prim2 Prim.lt v0 (num 2)) (num 0)
         (succT (prim1 Prim.log2 (prim2 Prim.div v0 (num 2))))))))
(def axArityDef
  (thm ctxT (eqn Label.tyTree (prim1 Prim.arity v0)
    (app3 (node2 Label.foldr Label.tyTree Label.tyTree)
          (node2 Label.lam Label.tyTree (node2 Label.lam Label.tyTree (succT v0))) (num 0)
          (prim1 Prim.children v0)))))
(def tailT
  (node2 Label.lam tyLT
    (app3 (node2 Label.lcase Label.tyTree tyLT) v0 (mk1 Label.nil Label.tyTree)
          (node2 Label.lam Label.tyTree (node2 Label.lam tyLT v0)))))
(def axChildDef
  (thm ctxTT (eqn Label.tyTree (prim2 Prim.child v0 v1)
    (app3 (node2 Label.lcase Label.tyTree Label.tyTree)
          (app3 (mk1 Label.iter tyLT) tailT (prim1 Prim.children v0) v1) (num 0)
          (node2 Label.lam Label.tyTree (node2 Label.lam tyLT v1))))))
(def axEqualRefl (thm ctxT (eqn Label.tyTree (prim2 Prim.equal v0 v0) (num 1))))
(def axEqualSubst (thm ctxTT (eqn Label.tyTree (mk3 Label.cond (prim2 Prim.equal v0 v1) v1 v0) v0)))
(def axEqualBool
  (thm ctxTT (eqn Label.tyTree (mk3 Label.cond (prim2 Prim.equal v0 v1) (num 1) (num 0))
    (prim2 Prim.equal v0 v1))))
(def axioms
  (cons axLabelNode (cons axChildrenNode (cons axNodeEta (cons axChildrenLabel (cons axLabelSucc
  (cons axAddIter (cons axPredIter (cons axSubIter (cons axMulIter (cons axDivIter (cons axModIter
  (cons axEqDef (cons axLtDef (cons axLog2Def (cons axArityDef (cons axChildDef (cons axEqualRefl
  (cons axEqualSubst (single axEqualBool))))))))))))))))))))

; a certificate with its conclusion as a function of the context and the hypotheses
(deftype Concl (Arrow Ts (Arrow Ts T)))
(deftype CR (Prod T Concl))
(deftype CRs (List CR))
(defn crTrees ((rs CRs)) Ts (foldr CR Ts (lam ((r CR) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn crTail ((rs CRs)) CRs (lcase CR CRs rs (nil CR) (lam ((r CR) (rest CRs)) rest)))
(defn prem ((rs CRs) (i T)) Concl
  (lcase CR Concl (iter CRs crTail rs i) (lam ((ctx Ts) (hs Ts)) none)
    (lam ((r CR) (rest CRs)) (snd r))))
(defn shape ((l T) (k T) (m T) (n T)) T (and (eq l m) (eq k n)))

; the rules of equality, congruence, computation, substitution, the right fold of lists and
; induction on lists, by the label of a certificate's node, with its children and their results
(defn checkCore ((D Ts) (G Ts) (l T) (cs Ts) (rs CRs) (ctx Ts) (hs Ts)) T
  (let k T (length cs)
  (let c0 T (at cs 0)
  (let c1 T (at cs 1)
  (let c2 T (at cs 2)
  (let c3 T (at cs 3)
  ; a hypothesis, by index
  (if (shape l k Rule.hyp 1)
    (bindO (nth hs (label c0)) (lam ((q T)) (if (typedIn G ctx q) (some q) none)))
  ; reflexivity, symmetry and transitivity
  (if (shape l k Rule.refl 1) (bindO (typeIn G ctx c0) (lam ((a T)) (some (eqn a c0 c0))))
  (if (shape l k Rule.symm 1)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (some (eqn (eqTy q) (eqRhs q) (eqLhs q)))))
  (if (shape l k Rule.trans 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (if (and (equal (eqTy q) (eqTy q2)) (equal (eqRhs q) (eqLhs q2)))
        (some (eqn (eqTy q) (eqLhs q) (eqRhs q2)))
        none)))))
  ; congruence: application, abstraction, pairs, projections, lists and the conditional
  (if (shape l k Rule.congApp 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (let f T (eqTy q)
        (if (isArrow f)
          (if (equal (eqTy q2) (child f 0))
            (some (eqn (child f 1) (app (eqLhs q) (eqLhs q2)) (app (eqRhs q) (eqRhs q2))))
            none)
          none))))))
  (if (shape l k Rule.congLam 2)
    (if (isTy c0)
      (bindO ((prem rs 1) (cons c0 ctx) (mapT (eqWk 1) hs)) (lam ((q T))
        (some (eqn (tyArrow c0 (eqTy q)) (node2 Label.lam c0 (eqLhs q))
                   (node2 Label.lam c0 (eqRhs q))))))
      none)
  (if (shape l k Rule.congPair 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (some (eqn (node2 Label.tyProd (eqTy q) (eqTy q2)) (node2 Label.pair (eqLhs q) (eqLhs q2))
                 (node2 Label.pair (eqRhs q) (eqRhs q2))))))))
  (if (shape l k Rule.congFst 1)
    (bindO ((prem rs 0) ctx hs) (lam ((q T))
      (if (isProd (eqTy q))
        (some (eqn (child (eqTy q) 0) (mk1 Label.fst (eqLhs q)) (mk1 Label.fst (eqRhs q))))
        none)))
  (if (shape l k Rule.congSnd 1)
    (bindO ((prem rs 0) ctx hs) (lam ((q T))
      (if (isProd (eqTy q))
        (some (eqn (child (eqTy q) 1) (mk1 Label.snd (eqLhs q)) (mk1 Label.snd (eqRhs q))))
        none)))
  (if (shape l k Rule.congCons 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (if (equal (eqTy q2) (tyList (eqTy q)))
        (some (eqn (eqTy q2) (node2 Label.cons (eqLhs q) (eqLhs q2))
                   (node2 Label.cons (eqRhs q) (eqRhs q2))))
        none)))))
  (if (shape l k Rule.congCond 3)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (bindO ((prem rs 2) ctx hs) (lam ((q3 T))
        (if (and (equal (eqTy q) Label.tyTree) (equal (eqTy q3) (eqTy q2)))
          (some (eqn (eqTy q2) (mk3 Label.cond (eqLhs q) (eqLhs q2) (eqLhs q3))
                     (mk3 Label.cond (eqRhs q) (eqRhs q2) (eqRhs q3))))
          none)))))))
  ; computation: the β and η rules of functions, pairs and the unit type
  (if (shape l k Rule.beta 3)
    (if (and (isTy c0) (hasType G ctx c2 c0))
      (bindO (typeIn G (cons c0 ctx) c1) (lam ((b T))
        (some (eqn b (app (node2 Label.lam c0 c1) c2) (subst c2 c1)))))
      none)
  (if (shape l k Rule.eta 1)
    (bindO (typeIn G ctx c0) (lam ((f T))
      (if (isArrow f)
        (if (isTy (child f 0))
            (some (eqn f c0 (node2 Label.lam (child f 0) (app (wk 1 c0) (var 0))))) none)
        none)))
  (if (shape l k Rule.betaFst 2)
    (bindO (typeIn G ctx c0) (lam ((a T)) (bindO (typeIn G ctx c1) (lam ((b T))
      (some (eqn a (mk1 Label.fst (node2 Label.pair c0 c1)) c0))))))
  (if (shape l k Rule.betaSnd 2)
    (bindO (typeIn G ctx c0) (lam ((a T)) (bindO (typeIn G ctx c1) (lam ((b T))
      (some (eqn b (mk1 Label.snd (node2 Label.pair c0 c1)) c1))))))
  (if (shape l k Rule.etaPair 1)
    (bindO (typeIn G ctx c0) (lam ((p T))
      (if (isProd p) (some (eqn p (node2 Label.pair (mk1 Label.fst c0) (mk1 Label.snd c0)) c0))
          none)))
  (if (shape l k Rule.etaUnit 1)
      (if (hasType G ctx c0 Label.tyUnit) (some (eqn Label.tyUnit c0 Label.unit)) none)
  ; a primitive at literals is the literal of its value
  (if (and (eq l Rule.delta) (lt 0 k))
    (let as Ts (tail cs)
      (if (nonEmpty ctx) none
        (if (allT isLit as)
          (let t T (apps (mk1 Label.prim c0) as)
            (bindO (typeIn G (nil T) t) (lam ((b T))
              (let v T (delta (label c0) (litValue (at as 0)) (litValue (at as 1)))
                (if (equal b Label.tyTree) (some (eqn b t (mk1 Label.quote v)))
                  (if (equal b (tyList Label.tyTree)) (some (eqn b t (listLit (children v))))
                      none))))))
          none)))
  ; weakening, cut and instantiation of the innermost variable
  (if (shape l k Rule.weaken 1)
    (lcase T T ctx none (lam ((a T) (ctx2 Ts))
      (bindO ((prem rs 0) ctx2 (nil T)) (lam ((q T)) (some (eqWk 1 q))))))
  (if (shape l k Rule.cut 2)
      (bindO ((prem rs 0) ctx hs) (lam ((h T)) ((prem rs 1) ctx (cons h hs))))
  (if (shape l k Rule.instVar 2)
    (bindO (typeIn G ctx c0) (lam ((a T))
      (bindO ((prem rs 1) (cons a ctx) (mapT (eqWk 1) hs)) (lam ((q T))
        (some (eqn (eqTy q) (subst c0 (eqLhs q)) (subst c0 (eqRhs q))))))))
  ; the right fold of lists at the empty list and at a list of a head and a tail
  (if (shape l k Rule.foldrNil 4)
    (if (and (isTy c0) (and (isTy c1)
          (and (hasType G ctx c2 (tyArrow c0 (tyArrow c1 c1))) (hasType G ctx c3 c1))))
      (some (eqn c1 (app3 (node2 Label.foldr c0 c1) c2 c3 (mk1 Label.nil c0)) c3))
      none)
  (if (shape l k Rule.foldrCons 6)
    (let x T (at cs 4)
      (let xs T (at cs 5)
        (let fr T (node2 Label.foldr c0 c1)
          (if (and (isTy c0) (and (isTy c1)
                (and (hasType G ctx c2 (tyArrow c0 (tyArrow c1 c1))) (and (hasType G ctx c3 c1)
                  (and (hasType G ctx x c0) (hasType G ctx xs (tyList c0)))))))
            (some (eqn c1 (app3 fr c2 c3 (node2 Label.cons x xs)) (app2 c2 x (app3 fr c2 c3 xs))))
            none))))
  ; induction on the innermost variable, a list: the case of the empty list, and the case of a
  ; head and a tail under the hypothesis for the tail
  (if (shape l k Rule.indList 4)
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (if (isListTy lt0)
        (let a T (child lt0 0)
          (bindO (typeIn G ctx c0) (lam ((b T))
            (let h0 Ts (mapT eqLower hs)
              (let c T (node2 Label.cons (var 1) (var 0))
                (let nl T (mk1 Label.nil a)
                  (if (and (isTy a) (and (hasType G ctx c1 b)
                        (and (weakens G ctx2 h0 hs)
                          (and (equal ((prem rs 2) ctx2 h0)
                                      (some (eqn b (subst nl c0) (subst nl c1))))
                            (equal ((prem rs 3) (cons lt0 (cons a ctx2))
                                     (cons (eqn b (wkAt 1 1 c0) (wkAt 1 1 c1)) (mapT (eqWk 2) h0)))
                                   (some (eqn b (subst c (wkAt 1 2 c0))
                                               (subst c (wkAt 1 2 c1)))))))))
                    (some (eqn b c0 c1))
                    none)))))))
        none)))
    none))))))))))))))))))))))))))))))

; the rules of case analysis of lists, iteration, the fold of trees, induction on trees and on
; labels, references to definitions and the conditional at a quoted tree, by the label of a
; certificate's node
(defn checkMore ((D Ts) (Th Ts) (G Ts) (l T) (cs Ts) (rs CRs) (ctx Ts) (hs Ts)) T
  (let k T (length cs)
  (let c0 T (at cs 0)
  (let c1 T (at cs 1)
  (let c2 T (at cs 2)
  (let c3 T (at cs 3)
  ; case analysis of lists at the empty list and at a list of a head and a tail
  (if (shape l k Rule.lcaseNil 4)
    (if (and (isTy c0) (and (isTy c1) (and (hasType G ctx c2 c1)
          (hasType G ctx c3 (tyArrow c0 (tyArrow (tyList c0) c1))))))
      (some (eqn c1 (app3 (node2 Label.lcase c0 c1) (mk1 Label.nil c0) c2 c3) c2))
      none)
  (if (shape l k Rule.lcaseCons 6)
    (let n T (at cs 4)
      (let c T (at cs 5)
        (if (and (isTy c0) (and (isTy c1) (and (hasType G ctx n c1)
              (and (hasType G ctx c (tyArrow c0 (tyArrow (tyList c0) c1)))
                (and (hasType G ctx c2 c0) (hasType G ctx c3 (tyList c0)))))))
          (some (eqn c1 (app3 (node2 Label.lcase c0 c1) (node2 Label.cons c2 c3) n c)
                     (app2 c c2 c3)))
          none)))
  ; iteration at the label zero and at the successor of a label
  (if (shape l k Rule.iterZero 3)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow c0 c0)) (hasType G ctx c2 c0)))
      (some (eqn c0 (app3 (mk1 Label.iter c0) c1 c2 (mk1 Label.quote 0)) c2))
      none)
  (if (shape l k Rule.iterSucc 4)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow c0 c0))
          (and (hasType G ctx c2 c0) (hasType G ctx c3 Label.tyTree))))
      (some (eqn c0
                 (app3 (mk1 Label.iter c0) c1 c2
                       (app2 (mk1 Label.prim Prim.add) c3 (mk1 Label.quote 1)))
                 (app c1 (app3 (mk1 Label.iter c0) c1 c2 c3))))
      none)
  ; the fold of trees at a node
  (if (shape l k Rule.foldNode 4)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow Label.tyTree (tyArrow (tyList c0) c0)))
          (and (hasType G ctx c2 Label.tyTree) (hasType G ctx c3 (tyList Label.tyTree)))))
      (some (eqn c0 (app2 (mk1 Label.fold c0) c1 (app2 (mk1 Label.prim Prim.node) c2 c3))
                 (app2 c1 (app (mk1 Label.prim Prim.label) c2)
                       (mapBy Label.tyTree c0 (app2 (mk1 Label.fold c0) (wk 2 c1) (var 1)) c3))))
      none)
  ; induction on the innermost variable, a tree, under the hypothesis for its children
  (if (shape l k Rule.indTree 3)
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (bindO (typeIn G ctx c0) (lam ((b T))
        (let h0 Ts (mapT eqLower hs)
          (let nd T (app2 (mk1 Label.prim Prim.node) (var 1) (var 0))
            (if (and (equal lt0 Label.tyTree) (and (isTy b) (and (hasType G ctx c1 b)
                  (and (weakens G ctx2 h0 hs)
                    (equal ((prem rs 2) (cons (tyList Label.tyTree) (cons Label.tyTree ctx2))
                             (cons (eqn (tyList b)
                                        (mapBy Label.tyTree b (subst (var 1) (wkAt 1 4 c0)) (var 0))
                                     (mapBy Label.tyTree b (subst (var 1) (wkAt 1 4 c1)) (var 0)))
                                   (mapT (eqWk 2) h0)))
                           (some (eqn b (subst nd (wkAt 1 2 c0))
                                      (subst nd (wkAt 1 2 c1)))))))))
              (some (eqn b c0 c1))
              none)))))))
  ; induction on the label of the innermost variable, a tree
  (if (shape l k Rule.indLabel 4)
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (bindO (typeIn G ctx c0) (lam ((b T))
        (let h0 Ts (mapT eqLower hs)
          (let suc T (app2 (mk1 Label.prim Prim.add) (var 0) (mk1 Label.quote 1))
            (let lab T (app (mk1 Label.prim Prim.label) (var 0))
              (if (and (equal lt0 Label.tyTree) (and (hasType G ctx c1 b)
                    (and (weakens G ctx2 h0 hs)
                      (and (equal ((prem rs 2) ctx2 h0)
                                  (some (eqn b (subst (mk1 Label.quote 0) c0)
                                             (subst (mk1 Label.quote 0) c1))))
                        (equal ((prem rs 3) ctx (cons (eqn b c0 c1) hs))
                               (some (eqn b (subst suc (wkAt 1 1 c0))
                                           (subst suc (wkAt 1 1 c1)))))))))
                (some (eqn b (subst lab (wkAt 1 1 c0)) (subst lab (wkAt 1 1 c1))))
                none))))))))
  ; a reference to a definition is the definition, weakened into the context
  (if (shape l k Rule.unfold 1)
    (bindO (nth D (label c0)) (lam ((t T))
      (bindO (typeIn G ctx (mk1 Label.ref c0)) (lam ((a T))
        (some (eqn a (mk1 Label.ref c0) (wk (length ctx) t)))))))
  ; the conditional at a quoted tree
  (if (shape l k Rule.condQuote 3)
    (bindO (typeIn G ctx c1) (lam ((a T))
      (if (hasType G ctx c2 a)
          (some (eqn a (mk3 Label.cond (mk1 Label.quote c0) c1 c2) (if c0 c1 c2))) none)))
  ; an instance of an axiom, each variable replaced by a term of its type
  (if (and (eq l Rule.ax) (lt 0 k)) (bindO (nth axioms (label c0)) (cite G ctx (tail cs)))
  ; iteration reads the label of the tree it iterates over
  (if (shape l k Rule.iterLabel 4)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow c0 c0))
          (and (hasType G ctx c2 c0) (hasType G ctx c3 Label.tyTree))))
      (some (eqn c0 (app3 (mk1 Label.iter c0) c1 c2 c3)
                 (app3 (mk1 Label.iter c0) c1 c2 (app (mk1 Label.prim Prim.label) c3))))
      none)
  ; the conditional is the iteration of a constant function from its second branch
  (if (shape l k Rule.condIter 4)
    (if (and (isTy c0)
             (and (hasType G ctx c1 Label.tyTree)
                  (and (hasType G ctx c2 c0) (hasType G ctx c3 c0))))
      (some (eqn c0 (mk3 Label.cond c1 c2 c3)
                 (app3 (mk1 Label.iter c0) (node2 Label.lam c0 (wk 1 c2)) c3 c1)))
      none)
  ; an instance of a theorem, each variable replaced by a term of its type
  (if (and (eq l Rule.thm) (lt 0 k)) (bindO (nth Th (label c0)) (cite G ctx (tail cs)))
    none)))))))))))))))))))

; the checker: the conclusion of a certificate, given a program's definitions, theorems about
; it, the types of its global environment, a context and a list of hypotheses
(defn checkCert ((D Ts) (Th Ts) (G Ts) (c T) (ctx Ts) (hs Ts)) T
  ((snd (fold CR
     (lam ((l T) (rs CRs))
       (let cs Ts (crTrees rs)
         (pair (node l cs)
           (lam ((ctx Ts) (hs Ts))
             (if (lt l Rule.lcaseNil) (checkCore D G l cs rs ctx hs)
                 (checkMore D Th G l cs rs ctx hs))))))
     c))
   ctx hs))
