;
; The first rung of the metalogic's proof checker, written in Surface 1: the conclusion of a
; certificate, given a program's definitions, the types of the global environment they load, a
; context, innermost first, and a list of hypotheses, or nothing when the certificate does not
; check, deciding as Geb.Metalogic.check decides. An equation is the node of label 0 over its
; type and its two sides; an optional equation is represented as the reader represents optional
; trees. Requires the prelude, the reader and the checker.

(data Eqn (eqn T T T))
(defn eqTy ((q T)) T (case q ((eqn a s t) a)))
(defn eqLhs ((q T)) T (case q ((eqn a s t) s)))
(defn eqRhs ((q T)) T (case q ((eqn a s t) t)))

; optional trees: the result of a function at the tree an optional tree holds
(defn bindO ((m T) (f (Arrow T T))) T (if (isSome m) (f (get m)) none))

; the disjunction of two tests
(def or (lam ((a T) (b T)) (if a 1 b)))

; lists of trees: a function at every element, and whether a test holds at every element
(defn mapT ((f (Arrow T T)) (xs Ts)) Ts (foldr T Ts (lam ((x T) (r Ts)) (cons (f x) r)) (nil T) xs))
(defn allT ((f (Arrow T T)) (xs Ts)) T (foldr T T (lam ((x T) (r T)) (and (f x) r)) 1 xs))

; kernel terms and types
(defn mk1 ((l T) (a T)) T (node l (single a)))
(defn mk3 ((l T) (a T) (b T) (c T)) T (node l (cons a (cons b (single c)))))
(defn var ((i T)) T (mk1 8 i))
(defn app2 ((f T) (x T) (y T)) T (app (app f x) y))
(defn app3 ((f T) (x T) (y T) (z T)) T (app (app (app f x) y) z))
(defn hasType ((G Ts) (ctx Ts) (t T) (a T)) T
  (let r T (typeIn G ctx t) (if (isSome r) (equal (get r) a) 0)))

; the traversal of a term replacing each variable: the variable of index i under k binders
; becomes v k i, and every other node is rebuilt, descending only into the children that are
; terms, the body of an abstraction at one more binder
(deftype TR (Prod T (Arrow T T)))
(deftype TRs (List TR))
(defn trTrees ((rs TRs)) Ts (foldr TR Ts (lam ((r TR) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn trAll ((rs TRs) (k T)) Ts
  (foldr TR Ts (lam ((r TR) (acc Ts)) (cons ((snd r) k) acc)) (nil T) rs))
(defn termNode ((l T)) T
  (or (eq l 10) (or (eq l 11) (or (eq l 12) (or (eq l 13)
    (or (eq l 14) (or (eq l 16) (eq l 20))))))))
(defn trav ((v (Arrow T (Arrow T T))) (t T) (k0 T)) T
  ((snd (fold TR
     (lam ((l T) (rs TRs))
       (let cs Ts (trTrees rs)
         (let n T (length cs)
           (pair (node l cs)
             (lam ((k T))
               (if (and (eq l 8) (eq n 1)) (v k (label (at cs 0)))
               (if (and (eq l 9) (eq n 2)) (node2 9 (at cs 0) (at (trAll rs (add k 1)) 1))
               (if (termNode l) (node l (trAll rs k)) (node l cs)))))))))
     t))
   k0))

; weakening by n variables below k bound ones, and substitution for the innermost variable
(defn wkVar ((n T) (k T) (i T)) T (var (if (lt i k) i (add i n))))
(defn wk ((n T) (t T)) T (trav (wkVar n) t 0))
(defn wkAt ((k T) (n T) (t T)) T (trav (wkVar n) t k))
(defn substVar ((u T) (k T) (i T)) T (if (lt i k) (var i) (if (eq i k) (wk k u) (var (sub i 1)))))
(defn subst ((u T) (t T)) T (trav (substVar u) t 0))

; equations weakened, lowered below their innermost variable, and typed in a context
(defn eqWk ((n T) (q T)) T (eqn (eqTy q) (wk n (eqLhs q)) (wk n (eqRhs q))))
(defn eqLower ((q T)) T (eqn (eqTy q) (subst (mk1 15 0) (eqLhs q)) (subst (mk1 15 0) (eqRhs q))))
(defn typedIn ((G Ts) (ctx Ts) (q T)) T
  (and (hasType G ctx (eqLhs q) (eqTy q)) (hasType G ctx (eqRhs q) (eqTy q))))
; whether hypotheses are the weakenings of equations typed in the context below
(defn weakens ((G Ts) (ctx Ts) (h0 Ts) (hs Ts)) T
  (and (equal (node 0 (mapT (eqWk 1) h0)) (node 0 hs)) (allT (typedIn G ctx) h0)))

; the list of a function's values at the elements of a list, by the right fold
(defn mapBy ((a T) (b T) (body T) (xs T)) T
  (app3 (node2 21 a (tyList b)) (node2 9 a (node2 9 (tyList b) (node2 20 body (var 0))))
        (mk1 19 b) xs))

; literals: a quoted tree, and a list of quoted trees, whose trees are held by a node over them
(defn isQuote ((t T)) T (and (eq (label t) 15) (eq (arity t) 1)))
(defn listElems ((t T)) T
  (snd (fold RT
    (lam ((l T) (rs RTs))
      (let cs Ts (rtTrees rs)
        (let n T (length cs)
          (pair (node l cs)
            (if (and (eq l 19) (eq n 1)) (some (node 0 (nil T)))
            (if (and (eq l 20) (eq n 2))
              (let r T (at (rtValues rs) 1)
                (if (and (isQuote (at cs 0)) (isSome r))
                  (some (node 0 (cons (child (at cs 0) 0) (children (get r)))))
                  none))
              none))))))
    t)))
(defn isLit ((t T)) T (or (isQuote t) (isSome (listElems t))))
(defn litValue ((t T)) T (if (isQuote t) (child t 0) (get (listElems t))))
(defn listLit ((xs Ts)) T (foldr T T (lam ((x T) (r T)) (node2 20 (mk1 15 x) r)) (mk1 19 0) xs))

; the value of the primitive of index k at the values of literals, a list as a node over it
(defn delta ((k T) (a T) (b T)) T
  (if (eq k 0) (label a) (if (eq k 1) (arity a) (if (eq k 2) (child a b)
  (if (eq k 3) (node a (children b)) (if (eq k 4) (node 0 (children a)) (if (eq k 5) (add a b)
  (if (eq k 6) (sub a b) (if (eq k 7) (mul a b) (if (eq k 8) (div a b) (if (eq k 9) (mod a b)
  (if (eq k 10) (eq a b) (if (eq k 11) (lt a b) (if (eq k 12) (equal a b) (log2 a)))))))))))))))

; a certificate with its conclusion as a function of the context and the hypotheses
(deftype Concl (Arrow Ts (Arrow Ts T)))
(deftype CR (Prod T Concl))
(deftype CRs (List CR))
(defn crTrees ((rs CRs)) Ts (foldr CR Ts (lam ((r CR) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn crTail ((rs CRs)) CRs (lcase CR CRs rs (nil CR) (lam ((r CR) (rest CRs)) rest)))
(defn prem ((rs CRs) (i T)) Concl
  (lcase CR Concl (iter CRs crTail rs i) (lam ((ctx Ts) (hs Ts)) none)
    (lam ((r CR) (rest CRs)) (snd r))))
(defn shape ((l T) (k T) (m T) (n T)) T (and (eq l m) (eq k n)))

; the rules of equality, congruence, computation, substitution, the right fold of lists and
; induction on lists, by the label of a certificate's node, with its children and their results
(defn checkCore ((D Ts) (G Ts) (l T) (cs Ts) (rs CRs) (ctx Ts) (hs Ts)) T
  (let k T (length cs)
  (let c0 T (at cs 0)
  (let c1 T (at cs 1)
  (let c2 T (at cs 2)
  (let c3 T (at cs 3)
  ; a hypothesis, by index
  (if (shape l k 0 1)
    (bindO (nth hs (label c0)) (lam ((q T)) (if (typedIn G ctx q) (some q) none)))
  ; reflexivity, symmetry and transitivity
  (if (shape l k 1 1) (bindO (typeIn G ctx c0) (lam ((a T)) (some (eqn a c0 c0))))
  (if (shape l k 2 1)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (some (eqn (eqTy q) (eqRhs q) (eqLhs q)))))
  (if (shape l k 3 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (if (and (equal (eqTy q) (eqTy q2)) (equal (eqRhs q) (eqLhs q2)))
        (some (eqn (eqTy q) (eqLhs q) (eqRhs q2)))
        none)))))
  ; congruence: application, abstraction, pairs, projections, lists and the conditional
  (if (shape l k 4 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (let f T (eqTy q)
        (if (isArrow f)
          (if (equal (eqTy q2) (child f 0))
            (some (eqn (child f 1) (app (eqLhs q) (eqLhs q2)) (app (eqRhs q) (eqRhs q2))))
            none)
          none))))))
  (if (shape l k 5 2)
    (if (isTy c0)
      (bindO ((prem rs 1) (cons c0 ctx) (mapT (eqWk 1) hs)) (lam ((q T))
        (some (eqn (tyArrow c0 (eqTy q)) (node2 9 c0 (eqLhs q)) (node2 9 c0 (eqRhs q))))))
      none)
  (if (shape l k 6 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (some (eqn (node2 2 (eqTy q) (eqTy q2)) (node2 12 (eqLhs q) (eqLhs q2))
                 (node2 12 (eqRhs q) (eqRhs q2))))))))
  (if (shape l k 7 1)
    (bindO ((prem rs 0) ctx hs) (lam ((q T))
      (if (isProd (eqTy q))
        (some (eqn (child (eqTy q) 0) (mk1 13 (eqLhs q)) (mk1 13 (eqRhs q))))
        none)))
  (if (shape l k 8 1)
    (bindO ((prem rs 0) ctx hs) (lam ((q T))
      (if (isProd (eqTy q))
        (some (eqn (child (eqTy q) 1) (mk1 14 (eqLhs q)) (mk1 14 (eqRhs q))))
        none)))
  (if (shape l k 9 2)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (if (equal (eqTy q2) (tyList (eqTy q)))
        (some (eqn (eqTy q2) (node2 20 (eqLhs q) (eqLhs q2)) (node2 20 (eqRhs q) (eqRhs q2))))
        none)))))
  (if (shape l k 10 3)
    (bindO ((prem rs 0) ctx hs) (lam ((q T)) (bindO ((prem rs 1) ctx hs) (lam ((q2 T))
      (bindO ((prem rs 2) ctx hs) (lam ((q3 T))
        (if (and (equal (eqTy q) 0) (equal (eqTy q3) (eqTy q2)))
          (some (eqn (eqTy q2) (mk3 16 (eqLhs q) (eqLhs q2) (eqLhs q3))
                     (mk3 16 (eqRhs q) (eqRhs q2) (eqRhs q3))))
          none)))))))
  ; computation: the β and η rules of functions, pairs and the unit type
  (if (shape l k 11 3)
    (if (and (isTy c0) (hasType G ctx c2 c0))
      (bindO (typeIn G (cons c0 ctx) c1) (lam ((b T))
        (some (eqn b (app (node2 9 c0 c1) c2) (subst c2 c1)))))
      none)
  (if (shape l k 12 1)
    (bindO (typeIn G ctx c0) (lam ((f T))
      (if (isArrow f)
        (if (isTy (child f 0)) (some (eqn f c0 (node2 9 (child f 0) (app (wk 1 c0) (var 0))))) none)
        none)))
  (if (shape l k 13 2)
    (bindO (typeIn G ctx c0) (lam ((a T)) (bindO (typeIn G ctx c1) (lam ((b T))
      (some (eqn a (mk1 13 (node2 12 c0 c1)) c0))))))
  (if (shape l k 14 2)
    (bindO (typeIn G ctx c0) (lam ((a T)) (bindO (typeIn G ctx c1) (lam ((b T))
      (some (eqn b (mk1 14 (node2 12 c0 c1)) c1))))))
  (if (shape l k 15 1)
    (bindO (typeIn G ctx c0) (lam ((p T))
      (if (isProd p) (some (eqn p (node2 12 (mk1 13 c0) (mk1 14 c0)) c0)) none)))
  (if (shape l k 16 1) (if (hasType G ctx c0 1) (some (eqn 1 c0 11)) none)
  ; a primitive at literals is the literal of its value
  (if (and (eq l 17) (lt 0 k))
    (let as Ts (tail cs)
      (if (nonEmpty ctx) none
        (if (allT isLit as)
          (let t T (apps (mk1 22 c0) as)
            (bindO (typeIn G (nil T) t) (lam ((b T))
              (let v T (delta (label c0) (litValue (at as 0)) (litValue (at as 1)))
                (if (equal b 0) (some (eqn b t (mk1 15 v)))
                  (if (equal b (tyList 0)) (some (eqn b t (listLit (children v)))) none))))))
          none)))
  ; weakening, cut and instantiation of the innermost variable
  (if (shape l k 18 1)
    (lcase T T ctx none (lam ((a T) (ctx2 Ts))
      (bindO ((prem rs 0) ctx2 (nil T)) (lam ((q T)) (some (eqWk 1 q))))))
  (if (shape l k 19 2) (bindO ((prem rs 0) ctx hs) (lam ((h T)) ((prem rs 1) ctx (cons h hs))))
  (if (shape l k 20 2)
    (bindO (typeIn G ctx c0) (lam ((a T))
      (bindO ((prem rs 1) (cons a ctx) (mapT (eqWk 1) hs)) (lam ((q T))
        (some (eqn (eqTy q) (subst c0 (eqLhs q)) (subst c0 (eqRhs q))))))))
  ; the right fold of lists at the empty list and at a list of a head and a tail
  (if (shape l k 21 4)
    (if (and (isTy c0) (and (isTy c1)
          (and (hasType G ctx c2 (tyArrow c0 (tyArrow c1 c1))) (hasType G ctx c3 c1))))
      (some (eqn c1 (app3 (node2 21 c0 c1) c2 c3 (mk1 19 c0)) c3))
      none)
  (if (shape l k 22 6)
    (let x T (at cs 4)
      (let xs T (at cs 5)
        (let fr T (node2 21 c0 c1)
          (if (and (isTy c0) (and (isTy c1)
                (and (hasType G ctx c2 (tyArrow c0 (tyArrow c1 c1))) (and (hasType G ctx c3 c1)
                  (and (hasType G ctx x c0) (hasType G ctx xs (tyList c0)))))))
            (some (eqn c1 (app3 fr c2 c3 (node2 20 x xs)) (app2 c2 x (app3 fr c2 c3 xs))))
            none))))
  ; induction on the innermost variable, a list: the case of the empty list, and the case of a
  ; head and a tail under the hypothesis for the tail
  (if (shape l k 23 4)
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (if (isListTy lt0)
        (let a T (child lt0 0)
          (bindO (typeIn G ctx c0) (lam ((b T))
            (let h0 Ts (mapT eqLower hs)
              (let c T (node2 20 (var 1) (var 0))
                (let nl T (mk1 19 a)
                  (if (and (isTy a) (and (hasType G ctx c1 b)
                        (and (weakens G ctx2 h0 hs)
                          (and (equal ((prem rs 2) ctx2 h0)
                                      (some (eqn b (subst nl c0) (subst nl c1))))
                            (equal ((prem rs 3) (cons lt0 (cons a ctx2))
                                     (cons (eqn b (wkAt 1 1 c0) (wkAt 1 1 c1)) (mapT (eqWk 2) h0)))
                                   (some (eqn b (subst c (wkAt 1 2 c0))
                                               (subst c (wkAt 1 2 c1)))))))))
                    (some (eqn b c0 c1))
                    none)))))))
        none)))
    none))))))))))))))))))))))))))))))

; the rules of case analysis of lists, iteration, the fold of trees, induction on trees and on
; labels, references to definitions and the conditional at a quoted tree, by the label of a
; certificate's node
(defn checkMore ((D Ts) (G Ts) (l T) (cs Ts) (rs CRs) (ctx Ts) (hs Ts)) T
  (let k T (length cs)
  (let c0 T (at cs 0)
  (let c1 T (at cs 1)
  (let c2 T (at cs 2)
  (let c3 T (at cs 3)
  ; case analysis of lists at the empty list and at a list of a head and a tail
  (if (shape l k 24 4)
    (if (and (isTy c0) (and (isTy c1) (and (hasType G ctx c2 c1)
          (hasType G ctx c3 (tyArrow c0 (tyArrow (tyList c0) c1))))))
      (some (eqn c1 (app3 (node2 24 c0 c1) (mk1 19 c0) c2 c3) c2))
      none)
  (if (shape l k 25 6)
    (let n T (at cs 4)
      (let c T (at cs 5)
        (if (and (isTy c0) (and (isTy c1) (and (hasType G ctx n c1)
              (and (hasType G ctx c (tyArrow c0 (tyArrow (tyList c0) c1)))
                (and (hasType G ctx c2 c0) (hasType G ctx c3 (tyList c0)))))))
          (some (eqn c1 (app3 (node2 24 c0 c1) (node2 20 c2 c3) n c) (app2 c c2 c3)))
          none)))
  ; iteration at the label zero and at the successor of a label
  (if (shape l k 26 3)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow c0 c0)) (hasType G ctx c2 c0)))
      (some (eqn c0 (app3 (mk1 18 c0) c1 c2 (mk1 15 0)) c2))
      none)
  (if (shape l k 27 4)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow c0 c0))
          (and (hasType G ctx c2 c0) (hasType G ctx c3 0))))
      (some (eqn c0 (app3 (mk1 18 c0) c1 c2 (app2 (mk1 22 5) c3 (mk1 15 1)))
                 (app c1 (app3 (mk1 18 c0) c1 c2 c3))))
      none)
  ; the fold of trees at a node
  (if (shape l k 28 4)
    (if (and (isTy c0) (and (hasType G ctx c1 (tyArrow 0 (tyArrow (tyList c0) c0)))
          (and (hasType G ctx c2 0) (hasType G ctx c3 (tyList 0)))))
      (some (eqn c0 (app2 (mk1 17 c0) c1 (app2 (mk1 22 3) c2 c3))
                 (app2 c1 (app (mk1 22 0) c2)
                       (mapBy 0 c0 (app2 (mk1 17 c0) (wk 2 c1) (var 1)) c3))))
      none)
  ; induction on the innermost variable, a tree, under the hypothesis for its children
  (if (shape l k 29 3)
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (bindO (typeIn G ctx c0) (lam ((b T))
        (let h0 Ts (mapT eqLower hs)
          (let nd T (app2 (mk1 22 3) (var 1) (var 0))
            (if (and (equal lt0 0) (and (isTy b) (and (hasType G ctx c1 b)
                  (and (weakens G ctx2 h0 hs)
                    (equal ((prem rs 2) (cons (tyList 0) (cons 0 ctx2))
                             (cons (eqn (tyList b) (mapBy 0 b (subst (var 1) (wkAt 1 4 c0)) (var 0))
                                     (mapBy 0 b (subst (var 1) (wkAt 1 4 c1)) (var 0)))
                                   (mapT (eqWk 2) h0)))
                           (some (eqn b (subst nd (wkAt 1 2 c0))
                                      (subst nd (wkAt 1 2 c1)))))))))
              (some (eqn b c0 c1))
              none)))))))
  ; induction on the label of the innermost variable, a tree
  (if (shape l k 30 4)
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (bindO (typeIn G ctx c0) (lam ((b T))
        (let h0 Ts (mapT eqLower hs)
          (let suc T (app2 (mk1 22 5) (var 0) (mk1 15 1))
            (let lab T (app (mk1 22 0) (var 0))
              (if (and (equal lt0 0) (and (hasType G ctx c1 b)
                    (and (weakens G ctx2 h0 hs)
                      (and (equal ((prem rs 2) ctx2 h0)
                                  (some (eqn b (subst (mk1 15 0) c0) (subst (mk1 15 0) c1))))
                        (equal ((prem rs 3) ctx (cons (eqn b c0 c1) hs))
                               (some (eqn b (subst suc (wkAt 1 1 c0))
                                           (subst suc (wkAt 1 1 c1)))))))))
                (some (eqn b (subst lab (wkAt 1 1 c0)) (subst lab (wkAt 1 1 c1))))
                none))))))))
  ; a reference to a definition is the definition, weakened into the context
  (if (shape l k 31 1)
    (bindO (nth D (label c0)) (lam ((t T))
      (bindO (typeIn G ctx (mk1 23 c0)) (lam ((a T))
        (some (eqn a (mk1 23 c0) (wk (length ctx) t)))))))
  ; the conditional at a quoted tree
  (if (shape l k 32 3)
    (bindO (typeIn G ctx c1) (lam ((a T))
      (if (hasType G ctx c2 a) (some (eqn a (mk3 16 (mk1 15 c0) c1 c2) (if c0 c1 c2))) none)))
    none)))))))))))))))

; the checker: the conclusion of a certificate, given a program's definitions, the types of its
; global environment, a context and a list of hypotheses
(defn checkCert ((D Ts) (G Ts) (c T) (ctx Ts) (hs Ts)) T
  ((snd (fold CR
     (lam ((l T) (rs CRs))
       (let cs Ts (crTrees rs)
         (pair (node l cs)
           (lam ((ctx Ts) (hs Ts))
             (if (lt l 24) (checkCore D G l cs rs ctx hs) (checkMore D G l cs rs ctx hs))))))
     c))
   ctx hs))
