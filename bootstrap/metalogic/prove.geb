;
; Proof construction for the first rung of the metalogic, written in Surface 1: derived rules
; that compute certificates the checker of bootstrap/metalogic/equations.geb accepts, so that
; nothing here is trusted. Normalization, innermost first, returns a term's normal form with the
; certificate of the equation between them, contracting the redexes of the computation rules and
; rewriting with the rules a tactic names; a goal is proved when both of its sides normalize to
; one term, and induction splits it into the goals the checker's induction rules expect. A
; rewritten term is represented with its certificate as the node of label 0 over both. Requires
; the prelude, the reader, the checker, the Surface 1 expansion and the metalogic's checker.

; certificates, by rule
(defn cRefl ((t T)) T (mk1 Rule.refl t))
(defn cSym ((p T)) T (mk1 Rule.symm p))
(defn cTrans ((p T) (q T)) T (node2 Rule.trans p q))
(defn weakenN ((c T) (n T)) T (iter T (lam ((c T)) (mk1 Rule.weaken c)) c n))

; the negation of a test
(def not (lam ((a T)) (if a 0 1)))

; rewritten terms with their certificates
(defn res ((t T) (c T)) T (some (node2 0 t c)))
(defn resTerm ((r T)) T (child r 0))
(defn resCert ((r T)) T (child r 1))

; the list of a list's elements with the one at an index replaced
(defn setAt ((xs Ts) (i T) (v T)) Ts
  ((foldr T (Arrow T Ts) (lam ((x T) (k (Arrow T Ts)) (j T)) (cons (if (eq j i) v x) (k (add j 1))))
     (lam ((j T)) (nil T)) xs)
   0))

; a term's free variables lowered by k, when none of them is below k
(defn shiftDown ((k T) (t T)) T
  (trav (lam ((kk T) (j T)) (if (lt j kk) (var j) (var (sub j k)))) t 0))
(defn lowers ((k T) (t T)) T (equal (wk k (shiftDown k t)) t))

; first-order matching of a pattern, whose free variables are metavariables, against a term,
; under k binders of both: the substitution, a list of optional terms, extended, or nothing
(deftype MF (Arrow T (Arrow T (Arrow Ts T))))
(deftype MR (Prod T MF))
(deftype MRs (List MR))
(defn mrRaws ((rs MRs)) Ts (foldr MR Ts (lam ((r MR) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn mrTail ((rs MRs)) MRs (lcase MR MRs rs (nil MR) (lam ((r MR) (rest MRs)) rest)))
(defn mrFn ((rs MRs) (i T)) MF
  (lcase MR MF (iter MRs mrTail rs i) (lam ((t T) (k T) (s Ts)) none)
      (lam ((r MR) (rest MRs)) (snd r))))
(defn matchKids ((rs MRs) (ts Ts) (k T) (s T)) T
  ((foldr MR (Arrow Ts (Arrow T T))
     (lam ((r MR) (kf (Arrow Ts (Arrow T T))) (ts Ts) (s T))
       (lcase T T ts none
         (lam ((t T) (rest Ts)) (bindO ((snd r) t k (children s)) (lam ((s2 T)) (kf rest s2))))))
     (lam ((ts Ts) (s T)) (some s)) rs)
   ts s))
(defn matchPat ((p T)) MF
  (snd (fold MR
    (lam ((l T) (rs MRs))
      (let cs Ts (mrRaws rs)
        (let raw T (node l cs)
          (let n T (length cs)
            (pair raw
              (lam ((t T) (k T) (s Ts))
                (if (and (eq l Label.var) (eq n 1))
                  (let i T (label (at cs 0))
                    (if (lt i k)
                      (if (equal t (var i)) (some (node 0 s)) none)
                      (let m T (sub i k)
                        (if (lowers k t)
                          (let u T (shiftDown k t)
                            (let e T (at s m)
                              (if (isSome e)
                                (if (equal (get e) u) (some (node 0 s)) none)
                                (some (node 0 (setAt s m (some u)))))))
                          none))))
                (if (and (eq l Label.lam) (eq n 2))
                  (if (and (eq (label t) Label.lam)
                           (and (eq (arity t) 2) (equal (child t 0) (at cs 0))))
                    ((mrFn rs 1) (child t 1) (add k 1) s)
                    none)
                (if (termNode l)
                  (if (and (eq (label t) l) (eq (arity t) n))
                    (matchKids rs (children t) k (node 0 s))
                    none)
                  (if (equal t raw) (some (node 0 s)) none))))))))))
    p)))
(defn matchT ((p T) (n T) (t T)) T (matchPat p t 0 (replicate n none)))

; rewriting rules: a lemma, the node of label 0 over its index among the axioms and the
; theorems, its context, the side it rewrites and the side it rewrites to, the latter the
; left side when the lemma is used backward; and a hypothesis or other concrete equation, the
; node of label 1 over the term it rewrites, the term it rewrites to and the certificate
(defn lemmaRule ((Th Ts) (j T) (back T)) T
  (bindO (nth (append axioms Th) j) (lam ((th T))
    (let q T (child th 1)
      (some (node 0 (cons j (cons (child th 0) (cons (if back (eqRhs q) (eqLhs q))
                                                 (cons (if back (eqLhs q) (eqRhs q))
                                                     (single back)))))))))))
; the certificate citing the lemma of an index among the axioms and the theorems, at terms
(defn citation ((j T) (us Ts)) T
  (let na T (length axioms)
    (if (lt j na) (node Rule.ax (cons j us)) (node Rule.thm (cons (sub j na) us)))))
(defn applyRule ((G Ts) (ctx Ts) (t T) (r T)) T
  (let cs Ts (children r)
    (if (eq (label r) 2) none
    (if (eq (label r) 1)
      (if (equal (at cs 0) t) (res (at cs 1) (at cs 2)) none)
    (if (not (eq (label (at cs 2)) (label t))) none
      (let tctx Ts (children (at cs 1))
        (bindO (matchT (at cs 2) (length tctx) t) (lam ((sg T))
          (bindO (allSome (children sg)) (lam ((us T))
            (if (typesMatch G ctx (children us) tctx)
              (let q T (instAll (children us)
                         (eqWkAt (length tctx) (length ctx) (eqn Label.tyTree (at cs 2) (at cs 3))))
                (let c T (citation (at cs 0) (children us))
                  (if (equal (eqLhs q) t)
                    (res (eqRhs q) (if (at cs 4) (cSym c) c))
                    none)))
              none)))))))))))
(defn applyRules ((G Ts) (ctx Ts) (t T) (rules Ts)) T
  (foldr T T (lam ((r T) (acc T)) (let x T (applyRule G ctx t r) (if (isSome x) x acc)))
      none rules))

; the head redexes: unfolding a chosen definition, β, the projections of a pair, the
; conditional at a quoted tree, and the computation rules of iteration, the right fold, case
; analysis of lists and the fold of trees, literals first put in constructor form by a δ rule
; used backward; and δ at literals, weakened into the context
(defn primArity ((k T)) T
  (if (eq k Prim.label) 1
      (if (eq k Prim.arity) 1 (if (eq k Prim.children) 1 (if (eq k Prim.log2) 1 2)))))
(defn isNum1 ((t T)) T (equal t (num 1)))
(defn deltaRedex ((k T) (as Ts) (ctx Ts)) T
  (if (and (eq (length as) (primArity k)) (allT isLit as))
    (let v T (delta k (litValue (at as 0)) (litValue (at as 1)))
      (res (if (eq k Prim.children) (listLit (children v)) (mk1 Label.quote v))
           (weakenN (node Rule.delta (cons k as)) (length ctx))))
    none))
(defn iterLabelOn ((R Ts)) T (foldr T T (lam ((r T) (acc T)) (if (eq (label r) 2) 1 acc)) 0 R))
(defn isLabelOf ((t T)) T
      (and (eq (label t) Label.app) (equal (child t 0) (mk1 Label.prim Prim.label))))
(defn iterRedex ((R Ts) (hd T) (as Ts) (ctx Ts)) T
  (let a T (child hd 0)
    (let s T (at as 0)
      (let z T (at as 1)
        (let n T (at as 2)
          (if (isQuote n)
            (let q T (child n 0)
              (if (eq (arity q) 0)
                (if (eq (label q) 0)
                  (res z (mk3 Rule.iterZero a s z))
                  (let m T (num (sub (label q) 1))
                    (res (app s (app3 hd s z m))
                      (cTrans (node2 Rule.congApp (cRefl (app2 hd s z))
                                 (cSym (weakenN (mk3 Rule.delta Prim.add m (num 1)) (length ctx))))
                              (node Rule.iterSucc (cons a (cons s (cons z (single m)))))))))
                (res (app3 hd s z (app (mk1 Label.prim Prim.label) n))
                    (node Rule.iterLabel (cons a (cons s (cons z (single n))))))))
            (if (and (eq (label n) Label.app) (and (isNum1 (child n 1))
                  (equal (child (child n 0) 0) (mk1 Label.prim Prim.add))))
              (let m T (child (child n 0) 1)
                (res (app s (app3 hd s z m))
                     (node Rule.iterSucc (cons a (cons s (cons z (single m)))))))
              (if (and (iterLabelOn R) (not (isLabelOf n)))
                (res (app3 hd s z (app (mk1 Label.prim Prim.label) n))
                    (node Rule.iterLabel (cons a (cons s (cons z (single n))))))
                none))))))))
(defn foldrRedex ((hd T) (as Ts)) T
  (let a T (child hd 0)
    (let b T (child hd 1)
      (let g T (at as 0)
        (let z T (at as 1)
          (let xs T (at as 2)
            (if (eq (label xs) Label.nil)
              (res z (node Rule.foldrNil (cons a (cons b (cons g (single z))))))
            (if (eq (label xs) Label.cons)
              (let x T (child xs 0)
                (let r T (child xs 1)
                  (res (app2 g x (app3 hd g z r))
                    (node Rule.foldrCons (cons a (cons b (cons g (cons z (cons x (single r))))))))))
              none))))))))
(defn lcaseRedex ((hd T) (as Ts)) T
  (let a T (child hd 0)
    (let b T (child hd 1)
      (let xs T (at as 0)
        (let n T (at as 1)
          (let c T (at as 2)
            (if (eq (label xs) Label.nil)
              (res n (node Rule.lcaseNil (cons a (cons b (cons n (single c))))))
            (if (eq (label xs) Label.cons)
              (let x T (child xs 0)
                (let r T (child xs 1)
                  (res (app2 c x r)
                      (node Rule.lcaseCons
                            (cons a (cons b (cons x (cons r (cons n (single c))))))))))
              none))))))))
(defn foldStep ((hd T) (f T) (x T) (xs T)) T
  (app2 f (app (mk1 Label.prim Prim.label) x)
        (mapBy Label.tyTree (child hd 0) (app2 hd (wk 2 f) (var 1)) xs)))
(defn foldRedex ((hd T) (as Ts) (ctx Ts)) T
  (let a T (child hd 0)
    (let f T (at as 0)
      (let t T (at as 1)
        (if (and (eq (label t) Label.app) (equal (child (child t 0) 0) (mk1 Label.prim Prim.node)))
          (let x T (child (child t 0) 1)
            (let xs T (child t 1)
              (res (foldStep hd f x xs)
                   (node Rule.foldNode (cons a (cons f (cons x (single xs))))))))
          (if (isQuote t)
            (let q T (child t 0)
              (let x T (num (label q))
                (let xs T (listLit (children q))
                  (res (foldStep hd f x xs)
                    (cTrans (node2 Rule.congApp (cRefl (app hd f))
                               (cSym (weakenN (mk3 Rule.delta Prim.node x xs) (length ctx))))
                            (node Rule.foldNode (cons a (cons f (cons x (single xs))))))))))
            none))))))
(defn appRedex ((R Ts) (raw T) (hd T) (as Ts) (ctx Ts)) T
  (let f T (child raw 0)
    (if (and (eq (label f) Label.lam) (eq (arity f) 2))
      (let a T (child raw 1)
        (res (subst a (child f 1)) (mk3 Rule.beta (child f 0) (child f 1) a)))
      (let n T (length as)
        (let hl T (label hd)
          (if (and (eq hl Label.iter) (eq n 3)) (iterRedex R hd as ctx)
          (if (and (eq hl Label.foldr) (eq n 3)) (foldrRedex hd as)
          (if (and (eq hl Label.lcase) (eq n 3)) (lcaseRedex hd as)
          (if (and (eq hl Label.fold) (eq n 2)) (foldRedex hd as ctx)
          (if (eq hl Label.prim) (deltaRedex (label (child hd 0)) as ctx)
            none))))))))))
(defn redex ((D Ts) (G Ts) (U Ts) (R Ts) (ctx Ts) (raw T) (hd T) (as Ts)) T
  (let l T (label raw)
    (let k T (arity raw)
      (let rr T (applyRules G ctx raw R)
        (if (isSome rr) rr
        (if (and (eq l Label.ref) (eq k 1))
          (let j T (label (child raw 0))
            (if (isSome (indexOf j U))
              (bindO (nth D j)
                     (lam ((d T)) (res (wk (length ctx) d) (mk1 Rule.unfold (child raw 0)))))
              none))
        (if (and (eq l Label.app) (eq k 2)) (appRedex R raw hd as ctx)
        (if (and (or (eq l Label.fst) (eq l Label.snd)) (eq k 1))
          (let p T (child raw 0)
            (if (and (eq (label p) Label.pair) (eq (arity p) 2))
              ; the rules betaFst and betaSnd carry the labels of fst and snd
              (res (child p (sub l Label.fst)) (node2 l (child p 0) (child p 1)))
              none))
        (if (and (eq l Label.cond) (eq k 3))
          (let c T (child raw 0)
            (if (isQuote c)
              (let q T (child c 0)
                (res (if q (child raw 1) (child raw 2))
                     (mk3 Rule.condQuote q (child raw 1) (child raw 2))))
              none))
          none)))))))))

; the rules that apply inside binders, the lemmas
(defn lemmaOnly ((R Ts)) Ts
  (foldr T Ts (lam ((r T) (acc Ts)) (if (eq (label r) 0) (cons r acc) acc)) (nil T) R))
; the rule of congruence of a term former
(defn congRule ((l T)) T
  (if (eq l Label.app) Rule.congApp (if (eq l Label.pair) Rule.congPair
  (if (eq l Label.fst) Rule.congFst (if (eq l Label.snd) Rule.congSnd
  (if (eq l Label.cons) Rule.congCons Rule.congCond))))))
; certificates composed without reflexivities, and a term with the certificate of its
; reflexivity
(defn isRefl ((c T)) T (eq (label c) Rule.refl))
(defn seq ((c1 T) (c2 T)) T (if (isRefl c1) c2 (if (isRefl c2) c1 (cTrans c1 c2))))
(defn same ((t T)) T (node2 0 t (cRefl t)))

; the head of an application and its arguments in order, up to four of them
(defn spine4 ((t T)) T
  (iter T
    (lam ((s T))
      (let cur T (child s 0)
        (if (and (eq (label cur) Label.app) (eq (arity cur) 2))
          (node2 0 (child cur 0) (node 0 (cons (child cur 1) (children (child s 1)))))
          s)))
    (node2 0 t (node 0 (nil T)))
    4))
(defn headStep ((D Ts) (G Ts) (U Ts) (R Ts) (ctx Ts) (t T)) T
  (let sp T (spine4 t) (redex D G U R ctx t (child sp 0) (children (child sp 1)))))

; normalization, innermost first, as the iteration of one level of a recursive normalizer, the
; number of iterations bounding the depth of its recursion: a pass of a level normalizes the
; children under one congruence, by the level below, then contracts the head when it is a redex;
; the passes repeat at the level until the head is not a redex
(deftype NF (Arrow T (Arrow Ts (Arrow Ts (Arrow Ts T)))))
(defn normPass ((D Ts) (G Ts) (U Ts) (rec NF) (t T) (ctx Ts) (hs Ts) (R Ts)) T
  (let l T (label t)
    (let cs Ts (children t)
      (let k T (length cs)
        (let r1 T
          (if (and (eq l Label.lam) (eq k 2))
            (let a T (at cs 0)
              (let rb T (rec (at cs 1) (cons a ctx) (mapT (eqWk 1) hs) (lemmaOnly R))
                (if (isRefl (resCert rb)) (same t)
                  (node2 0 (node2 Label.lam a (resTerm rb)) (node2 Rule.congLam a (resCert rb))))))
            (if (and (termNode l) (lt 0 k))
              (let rs Ts (foldr T Ts (lam ((c T) (acc Ts)) (cons (rec c ctx hs R) acc)) (nil T) cs)
                (if (allT (lam ((r T)) (isRefl (resCert r))) rs) (same t)
                  (node2 0 (node l (mapT resTerm rs)) (node (congRule l) (mapT resCert rs)))))
              (same t)))
          (let h T (headStep D G U R ctx (resTerm r1))
            (if (isSome h)
              (mk3 0 (resTerm (get h)) (seq (resCert r1) (resCert (get h))) 0)
              (mk3 0 (resTerm r1) (resCert r1) 1))))))))
; passes iterated until one reports that it is done, the state the term, its certificate and
; whether it is done: a first pass, then up to sixty-four rounds of sixty-four passes, a round
; skipped once the state is done, so that a term a pass leaves unchanged costs one pass
(defn continue ((pass (Arrow T T)) (s T)) T
  (if (child s 2) s
    (let r T (pass (child s 0)) (mk3 0 (child r 0) (seq (child s 1) (child r 1)) (child r 2)))))
(defn untilDone ((pass (Arrow T T)) (t T)) T
  (let s T (iter T
             (lam ((s T)) (if (child s 2) s (iter T (continue pass) s 64)))
             (continue pass (mk3 0 t (cRefl t) 0))
             64)
    (node2 0 (child s 0) (child s 1))))
(defn normalizer ((D Ts) (G Ts) (U Ts) (depth T)) NF
  (iter NF
    (lam ((rec NF))
      (lam ((t T) (ctx Ts) (hs Ts) (R Ts))
        (untilDone (lam ((t T)) (normPass D G U rec t ctx hs R)) t)))
    (lam ((t T) (ctx Ts) (hs Ts) (R Ts)) (same t))
    depth))
(defn norm ((D Ts) (G Ts) (U Ts) (R Ts) (ctx Ts) (hs Ts) (depth T) (t T)) T
  ((normalizer D G U depth) t ctx hs R))

; the rewriting by a lemma rule of a term's subterm of index k among those it rewrites, in
; preorder: the fold whose result at a node is a function of the index and the context, giving
; the rewritten term, or nothing, with the index remaining
(deftype RF (Arrow T (Arrow Ts T)))
(deftype RN (Prod T RF))
(deftype RNs (List RN))
(defn rnRaws ((rs RNs)) Ts (foldr RN Ts (lam ((r RN) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn rnTail ((rs RNs)) RNs (lcase RN RNs rs (nil RN) (lam ((r RN) (rest RNs)) rest)))
(defn rnFn ((rs RNs) (i T)) RF
  (lcase RN RF (iter RNs rnTail rs i) (lam ((k T) (ctx Ts)) (node2 0 none k))
    (lam ((r RN) (rest RNs)) (snd r))))
(defn rewriteAt ((G Ts) (rule T) (t T) (k0 T) (ctx0 Ts)) T
  (child ((snd (fold RN
    (lam ((l T) (rs RNs))
      (let cs Ts (rnRaws rs)
        (let raw T (node l cs)
          (let n T (length cs)
            (pair raw
              (lam ((k T) (ctx Ts))
                (let here T (applyRule G ctx raw rule)
                  (if (and (isSome here) (eq k 0)) (node2 0 here 0)
                    (let k1 T (if (isSome here) (sub k 1) k)
                      (if (and (eq l Label.lam) (eq n 2))
                        (let rb T ((rnFn rs 1) k1 (cons (at cs 0) ctx))
                          (if (isSome (child rb 0))
                            (let x T (get (child rb 0))
                              (node2 0 (res (node2 Label.lam (at cs 0) (resTerm x))
                                  (node2 Rule.congLam (at cs 0) (resCert x))) 0))
                            rb))
                      (if (termNode l)
                        ((foldr T (Arrow T (Arrow T T))
                           (lam ((c T) (kf (Arrow T (Arrow T T))) (i T) (kk T))
                             (let rc T ((rnFn rs i) kk ctx)
                               (if (isSome (child rc 0))
                                 (let x T (get (child rc 0))
                                   (node2 0 (res (node l (setAt cs i (resTerm x)))
                                                 (node (congRule l)
                                                     (setAt (mapT cRefl cs) i (resCert x))))
                                            0))
                                 (kf (add i 1) (child rc 1)))))
                           (lam ((i T) (kk T)) (node2 0 none kk)) cs)
                         0 k1)
                        (node2 0 none k1))))))))))))
    t)) k0 ctx0) 0))

; tactics, each computing a certificate of a goal: a context, hypotheses and an equation
(deftype Tac (Arrow Ts (Arrow Ts (Arrow T T))))

; simplification: both sides normalized by the rules, first by the hypotheses normalized
; alike when asked, and the goal proved when the normal forms are one term
(defn hypRules ((D Ts) (G Ts) (U Ts) (R Ts) (ctx Ts) (fuel T) (hs Ts)) Ts
  ((foldr T (Arrow T Ts)
     (lam ((h T) (k (Arrow T Ts)) (i T))
       (let nl T (norm D G U R ctx (nil T) fuel (eqLhs h))
         (let nr T (norm D G U R ctx (nil T) fuel (eqRhs h))
           (cons (mk3 1 (resTerm nl) (resTerm nr)
                   (cTrans (cSym (resCert nl)) (cTrans (mk1 Rule.hyp i) (resCert nr))))
                 (k (add i 1))))))
     (lam ((i T)) (nil T)) hs)
   0))
(defn simpTac ((D Ts) (G Ts) (U Ts) (R Ts) (useH T) (fuel T)) Tac
  (lam ((ctx Ts) (hs Ts) (q T))
    (let R2 Ts (if useH (append (hypRules D G U R ctx fuel hs) R) R)
      (let nl T (norm D G U R2 ctx hs fuel (eqLhs q))
        (let nr T (norm D G U R2 ctx hs fuel (eqRhs q))
          (if (equal (resTerm nl) (resTerm nr))
            (some (cTrans (resCert nl) (cSym (resCert nr))))
            none))))))

; induction on the innermost variable, a list, and on the innermost variable, a tree: the
; subgoals are the premises the checker expects
(defn indListTac ((f0 Tac) (f1 Tac)) Tac
  (lam ((ctx Ts) (hs Ts) (q T))
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (if (isListTy lt0)
        (let a T (child lt0 0)
          (let s T (eqLhs q)
            (let t T (eqRhs q)
              (let b T (eqTy q)
                (let h0 Ts (mapT eqLower hs)
                  (let c T (node2 Label.cons (var 1) (var 0))
                    (let nl T (mk1 Label.nil a)
                      (bindO (f0 ctx2 h0 (eqn b (subst nl s) (subst nl t))) (lam ((p0 T))
                        (bindO (f1 (cons lt0 (cons a ctx2))
                                   (cons (eqn b (wkAt 1 1 s) (wkAt 1 1 t)) (mapT (eqWk 2) h0))
                                   (eqn b (subst c (wkAt 1 2 s)) (subst c (wkAt 1 2 t))))
                          (lam ((p1 T))
                              (some (node Rule.indList
                                          (cons s (cons t (cons p0 (single p1)))))))))))))))))
        none)))))
(defn indTreeTac ((f1 Tac)) Tac
  (lam ((ctx Ts) (hs Ts) (q T))
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (if (equal lt0 Label.tyTree)
        (let s T (eqLhs q)
          (let t T (eqRhs q)
            (let b T (eqTy q)
              (let h0 Ts (mapT eqLower hs)
                (let nd T (app2 (mk1 Label.prim Prim.node) (var 1) (var 0))
                  (bindO (f1 (cons (tyList Label.tyTree) (cons Label.tyTree ctx2))
                             (cons (eqn (tyList b)
                                        (mapBy Label.tyTree b (subst (var 1) (wkAt 1 4 s)) (var 0))
                                         (mapBy Label.tyTree b (subst (var 1) (wkAt 1 4 t))
                                                (var 0)))
                                   (mapT (eqWk 2) h0))
                             (eqn b (subst nd (wkAt 1 2 s)) (subst nd (wkAt 1 2 t))))
                    (lam ((p1 T)) (some (mk3 Rule.indTree s t p1)))))))))
        none)))))

; rewriting one side of a goal at an occurrence of a lemma's side, and normalization of both
; sides, each followed by a tactic on the goal they leave
(defn rewriteTac ((G Ts) (rule T) (side T) (k T) (f Tac)) Tac
  (lam ((ctx Ts) (hs Ts) (q T))
    (bindO (rewriteAt G rule (if side (eqRhs q) (eqLhs q)) k ctx) (lam ((r T))
      (if side
        (bindO (f ctx hs (eqn (eqTy q) (eqLhs q) (resTerm r))) (lam ((p T))
          (some (cTrans p (cSym (resCert r))))))
        (bindO (f ctx hs (eqn (eqTy q) (resTerm r) (eqRhs q))) (lam ((p T))
          (some (cTrans (resCert r) p)))))))))
(defn normalizeTac ((D Ts) (G Ts) (U Ts) (R Ts) (fuel T) (f Tac)) Tac
  (lam ((ctx Ts) (hs Ts) (q T))
    (let nl T (norm D G U R ctx hs fuel (eqLhs q))
      (let nr T (norm D G U R ctx hs fuel (eqRhs q))
        (bindO (f ctx hs (eqn (eqTy q) (resTerm nl) (resTerm nr))) (lam ((p T))
          (some (seq (resCert nl) (seq p (cSym (resCert nr)))))))))))

; induction on the label of the innermost variable, a tree: the goal's sides are those with the
; label of the variable abstracted, instantiated at the variable's label
(deftype Endo1 (Arrow T T))
(deftype AN (Prod T Endo1))
(deftype ANs (List AN))
(defn anRaws ((rs ANs)) Ts (foldr AN Ts (lam ((r AN) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn anTail ((rs ANs)) ANs (lcase AN ANs rs (nil AN) (lam ((r AN) (rest ANs)) rest)))
(defn anFn ((rs ANs) (i T)) Endo1
  (lcase AN Endo1 (iter ANs anTail rs i) (lam ((d T)) 0) (lam ((r AN) (rest ANs)) (snd r))))
(defn absLabel ((t T)) T
  ((snd (fold AN
     (lam ((l T) (rs ANs))
       (let cs Ts (anRaws rs)
         (let raw T (node l cs)
           (let n T (length cs)
             (pair raw
               (lam ((d T))
                 (if (and (isLabelOf raw) (equal (child raw 1) (var d))) (var d)
                 (if (and (eq l Label.lam) (eq n 2))
                     (node2 Label.lam (at cs 0) ((anFn rs 1) (add d 1)))
                 (if (termNode l)
                   (node l ((foldr T (Arrow T Ts)
                              (lam ((c T) (kf (Arrow T Ts)) (i T))
                                  (cons ((anFn rs i) d) (kf (add i 1))))
                              (lam ((i T)) (nil T)) cs)
                            0))
                   raw)))))))))
     t))
   0))
(defn indLabelTac ((f0 Tac) (f1 Tac)) Tac
  (lam ((ctx Ts) (hs Ts) (q T))
    (lcase T T ctx none (lam ((lt0 T) (ctx2 Ts))
      (let s T (absLabel (eqLhs q))
        (let t T (absLabel (eqRhs q))
          (let b T (eqTy q)
            (let lab T (app (mk1 Label.prim Prim.label) (var 0))
              (let suc T (app2 (mk1 Label.prim Prim.add) (var 0) (num 1))
                (if (and (equal lt0 Label.tyTree) (and (equal (subst lab (wkAt 1 1 s)) (eqLhs q))
                      (equal (subst lab (wkAt 1 1 t)) (eqRhs q))))
                  (let h0 Ts (mapT eqLower hs)
                    (bindO (f0 ctx2 h0 (eqn b (subst (num 0) s) (subst (num 0) t))) (lam ((p0 T))
                      (bindO (f1 ctx (cons (eqn b s t) hs)
                                 (eqn b (subst suc (wkAt 1 1 s)) (subst suc (wkAt 1 1 t))))
                        (lam ((p1 T))
                             (some (node Rule.indLabel
                                         (cons s (cons t (cons p0 (single p1)))))))))))
                  none))))))))))

; the names of the axioms, in the order of the table
(def axiomNames (children (quote (0
  (0 108 97 98 101 108 78 111 100 101) (0 99 104 105 108 100 114 101 110 78 111 100 101)
  (0 110 111 100 101 69 116 97) (0 99 104 105 108 100 114 101 110 76 97 98 101 108)
  (0 108 97 98 101 108 83 117 99 99) (0 97 100 100 73 116 101 114)
      (0 112 114 101 100 73 116 101 114)
  (0 115 117 98 73 116 101 114) (0 109 117 108 73 116 101 114) (0 100 105 118 73 116 101 114)
  (0 109 111 100 73 116 101 114) (0 101 113 68 101 102) (0 108 116 68 101 102)
  (0 108 111 103 50 68 101 102) (0 97 114 105 116 121 68 101 102) (0 99 104 105 108 100 68 101 102)
  (0 101 113 117 97 108 82 101 102 108) (0 101 113 117 97 108 83 117 98 115 116)
  (0 101 113 117 97 108 66 111 111 108)))))
(def kwTheorem (quote (0 116 104 101 111 114 101 109)))
(def kwSimp (quote (0 115 105 109 112)))
(def kwHyps (quote (0 104 121 112 115)))
(def kwUnfold (quote (0 117 110 102 111 108 100)))
(def kwRw (quote (0 114 119)))
(def kwRwl (quote (0 114 119 108)))
(def kwIndList (quote (0 105 110 100 117 99 116 105 111 110 45 108 105 115 116)))
(def kwRewrite (quote (0 114 101 119 114 105 116 101)))
(def kwRewritel (quote (0 114 101 119 114 105 116 101 108)))
(def kwNormalize (quote (0 110 111 114 109 97 108 105 122 101)))
(def kwIndLabel (quote (0 105 110 100 117 99 116 105 111 110 45 108 97 98 101 108)))
(def kwIterLabel (quote (0 105 116 101 114 108 97 98 101 108)))
(def kwRhs (quote (0 114 104 115)))
(def kwIndTree (quote (0 105 110 100 117 99 116 105 111 110 45 116 114 101 101)))

; the options of simplification: the indices of the definitions it unfolds, the rules of the
; lemmas it rewrites with, and whether it rewrites with the hypotheses
(defn listArgs ((kw T) (args Ts)) Ts
  (foldr T Ts
    (lam ((a T) (acc Ts))
      (if (isList a) (if (named (at (children a) 0) kw) (append (tail (children a)) acc) acc) acc))
    (nil T) args))
(defn hasAtom ((kw T) (args Ts)) T (foldr T T (lam ((a T) (acc T)) (if (named a kw) 1 acc)) 0 args))
(defn resolveAll ((names Ts) (xs Ts)) Ts
  (foldr T Ts (lam ((x T) (acc Ts)) (let i T (indexOf (nameOf x) names)
      (if (isSome i) (cons (get i) acc) acc)))
    (nil T) xs))
(defn lemmaRules ((Th Ts) (names Ts) (xs Ts) (back T)) Ts
  (foldr T Ts (lam ((j T) (acc Ts)) (let r T (lemmaRule Th j back)
      (if (isSome r) (cons (get r) acc) acc)))
    (nil T) (resolveAll names xs)))

; a tactic's certificate: the fold over the tactic's S-expression whose result at a list is its
; tactic, from its elements' results
(deftype TN (Prod T Tac))
(deftype TNs (List TN))
(defn tnRaws ((rs TNs)) Ts (foldr TN Ts (lam ((r TN) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
(defn tnTail ((rs TNs)) TNs (lcase TN TNs rs (nil TN) (lam ((r TN) (rest TNs)) rest)))
(defn tnAt ((rs TNs) (i T)) Tac
  (lcase TN Tac (iter TNs tnTail rs i) (lam ((c Ts) (h Ts) (q T)) none)
      (lam ((r TN) (rest TNs)) (snd r))))
(defn tactic ((D Ts) (Th Ts) (G Ts) (dn Ts) (tn Ts) (fuel T) (e T)) Tac
  (snd (fold TN
    (lam ((l T) (rs TNs))
      (let es Ts (tnRaws rs)
        (let raw T (node l es)
          (pair raw
            (if (and (eq l 2) (lt 0 (length es)))
              (let h T (at es 0)
                (let args Ts (tail es)
                  (let U Ts (resolveAll dn (listArgs kwUnfold args))
                    (let R Ts (append (if (hasAtom kwIterLabel args)
                        (single (node 2 (nil T))) (nil T))
                                (append (lemmaRules Th tn (listArgs kwRw args) 0)
                                        (lemmaRules Th tn (listArgs kwRwl args) 1)))
                      (if (named h kwSimp) (simpTac D G U R (hasAtom kwHyps args) fuel)
                      (if (named h kwNormalize) (normalizeTac D G U R fuel (tnAt rs 1))
                      (if (or (named h kwRewrite) (named h kwRewritel))
                        (let rr Ts (lemmaRules Th tn (single (at args 0)) (named h kwRewritel))
                          (if (nonEmpty rr)
                            (rewriteTac G (at rr 0) (named (at args 1) kwRhs)
                              (get (numeral (children (at args 2)))) (tnAt rs 4))
                            (lam ((c Ts) (hs Ts) (q T)) none)))
                      (if (named h kwIndList) (indListTac (tnAt rs 1) (tnAt rs 2))
                      (if (named h kwIndTree) (indTreeTac (tnAt rs 1))
                      (if (named h kwIndLabel) (indLabelTac (tnAt rs 1) (tnAt rs 2))
                        (lam ((c Ts) (hs Ts) (q T)) none)))))))))))
              (lam ((c Ts) (hs Ts) (q T)) none))))))
    e)))

; a file of program forms and theorems, each (theorem name binders lhs rhs tactic): every
; theorem's statement is read as the definition, named by the theorem's name after a percent
; sign, of the abstraction over its binders of the pair of its sides, so that it is expanded,
; read and typed as the program is, its Surface 1 forms included; each tactic's certificate is
; checked against the statement, and the theorems checked are cited by later ones
(def atomDef (quote (1 100 101 102)))
(def atomLam (quote (1 108 97 109)))
(def atomPair (quote (1 112 97 105 114)))
(defn isTheorem ((e T)) T (if (isList e) (named (at (children e) 0) kwTheorem) 0))
(defn statementDef ((e T)) T
  (let es Ts (children e)
    (node 2 (cons atomDef (cons (node 1 (cons 37 (children (at es 1))))
      (single (node 2 (cons atomLam (cons (at es 2)
        (single (node 2 (cons atomPair (cons (at es 3) (single (at es 4)))))))))))))))
(defn stripLams ((n T) (t T)) T
  (iter T (lam ((p T)) (node2 0 (node 0 (cons (child (child p 1) 0) (children (child p 0))))
                                 (child (child p 1) 1)))
    (node2 0 (node 0 (nil T)) t) n))
; the state of checking a file: the theorems checked, their names, and a result for each
; theorem, the node of label 0 over its name, the theorem, the certificate and whether it checks
(deftype PS (Prod Ts (Prod Ts Ts)))
(defn proveOne ((D Ts) (G Ts) (dn Ts) (fuel T) (s PS) (e T)) PS
  (let es Ts (children e)
    (let name T (nameOf (at es 1))
      (let di T (indexOf (node 0 (cons 37 (children name))) dn)
        (let st T (stripLams (length (children (at es 2))) (get (nth D (get di))))
          (let ctx Ts (children (child st 0))
            (let body T (child st 1)
              (let q T (eqn (get (typeIn G ctx (child body 0))) (child body 0) (child body 1))
                (let c T ((tactic D (fst s) G dn (append axiomNames (fst (snd s))) fuel (at es 5))
                          ctx (nil T) q)
                  (let ok T (if (isSome c)
                      (equal (checkCert D (fst s) G (get c) ctx (nil T)) (some q)) 0)
                    (let th T (thm ctx q)
                      (pair (if ok (append (fst s) (single th)) (fst s))
                        (pair (if ok (append (fst (snd s)) (single name)) (fst (snd s)))
                          (append (snd (snd s))
                            (single (node 0 (cons name (cons th
                              (cons (if (isSome c) (get c) 0) (single ok))))))))))))))))))))
; a program's forms, their Surface 1 forms expanded, read into its bundle
(defn readSurface ((es Ts)) T (bindO (expandProgram es) (lam ((kx T)) (readProgram (children kx)))))
(defn proveFile ((fuel T) (file T)) T
  (bindO (readSExps (children file)) (lam ((sx T))
    (let forms Ts (children sx)
      (let thms Ts (foldr T Ts (lam ((e T) (acc Ts)) (if (isTheorem e) (cons e acc) acc))
          (nil T) forms)
        (let prog Ts (append (foldr T Ts (lam ((e T) (acc Ts)) (if (isTheorem e) acc (cons e acc)))
                               (nil T) forms)
                             (mapT statementDef thms))
          (bindO (readSurface prog) (lam ((b T))
              (let D Ts (children (child b 0))
                (let dn Ts (children (child b 1))
                  (bindO (checkProgram D) (lam ((gt T))
                    (let s PS ((foldr T (Arrow PS PS)
                                 (lam ((e T) (k (Arrow PS PS)) (s PS))
                                   (k (proveOne D (children gt) dn fuel s e)))
                                 (lam ((s PS)) s) thms)
                               (pair (nil T) (pair (nil T) (nil T))))
                      (some (node2 0 b (node 0 (snd (snd s))))))))))))))))))
