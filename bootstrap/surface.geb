;
; Surface 1: datatypes, case analysis, structural recursion and functions with result types,
; expanded into the kernel's syntax. A surface program's S-expressions are rewritten into
; kernel S-expressions, which the reader then resolves; a program of kernel forms alone is
; unchanged. Datatypes are erased: a value of a datatype is a tree, the node labelled by its
; constructor's position over its fields.
;
;   (data D (c A ...) ... (c B ... & E))   declares the datatype D and its constructors; a last
;                                        field & E takes the remaining children as a list
;   (case e ((c x ...) body) ... (else body))
;                                        case analysis; without else, it is exhaustive
;   (cata D R e ((c x ...) body) ...)    structural recursion over D at result type R: a field
;                                        of type D, or a last & D field, is bound to its
;                                        results, any other field to its value
;   (defn f ((x A) ...) R body)          a function with its result type
;
; A pattern (c x ...) names one variable for each field of c, the last standing for the
; remaining children when c has a & field; the & is not repeated in the pattern.
;
; Names beginning with % are reserved for the expansion. The expansion refers to the
; primitives label, child, children, node and eq by name, so a surface program does not rebind
; them around case and cata. Requires the prelude, the reader and the checker.

; S-expressions under construction
(def sx1 (lam ((a T)) (node 2 (single a))))
(def sx2 (lam ((a T) (b T)) (node 2 (cons a (single b)))))
(def sx3 (lam ((a T) (b T) (c T)) (node 2 (cons a (cons b (single c))))))
(def sx4 (lam ((a T) (b T) (c T) (d T)) (node 2 (cons a (cons b (cons c (single d)))))))
(def sx5 (lam ((a T) (b T) (c T) (d T) (e T))
  (node 2 (cons a (cons b (cons c (cons d (single e))))))))
(def sx6 (lam ((a T) (b T) (c T) (d T) (e T) (f T))
  (node 2 (cons a (cons b (cons c (cons d (cons e (single f)))))))))

; the atoms of the expansion
(def aLet (quote (1 108 101 116)))
(def aIf (quote (1 105 102)))
(def aLam (quote (1 108 97 109)))
(def aPair (quote (1 112 97 105 114)))
(def aFst (quote (1 102 115 116)))
(def aSnd (quote (1 115 110 100)))
(def aCons (quote (1 99 111 110 115)))
(def aNil (quote (1 110 105 108)))
(def aIter (quote (1 105 116 101 114)))
(def aLcase (quote (1 108 99 97 115 101)))
(def aFoldr (quote (1 102 111 108 100 114)))
(def aFold (quote (1 102 111 108 100)))
(def aDef (quote (1 100 101 102)))
(def aDeftype (quote (1 100 101 102 116 121 112 101)))
(def aUnitV (quote (1 117 110 105 116)))
(def aLabel (quote (1 108 97 98 101 108)))
(def aChild (quote (1 99 104 105 108 100)))
(def aChildren (quote (1 99 104 105 108 100 114 101 110)))
(def aNode (quote (1 110 111 100 101)))
(def aEq (quote (1 101 113)))
(def aT (quote (1 84)))
(def aUnit (quote (1 85 110 105 116)))
(def aProd (quote (1 80 114 111 100)))
(def aArrow (quote (1 65 114 114 111 119)))
(def aList (quote (1 76 105 115 116)))
(def aZero (quote (1 48)))
(def aS (quote (1 37 115)))
(def aL (quote (1 37 108)))
(def aRs (quote (1 37 114 115)))
(def aO (quote (1 37 111)))
(def aP (quote (1 37 112)))
(def aA (quote (1 37 97)))
(def aH (quote (1 37 104)))
(def aTl (quote (1 37 116)))
(def aX (quote (1 37 120)))
(def aU (quote (1 37 117)))
(def aR (quote (1 37 114)))
(def aD (quote (1 37 100)))
(def aRest (quote (1 37 114 101 115 116)))
(def kwData (quote (0 100 97 116 97)))
(def kwCase (quote (0 99 97 115 101)))
(def kwCata (quote (0 99 97 116 97)))
(def kwDefn (quote (0 100 101 102 110)))
(def kwElse (quote (0 101 108 115 101)))
(def kwAmp (quote (0 38)))

; a numeral's characters and atom
(def decimalChars (lam ((n T))
  (if (eq n 0) (single 48)
    (let k T (fst (iter (Prod T T)
                    (lam ((s (Prod T T))) (if (eq (snd s) 0) s (pair (add (fst s) 1) (div (snd s) 10))))
                    (pair 0 n) (add (log2 n) 1)))
      (foldr T Ts (lam ((d T) (acc Ts)) (cons (add d 48) acc)) (nil T) (digitsMsb 10 n k))))))
(def numAtom (lam ((n T)) (node 1 (decimalChars n))))
(def fieldAtom (lam ((k T)) (node 1 (cons 37 (cons 102 (decimalChars k))))))

; types and expressions under construction
(def sList (lam ((a T)) (sx2 aList a)))
(def sProd (lam ((a T) (b T)) (sx3 aProd a b)))
(def sArrow (lam ((a T) (b T)) (sx3 aArrow a b)))
(def sLet (lam ((x T) (a T) (e T) (b T)) (sx5 aLet x a e b)))
(def sIf (lam ((c T) (a T) (b T)) (sx4 aIf c a b)))
(def sLam1 (lam ((x T) (a T) (b T)) (sx3 aLam (sx1 (sx2 x a)) b)))
(def sLam2 (lam ((x T) (a T) (y T) (b T) (e T))
  (sx3 aLam (sx2 (sx2 x a) (sx2 y b)) e)))
; the function dropping a list's head, at the elements' type
(def sTail (lam ((a T))
  (sLam1 aX (sList a) (sx6 aLcase a (sList a) aX (sx2 aNil a) (sLam2 aH a aTl (sList a) aTl)))))
; a list without its first n elements
(def sDrop (lam ((a T) (xs T) (n T)) (sx5 aIter (sList a) (sTail a) xs (numAtom n))))

; lists by position
(def dropLast (lam ((xs Ts)) (reverse (tail (reverse xs)))))
(def zipTs (lam ((xs Ts) (ys Ts))
  (let ny T (length ys)
    (snd (foldr T (Prod T Ts)
      (lam ((x T) (acc (Prod T Ts)))
        (pair (add (fst acc) 1) (cons (node2 0 x (at ys (sub (sub ny 1) (fst acc)))) (snd acc))))
      (pair 0 (nil T)) xs)))))
(def allTrue (lam ((xs Ts)) (foldr T T (lam ((x T) (r T)) (and x r)) 1 xs)))

; the environment of declarations: constructors, the node of label 5 over the name, position,
; datatype, field types, whether a last field takes the remaining children, and its type;
; datatypes, the node of label 6 over the name; type abbreviations, the node of label 7 over
; the name and the type with abbreviations expanded
(def findCtor (lam ((n T) (env Ts))
  (foldr T T (lam ((e T) (r T)) (if (and (eq (label e) 5) (equal (child e 0) n)) (some e) r)) none env)))
(def isData (lam ((n T) (env Ts))
  (foldr T T (lam ((e T) (r T)) (if (and (eq (label e) 6) (equal (child e 0) n)) 1 r)) 0 env)))
(def findAlias (lam ((n T) (env Ts))
  (foldr T T (lam ((e T) (r T)) (if (and (eq (label e) 7) (equal (child e 0) n)) (some (child e 1)) r))
    none env)))
(def ctorsOf (lam ((d T) (env Ts))
  (foldr T Ts (lam ((e T) (r Ts)) (if (and (eq (label e) 5) (equal (child e 2) d)) (cons e r) r))
    (nil T) env)))

; a type with its abbreviations expanded, and a value of each type
(def expandAliases (lam ((env Ts) (ty T))
  (fold T
    (lam ((l T) (rs Ts))
      (let raw T (node l rs)
        (if (isAtom raw) (let a T (findAlias (nameOf raw) env) (if (isSome a) (get a) raw)) raw)))
    ty)))
(def defaultOf (lam ((ty T))
  (snd (fold RT
    (lam ((l T) (rs RTs))
      (let raw T (node l (rtTrees rs))
        (let vs Ts (rtValues rs)
          (pair raw
            (if (isAtom raw)
              (if (equal (nameOf raw) kwUnit) aUnitV aZero)
              (let h T (at (children raw) 0)
                (if (named h kwProd) (sx3 aPair (at vs 1) (at vs 2))
                (if (named h kwArrow) (sLam1 aD (at (children raw) 1) (at vs 2))
                (if (named h kwList) (sx2 aNil (at (children raw) 1))
                  aZero)))))))))
    ty))))

; the bindings of a clause's variables, from the innermost out: fb binds a field at a position
; with its type, and vb binds the remaining children after the fixed fields
(deftype Binder (Arrow T (Arrow T (Arrow T (Arrow T T)))))
(def bindWith (lam ((fb Binder) (vb Binder) (ctor T) (vars Ts) (body T))
  (let fields Ts (children (child ctor 3))
    (let nf T (length fields)
      (let nv T (length vars)
        (if (and (eq nv (add nf (child ctor 4))) (allTrue (foldr T Ts (lam ((v T) (r Ts)) (cons (isAtom v) r)) (nil T) vars)))
          (some (snd (foldr T (Prod T T)
            (lam ((v T) (acc (Prod T T)))
              (let k T (sub (sub nv 1) (fst acc))
                (pair (add (fst acc) 1)
                  (if (lt k nf) (fb k (at fields k) v (snd acc)) (vb nf (child ctor 5) v (snd acc))))))
            (pair 0 body) vars)))
          none))))))

; the constructor a clause names, when it is declared
(def clauseCtor (lam ((env Ts) (c T))
  (if (isList c)
    (let pat T (child c 0) (if (isList pat) (findCtor (nameOf (child pat 0)) env) none))
    none)))

; the chain of tests of a clause list: each clause, a node over its raw form and its expansion,
; binds its variables and tests the scrutinee's label, the last without an else untested
(deftype Chain (Prod T (Prod T T)))
(deftype Bind (Arrow T (Arrow Ts (Arrow T T))))
(def testChain (lam ((sv T) (pairs Ts) (base T) (bind Bind))
  (let r Chain
    (foldr T Chain
      (lam ((p T) (acc Chain))
        (let c T (child p 0)
          (let ctor T (child p 1)
            (let b T (bind ctor (tail (children (child c 0))) (child (child p 2) 1))
              (if (and (fst acc) (isSome b))
                (pair 1 (pair 1 (if (fst (snd acc))
                                  (sIf (sx3 aEq (sx2 aLabel sv) (numAtom (child ctor 1))) (get b) (snd (snd acc)))
                                  (get b))))
                (pair 0 (pair 0 0)))))))
      (if (isSome base) (pair 1 (pair 1 (get base))) (pair 1 (pair 0 0)))
      pairs)
    (if (and (fst r) (fst (snd r))) (some (snd (snd r))) none))))

; a clause list's chain, given the datatype, or none to take it from the first clause: every
; clause names a constructor of that datatype, and without a last else clause every
; constructor is named
(def clauseChain (lam ((env Ts) (d0 T) (cls Ts) (xo T) (sv T) (bind Bind))
  (if (and (isSome xo) (nonEmpty cls))
    (let xs Ts (children (get xo))
      (let n T (length cls)
        (let lastC T (at cls (sub n 1))
          (let hasElse T (and (isList lastC) (and (eq (arity lastC) 2) (named (child lastC 0) kwElse)))
            (let ncls Ts (if hasElse (dropLast cls) cls)
              (let nxs Ts (if hasElse (dropLast xs) xs)
                (let base T (if hasElse (some (child (at xs (sub n 1)) 1)) none)
                  (let ctors Ts (foldr T Ts (lam ((c T) (acc Ts)) (cons (clauseCtor env c) acc)) (nil T) ncls)
                    (let d T (if (isSome d0) (get d0)
                               (if (nonEmpty ctors) (if (isSome (at ctors 0)) (child (get (at ctors 0)) 2) 0) 0))
                      (let valid T (allTrue (foldr T Ts
                                              (lam ((c T) (acc Ts))
                                                (cons (and (eq (arity c) 2)
                                                        (let e T (clauseCtor env c)
                                                          (and (isSome e) (equal (child (get e) 2) d))))
                                                      acc))
                                              (nil T) ncls))
                        (let names Ts (foldr T Ts (lam ((c T) (acc Ts)) (cons (child (get c) 0) acc)) (nil T) ctors)
                          (let covered T (or hasElse
                                           (allTrue (foldr T Ts (lam ((e T) (acc Ts)) (cons (isSome (indexOf (child e 0) names)) acc))
                                                      (nil T) (ctorsOf d env))))
                            (if (and valid covered)
                              (let m T (length ncls)
                                (testChain sv
                                  (snd (foldr T (Prod T Ts)
                                    (lam ((c T) (acc (Prod T Ts)))
                                      (let i T (sub (sub m 1) (fst acc))
                                        (pair (add (fst acc) 1)
                                          (cons (node 0 (cons c (cons (get (at ctors i)) (single (at nxs i))))) (snd acc)))))
                                    (pair 0 (nil T)) ncls))
                                  base bind))
                              none)))))))))))))
    none)))

; case analysis: the scrutinee bound once, its label tested, its children bound to the clause's
; variables
(def caseField (lam ((k T) (ty T) (v T) (b T)) (sLet v aT (sx3 aChild aS (numAtom k)) b)))
(def caseRest (lam ((nf T) (ty T) (v T) (b T)) (sLet v (sList aT) (sDrop aT (sx2 aChildren aS) nf) b)))
(def expandCase (lam ((env Ts) (raw T) (rs RRs))
  (let scr T (rrAt rs 1 env)
    (let chain T (clauseChain env none (drop 2 (children raw)) (argsOf rs 2 env) aS
                   (bindWith caseField caseRest))
      (if (both scr chain) (some (sLet aS aT (get scr) (get chain))) none)))))

; structural recursion: the kernel's fold at pairs of a subtree and its suspended result; a
; recursive field is bound to its forced result, any other to the subtree's child
(def pTy (lam ((r T)) (sProd aT (sArrow aUnit r))))
(def forced (lam ((p T)) (sx2 (sx2 aSnd p) aUnitV)))
(def nthP (lam ((r T) (dr T) (k T))
  (sx6 aLcase (pTy r) (pTy r) (sDrop (pTy r) aRs k) (sx3 aPair aZero (sLam1 aU aUnit dr))
       (sLam2 aH (pTy r) aTl (sList (pTy r)) aH))))
(def cataField (lam ((d T) (r T) (dr T) (k T) (ty T) (v T) (b T))
  (if (named ty d)
    (sLet v r (forced (nthP r dr k)) b)
    (sLet v aT (sx3 aChild aO (numAtom k)) b))))
(def cataRest (lam ((d T) (r T) (nf T) (ty T) (v T) (b T))
  (if (named ty d)
    (sLet v (sList r)
      (sx6 aFoldr (pTy r) (sList r) (sLam2 aP (pTy r) aA (sList r) (sx3 aCons (forced aP) aA))
           (sx2 aNil r) (sDrop (pTy r) aRs nf))
      b)
    (sLet v (sList aT) (sDrop aT (sx2 aChildren aO) nf) b))))
(def expandCata (lam ((env Ts) (raw T) (rs RRs))
  (let es Ts (children raw)
    (let d T (nameOf (at es 1))
      (let r T (at es 2)
        (let dr T (defaultOf (expandAliases env r))
          (let scr T (rrAt rs 3 env)
            (let chain T (if (and (isAtom (at es 1)) (isData d env))
                           (clauseChain env (some d) (drop 4 es) (argsOf rs 4 env) aO
                             (bindWith (cataField d r dr) (cataRest d r)))
                           none)
              (if (both scr chain)
                (let step T (sLam2 aL aT aRs (sList (pTy r))
                              (sLet aO aT
                                (sx3 aNode aL (sx6 aFoldr (pTy r) (sList aT)
                                                   (sLam2 aP (pTy r) aA (sList aT) (sx3 aCons (sx2 aFst aP) aA))
                                                   (sx2 aNil aT) aRs))
                                (sx3 aPair aO (sLam1 aU aUnit (get chain)))))
                  (some (forced (sx4 aFold (pTy r) step (get scr)))))
                none)))))))))

; an expression expanded, given the declarations before it
(def expandExpr (lam ((env Ts) (e T))
  ((snd (fold RR
     (lam ((l T) (rs RRs))
       (let raw T (node l (rrTrees rs))
         (pair raw
           (lam ((env Ts))
             (if (isList raw)
               (let h T (at (children raw) 0)
                 (let k T (arity raw)
                   (if (and (named h kwCase) (lt 2 k)) (expandCase env raw rs)
                   (if (and (named h kwCata) (lt 4 k)) (expandCata env raw rs)
                     (let xs T (allSome (rrApply rs env))
                       (if (isSome xs) (some (node 2 (children (get xs)))) none))))))
               (some raw))))))
     e))
   env)))

; a datatype declaration: its environment entries and kernel forms, the datatype's
; abbreviation for trees and one definition for each constructor
(def ctorDecl (lam ((d T) (j T) (c T))
  (let es Ts (children c)
    (let rest Ts (tail es)
      (let nr T (length rest)
        (let isVar T (and (lt 1 nr) (named (at rest (sub nr 2)) kwAmp))
          (let fields Ts (if isVar (dropLast (dropLast rest)) rest)
            (let nf T (length fields)
                (let ps Ts (snd (foldr T (Prod T Ts)
                                  (lam ((f T) (acc (Prod T Ts)))
                                    (pair (add (fst acc) 1) (cons (sx2 (fieldAtom (sub (sub nf 1) (fst acc))) aT) (snd acc))))
                                  (pair 0 (nil T)) fields))
                  (let tailE T (if isVar aRest (sx2 aNil aT))
                    (let listE T (snd (foldr T (Prod T T)
                                        (lam ((f T) (acc (Prod T T)))
                                          (pair (add (fst acc) 1)
                                                (sx3 aCons (fieldAtom (sub (sub nf 1) (fst acc))) (snd acc))))
                                        (pair 0 tailE) fields))
                      (let allPs Ts (if isVar (append ps (single (sx2 aRest (sList aT)))) ps)
                        (let body T (sx3 aNode (numAtom j) listE)
                          (if (and (isList c) (isAtom (at es 0)))
                            (some (node2 0
                                    (node 5 (cons (nameOf (at es 0)) (cons j (cons d (cons (node 0 fields)
                                      (cons isVar (single (if isVar (at rest (sub nr 1)) 0))))))))
                                    (sx3 aDef (at es 0)
                                      (if (nonEmpty allPs) (sx3 aLam (node 2 allPs) body) body))))
                            none))))))))))))))
(def dataDecl (lam ((e T))
  (let es Ts (children e)
    (let d T (nameOf (at es 1))
      (let cs Ts (drop 2 es)
        (let nc T (length cs)
          (let decls T (allSome (snd (foldr T (Prod T Ts)
                                      (lam ((c T) (acc (Prod T Ts)))
                                        (pair (add (fst acc) 1) (cons (ctorDecl d (sub (sub nc 1) (fst acc)) c) (snd acc))))
                                      (pair 0 (nil T)) cs)))
            (if (and (isAtom (at es 1)) (isSome decls))
              (let ds Ts (children (get decls))
                (some (node2 0
                        (node 0 (cons (node 6 (single d)) (foldr T Ts (lam ((x T) (acc Ts)) (cons (child x 0) acc)) (nil T) ds)))
                        (node 0 (cons (sx3 aDeftype (at es 1) aT) (foldr T Ts (lam ((x T) (acc Ts)) (cons (child x 1) acc)) (nil T) ds))))))
              none))))))))

; a program's forms expanded: the state is whether every form has expanded, the declarations,
; and the kernel forms, the most recent first
(deftype XP (Prod T (Prod Ts Ts)))
(deftype XPK (Arrow XP XP))
(def xpFail (pair 0 (pair (nil T) (nil T))))
(def xpStep (lam ((s XP) (e T))
  (if (and (fst s) (isList e))
    (let env Ts (fst (snd s))
      (let out Ts (snd (snd s))
        (let es Ts (children e)
          (let h T (at es 0)
            (let k T (arity e)
              (if (named h kwData)
                (let dd T (dataDecl e)
                  (if (isSome dd)
                    (pair 1 (pair (append env (children (child (get dd) 0)))
                                  (append (reverse (children (child (get dd) 1))) out)))
                    xpFail))
              (if (and (named h kwDefn) (eq k 5))
                (let b T (expandExpr env (at es 4))
                  (if (isSome b)
                    (let body T (sLet aR (at es 3) (get b) aR)
                      (pair 1 (pair env (cons (sx3 aDef (at es 1)
                                                (if (eq (arity (at es 2)) 0) body (sx3 aLam (at es 2) body)))
                                              out))))
                    xpFail))
              (if (and (named h kwDef) (eq k 3))
                (let b T (expandExpr env (at es 2))
                  (if (isSome b) (pair 1 (pair env (cons (sx3 aDef (at es 1) (get b)) out))) xpFail))
              (if (and (named h kwDeftype) (eq k 3))
                (pair 1 (pair (append env (single (node2 7 (nameOf (at es 1)) (expandAliases env (at es 2)))))
                              (cons e out)))
              (if (and (named h kwDefnum) (eq k 3))
                (pair 1 (pair env (cons e out)))
                xpFail))))))))))
    xpFail)))
(def expandProgram (lam ((es Ts))
  (let s XP ((foldr T XPK (lam ((e T) (k XPK) (s XP)) (k (xpStep s e))) (lam ((s XP)) s) es)
             (pair 1 (pair (nil T) (nil T))))
    (if (fst s) (some (node 0 (reverse (snd (snd s))))) none))))
