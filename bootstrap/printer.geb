;
; The printer of kernel terms, written in the kernel's syntax: a bundle's definitions as
; S-expressions of the readable syntax, which the reader reads back, printing as the seed's
; printer prints. The printer is partial: it prints a term only when the term is well formed and
; the names of the definitions may be read back as theirs, and a bundle only when each of its
; definitions is.
; Requires the prelude, the reader, the checker's isTy and decimalChars of the datatype language.
;
; Representations. As in the reader: an S-expression is a node of label 1 over an atom's
; characters or a node of label 2 over a list's elements, and a name is a node of label 0 over
; its characters. A bundle is the node of label 100 over the node of label 101 over the terms and
; the node of label 102 over the names.

(module Printer
  (export printType printDatum printTerm readBack termWf nameOk namesOk printTermOpt printProgram)
  (import Prelude)
  (import Reader)
  (import Check)
  ; atoms and lists
  (def atomOf (lam ((n T)) (node 1 (children n))))
  (def listOf (lam ((xs Ts)) (node 2 xs)))
  (def numAtom (lam ((n T)) (node 1 (Datatype.decimalChars n))))
  ; the name of the binder at a depth, an underscore followed by the depth's numeral
  (def binderAtom (lam ((d T)) (node 1 (cons 95 (Datatype.decimalChars d)))))
  ; the atom of the name at a position of a list of names
  (def nameAt (lam ((ns Ts) (i T)) (atomOf (at ns i))))

  ; a type written structurally
  (def printType
    (lam ((A T))
      (fold T
        (lam ((l T) (rs Ts))
          (if (eq l Label.tyTree) (atomOf kwT)
            (if (eq l Label.tyUnit) (atomOf kwUnit)
              (if (eq l Label.tyProd) (listOf (cons (atomOf kwProd) rs))
                (if (eq l Label.tyArrow) (listOf (cons (atomOf kwArrow) rs))
                  (listOf (cons (atomOf kwList) rs)))))))
        A)))
  (def printTypes
    (lam ((cs Ts)) (foldr T Ts (lam ((c T) (acc Ts)) (cons (printType c) acc)) (nil T) cs)))
  ; a quoted tree as a datum: a leaf as its label's numeral, and a node of children as the list
  ; of its label's numeral and its children's data
  (def printDatum
    (lam ((t T))
      (fold T (lam ((l T) (rs Ts)) (if (nonEmpty rs) (listOf (cons (numAtom l) rs)) (numAtom l)))
        t)))

  ; a term printed under binders to a depth: each node's result is its subtree with its printing
  ; as a function of the depth
  (deftype PF (Arrow T T))
  (deftype PR (Prod T PF))
  (deftype PRs (List PR))
  (def prTrees (lam ((rs PRs)) (foldr PR Ts (lam ((r PR) (acc Ts)) (cons (fst r) acc)) (nil T) rs)))
  (def prAt
    (lam ((rs PRs) (d T)) (foldr PR Ts (lam ((r PR) (acc Ts)) (cons ((snd r) d) acc)) (nil T) rs)))
  (def kwList1 (lam ((kw T) (xs Ts)) (listOf (cons (atomOf kw) xs))))
  ; one node printed, from its children with their printings, given the names of the definitions
  (def printStep
    (lam ((defs Ts) (l T) (rs PRs) (d T))
      (let cs Ts (prTrees rs)
        (let ps Ts (prAt rs d)
          (let i T (label (at cs 0))
            (if (eq l Label.var) (binderAtom (sub (sub d 1) i))
              (if (eq l Label.lam)
                (kwList1 kwLam
                  (cons (listOf (cons (binderAtom d) (single (printType (at cs 0)))))
                    (single (at (prAt rs (add d 1)) 1))))
                (if (eq l Label.app) (listOf ps)
                  (if (eq l Label.unit) (atomOf kwUnitValue)
                    (if (eq l Label.pair) (kwList1 kwPair ps)
                      (if (eq l Label.fst) (kwList1 kwFst ps)
                        (if (eq l Label.snd) (kwList1 kwSnd ps)
                          (if (eq l Label.cond) (kwList1 kwIf ps)
                            (if (eq l Label.cons) (kwList1 kwCons ps)
                              (if (eq l Label.quote)
                                (let c T (at cs 0)
                                  (if (nonEmpty (children c))
                                    (kwList1 kwQuote (single (printDatum c)))
                                    (numAtom (label c))))
                                (if (eq l Label.nil) (kwList1 kwNil (printTypes cs))
                                  (if (eq l Label.fold) (kwList1 kwFold (printTypes cs))
                                    (if (eq l Label.para) (kwList1 kwPara (printTypes cs))
                                      (if (eq l Label.iter) (kwList1 kwIter (printTypes cs))
                                        (if (eq l Label.foldr) (kwList1 kwFoldr (printTypes cs))
                                          (if (eq l Label.lcase) (kwList1 kwLcase (printTypes cs))
                                            (if (eq l Label.prim) (nameAt primNames i)
                                              (nameAt defs i)))))))))))))))))))))))
  ; a term printed under binders to a depth, given the names of the definitions; the body is
  ; applied to the identity at its type, as the datatype language's defn applies it, so that the
  ; type is read from the definition
  (def printTerm
    (lam ((defs Ts) (t T) (d T))
      ((lam ((r T)) r)
       ((snd
          (fold PR
            (lam ((l T) (rs PRs))
              (pair (node l (prTrees rs)) (lam ((e T)) (printStep defs l rs e))))
            t)) d))))
  ; the reader's resolution of an S-expression, with no type abbreviations, given the names of the
  ; definitions and the names in scope: what reads back what the printer writes
  (def readBack (lam ((defs Ts) (e T) (scope Ts)) ((lam ((r T)) r) (resolve (nil T) defs e scope))))

  ; well-formedness: whether the only one of trees is a leaf below a bound
  (def leafBelow
    (lam ((cs Ts) (n T))
      (if (eq (length cs) 1) (if (nonEmpty (children (at cs 0))) 0 (lt (label (at cs 0)) n)) 0)))
  ; whether every child is well formed at a depth
  (def allAt (lam ((rs PRs) (d T)) (foldr PR T (lam ((r PR) (ok T)) (if ((snd r) d) ok 0)) 1 rs)))
  ; whether there are a number of children, each a type
  (def tysOf
    (lam ((k T) (cs Ts))
      (if (eq (length cs) k) (foldr T T (lam ((c T) (ok T)) (if (isTy c) ok 0)) 1 cs) 0)))
  ; one node's well-formedness under binders to a depth, from its children with their
  ; well-formedness as a function of the depth, given the number of definitions
  (def wfStep
    (lam ((nDefs T) (l T) (rs PRs) (d T))
      (let cs Ts (prTrees rs)
        (if (eq l Label.var) (leafBelow cs d)
          (if (eq l Label.lam)
            (if (eq (length cs) 2) (if (isTy (at cs 0)) (at (prAt rs (add d 1)) 1) 0) 0)
            (if (eq l Label.app) (if (eq (length cs) 2) (allAt rs d) 0)
              (if (eq l Label.unit) (if (nonEmpty cs) 0 1)
                (if (eq l Label.pair) (allAt rs d)
                  (if (eq l Label.fst) (allAt rs d)
                    (if (eq l Label.snd) (allAt rs d)
                      (if (eq l Label.cond) (allAt rs d)
                        (if (eq l Label.cons) (allAt rs d)
                          (if (eq l Label.quote) (eq (length cs) 1)
                            (if (eq l Label.nil) (tysOf 1 cs)
                              (if (eq l Label.fold) (tysOf 1 cs)
                                (if (eq l Label.para) (tysOf 1 cs)
                                  (if (eq l Label.iter) (tysOf 1 cs)
                                    (if (eq l Label.foldr) (tysOf 2 cs)
                                      (if (eq l Label.lcase) (tysOf 2 cs)
                                        (if (eq l Label.prim) (leafBelow cs (length primNames))
                                          (if (eq l Label.ref) (leafBelow cs nDefs)
                                            0)))))))))))))))))))))
  ; whether a term is well formed under binders to a depth, given the number of definitions
  (def termWf
    (lam ((nDefs T) (t T) (d T))
      ((snd
         (fold PR
           (lam ((l T) (rs PRs)) (pair (node l (prTrees rs)) (lam ((e T)) (wfStep nDefs l rs e))))
           t)) d)))
  ; whether a name is a binder's: an underscore followed by a numeral as the printer writes it
  (def isBinderName
    (lam ((n T))
      (let k T (numeral (tail (children n)))
        (if (isSome k) (equal (node 0 (cons 95 (Datatype.decimalChars (get k)))) n) 0))))
  ; whether a name may be a definition's: no numeral, no binder's name and not reserved
  (def nameOk
    (lam ((n T))
      (if (isSome (numeral (children n))) 0
        (if (isBinderName n) 0 (if (isSome (indexOf n reservedNames)) 0 1)))))
  ; whether names are distinct
  (deftype Seen (Prod T Ts))
  (def distinct
    (lam ((ns Ts))
      (fst
        (foldr T Seen
          (lam ((n T) (s Seen))
            (pair (if (fst s) (if (isSome (indexOf n (snd s))) 0 1) 0) (cons n (snd s))))
          (pair 1 (nil T))
          ns))))
  ; whether names may be a program's definitions': distinct, and each a definition's
  (def namesOk
    (lam ((ns Ts)) (if (distinct ns) (foldr T T (lam ((n T) (ok T)) (if (nameOk n) ok 0)) 1 ns) 0)))
  ; a term printed under binders to a depth, given the names of the definitions, when the names
  ; may be a program's definitions' and the term is well formed; none otherwise
  (def printTermOpt
    (lam ((defs Ts) (t T) (d T))
      ((lam ((r T)) r)
       (if (namesOk defs) (if (termWf (length defs) t d) (some (printTerm defs t d)) none) none))))

  ; a bundle's definitions printed, each (def name term), its references named by the names of
  ; the definitions before it, or none when a name may not be a definition's or is declared
  ; already, or a term is not well formed among the definitions before it
  (deftype PK (Arrow Ts T))
  (def printProgram
    (lam ((b T))
      (let names Ts (children (child b 1))
        ((foldr T PK
           (lam ((t T) (k PK) (pre Ts))
             (let n T (at names (length pre))
               (if (nameOk n)
                 (if (isSome (indexOf n pre)) none
                   (if (termWf (length pre) t 0)
                     (let r T (k (append pre (single n)))
                       (if (isSome r)
                         (some
                           (node 0
                             (cons (kwList1 kwDef (cons (atomOf n) (single (printTerm pre t 0))))
                               (children (get r)))))
                         none))
                     none))
                 none)))
           (lam ((pre Ts)) (some (node 0 (nil T))))
           (children (child b 0))) (nil T))))))
