; Authors: Terence Rokop
;
; The reader, written in the kernel's syntax: text in the authoring profile to tokens, tokens to
; S-expressions, and S-expressions to a program's bundle, reading exactly as the seed's reader
; reads.
; Requires the prelude.
;
; Representations. Text is a list of the leaves of its bytes. A token is the leaf 1 for an
; opening parenthesis, the leaf 2 for a closing one, or a node of label 3 over the leaves of
; an atom's characters. An S-expression is a node of label 1 over an atom's characters or a
; node of label 2 over a list's elements. An optional tree is the node of label 1 over the
; tree, or the leaf 0. A name is a node of label 0 over its characters.

; whether two optional trees are both present, and whether a list has an element
(def both (lam ((a T) (b T)) (if (isSome a) (isSome b) 0)))
(def nonEmpty (lam ((xs Ts)) (lcase T T xs 0 (lam ((x T) (r Ts)) 1))))

; the list of the values of a list of optional trees, when every one is present
(deftype Opts (Prod T Ts))
(def allSome
  (lam ((ms Ts))
    (let r Opts
      (foldr T Opts (lam ((m T) (acc Opts)) (pair (both m (fst acc)) (cons (get m) (snd acc))))
        (pair 1 (nil T))
        ms)
      (if (fst r) (some (node 0 (snd r))) none))))

; the lexer of the authoring profile, reading as the seed's lexer reads and leaving out the
; comments. Its state is the tokens read, the latest first, the characters of the token being
; read, the latest first, and the mode, a tree whose label is what is being read: 0 nothing, 1
; a bare atom, 2 a numeral, 3 a hole's name, 4 a comment, 5 a quoted string, 6 an escape after
; its backslash, 7 after a backslash and a carriage return, 8 after a backslash and a line feed,
; 9 a hexadecimal and 10 an octal escape, each over the digits read and their value, and 11 a
; text that is not well formed
(deftype Lex (Prod Ts (Prod Ts T)))
(deftype LexK (Arrow Lex Lex))
(def lexFail (pair (nil T) (pair (nil T) 11)))
(def lexIn (lam ((toks Ts) (cur Ts) (m T)) (pair toks (pair cur m))))
(def lexIdle (lam ((toks Ts)) (lexIn toks (nil T) 0)))
(def inRange (lam ((c T) (lo T) (hi T)) (if (lt c lo) 0 (lt c (add hi 1)))))
(def isDigit (lam ((c T)) (inRange c 48 57)))
(def isSpace
  (lam ((c T))
    (if (eq c 32) 1 (if (eq c 10) 1 (if (eq c 9) 1 (if (eq c 13) 1 (if (eq c 11) 1 (eq c 12))))))))
; a letter, or one of the eight pseudo-alphabetic characters of RFC 9804, - . / _ : * + =
(def isTokenStart
  (lam ((c T))
    (if (inRange c 65 90) 1
      (if (inRange c 97 122) 1
        (if (eq c 45) 1
          (if (eq c 46) 1
            (if (eq c 47) 1
              (if (eq c 95) 1 (if (eq c 58) 1 (if (eq c 42) 1 (if (eq c 43) 1 (eq c 61))))))))))))
(def isTokenChar (lam ((c T)) (if (isTokenStart c) 1 (isDigit c))))
; a character a quoted string holds as it is: printable ASCII but the double quote and the
; backslash, a line break, or a byte beyond ASCII
(def isPlainIn
  (lam ((c T))
    (if (inRange c 32 126) (if (eq c 34) 0 (if (eq c 92) 0 1))
      (if (eq c 10) 1 (if (eq c 13) 1 (lt 127 c))))))
(def atomTok (lam ((cur Ts)) (node 3 (reverse cur))))
(def kwHole (quote (0 hole)))
; the tokens of a hole's form, (hole name), after the tokens read
(def holeToks
  (lam ((cur Ts) (toks Ts))
    (cons 2 (cons (atomTok cur) (cons (node 3 (children kwHole)) (cons 1 toks))))))
; a character read between tokens
(def idleStep
  (lam ((toks Ts) (c T))
    (if (eq c 59) (lexIn toks (nil T) 4)
      (if (eq c 40) (lexIdle (cons 1 toks))
        (if (eq c 41) (lexIdle (cons 2 toks))
          (if (eq c 34) (lexIn toks (nil T) 5)
            (if (eq c 38) (lexIdle (cons (node 3 (single 38)) toks))
              (if (eq c 63) (lexIn toks (nil T) 3)
                (if (isSpace c) (lexIdle toks)
                  (if (isDigit c) (lexIn toks (single c) 2)
                    (if (isTokenStart c) (lexIn toks (single c) 1) lexFail)))))))))))
; a character of a quoted string
(def strStep
  (lam ((toks Ts) (cur Ts) (c T))
    (if (eq c 34) (lexIdle (cons (atomTok cur) toks))
      (if (eq c 92) (lexIn toks cur 6) (if (isPlainIn c) (lexIn toks (cons c cur) 5) lexFail)))))
; the character an escape of one character after its backslash denotes
(def escChar
  (lam ((c T))
    (if (eq c 97) (some 7)
      (if (eq c 98) (some 8)
        (if (eq c 116) (some 9)
          (if (eq c 118) (some 11)
            (if (eq c 110) (some 10)
              (if (eq c 102) (some 12)
                (if (eq c 114) (some 13)
                  (if (eq c 34) (some c)
                    (if (eq c 39) (some c)
                      (if (eq c 63) (some c) (if (eq c 92) (some c) none)))))))))))))
(def hexVal
  (lam ((c T))
    (if (isDigit c) (some (sub c 48))
      (if (inRange c 65 70) (some (sub c 55)) (if (inRange c 97 102) (some (sub c 87)) none)))))
(def lexStep
  (lam ((s Lex) (c T))
    (let toks Ts (fst s)
      (let cur Ts (fst (snd s))
        (let m T (snd (snd s))
          (let k T (label m)
            (if (eq k 0) (idleStep toks c)
              (if (eq k 4) (if (eq c 10) (lexIdle toks) s)
                (if (eq k 1)
                  (if (isTokenChar c) (lexIn toks (cons c cur) m)
                    (idleStep (cons (atomTok cur) toks) c))
                  (if (eq k 2)
                    (if (isDigit c) (lexIn toks (cons c cur) m)
                      (if (if (isTokenChar c) 1 (if (eq c 34) 1 (if (eq c 35) 1 (eq c 124))))
                        lexFail
                        (idleStep (cons (atomTok cur) toks) c)))
                    (if (eq k 3)
                      (if (if (isTokenChar c) (if (nonEmpty cur) 1 (if (isDigit c) 0 1)) 0)
                        (lexIn toks (cons c cur) m)
                        (if (nonEmpty cur) (idleStep (holeToks cur toks) c) lexFail))
                      (if (eq k 5) (strStep toks cur c)
                        (if (eq k 6)
                          (let e T (escChar c)
                            (if (isSome e) (lexIn toks (cons (get e) cur) 5)
                              (if (eq c 120) (lexIn toks cur (node 9 (cons 0 (single 0))))
                                (if (inRange c 48 55)
                                  (lexIn toks cur (node 10 (cons 1 (single (sub c 48)))))
                                  (if (eq c 13) (lexIn toks cur 7)
                                    (if (eq c 10) (lexIn toks cur 8) lexFail))))))
                          (if (eq k 7) (if (eq c 10) (lexIn toks cur 5) (strStep toks cur c))
                            (if (eq k 8) (if (eq c 13) (lexIn toks cur 5) (strStep toks cur c))
                              (if (eq k 9)
                                (let d T (hexVal c)
                                  (if (isSome d)
                                    (if (eq (child m 0) 1)
                                      (lexIn toks (cons (add (mul 16 (child m 1)) (get d)) cur) 5)
                                      (lexIn toks cur (node 9 (cons 1 (single (get d))))))
                                    lexFail))
                                (if (eq k 10)
                                  (if (inRange c 48 55)
                                    (let w T (add (mul 8 (child m 1)) (sub c 48))
                                      (if (eq (child m 0) 2)
                                        (if (lt w 256) (lexIn toks (cons w cur) 5) lexFail)
                                        (lexIn toks cur
                                          (node 10 (cons (add (child m 0) 1) (single w))))))
                                    lexFail)
                                  s)))))))))))))))))
; the tokens of a text, in order, when it is well formed
(def lexEnd
  (lam ((s Lex))
    (let toks Ts (fst s)
      (let cur Ts (fst (snd s))
        (let k T (label (snd (snd s)))
          (if (if (eq k 0) 1 (eq k 4)) (some (node 0 (reverse toks)))
            (if (if (eq k 1) 1 (eq k 2)) (some (node 0 (reverse (cons (atomTok cur) toks))))
              (if (eq k 3) (if (nonEmpty cur) (some (node 0 (reverse (holeToks cur toks)))) none)
                none))))))))
(def tokenize
  (lam ((cs Ts))
    (lexEnd
      ((foldr T LexK (lam ((c T) (k LexK) (s Lex)) (k (lexStep s c))) (lam ((s Lex)) s) cs)
       (lexIdle (nil T))))))

; S-expressions, by a stack of lists under construction, innermost first, each in reverse
(deftype Stack (List Ts))
(deftype Par (Prod T Stack))
(deftype ParK (Arrow Par Par))
(def fail (pair 0 (nil Ts)))
(def parseStep
  (lam ((s Par) (tok T))
    (if (fst s)
      (lcase Ts Par (snd s) fail
        (lam ((f Ts) (fs Stack))
          (if (eq (label tok) 1) (pair 1 (cons (nil T) (cons f fs)))
            (if (eq (label tok) 3) (pair 1 (cons (cons (node 1 (children tok)) f) fs))
              (lcase Ts Par fs fail
                (lam ((g Ts) (gs Stack)) (pair 1 (cons (cons (node 2 (reverse f)) g) gs))))))))
      s)))
(def readSExps
  (lam ((cs Ts))
    (let toks T (tokenize cs)
      (if (isSome toks)
        (let s Par
          ((foldr T ParK (lam ((t T) (k ParK) (s Par)) (k (parseStep s t))) (lam ((s Par)) s)
             (children (get toks))) (pair 1 (cons (nil T) (nil Ts))))
          (if (fst s)
            (lcase Ts T (snd s) none
              (lam ((f Ts) (fs Stack))
                (lcase Ts T fs (some (node 0 (reverse f))) (lam ((g Ts) (gs Stack)) none))))
            none))
        none))))

; atoms and names
(def isAtom (lam ((e T)) (eq (label e) 1)))
(def isList (lam ((e T)) (eq (label e) 2)))
(def nameOf (lam ((e T)) (node 0 (children e))))
(def named (lam ((e T) (n T)) (if (isAtom e) (equal (nameOf e) n) 0)))
(def kwT (quote (0 T)))
(def kwUnit (quote (0 Unit)))
(def kwProd (quote (0 Prod)))
(def kwArrow (quote (0 Arrow)))
(def kwList (quote (0 List)))
(def kwLam (quote (0 lam)))
(def kwLet (quote (0 let)))
(def kwPair (quote (0 pair)))
(def kwFst (quote (0 fst)))
(def kwSnd (quote (0 snd)))
(def kwIf (quote (0 if)))
(def kwQuote (quote (0 quote)))
(def kwCons (quote (0 cons)))
(def kwNil (quote (0 nil)))
(def kwFold (quote (0 fold)))
(def kwPara (quote (0 para)))
(def kwIter (quote (0 iter)))
(def kwFoldr (quote (0 foldr)))
(def kwLcase (quote (0 lcase)))
(def kwUnitValue (quote (0 unit)))
(def kwDef (quote (0 def)))
(def kwDeftype (quote (0 deftype)))
(def kwDefnum (quote (0 defnum)))
(def primNames
  (children
    (quote
      (0 (0 label) (0 arity) (0 child) (0 node) (0 children) (0 add) (0 sub) (0 mul) (0 div) (0 mod)
        (0 eq)
        (0 lt)
        (0 equal)
        (0 log2)))))

; the first position of a name in a list of names
(def indexOf
  (lam ((x T) (xs Ts))
    (foldr T T
      (lam ((y T) (r T)) (if (equal x y) (some 0) (if (isSome r) (some (add (get r) 1)) none)))
      none
      xs)))
; the value an abbreviation names; an abbreviation is a node over its name and its value
(def lookupAbbrev
  (lam ((n T) (abbrevs Ts))
    (foldr T T (lam ((p T) (r T)) (if (equal n (child p 0)) (some (child p 1)) r)) none abbrevs)))
; the value of a numeral: a non-empty list of decimal digits
(deftype Num (Prod T (Prod T T)))
(def numeral
  (lam ((cs Ts))
    (let r Num
      (foldr T Num
        (lam ((c T) (s Num))
          (if (lt c 48) (pair 0 (snd s))
            (if (lt 57 c) (pair 0 (snd s))
              (pair (fst s)
                (pair (add (fst (snd s)) (mul (sub c 48) (snd (snd s)))) (mul 10 (snd (snd s))))))))
        (pair 1 (pair 0 1))
        cs)
      (if (nonEmpty cs) (if (fst r) (some (fst (snd r))) none) none))))
; an S-expression with each atom that names a numeral abbreviation replaced by its numeral's
; atom; a numeral abbreviation's value is that atom
(def expandNums
  (lam ((nums Ts) (e T))
    (fold T
      (lam ((l T) (rs Ts))
        (let raw T (node l rs)
          (if (isAtom raw) (let v T (lookupAbbrev (nameOf raw) nums) (if (isSome v) (get v) raw))
            raw)))
      e)))
; a numeral abbreviation's value: the S-expression, its abbreviations expanded, when it is a
; numeral
(def numOf
  (lam ((nums Ts) (e T))
    (let x T (expandNums nums e)
      (if (isAtom x) (if (isSome (numeral (children x))) (some x) none) none))))

; a fold whose results carry the subtree they come from, the subtrees' list and the results'
(deftype RT (Prod T T))
(deftype RTs (List RT))
(def rtTrees (lam ((rs RTs)) (foldr RT Ts (lam ((r RT) (acc Ts)) (cons (fst r) acc)) (nil T) rs)))
(def rtValues (lam ((rs RTs)) (foldr RT Ts (lam ((r RT) (acc Ts)) (cons (snd r) acc)) (nil T) rs)))
(def node2 (lam ((l T) (a T) (b T)) (node l (cons a (single b)))))
(def some2 (lam ((l T) (a T) (b T)) (if (both a b) (some (node2 l (get a) (get b))) none)))

; an S-expression read as a type, given the type abbreviations in force
(def readType
  (lam ((tys Ts) (e T))
    (snd
      (fold RT
        (lam ((l T) (rs RTs))
          (let raw T (node l (rtTrees rs))
            (let vs Ts (rtValues rs)
              (pair raw
                (if (isAtom raw)
                  (let n T (nameOf raw)
                    (if (equal n kwT) (some Label.tyTree)
                      (if (equal n kwUnit) (some Label.tyUnit) (lookupAbbrev n tys))))
                  (if (isList raw)
                    (let h T (at (children raw) 0)
                      (let k T (arity raw)
                        (if (named h kwProd)
                          (if (eq k 3) (some2 Label.tyProd (at vs 1) (at vs 2)) none)
                          (if (named h kwArrow)
                            (if (eq k 3) (some2 Label.tyArrow (at vs 1) (at vs 2)) none)
                            (if (named h kwList)
                              (if (eq k 2)
                                (if (isSome (at vs 1))
                                  (some (node Label.tyList (single (get (at vs 1)))))
                                  none)
                                none)
                              none)))))
                    none))))))
        e))))

; an S-expression read as a quoted datum: a numeral is a leaf, and a list of a numeral and data
; is a node, in which an atom that is not a numeral contributes the leaves of its characters'
; codes; each node's result is the list of the trees it contributes, under a node of label 0
(def readDatum
  (lam ((e T))
    (if (isAtom e)
      (let v T (numeral (children e)) (if (isSome v) (some (node (get v) (nil T))) none))
      (let r T
        (snd
          (fold RT
            (lam ((l T) (rs RTs))
              (let raw T (node l (rtTrees rs))
                (pair raw
                  (if (isAtom raw)
                    (let v T (numeral (children raw))
                      (if (isSome v) (some (node 0 (single (node (get v) (nil T)))))
                        (some (node 0 (children raw)))))
                    (if (isList raw)
                      (lcase T T (children raw) none
                        (lam ((h T) (r Ts))
                          (let v T (if (isAtom h) (numeral (children h)) none)
                            (let ds T (allSome (tail (rtValues rs)))
                              (if (both v ds)
                                (some
                                  (node 0
                                    (single
                                      (node (get v)
                                        (foldr T Ts (lam ((x T) (acc Ts)) (append (children x) acc))
                                          (nil T)
                                          (children (get ds)))))))
                                none)))))
                      none)))))
            e))
        (if (isSome r) (some (child (get r) 0)) none)))))

; resolution: each S-expression's result is its subtree with its resolution as a function of
; the names bound around it
(deftype Scope Ts)
(deftype Res (Arrow Scope T))
(deftype RR (Prod T Res))
(deftype RRs (List RR))
(def rrTrees (lam ((rs RRs)) (foldr RR Ts (lam ((r RR) (acc Ts)) (cons (fst r) acc)) (nil T) rs)))
(def rrApply
  (lam ((rs RRs) (scope Scope))
    (foldr RR Ts (lam ((r RR) (acc Ts)) (cons ((snd r) scope) acc)) (nil T) rs)))
(def rrTail (lam ((rs RRs)) (lcase RR RRs rs (nil RR) (lam ((r RR) (rest RRs)) rest))))
(def rrAt
  (lam ((rs RRs) (i T) (scope Scope))
    ((lcase RR Res (iter RRs rrTail rs i) (lam ((s Scope)) none) (lam ((r RR) (rest RRs)) (snd r)))
     scope)))
(def app (lam ((f T) (x T)) (node2 Label.app f x)))
(def apps (lam ((f T) (xs Ts)) (foldr T T (lam ((x T) (acc T)) (app acc x)) f (reverse xs))))
(def some1 (lam ((l T) (a T)) (if (isSome a) (some (node l (single (get a)))) none)))
(def argsOf (lam ((rs RRs) (n T) (scope Scope)) (allSome (rrApply (iter RRs rrTail rs n) scope))))
(def mkArgs (lam ((l T) (a T)) (if (isSome a) (some (node l (children (get a)))) none)))
(def appsOpt (lam ((f T) (a T)) (if (both f a) (some (apps (get f) (children (get a)))) none)))

; the binders of an abstraction: one binder (x A), or a list of them
(def binders
  (lam ((b T))
    (if (isList b)
      (if (eq (arity b) 2) (if (isAtom (child b 0)) (single b) (children b)) (children b))
      (nil T))))
; the names and types of binders, as the node of label 0 over nodes of label 0 over a name and
; a type, when every binder is a name with a type
(def readBinders
  (lam ((tys Ts) (bs Ts))
    (allSome
      (foldr T Ts
        (lam ((c T) (acc Ts))
          (cons
            (if (isList c)
              (if (eq (arity c) 2)
                (if (isAtom (child c 0))
                  (let A T (readType tys (child c 1))
                    (if (isSome A) (some (node2 0 (nameOf (child c 0)) (get A))) none))
                  none)
                none)
              none)
            acc))
        (nil T)
        bs))))

; one atom's resolution
(def resolveAtom
  (lam ((defs Ts) (raw T) (scope Scope))
    (let v T (numeral (children raw))
      (if (isSome v) (some (node Label.quote (single (get v))))
        (let n T (nameOf raw)
          (let i T (indexOf n scope)
            (if (isSome i) (some (node Label.var (single (get i))))
              (let j T (indexOf n defs)
                (if (isSome j) (some (node Label.ref (single (get j))))
                  (let k T (indexOf n primNames)
                    (if (isSome k) (some (node Label.prim (single (get k))))
                      (if (equal n kwUnitValue) (some (node Label.unit (nil T))) none))))))))))))

; one list's resolution, from its elements with their resolutions
(def resolveList
  (lam ((tys Ts) (raw T) (rs RRs) (scope Scope))
    (let es Ts (children raw)
      (let k T (arity raw)
        (let h T (at es 0)
          (if (eq k 0) none
            (if (if (named h kwLam) (eq k 3) 0)
              (let bs T (readBinders tys (binders (at es 1)))
                (if (isSome bs)
                  (let ps Ts (children (get bs))
                    (if (nonEmpty ps)
                      (let body T
                        (rrAt rs 2
                          (append
                            (reverse
                              (foldr T Ts (lam ((p T) (acc Ts)) (cons (child p 0) acc)) (nil T) ps))
                            scope))
                        (if (isSome body)
                          (some
                            (foldr T T (lam ((p T) (u T)) (node2 Label.lam (child p 1) u))
                              (get body)
                              ps))
                          none))
                      none))
                  none))
              (if (if (named h kwLet) (eq k 5) 0)
                (let x T (at es 1)
                  (if (isAtom x)
                    (let A T (readType tys (at es 2))
                      (let body T (rrAt rs 4 (cons (nameOf x) scope))
                        (let e T (rrAt rs 3 scope)
                          (if (both A (both body e))
                            (some (app (node2 Label.lam (get A) (get body)) (get e)))
                            none))))
                    none))
                (if (named h kwPair) (mkArgs Label.pair (argsOf rs 1 scope))
                  (if (named h kwFst) (mkArgs Label.fst (argsOf rs 1 scope))
                    (if (named h kwSnd) (mkArgs Label.snd (argsOf rs 1 scope))
                      (if (named h kwIf) (mkArgs Label.cond (argsOf rs 1 scope))
                        (if (named h kwCons) (mkArgs Label.cons (argsOf rs 1 scope))
                          (if (if (named h kwQuote) (eq k 2) 0)
                            (some1 Label.quote (readDatum (at es 1)))
                            (if (if (named h kwNil) (eq k 2) 0)
                              (some1 Label.nil (readType tys (at es 1)))
                              (if (if (named h kwFold) (lt 1 k) 0)
                                (let A T (readType tys (at es 1))
                                  (if (isSome A)
                                    (appsOpt (some (node Label.fold (single (get A))))
                                      (argsOf rs 2 scope))
                                    none))
                                (if (if (named h kwPara) (lt 1 k) 0)
                                  (let A T (readType tys (at es 1))
                                    (if (isSome A)
                                      (appsOpt (some (node Label.para (single (get A))))
                                        (argsOf rs 2 scope))
                                      none))
                                  (if (if (named h kwIter) (lt 1 k) 0)
                                    (let A T (readType tys (at es 1))
                                      (if (isSome A)
                                        (appsOpt (some (node Label.iter (single (get A))))
                                          (argsOf rs 2 scope))
                                        none))
                                    (if (if (named h kwFoldr) (lt 2 k) 0)
                                      (let A T
                                        (some2 Label.foldr (readType tys (at es 1))
                                          (readType tys (at es 2)))
                                        (if (isSome A) (appsOpt A (argsOf rs 3 scope)) none))
                                      (if (if (named h kwLcase) (lt 2 k) 0)
                                        (let A T
                                          (some2 Label.lcase (readType tys (at es 1))
                                            (readType tys (at es 2)))
                                          (if (isSome A) (appsOpt A (argsOf rs 3 scope)) none))
                                        (appsOpt (rrAt rs 0 scope)
                                          (argsOf rs 1 scope))))))))))))))))))))))

; an S-expression resolved into a kernel term, given the type abbreviations in force, the names
; of the definitions before it and the names bound around it
(def resolve
  (lam ((tys Ts) (defs Ts) (e T) (scope Scope))
    ((snd
       (fold RR
         (lam ((l T) (rs RRs))
           (let raw T (node l (rrTrees rs))
             (pair raw
               (lam ((s Scope))
                 (if (isAtom raw) (resolveAtom defs raw s)
                   (if (isList raw) (resolveList tys raw rs s) none))))))
         e)) scope)))

; the names no declaration takes: the keywords of terms and of declarations, the form of a hole,
; the names of the types and of the primitives
(def reservedNames
  (append
    (cons kwLam
      (cons kwLet
        (cons kwPair
          (cons kwFst
            (cons kwSnd
              (cons kwIf
                (cons kwQuote
                  (cons kwCons
                    (cons kwNil
                      (cons kwFold
                        (cons kwPara
                          (cons kwIter
                            (cons kwFoldr
                              (cons kwLcase
                                (cons kwUnitValue
                                  (cons kwDef
                                    (cons kwDeftype
                                      (cons kwDefnum
                                        (cons kwHole
                                          (cons kwT
                                            (cons kwUnit
                                              (cons kwProd
                                                (cons kwArrow (single kwList))))))))))))))))))))))))
    primNames))
; whether a name may be declared after the type abbreviations, numeral abbreviations and
; definitions given: it is neither reserved nor declared already
(def isFresh
  (lam ((tys Ts) (nums Ts) (names Ts) (n T))
    (if (isSome (indexOf n reservedNames)) 0
      (if (isSome (indexOf n names)) 0
        (if (isSome (lookupAbbrev n tys)) 0 (if (isSome (lookupAbbrev n nums)) 0 1))))))

; a program's forms read into its bundle: the state is whether every form has read, the type
; abbreviations, the numeral abbreviations, the names of the definitions, and their terms
(deftype Prog (Prod T (Prod Ts (Prod Ts (Prod Ts Ts)))))
(deftype ProgK (Arrow Prog Prog))
(def progStep
  (lam ((s Prog) (e T))
    (let tys Ts (fst (snd s))
      (let nums Ts (fst (snd (snd s)))
        (let names Ts (fst (snd (snd (snd s))))
          (let terms Ts (snd (snd (snd (snd s))))
            (if
              (if (fst s)
                (if (isList e)
                  (if (eq (arity e) 3)
                    (if (isAtom (child e 1)) (isFresh tys nums names (nameOf (child e 1))) 0)
                    0)
                  0)
                0)
              (let n T (nameOf (child e 1))
                (if (named (child e 0) kwDef)
                  (let t T (resolve tys names (expandNums nums (child e 2)) (nil T))
                    (if (isSome t)
                      (pair 1
                        (pair tys
                          (pair nums
                            (pair (append names (single n)) (append terms (single (get t)))))))
                      (pair 0 (snd s))))
                  (if (named (child e 0) kwDeftype)
                    (let A T (readType tys (child e 2))
                      (if (isSome A) (pair 1 (pair (cons (node2 0 n (get A)) tys) (snd (snd s))))
                        (pair 0 (snd s))))
                    (if (named (child e 0) kwDefnum)
                      (let v T (numOf nums (child e 2))
                        (if (isSome v)
                          (pair 1
                            (pair tys (pair (cons (node2 0 n (get v)) nums) (snd (snd (snd s))))))
                          (pair 0 (snd s))))
                      (pair 0 (snd s))))))
              (pair 0 (snd s)))))))))
(def readProgram
  (lam ((es Ts))
    (let s Prog
      ((foldr T ProgK (lam ((e T) (k ProgK) (s Prog)) (k (progStep s e))) (lam ((s Prog)) s) es)
       (pair 1 (pair (nil T) (pair (nil T) (pair (nil T) (nil T))))))
      (if (fst s)
        (some (node2 100 (node 101 (snd (snd (snd (snd s))))) (node 102 (fst (snd (snd (snd s)))))))
        none))))
