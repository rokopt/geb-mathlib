;
; Lists and optional values at an explicit element type. Optional trees have the prelude's
; encoding: nothing is the leaf 0 and just is the node of label 1 over its value.

(module Seq (export single length append reverse tail drop atOr)
  (defn (single A) ((x A)) (List A) (cons x (nil A)))
  (defn (length A) ((xs (List A))) T (foldr A T (lam ((x A) (n T)) (add n 1)) 0 xs))
  (defn (append A) ((xs (List A)) (ys (List A))) (List A)
    (foldr A (List A) (lam ((x A) (r (List A))) (cons x r)) ys xs))
  (defn (reverse A) ((xs (List A))) (List A)
    ((foldr A (Arrow (List A) (List A))
       (lam ((x A) (k (Arrow (List A) (List A))) (acc (List A))) (k (cons x acc)))
       (lam ((acc (List A))) acc)
       xs) (nil A)))
  (defn (tail A) ((xs (List A))) (List A)
    (lcase A (List A) xs (nil A) (lam ((x A) (r (List A))) r)))
  (defn (drop A) ((n T) (xs (List A))) (List A) (iter (List A) (tail A) xs n))
  ; the element at a position, or a default when the list is not longer
  (defn (atOr A) ((d A) (xs (List A)) (i T)) A
    (lcase A A (drop A i xs) d (lam ((x A) (r (List A))) x))))

(module Option (export Maybe nothing just isJust fromMaybe nthOf allJust)
  (data (Maybe A) (nothing) (just A))
  (defn (isJust A) ((m (Maybe A))) T (case m ((just A x) 1) ((nothing A) 0)))
  (defn (fromMaybe A) ((d A) (m (Maybe A))) A (case m ((just A x) x) ((nothing A) d)))
  ; the element at a position, when the list is longer
  (defn (nthOf A) ((xs (List A)) (i T)) (Maybe A)
    (lcase A (Maybe A)
      (iter (List A)
        (lam ((ys (List A))) (lcase A (List A) ys (nil A) (lam ((y A) (r (List A))) r)))
        xs
        i)
      (nothing A)
      (lam ((x A) (r (List A))) (just A x))))
  ; the values of a list of optional values, when every one is present
  (defn (allJust A) ((ms (List (Maybe A)))) (Prod T (List A))
    (foldr (Maybe A) (Prod T (List A))
      (lam ((m (Maybe A)) (acc (Prod T (List A))))
        (case m ((just A x) (pair (fst acc) (cons x (snd acc)))) ((nothing A) (pair 0 (snd acc)))))
      (pair 1 (nil A))
      ms)))
