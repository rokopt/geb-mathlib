; The tactics of the internal language (Geb.FreeTopos.Tactics), composed from its prover: proofs
; by reduction, by induction and case analysis, with hypotheses, by search, and about the
; translation's trees.

(module Tactics
  (export byMode hypRules byListCases AI openSubterms stuckVar mentions matchesOf byAuto condParts
    stuckVarC
    appsOf
    unnodeU
    occRewrite
    abstractTerm)
  (import Prelude)
  (import Base)
  (import Theory)
  (import Infer)
  (import Language)
  (import Derivation)
  (import Translation)
  (import Prover)
  (import (Seq LDefn) as LDefnL)
  ; the bindings of optional theorems, assignments, conditionals' parts, masked rewritings and
  ; trees, as the base binds optional trees
  (defn bindTh ((m OThm.Maybe) (f (Arrow Thm T))) T
    (case m ((OThm.just a) (f a)) ((OThm.nothing) none)))
  (defn bindAT ((m OAssign.Maybe) (f (Arrow Assign T))) T
    (case m ((OAssign.just a) (f a)) ((OAssign.nothing) none)))
  (def pr0 (pr 0 0))
  (def nfr0 (nfr 0 (mark 0 0)))
  ; the connectives, the definitions from an index: truth, and the implication of one formula by
  ; another; the proof of truth, and the introduction of an implication under hypotheses, the rules
  ; the theorems from an index
  (defn ttL ((o T)) T (mDefn o (nil T) (nil T)))
  (defn impL ((o T) (p T) (q T)) T (mDefn (add o 2) (nil T) (l2 q p)))
  (def trueI
    (dNode 23 (nil T)
      (l2 (dNode 8 (nil T) (nil T))
        (dNode 18 (nil T) (l2 (dNode 0 (nil T) (nil T)) (dNode 0 (nil T) (nil T)))))))
  (defn impI ((j T) (n T) (p T) (q T) (d T)) T
    (dNode 23 (nil T)
      (l2 (dNode 8 (nil T) (nil T))
        (dNode 25 (nil T)
          (l2
            (dNode 27 (l3 (add j 2) (node 0 (nil T)) (node 0 (l2 q p)))
              (single (dNode 21 (single n) (nil T))))
            (dNode 27 (l3 (add j 1) (node 0 (nil T)) (node 0 (l2 q p)))
              (l2 (dNode 21 (single n) (nil T)) d)))))))

  ; proofs by reduction: both sides to one normal form at a depth, and the equation of the normal
  ; forms by a prover; normalization with the hypotheses as rewriting rules
  (defn apps ((f T) (xs Ts)) T
    (foldr T RW (lam ((x T) (k RW) (acc T)) (k (app acc x))) (lam ((acc T)) acc) xs f))
  (defn byMode ((m T) (G Globals) (E (List Entry)) (n T) (rs NRs)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T)) (joinBy (eval G E n rs 4096 m) g hs t u)))
  (defn byWeak ((G Globals) (E (List Entry)) (n T) (rs NRs)) Pv (byMode 1 G E n rs))
  (defn byNF ((G Globals) (E (List Entry)) (n T) (rs NRs) (m T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindNT (eval G E n rs 4096 m g hs t)
        (lam ((a NFR))
          (bindNT (eval G E n rs 4096 m g hs u)
            (lam ((b NFR))
              (mapO
                (lam ((q T))
                  (dNode 23 (nil T)
                    (l2 (dNode 2 (nil T) (l2 (mDeriv (nfMarked a)) (mDeriv (nfMarked b)))) q)))
                (p g hs (nfTerm a) (nfTerm b)))))))))
  (defn appendNR ((xs NRs) (ys NRs)) NRs (foldr NR NRs (lam ((x NR) (acc NRs)) (cons x acc)) ys xs))
  (defn hypRule ((i T)) NR (pair (nrHyp i) noMatch))
  (defn hypRules ((k T)) NRs
    (foldr T NRs (lam ((i T) (acc NRs)) (cons (hypRule i) acc)) (nil NR) (range k)))
  (defn normH ((G Globals) (E (List Entry)) (rs NRs)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (byNormW G E 0 (appendNR (hypRules (length hs)) rs) 1024 g hs t u)))

  ; induction and case analysis
  (defn funExts ((k T) (G Globals) (p Pv)) Pv (iter Pv (lam ((q Pv)) (byFunExt G 0 q)) p k))
  (defn byListIndWeak ((G Globals) (E (List Entry)) (n T) (s T) (rs NRs)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (lcase T T g none
        (lam ((c T) (g1 Ts))
          (bindO (listPart c)
            (lam ((a T))
              (bindHT (lowerHyps G n g1 hs)
                (lam ((hn Terms))
                  (let h1 Ts (termsOf hn)
                    (let g2 Ts (cons c (cons a g1))
                      (let h2 Ts (mapT weaken2 h1)
                        (bindO
                          (byWeak G E n rs g1 h1 (instAt 0 (single a) t) (instAt 0 (single a) u))
                          (lam ((p0 T))
                            (bindO
                              (byWeak G E n rs g2 h2 (listConsAt 1 a t)
                                (subst s (atVar0 (weakenElem t))))
                              (lam ((p1v T))
                                (mapO (lam ((p2v T)) (dNode 20 (l3 0 1 s) (l3 p0 p1v p2v)))
                                  (byWeak G E n rs g2 h2 (listConsAt 1 a u)
                                    (subst s (atVar0 (weakenElem u))))))))))))))))))))
  (defn byRoseIndWith ((G Globals) (n T) (s T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (if (eq (length g) 1)
        (let r T (at g 0)
          (bindO (roseLabel r)
            (lam ((a T))
              (bindO (typeIn G n g t)
                (lam ((C T))
                  (let g2 Ts (l2 (list r) a)
                    (bindO
                      (p g2 (nil T) (roseNodeAt 2 r a t) (subst s (atVar0 (roseMapAt 0 1 C t))))
                      (lam ((q1 T))
                        (mapO (lam ((q2 T)) (dNode 32 (l4 2 0 1 s) (l2 q1 q2)))
                          (p g2 (nil T) (roseNodeAt 2 r a u)
                            (subst s (atVar0 (roseMapAt 0 1 C u)))))))))))))
        none)))
  ; the derivation of an equation from the equation of the sides' abstractions over a term, cut in,
  ; by applying them to the term
  (defn applyAbs ((x T) (nh T) (F T) (H T) (dF T)) T
    (dNode 22 (single (mEq F H))
      (l2 dF
        (dNode 24 (single (mEq (app F x) (app H x)))
          (l2 (dNode 2 (nil T) (l2 (dNode 3 (nil T) (nil T)) (dNode 3 (nil T) (nil T))))
            (dNode 18 (nil T)
              (l2 (dNode 2 (nil T) (l2 (dNode 17 (l2 nh 0) (nil T)) (dNode 0 (nil T) (nil T))))
                (dNode 0 (nil T) (nil T)))))))))
  (defn byListSplit ((G Globals) (n T) (i T) (p0 Pv) (p1v Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindO (nth g i)
        (lam ((c T))
          (let F T (abstractVar i c t)
            (let H T (abstractVar i c u)
              (mapO (lam ((q T)) (applyAbs (var i) (length hs) F H (dNode 26 (nil T) (single q))))
                ((byListIndWith G n 0 1 p0 p1v) (cons c g) (mapT weaken1 hs)
                 (app (weaken1 F) (var 0))
                 (app (weaken1 H) (var 0))))))))))
  (defn bySplit2 ((kl T) (kr T) (i T) (p0 Pv) (p1v Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindO (nth g i)
        (lam ((c T))
          (bindPT (coprodParts c)
            (lam ((ab TPair))
              (let a T (p1 ab)
                (let b T (p2 ab)
                  (let F T (abstractVar i c t)
                    (let H T (abstractVar i c u)
                      (let inj (Arrow T (Arrow T T))
                        (lam ((k T) (s T)) (app (weaken1 s) (mArr k (l2 a b) (var 0))))
                        (bindO (p0 (cons a g) (mapT weaken1 hs) (inj kl F) (inj kl H))
                          (lam ((q0 T))
                            (mapO
                              (lam ((q1 T))
                                (applyAbs (var i) (length hs) F H
                                  (dNode 26 (nil T) (single (dNode 34 (l2 kl kr) (l2 q0 q1))))))
                              (p1v (cons b g) (mapT weaken1 hs) (inj kr F) (inj kr H))))))))))))))))
  (defn byListCases ((G Globals) (n T) (p Pv)) Pv (byListIndWith G n 0 1 p p))
  (defn bitsInd ((G Globals) (n T) (p0 Pv) (p1v Pv)) Pv
    (byListIndWith G n 0 1 p0 (bySplit 3 4 1 p1v)))
  (defn bitsCases ((G Globals) (n T) (p Pv)) Pv (bitsInd G n p p))
  (deftype PvAt (Arrow T Pv))
  (defn byBits ((G Globals) (p Pv) (d T)) PvAt
    (iter PvAt (lam ((rec PvAt) (i T)) (byListSplit G 0 i p (bySplit2 3 4 1 (rec 1) (rec 1))))
      (lam ((i T)) p)
      d))
  (defn byLength3 ((G Globals) (i T) (p Pv) (q Pv)) Pv
    (byListSplit G 0 i q (byListSplit G 0 0 q (byListSplit G 0 0 q (byListSplit G 0 0 p q)))))

  ; hypotheses: equations among them cut in in normal form and used as rewriting rules, the
  ; instances of an equation of functions, the hypotheses at the children of an induction on rose
  ; trees, the case analysis of a list variable a hypothesis mentions, and implications
  (deftype KR (Arrow NRs Pv))
  (deftype AR (Arrow Ts (Arrow NRs T)))
  (defn withWeakHyps ((G Globals) (E (List Entry)) (n T) (rs NRs) (is Ts) (k KR) (m T)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      ((foldr T AR
         (lam ((i T) (acc AR) (h1 Ts) (extra NRs))
           (bindPT (bindTP (nth h1 i) eqParts)
             (lam ((ab TPair))
               (bindNT (eval G E n rs 4096 m g h1 (p1 ab))
                 (lam ((ra NFR))
                   (bindNT (eval G E n rs 4096 m g h1 (p2 ab))
                     (lam ((rb NFR))
                       (let psi T (mEq (nfTerm ra) (nfTerm rb))
                         (mapO
                           (lam ((rest T))
                             (dNode 22 (single psi)
                               (l2
                                 (dNode 24 (single (mEq (p1 ab) (p2 ab)))
                                   (l2
                                     (dNode 2 (nil T)
                                       (l2 (mDeriv (nfMarked ra)) (mDeriv (nfMarked rb))))
                                     (dNode 21 (single i) (nil T))))
                                 rest)))
                           (acc (append h1 (single psi))
                             (appendNR extra (cons (hypRule (length h1)) (nil NR)))))))))))))
         (lam ((h1 Ts) (extra NRs)) (k extra g h1 t u))
         is) hs (nil NR))))
  (defn byListIndHypWeak ((G Globals) (E (List Entry)) (n T) (rs NRs)) Pv
    (byListIndWith G n 0 1 (byWeak G E n rs)
      (lam ((g Ts) (hs Ts) (t T) (u T))
        (withWeakHyps G E n rs (single (sub (length hs) 1))
          (lam ((extra NRs)) (byWeak G E n (appendNR extra rs)))
          1
          g
          hs
          t
          u))))
  (defn byBitsIndHyp ((G Globals) (E (List Entry)) (rs NRs) (m T)) Pv
    (byListIndWith G 0 0 1 (byMode m G E 0 rs)
      (bySplit 3 4 1
        (lam ((g Ts) (hs Ts) (t T) (u T))
          (withWeakHyps G E 0 rs (single (sub (length hs) 1))
            (lam ((extra NRs)) (byMode m G E 0 (appendNR extra rs)))
            m
            g
            hs
            t
            u)))))
  (defn rwFun ((i T) (k T)) T
    (iter T (lam ((d T)) (dNode 2 (nil T) (l2 d (dNode 0 (nil T) (nil T)))))
      (dNode 17 (l2 i 0) (nil T))
      k))
  (deftype Tss (List Ts))
  (defn instEqs ((F T) (H T) (als Tss)) Ts
    (foldr Ts Ts (lam ((al Ts) (acc Ts)) (cons (mEq (apps F al) (apps H al)) acc)) (nil T) als))
  (defn cutInsts ((F T) (H T) (i T) (als Tss) (rest T)) T
    (foldr Ts T
      (lam ((al Ts) (r T))
        (dNode 22 (single (mEq (apps F al) (apps H al)))
          (l2 (dNode 18 (nil T) (l2 (rwFun i (length al)) (dNode 0 (nil T) (nil T)))) r)))
      rest
      als))
  (defn withInsts ((G Globals) (E (List Entry)) (n T) (rs NRs) (h T) (als Tss) (k KR) (m T)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindPT (bindTP (nth hs h) eqParts)
        (lam ((FH TPair))
          (let ins Ts (instEqs (p1 FH) (p2 FH) als)
            (mapO (lam ((rest T)) (cutInsts (p1 FH) (p2 FH) h als rest))
              (withWeakHyps G E n rs (mapT (lam ((j T)) (add (length hs) j)) (range (length ins))) k
                m
                g
                (append hs ins)
                t
                u)))))))
  (deftype KI (Arrow Ts Pv))
  (deftype AI (Arrow Ts (Arrow Ts T)))
  (deftype ArgsF (Arrow T Tss))
  (defn nthOf ((X T) (p T)) T
    (call D.headD (single omega)
      (l2 (mEq mStar mStar) (iter T (lam ((Y T)) (call D.tail (single omega) (single Y))) X p))))
  (defn withChildHyps
    ((G Globals) (E (List Entry)) (n T) (rs NRs) (h T) (kids Ts) (args ArgsF) (k KI))
    Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindPT (bindTP (nth hs h) eqParts)
        (lam ((LR TPair))
          ((foldr T AI
             (lam ((p T) (acc AI) (h1 Ts) (insts Ts))
               (let A T (nthOf (p1 LR) p)
                 (let B T (nthOf (p2 LR) p)
                   (bindNT (eval G E n rs 4096 1 g h1 A)
                     (lam ((ra NFR))
                       (bindNT (eval G E n rs 4096 1 g h1 B)
                         (lam ((rb NFR))
                           (bindNT (eval G E n (cons (hypRule h) (nil NR)) 4096 1 g h1 A)
                             (lam ((rh NFR))
                               (bindPT (eqParts (nfTerm ra))
                                 (lam ((FH TPair))
                                   (let i1 T (length h1)
                                     (let i2 T (add i1 1)
                                       (let als Tss (args p)
                                         (let ins Ts (instEqs (p1 FH) (p2 FH) als)
                                           (mapO
                                             (lam ((rest T))
                                               (dNode 22 (single (mEq (nfTerm ra) (nfTerm rb)))
                                                 (l2
                                                   (dNode 24 (single (mEq A B))
                                                     (l2
                                                       (dNode 2 (nil T)
                                                         (l2 (mDeriv (nfMarked ra))
                                                           (mDeriv (nfMarked rb))))
                                                       (dNode 18 (nil T)
                                                         (l2 (mDeriv (nfMarked rh))
                                                           (dNode 0 (nil T) (nil T))))))
                                                   (dNode 22 (single (nfTerm ra))
                                                     (l2
                                                       (dNode 23 (nil T)
                                                         (l2 (dNode 17 (l2 i1 0) (nil T))
                                                           (dNode 18 (nil T)
                                                             (l2 (dNode 0 (nil T) (nil T))
                                                               (dNode 0 (nil T) (nil T))))))
                                                       (cutInsts (p1 FH) (p2 FH) i2 als rest))))))
                                             (acc
                                               (append
                                                 (append h1
                                                   (l2 (mEq (nfTerm ra) (nfTerm rb)) (nfTerm ra)))
                                                 ins)
                                               (append insts
                                                 (mapT (lam ((j T)) (add (add i2 1) j))
                                                   (range (length ins)))))))))))))))))))))
             (lam ((h1 Ts) (insts Ts)) (k insts g h1 t u))
             kids) hs (nil T))))))
  (defn subVar ((i T) (x T)) T
    (subst (weaken1 x) (lam ((j T)) (if (eq j (add i 1)) (var 0) (var j)))))
  (defn revertCase ((G Globals) (n T) (o T) (lb T) (i T) (h T) (pNil Pv) (pCons Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindO (nth g i)
        (lam ((c T))
          (bindO (listPart c)
            (lam ((a T))
              (bindO (nth hs h)
                (lam ((psi T))
                  (let q T (mEq t u)
                    (let tt T (ttL o)
                      (let Fx T (abstractVar i c (impL o psi q))
                        (let sub1 RW (lam ((x T)) (subVar i x))
                          (let psi1 T (sub1 psi)
                            (let q1 T (sub1 q)
                              (bindHT (lowerHyps G n g (append (mapT weaken1 hs) (single tt)))
                                (lam ((hn Terms))
                                  (let h0 Ts (termsOf hn)
                                    (let psi0 T (instAt 0 (single a) psi1)
                                      (let q0 T (instAt 0 (single a) q1)
                                        (bindPT (eqParts q0)
                                          (lam ((tu0 TPair))
                                            (bindO
                                              (pNil g (append h0 (single psi0)) (p1 tu0) (p2 tu0))
                                              (lam ((d0 T))
                                                (let hc Ts
                                                  (append (mapT weaken2 h0)
                                                    (single (weakenElem (impL o psi1 q1))))
                                                  (let psic T (listConsAt 1 a psi1)
                                                    (let qc T (listConsAt 1 a q1)
                                                      (bindPT (eqParts qc)
                                                        (lam ((tuc TPair))
                                                          (mapO
                                                            (lam ((dc T))
                                                              (let dx1 T
                                                                (dNode 29 (l2 0 1)
                                                                  (l2
                                                                    (impI lb (length h0) psi0 q0 d0)
                                                                    (impI lb (length hc) psic qc
                                                                      dc)))
                                                                (let dF T
                                                                  (dNode 26 (nil T)
                                                                    (single
                                                                      (dNode 23 (nil T)
                                                                        (l2
                                                                          (dNode 2 (nil T)
                                                                            (l2
                                                                              (dNode 3 (nil T)
                                                                                (nil T))
                                                                              (dNode 3 (nil T)
                                                                                (nil T))))
                                                                          (dNode 25 (nil T)
                                                                            (l2 trueI dx1))))))
                                                                  (let dx T
                                                                    (dNode 22
                                                                      (single (mEq Fx (mLam c tt)))
                                                                      (l2 dF
                                                                        (dNode 24
                                                                          (single (app Fx (var i)))
                                                                          (l2
                                                                            (dNode 3 (nil T)
                                                                              (nil T))
                                                                            (dNode 23 (nil T)
                                                                              (l2
                                                                                (dNode 1 (nil T)
                                                                                  (l2
                                                                                    (dNode 2 (nil T)
                                                                                      (l2
                                                                                        (dNode 17
                                                                                          (l2
                                                                                            (length
                                                                                              hs)
                                                                                            0)
                                                                                          (nil T))
                                                                                        (dNode 0
                                                                                          (nil T)
                                                                                          (nil T))))
                                                                                    (dNode 3 (nil T)
                                                                                      (nil T))))
                                                                                trueI))))))
                                                                    (dNode 27
                                                                      (l3 (add lb 4)
                                                                        (node 0 (nil T))
                                                                        (node 0 (l2 q psi)))
                                                                      (l2 dx
                                                                        (dNode 21 (single h)
                                                                          (nil T))))))))
                                                            (pCons (cons c (cons a g))
                                                              (append hc (single psic))
                                                              (p1 tuc)
                                                              (p2 tuc)))))))))))))))))))))))))))))))
  (def betaRule (cons (pair (nrRule 3 (terms (nil T))) noMatch) (nil NR)))
  (defn byImpI ((G Globals) (E (List Entry)) (o T) (lb T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindNT (eval G E 0 betaRule 4096 0 g hs t)
        (lam ((rt NFR))
          (bindNT (eval G E 0 betaRule 4096 0 g hs u)
            (lam ((ru NFR))
              (let t1 T (nfTerm rt)
                (let u1 T (nfTerm ru)
                  (if (and (mIs 11 2 t1) (eq (label u1) 11))
                    (if (and (eq (mD t1 0) (add o 2)) (eq (mD u1 0) o))
                      (let q T (mArg t1 0)
                        (let a T (mArg t1 1)
                          (bindPT (eqParts q)
                            (lam ((lr TPair))
                              (mapO
                                (lam ((d T))
                                  (dNode 23 (nil T)
                                    (l2
                                      (dNode 2 (nil T)
                                        (l2 (mDeriv (nfMarked rt)) (mDeriv (nfMarked ru))))
                                      (dNode 25 (nil T)
                                        (l2 trueI (impI lb (add (length hs) 1) a q d))))))
                                (p g (append hs (l2 (ttL o) a)) (p1 lr) (p2 lr)))))))
                      none)
                    none)))))))))
  (defn withImpElim ((o T) (lb T) (h T) (is Ts) (k KR)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      ((foldr T AR
         (lam ((i T) (acc AR) (h1 Ts) (extra NRs))
           (bindPT (bindTP (nth h1 i) eqParts)
             (lam ((lr TPair))
               (let l T (p1 lr)
                 (if (mIs 11 2 l)
                   (if (eq (mD l 0) (add o 2))
                     (let q T (mArg l 0)
                       (let a T (mArg l 1)
                         (mapO
                           (lam ((rest T))
                             (dNode 22 (single q)
                               (l2
                                 (dNode 27 (l3 (add lb 4) (node 0 (nil T)) (node 0 (l2 q a)))
                                   (l2 (dNode 23 (nil T) (l2 (dNode 17 (l2 i 0) (nil T)) trueI))
                                     (dNode 21 (single h) (nil T))))
                                 rest)))
                           (acc (append h1 (single q))
                             (appendNR extra (cons (hypRule (length h1)) (nil NR)))))))
                     none)
                   none)))))
         (lam ((h1 Ts) (extra NRs)) (k extra g h1 t u))
         is) hs (nil NR))))
  (defn hypIndex ((r NR)) T (case (fst r) ((nrHyp i) (some i)) (else none)))
  (defn succPredRw ((j T) (l T) (s T)) OTPair.Maybe
    (if (mIs 6 2 s)
      (let sg Ts (l2 (var 1) (var 0))
        (OTPair.just
          (pr (app (mArg s 0) (instTerm (nil T) sg l))
            (dNode 2 (nil T)
              (l2 (dNode 0 (nil T) (nil T))
                (dNode 16 (l4 j (node 0 (nil T)) (node 0 sg) 1) (nil T)))))))
      OTPair.nothing))
  (defn bySuccPred ((E (List Entry)) (j T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindTh (thmAt E j)
        (lam ((b Thm))
          (bindPT (eqParts (thConcl b))
            (lam ((lr TPair))
              (bindPT (succPredRw j (p1 lr) t)
                (lam ((rt TPair))
                  (bindPT (succPredRw j (p1 lr) u)
                    (lam ((ru TPair))
                      (mapO
                        (lam ((q T))
                          (dNode 23 (nil T) (l2 (dNode 2 (nil T) (l2 (p2 rt) (p2 ru))) q)))
                        (p g hs (p1 rt) (p1 ru)))))))))))))

  ; search: the subterms outside binders and folds' starts and steps, the variable the sides are
  ; stuck on, the arguments at which a hypothesis's abstraction matches, and the proofs by the
  ; instances found so and by case analysis of stuck variables
  (defn tailTss ((xs Tss)) Tss (lcase Ts Tss xs (nil Ts) (lam ((x Ts) (rest Tss)) rest)))
  (defn concatTss ((xs Tss)) Ts (foldr Ts Ts (lam ((x Ts) (acc Ts)) (append x acc)) (nil T) xs))
  ; the step of a paramorphism over an encoded term sees the result at the node's data first
  (defn subtermsStep ((nd T) (rs Tss)) Ts
    (let l T (label nd)
      (cons nd
        (if (eq l 5) (nil T)
          (if (or (eq l 8) (eq l 9)) (concatTss (iter Tss tailTss rs 3))
            (if (eq l 10) (concatTss (iter Tss tailTss rs 2)) (concatTss (tailTss rs))))))))
  (defn openSubterms ((t T)) Ts (para Ts subtermsStep t))
  (defn findSomeT ((f RW) (xs Ts)) T
    (foldr T T (lam ((x T) (acc T)) (let r T (f x) (if (isSome r) r acc))) none xs))
  (defn varUnless ((skip RW) (m T)) T
    (if (eq (label m) 0) (let i T (mD m 0) (if (skip i) none (some i))) none))
  (defn scrutVar ((skip RW) (u T)) T
    (if (mIs 6 2 u)
      (let f T (mArg u 0)
        (if (and (eq (label f) 7) (eq (mD f 0) 5)) (varUnless skip (mArg u 1)) none))
      none))
  (defn datumVar ((skip RW) (u T)) T
    (if (or (mIs 8 3 u) (mIs 9 3 u)) (varUnless skip (mArg u 2))
      (if (mIs 10 2 u) (varUnless skip (mArg u 1)) none)))
  (defn stuckVar ((skip RW) (t T)) T
    (let subs Ts (openSubterms t)
      (let r T (findSomeT (scrutVar skip) subs)
        (if (isSome r) r (findSomeT (datumVar skip) subs)))))
  (defn mentions ((t T) (i T)) T (lt 0 (uses t i)))
  (deftype Seen (Arrow Tss Tss))
  (defn eraseDupsTss ((xs Tss)) Tss
    ((foldr Ts Seen
       (lam ((x Ts) (k Seen) (acc Tss))
         (if (foldr Ts T (lam ((y Ts) (b T)) (or (equalTs y x) b)) 0 acc) (k acc) (k (cons x acc))))
       (lam ((acc Tss))
         (foldr Ts Seen (lam ((x Ts) (k Seen) (a Tss)) (k (cons x a))) (lam ((a Tss)) a) acc
           (nil Ts)))
       xs) (nil Ts)))
  (defn matchesWith ((mt Mt) (k T) (t T)) Tss
    (let s0 Ts (mapT (lam ((j T)) (if (lt j k) none (some (var (sub j k))))) (range (add k 64)))
      (eraseDupsTss
        (foldr T Tss
          (lam ((u T) (acc Tss))
            (let r T (bindAT (mt 0 u s0) (lam ((s Assign)) (allSomeT (take k (assigned s)))))
              (if (isSome r) (cons (reverse (children (get r))) acc) acc)))
          (nil Ts)
          (openSubterms t)))))
  (defn matchesOf ((body T) (k T) (t T)) Tss (matchesWith (matchTerm body) k t))
  (deftype HA (Prod T Tss))
  (deftype HAs (List HA))
  (defn appendTss ((xs Tss) (ys Tss)) Tss
    (foldr Ts Tss (lam ((x Ts) (acc Tss)) (cons x acc)) ys xs))
  (defn instArgs
    ((m T) (G Globals) (E (List Entry)) (n T) (rs NRs) (g Ts) (hs Ts) (t1 T) (u1 T) (h T))
    Tss
    (let r1 OTPair.Maybe (bindTP (nth hs h) eqParts)
      (if (OTPair.isJust r1)
        (let F T (p1 (OTPair.fromMaybe pr0 r1))
          (if (mIs 5 1 F)
            (let rb ONFR.Maybe (eval G E n rs 4096 m (cons (mD F 0) g) (mapT weaken1 hs) (mArg F 0))
              (if (ONFR.isJust rb)
                (let bw T (nfTerm (ONFR.fromMaybe nfr0 rb))
                  (eraseDupsTss (appendTss (matchesOf bw 1 t1) (matchesOf bw 1 u1))))
                (nil Ts)))
            (nil Ts)))
        (nil Ts))))
  (defn byInstsOnce ((m T) (G Globals) (E (List Entry)) (n T) (rs NRs) (nh T) (next KR)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindNT (eval G E n rs 4096 m g hs t)
        (lam ((rt NFR))
          (bindNT (eval G E n rs 4096 m g hs u)
            (lam ((ru NFR))
              (let t1 T (nfTerm rt)
                (let u1 T (nfTerm ru)
                  (if (equal t1 u1) (byMode m G E n rs g hs t u)
                    (let found HAs
                      (foldr T HAs
                        (lam ((h T) (acc HAs))
                          (let als Tss (instArgs m G E n rs g hs t1 u1 h)
                            (lcase Ts HAs als acc
                              (lam ((x Ts) (rest Tss)) (cons (pair h als) acc)))))
                        (nil HA)
                        (range (if (lt nh (length hs)) nh (length hs))))
                      (lcase HA T found none
                        (lam ((x HA) (rest HAs))
                          ((foldr HA KR
                             (lam ((ha HA) (k KR) (extra NRs))
                               (withInsts G E n rs (fst ha) (snd ha)
                                 (lam ((ex NRs)) (k (appendNR extra ex)))
                                 m))
                             next
                             found) (nil NR) g hs t u)))))))))))))
  (defn instsLast ((m T) (G Globals) (E (List Entry)) (n T) (rs NRs)) KR
    (lam ((extra NRs)) (byMode m G E n (appendNR extra rs))))
  (defn instsRound ((m T) (G Globals) (E (List Entry)) (n T) (rs NRs) (nh T) (next KR)) KR
    (lam ((extra NRs) (g Ts) (hs Ts) (t T) (u T))
      (let r T (byMode m G E n (appendNR extra rs) g hs t u)
        (if (isSome r) r
          (byInstsOnce m G E n (appendNR extra rs) nh (lam ((ex NRs)) (next (appendNR extra ex))) g
            hs
            t
            u)))))
  (defn byInsts ((m T) (G Globals) (E (List Entry)) (n T) (rs NRs) (nh T)) Pv
    (instsRound m G E n rs nh
      (instsRound m G E n rs nh (instsRound m G E n rs nh (instsLast m G E n rs)))
      (nil NR)))
  (defn orO ((a T) (b T)) T (if (isSome a) a b))
  (defn byAuto ((G Globals) (E (List Entry)) (n T) (rs NRs) (d T) (m T)) Pv
    (lam ((g0 Ts) (h0 Ts) (t0 T) (u0 T))
      (let nh T (length h0)
        ((iter Pv
           (lam ((rec Pv) (g Ts) (hs Ts) (t T) (u T))
             (orO (byInsts m G E n rs nh g hs t u)
               (bindNT (eval G E n rs 4096 m g hs t)
                 (lam ((rt NFR))
                   (bindNT (eval G E n rs 4096 m g hs u)
                     (lam ((ru NFR))
                       (let skip RW (lam ((i T)) (anyT (lam ((x T)) (mentions x i)) (take nh hs)))
                         (let none0 RW (lam ((i T)) 0)
                           (bindO
                             (orO (orO (stuckVar skip (nfTerm rt)) (stuckVar skip (nfTerm ru)))
                               (orO (stuckVar none0 (nfTerm rt)) (stuckVar none0 (nfTerm ru))))
                             (lam ((i T))
                               (bindO (nth g i)
                                 (lam ((c T))
                                   (if (isSome (listPart c)) (byListSplit G n i rec rec g hs t u)
                                     (if (OTPair.isJust (coprodParts c))
                                       (bySplit2 3 4 i rec rec g hs t u)
                                       none))))))))))))))
           (byInsts m G E n rs nh)
           d) g0 h0 t0 u0))))
  (data Cond (condOf T T T T))
  (import (Option Cond) as OCond)
  (defn bindCT ((m OCond.Maybe) (f (Arrow Cond T))) T
    (case m ((OCond.just q) (f q)) ((OCond.nothing) none)))
  (defn condParts ((w T)) OCond.Maybe
    (if (and (mIs 11 3 w) (and (eq (mD w 0) D.cond) (eq (length (children (mD w 1))) 1)))
      (OCond.just (condOf (at (children (mD w 1)) 0) (mArg w 2) (mArg w 1) (mArg w 0)))
      OCond.nothing))
  (defn condVar ((skip RW) (u T)) T
    (bindCT (condParts u) (lam ((q Cond)) (varUnless skip (at (children (rep q)) 1)))))
  (defn stuckVarC ((skip RW) (t T)) T
    (orO (findSomeT (condVar skip) (openSubterms t)) (stuckVar skip t)))
  (defn isApps2 ((k T) (u T)) T
    (and (mIs 6 2 u)
      (let f T (mArg u 0)
        (and (mIs 6 2 f)
          (let h T (mArg f 0)
            (and (eq (label h) 11) (and (eq (mD h 0) k) (equal (mD h 1) (node 0 (nil T))))))))))
  (defn appsOf ((k T) (t T)) Ts
    (foldr T Ts (lam ((u T) (acc Ts)) (if (isApps2 k u) (cons u acc) acc)) (nil T)
      (openSubterms t)))

  ; trees: the unfolding of a tree, the case analysis of a tree variable by Lambek's lemma, proof
  ; search that splits trees and folded conditionals' tests, the abstraction of a term's
  ; occurrences and the generalization over it, and the rewriting under a conditional's mask
  (def ldefn0 (ldefn 0 (objs (nil T)) 0 0))
  (def unnodeTy (prod bitsTy (list treeTy)))
  (def unnodeStep
    (let r OLDefn.Maybe (OLDefn.nthOf lib D.unnode)
      (if (OLDefn.isJust r)
        (lcase T T (mArgs (ldBody (OLDefn.fromMaybe ldefn0 r))) mStar (lam ((x T) (rest Ts)) x))
        mStar)))
  (defn unnodeU ((t T)) T (mRoseRec unnodeTy unnodeStep t))
  (defn lenUF ((rs UFs)) T (foldr UF T (lam ((r UF) (k T)) (add k 1)) 0 rs))
  (defn occStep ((lk T) (i T) (nd T) (rs UFs)) UF
    (lam ((d T))
      (let refl T (dNode 0 (nil T) (nil T))
        (let j T (add i d)
          (let l T (label nd)
            (if (eq l 0)
              (if (eq (mD nd 0) j)
                (dNode 1 (nil T)
                  (l2 (dNode 2 (nil T) (single (dNode 6 (nil T) (nil T))))
                    (dNode 16 (l4 lk (node 0 (nil T)) (node 0 (single (var j))) 0) (nil T))))
                refl)
              (if (eq l 5)
                (dNode 2 (nil T)
                  (foldr UF Ts (lam ((r UF) (acc Ts)) (cons (r (add d 1)) acc)) (nil T)
                    (UFs.tail rs)))
                (if (or (eq l 8) (eq l 9))
                  (dNode 2 (nil T)
                    (mapT
                      (lam ((k T)) ((ufAt rs (add k 1)) (if (eq k 1) (add d (if (eq l 8) 1 2)) d)))
                      (range (lenUF (UFs.tail rs)))))
                  (if (eq l 10)
                    (dNode 2 (nil T)
                      (mapT (lam ((k T)) ((ufAt rs (add k 1)) (if (eq k 0) (add d 1) d)))
                        (range (lenUF (UFs.tail rs)))))
                    (if (allT (lam ((c T)) (eq (uses c j) 0)) (mArgs nd)) refl
                      (dNode 2 (nil T)
                        (foldr UF Ts (lam ((r UF) (acc Ts)) (cons (r d) acc)) (nil T)
                          (UFs.tail rs)))))))))))))
  (defn occRewrite ((lk T) (i T) (t T) (d T)) T ((para UF (occStep lk i) t) d))
  (defn byTreeSplit ((lk T) (i T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindO (nth g i)
        (lam ((c T))
          (if (equal c treeTy)
            (let F T (abstractVar i c t)
              (let H T (abstractVar i c u)
                (let N0 T (nodeT (mPair (var 1) (var 0)))
                  (let A T (app (weaken2 F) N0)
                    (let B T (app (weaken2 H) N0)
                      (mapO
                        (lam ((q T))
                          (let Fl T (mLam bitsTy (mLam (list treeTy) A))
                            (let Hl T (mLam bitsTy (mLam (list treeTy) B))
                              (let beta T (dNode 3 (nil T) (nil T))
                                (let refl T (dNode 0 (nil T) (nil T))
                                  (let bb T (dNode 2 (nil T) (l2 beta beta))
                                    (let dG T
                                      (dNode 26 (nil T)
                                        (single
                                          (dNode 23 (nil T)
                                            (l2 bb
                                              (dNode 26 (nil T)
                                                (single (dNode 23 (nil T) (l2 bb q))))))))
                                      (let U T (unnodeU (var i))
                                        (let ap RW (lam ((L T)) (app (app L (mFst U)) (mSnd U)))
                                          (let side RW
                                            (lam ((w T))
                                              (dNode 1 (nil T)
                                                (l2 (dNode 2 (nil T) (l2 beta refl))
                                                  (dNode 1 (nil T)
                                                    (l2 beta
                                                      (dNode 1 (nil T)
                                                        (l2 beta (occRewrite lk i w 0))))))))
                                            (let dx T
                                              (dNode 18 (nil T)
                                                (l2
                                                  (dNode 2 (nil T)
                                                    (l2
                                                      (dNode 2 (nil T)
                                                        (l2 (dNode 17 (l2 (length hs) 0) (nil T))
                                                          refl))
                                                      refl))
                                                  refl))
                                              (dNode 22 (single (mEq Fl Hl))
                                                (l2 dG
                                                  (dNode 24 (single (mEq (ap Fl) (ap Hl)))
                                                    (l2 (dNode 2 (nil T) (l2 (side t) (side u)))
                                                      dx)))))))))))))))
                        (p (cons (list treeTy) (cons bitsTy g)) (mapT weaken2 hs) A B)))))))
            none)))))
  (defn splitStuck ((G Globals) (n T) (lk T) (i T) (rec Pv) (g Ts) (hs Ts) (t T) (u T)) T
    (bindO (nth g i)
      (lam ((c T))
        (if (isSome (listPart c)) (byListSplit G n i rec rec g hs t u)
          (if (OTPair.isJust (coprodParts c)) (bySplit2 3 4 i rec rec g hs t u)
            (if (equal c treeTy) (byTreeSplit lk i rec g hs t u) none))))))
  (defn byAutoT ((G Globals) (E (List Entry)) (n T) (lk T) (rs NRs) (d T) (m T)) Pv
    (lam ((g0 Ts) (h0 Ts) (t0 T) (u0 T))
      (let nh T (length h0)
        (let direct Pv
          (lam ((g Ts) (hs Ts) (t T) (u T))
            (bindNT (eval G E n rs 4096 m g hs t)
              (lam ((rt NFR))
                (bindNT (eval G E n rs 4096 m g hs u)
                  (lam ((ru NFR))
                    (if (equal (nfTerm rt) (nfTerm ru))
                      (some (dNode 18 (nil T) (l2 (mDeriv (nfMarked rt)) (mDeriv (nfMarked ru)))))
                      none))))))
          (let viaInsts Pv
            (lam ((g Ts) (hs Ts) (t T) (u T)) (if (eq nh 0) none (byInsts m G E n rs nh g hs t u)))
            ((iter Pv
               (lam ((rec Pv) (g Ts) (hs Ts) (t T) (u T))
                 (bindNT (eval G E n rs 4096 m g hs t)
                   (lam ((rt NFR))
                     (bindNT (eval G E n rs 4096 m g hs u)
                       (lam ((ru NFR))
                         (if (equal (nfTerm rt) (nfTerm ru))
                           (some
                             (dNode 18 (nil T) (l2 (mDeriv (nfMarked rt)) (mDeriv (nfMarked ru)))))
                           (orO (viaInsts g hs t u)
                             (let skip RW
                               (lam ((i T)) (anyT (lam ((x T)) (mentions x i)) (take nh hs)))
                               (let none0 RW (lam ((i T)) 0)
                                 (bindO
                                   (orO
                                     (orO (stuckVar skip (nfTerm rt)) (stuckVar skip (nfTerm ru)))
                                     (orO (stuckVar none0 (nfTerm rt))
                                       (stuckVar none0 (nfTerm ru))))
                                   (lam ((i T)) (splitStuck G n lk i rec g hs t u))))))))))))
               (lam ((g Ts) (hs Ts) (t T) (u T)) (orO (direct g hs t u) (viaInsts g hs t u)))
               d) g0 h0 t0 u0))))))
  (defn byAutoC ((G Globals) (E (List Entry)) (n T) (lk T) (rs NRs) (d T)) Pv
    (iter Pv
      (lam ((rec Pv) (g Ts) (hs Ts) (t T) (u T))
        (orO (byWeak G E n rs g hs t u)
          (bindNT (eval G E n rs 4096 1 g hs t)
            (lam ((rt NFR))
              (bindNT (eval G E n rs 4096 1 g hs u)
                (lam ((ru NFR))
                  (let none0 RW (lam ((i T)) 0)
                    (bindO (orO (stuckVarC none0 (nfTerm rt)) (stuckVarC none0 (nfTerm ru)))
                      (lam ((i T)) (splitStuck G n lk i rec g hs t u))))))))))
      (byWeak G E n rs)
      d))
  (defn absStep ((xw T) (nd T) (rs UFs)) UF
    (lam ((d T))
      (if (equal nd (rename xw (lam ((j T)) (add j d)))) (var d)
        (let l T (label nd)
          (let rebuild0 (Arrow Ts T) (lam ((ks Ts)) (node l (cons (child nd 0) ks)))
            (if (eq l 5)
              (rebuild0
                (foldr UF Ts (lam ((r UF) (acc Ts)) (cons (r (add d 1)) acc)) (nil T)
                  (UFs.tail rs)))
              (if (or (eq l 8) (eq l 9))
                (rebuild0
                  (mapT
                    (lam ((k T)) ((ufAt rs (add k 1)) (if (eq k 1) (add d (if (eq l 8) 1 2)) d)))
                    (range (lenUF (UFs.tail rs)))))
                (if (eq l 10)
                  (rebuild0
                    (mapT (lam ((k T)) ((ufAt rs (add k 1)) (if (eq k 0) (add d 1) d)))
                      (range (lenUF (UFs.tail rs)))))
                  (rebuild0
                    (foldr UF Ts (lam ((r UF) (acc Ts)) (cons (r d) acc)) (nil T)
                      (UFs.tail rs)))))))))))
  (defn abstractTerm ((b T) (x T) (y T)) T (mLam b ((para UF (absStep (weaken1 x)) (weaken1 y)) 0)))
  (defn maskRwD ((a T) (b T) (ab T) (dM T) (c T) (d T) (x T) (x1 T) (z T) (y T)) T
    (let F T (abstractTerm b x y)
      (let refl T (dNode 0 (nil T) (nil T))
        (let beta T (dNode 3 (nil T) (nil T))
          (let chi T (mEq (condT a c (app F x) d) (condT a c (app F x1) d))
            (let dchi T
              (dNode 18 (nil T)
                (l2
                  (dNode 1 (nil T)
                    (l2 (dNode 16 (l4 ab (node 0 (l2 a b)) (node 0 (l5 c d x z F)) 1) (nil T))
                      (dNode 1 (nil T)
                        (l2 (dNode 2 (nil T) (l3 refl (dNode 2 (nil T) (l2 refl dM)) refl))
                          (dNode 16 (l4 ab (node 0 (l2 a b)) (node 0 (l5 c d x1 z F)) 0)
                            (nil T))))))
                  refl))
              (dNode 24 (single chi)
                (l2
                  (dNode 2 (nil T)
                    (l2 (dNode 2 (nil T) (l3 refl beta refl))
                      (dNode 2 (nil T) (l3 refl beta refl))))
                  dchi))))))))
  (defn maskRw ((a T) (b T) (ab T) (j T) (th Ts) (sg Ts) (c T) (d T) (x T) (x1 T) (z T) (y T)) T
    (maskRwD a b ab (dNode 16 (l4 j (node 0 th) (node 0 sg) 0) (nil T)) c d x x1 z y))
  ; a rewriting under a conditional's mask: the subterm, its rewritten form and the derivation
  (data Mask (maskStep T T T))
  (import (Option Mask) as OMask)
  (def cond0 (condOf 0 0 0 0))
  (def mask0 (maskStep 0 0 0))
  (defn bindPM ((m OTPair.Maybe) (f (Arrow TPair OMask.Maybe))) OMask.Maybe
    (case m ((OTPair.just p) (f p)) ((OTPair.nothing) OMask.nothing)))
  (defn bindCM ((m OCond.Maybe) (f (Arrow Cond OMask.Maybe))) OMask.Maybe
    (case m ((OCond.just q) (f q)) ((OCond.nothing) OMask.nothing)))
  (defn bindTM ((m T) (f (Arrow T OMask.Maybe))) OMask.Maybe
    (if (isSome m) (f (get m)) OMask.nothing))
  (defn findMask ((f (Arrow T OMask.Maybe)) (xs Ts)) OMask.Maybe
    (foldr T OMask.Maybe
      (lam ((x T) (acc OMask.Maybe)) (let r OMask.Maybe (f x) (if (OMask.isJust r) r acc)))
      OMask.nothing
      xs))
  (defn orMask ((a OMask.Maybe) (b OMask.Maybe)) OMask.Maybe (if (OMask.isJust a) a b))
  (defn maskAt ((ab T) (cs T) (hs Ts) (a T) (c T) (y T) (d T) (S T) (i T)) OMask.Maybe
    (bindPM (bindTP (nth hs i) eqParts)
      (lam ((LR TPair))
        (let L T (p1 LR)
          (let R T (p2 LR)
            (bindCM (condParts L)
              (lam ((qL Cond))
                (let b T (at (children (rep qL)) 0)
                  (let x T (at (children (rep qL)) 2)
                    (let z T (at (children (rep qL)) 3)
                      (if (not (equal (at (children (rep qL)) 1) c)) OMask.nothing
                        (bindPM
                          (let qR OCond.Maybe (condParts R)
                            (if (OCond.isJust qR)
                              (let q2 T (rep (OCond.fromMaybe cond0 qR))
                                (if
                                  (and (equal (at (children q2) 1) c)
                                    (equal (at (children q2) 3) z))
                                  (OTPair.just
                                    (pr (at (children q2) 2) (dNode 17 (l2 i 0) (nil T))))
                                  OTPair.nothing))
                              (if (equal R z)
                                (OTPair.just
                                  (pr R
                                    (dNode 1 (nil T)
                                      (l2 (dNode 17 (l2 i 0) (nil T))
                                        (dNode 16 (l4 cs (node 0 (single b)) (node 0 (l2 c R)) 1)
                                          (nil T))))))
                                OTPair.nothing)))
                          (lam ((xd TPair))
                            (let x1 T (p1 xd)
                              (if (equal x x1) OMask.nothing
                                (let F T (abstractTerm b x y)
                                  (bindTM
                                    (lcase T T (mArgs F) none (lam ((h T) (rest Ts)) (some h)))
                                    (lam ((body T))
                                      (if (eq (uses body 0) 0) OMask.nothing
                                        (OMask.just
                                          (maskStep S (condT a c (subst body (instVar x1)) d)
                                            (maskRwD a b ab (p2 xd) c d x x1 z
                                              y))))))))))))))))))))))
  (defn maskSub ((ab T) (cs T) (hs Ts) (w T)) OMask.Maybe
    (findMask
      (lam ((S T))
        (bindCM (condParts S)
          (lam ((q Cond))
            (findMask
              (maskAt ab cs hs (at (children (rep q)) 0) (at (children (rep q)) 1)
                (at (children (rep q)) 2)
                (at (children (rep q)) 3)
                S)
              (reverse (range (length hs)))))))
      (openSubterms w)))
  (deftype MS (Arrow NRs (Arrow KR Pv)))
  (defn byMaskSubs ((G Globals) (E (List Entry)) (ab T) (cs T) (rs NRs) (n T)) (Arrow KR Pv)
    ((iter MS
       (lam ((rec MS) (extra NRs) (p KR))
         (byNF G E 0 (appendNR extra rs) 1
           (lam ((g Ts) (hs Ts) (t T) (u T))
             (let r OMask.Maybe (orMask (maskSub ab cs hs t) (maskSub ab cs hs u))
               (if (OMask.isJust r)
                 (let S T (at (children (rep (OMask.fromMaybe mask0 r))) 0)
                   (let S1 T (at (children (rep (OMask.fromMaybe mask0 r))) 1)
                     (mapO
                       (lam ((q T))
                         (dNode 22 (single (mEq S S1))
                           (l2 (at (children (rep (OMask.fromMaybe mask0 r))) 2) q)))
                       (rec (cons (hypRule (length hs)) extra) p g (append hs (single (mEq S S1))) t
                         u))))
                 (p extra g hs t u))))))
       (lam ((extra NRs) (p KR)) (p extra))
       n) (nil NR)))
  (defn byGeneralize ((a T) (c T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (let F T (abstractTerm a c t)
        (let H T (abstractTerm a c u)
          (mapO (lam ((q T)) (applyAbs c (length hs) F H (dNode 26 (nil T) (single q))))
            (p (cons a g) (mapT weaken1 hs) (app (weaken1 F) (var 0))
              (app (weaken1 H) (var 0)))))))))
