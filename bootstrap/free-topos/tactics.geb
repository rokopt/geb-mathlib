  (defn maskRw ((a T) (b T) (ab T) (j T) (th Ts) (sg Ts) (c T) (d T) (x T) (x1 T) (z T) (y T)) T
    (maskRwD a b ab (dNode 16 (l4 j (node 0 th) (node 0 sg) 0) (nil T)) c d x x1 z y))
  ; a rewriting under a conditional's mask: the subterm, its rewritten form and the derivation
  (data Mask (maskStep T T T))

  (def cond0 (condOf 0 0 0 0))
  (def mask0 (maskStep 0 0 0))
  (defn bindPM ((m (Option.Maybe TPair)) (f (Arrow TPair (Option.Maybe Mask)))) (Option.Maybe Mask)
    (case m ((Option.just TPair p) (f p)) ((Option.nothing TPair) (Option.nothing Mask))))
  (defn bindCM ((m (Option.Maybe Cond)) (f (Arrow Cond (Option.Maybe Mask)))) (Option.Maybe Mask)
    (case m ((Option.just Cond q) (f q)) ((Option.nothing Cond) (Option.nothing Mask))))
  (defn bindTM ((m T) (f (Arrow T (Option.Maybe Mask)))) (Option.Maybe Mask)
    (if (isSome m) (f (get m)) (Option.nothing Mask)))
  (defn findMask ((f (Arrow T (Option.Maybe Mask))) (xs Ts)) (Option.Maybe Mask)
    (foldr T (Option.Maybe Mask)
      (lam ((x T) (acc (Option.Maybe Mask)))
        (let r (Option.Maybe Mask) (f x) (if (Option.isJust Mask r) r acc)))
      (Option.nothing Mask)
      xs))
  (defn orMask ((a (Option.Maybe Mask)) (b (Option.Maybe Mask))) (Option.Maybe Mask)
    (if (Option.isJust Mask a) a b))
  (defn maskAt ((ab T) (cs T) (hs Ts) (a T) (c T) (y T) (d T) (S T) (i T)) (Option.Maybe Mask)
    (bindPM (bindTP (nth hs i) eqParts)
      (lam ((LR TPair))
        (let* ((L T (p1 LR)) (R T (p2 LR)))
          (bindCM (condParts L)
            (lam ((qL Cond))
              (let*
                ((b T (at (children (rep qL)) 0)) (x T (at (children (rep qL)) 2))
                 (z T (at (children (rep qL)) 3)))
                (if (not (equal (at (children (rep qL)) 1) c)) (Option.nothing Mask)
                  (bindPM
                    (let qR (Option.Maybe Cond) (condParts R)
                      (cond
                        ((Option.isJust Cond qR)
                         (let q2 T (rep (Option.fromMaybe Cond cond0 qR))
                           (if (and (equal (at (children q2) 1) c) (equal (at (children q2) 3) z))
                             (Option.just TPair
                               (pr (at (children q2) 2) (dNode 17 (l2 i 0) (nil T))))
                             (Option.nothing TPair))))
                        ((equal R z)
                         (Option.just TPair
                           (pr R
                             (dNode 1 (nil T)
                               (l2 (dNode 17 (l2 i 0) (nil T))
                                 (dNode 16 (l4 cs (node 0 (single b)) (node 0 (l2 c R)) 1)
                                   (nil T)))))))
                        (else (Option.nothing TPair))))
                    (lam ((xd TPair))
                      (let x1 T (p1 xd)
                        (if (equal x x1) (Option.nothing Mask)
                          (let F T (abstractTerm b x y)
                            (bindTM (lcase T T (mArgs F) none (lam ((h T) (rest Ts)) (some h)))
                              (lam ((body T))
                                (if (eq (uses body 0) 0) (Option.nothing Mask)
                                  (Option.just Mask
