;
; The prover of the internal language, written in the datatype language, proving as
; Geb.FreeTopos.Internal's prover in Lean proves: normalization innermost first, or weak head
; normal forms first to a depth, by the language's equations, the unfolding of definitions, the
; element of the terminal type, earlier theorems found by matching their left sides, and the
; hypotheses; induction on natural numbers, lists and rose trees; and the proofs of an equation
; from proofs of others. A derivation is encoded as the checker of derivations encodes it, a
; derivation with a mark whether it rewrites as the pair of the two, and a rule of the normalizer
; as the node of its constructor's position over its fields, paired with its left side's
; matching where it has one, as their datatypes declare them. Requires the prelude, the lists of
; bootstrap/seq.geb, the base, partial Horn logic, the theory, the inference, the language and the
; checker of derivations.

(module Prover
  (export dNode Marked mark mDeriv mFlag NFR nfr nfTerm nfMarked ONFR.Maybe ONFR.nothing ONFR.just
    ONFR.isJust
    ONFR.fromMaybe
    bindNT
    termsOf
    bindHT
    setAt
    Assign
    assign
    assigned
    bindP
    OAssign.Maybe
    OAssign.nothing
    OAssign.just
    Mt
    matchTerm
    NormRule
    nrRule
    nrDelta
    nrBelow
    nrUnit
    nrThm
    nrThmAt
    nrHyp
    NR
    NRs
    noMatch
    RW
    NF
    rebuild
    marked
    zipTs
    normalize
    joinBy
    byNorm
    instAt
    byNatInd
    byListInd
    byNatIndHyp
    byListIndHyp
    UF
    UFs
    UFs.tail
    ufAt
    uses
    headStep
    EV
    eval
    byNormW
    Pv
    abstractVar
    byFunExt
    bySplit
    byListIndWith)
  (import Prelude)
  (import Base)
  (import Theory)
  (import Language)
  (import Derivation)
  ; derivations, and a rewriting's derivation marked when it rewrites
  (defn dNode ((r T) (d Ts) (cs Ts)) T (mNode r d cs))
  (data Marked (mark T T))
  (defn mDeriv ((m Marked)) T (case m ((mark d f) d)))
  (defn mFlag ((m Marked)) T (case m ((mark d f) f)))
  (import (Each Marked) as EachMarked)
  (import (Map Marked T) as MarkedOut)
  (import (Few Marked) as MarkedF)
  (import (Map T Marked) as MarkedAt)
  (def dRefl (mark (dNode 0 (nil T) (nil T)) 0))
  (defn dTrans ((d1 Marked) (d2 Marked)) Marked
    (if (mFlag d1) (if (mFlag d2) (mark (dNode 1 (nil T) (l2 (mDeriv d1) (mDeriv d2))) 1) d1) d2))
  (defn dCong ((cs (List Marked))) Marked
    (if (EachMarked.any mFlag cs) (mark (dNode 2 (nil T) (MarkedOut.map mDeriv cs)) 1) dRefl))

  ; whether a pattern's root may match a term's root: the pattern's root is a variable, or the two
  ; roots are of one kind, of one index for a primitive or a definition
  (defn sameShape ((p T) (t T)) T
    (let l T (label p)
      (if (eq l 0) 1
        (if (eq (label t) l) (if (or (eq l 7) (eq l 11)) (eq (mD p 0) (mD t 0)) 1) 0))))

  ; a list with the element at a position replaced
  (defn setAt ((xs Ts) (i T) (x T)) Ts
    (mapT (lam ((j T)) (if (eq j i) x (at xs j))) (range (length xs))))

  ; the matching of a pattern against a term under d binders, extending an assignment of the
  ; pattern's variables to optional terms: the optional extended assignment
  (data Assign (assign & T))
  (import (Option Assign) as OAssign)
  (defn assigned ((a Assign)) Ts (case a ((assign s) s)))
  (defn bindAA ((m OAssign.Maybe) (f (Arrow Assign OAssign.Maybe))) OAssign.Maybe
    (case m ((OAssign.just a) (f a)) ((OAssign.nothing) OAssign.nothing)))
  (deftype Mt (Arrow T (Arrow T (Arrow Ts OAssign.Maybe))))
  (deftype Mts (List Mt))
  (import (Lists Mt) as Mts)
  (defn mtAt ((rs Mts) (i T)) Mt
    (lcase Mt Mt (iter Mts Mts.tail rs i) (lam ((d T) (t T) (s Ts)) OAssign.nothing)
      (lam ((r Mt) (rest Mts)) r)))
  (defn matchVar ((i T) (d T) (t T) (s Ts)) OAssign.Maybe
    (if (lt i d) (if (equal t (var i)) (OAssign.just (assign s)) OAssign.nothing)
      (let t1 T (if (eq d 0) t (rename t (lam ((j T)) (sub j d))))
        (if (or (eq d 0) (equal (rename t1 (lam ((j T)) (add j d))) t))
          (let e T (nth s (sub i d))
            (if (isSome e)
              (if (isSome (get e))
                (if (equal (get (get e)) t1) (OAssign.just (assign s)) OAssign.nothing)
                (OAssign.just (assign (setAt s (sub i d) (some t1)))))
              (if (equal t1 (var (sub i d))) (OAssign.just (assign s)) OAssign.nothing)))
          OAssign.nothing))))
  (deftype MA (Arrow Ts (Arrow OAssign.Maybe OAssign.Maybe)))
  (defn matchAll ((rs Mts) (d T) (us Ts) (s Ts)) OAssign.Maybe
    ((foldr Mt MA
       (lam ((q Mt) (k MA))
         (lam ((ts Ts) (acc OAssign.Maybe))
           (lcase T OAssign.Maybe ts acc
             (lam ((u T) (rest Ts))
               (k rest (bindAA acc (lam ((sn Assign)) (q d u (assigned sn)))))))))
       (lam ((ts Ts) (acc OAssign.Maybe)) acc)
       (Mts.tail rs)) us (OAssign.just (assign s))))
  (defn matchStep ((nd T) (rs Mts)) Mt
    (lam ((d T) (t T) (s Ts))
      (let l T (label nd)
        (if (eq l 0) (matchVar (mD nd 0) d t s)
          (let us Ts (mArgs t)
            (let k T (length us)
              (if
                (and (and (eq l (label t)) (equal (child nd 0) (child t 0)))
                  (eq (length (mArgs nd)) k))
                (if (and (eq l 5) (eq k 1)) ((mtAt rs 1) (add d 1) (at us 0) s)
                  (if (and (or (eq l 8) (eq l 9)) (eq k 3))
                    (if (and (equal (mArg nd 0) (at us 0)) (equal (mArg nd 1) (at us 1)))
                      ((mtAt rs 3) d (at us 2) s)
                      OAssign.nothing)
                    (if (and (eq l 10) (eq k 2))
                      (if (equal (mArg nd 0) (at us 0)) ((mtAt rs 2) d (at us 1) s) OAssign.nothing)
                      (matchAll rs d us s))))
                OAssign.nothing)))))))
  (defn matchTerm ((p T)) Mt (para Mt matchStep p))

  ; the rules of the normalizer: a rule of the checker's position and data, the unfolding of one
  ; definition, of the definitions below an index but a list, the terminal type's element, a
  ; theorem at objects, a theorem at objects with its left side, and a hypothesis; each paired
  ; with its left side's matching, or with none
  (data NormRule (nrRule T Terms) (nrDelta T) (nrBelow T Terms) (nrUnit) (nrThm T Objs)
    (nrThmAt T Objs T T)
    (nrHyp T))
  (deftype NR (Prod NormRule Mt))
  (deftype NRs (List NR))
  (def noMatch (lam ((d T) (t T) (s Ts)) OAssign.nothing))

  ; the bindings and images of optional values into optional pairs, as the base binds and maps
  ; optional trees
  (defn bindP ((m OTPair.Maybe) (f (Arrow TPair T))) T
    (case m ((OTPair.just q) (f q)) ((OTPair.nothing) none)))
  (defn bindAP ((m OAssign.Maybe) (f (Arrow Assign OTPair.Maybe))) OTPair.Maybe
    (case m ((OAssign.just a) (f a)) ((OAssign.nothing) OTPair.nothing)))
  (defn bindHP ((m OThm.Maybe) (f (Arrow Thm OTPair.Maybe))) OTPair.Maybe
    (case m ((OThm.just a) (f a)) ((OThm.nothing) OTPair.nothing)))
  (defn mapTP ((f (Arrow T TPair)) (m T)) OTPair.Maybe
    (if (isSome m) (OTPair.just (f (get m))) OTPair.nothing))
  (defn termsOf ((h Terms)) Ts (case h ((terms xs) xs)))
  (defn objsOf ((h Objs)) Ts (case h ((objs xs) xs)))

  ; the first rule that rewrites a term at its root: the pair of the result and its derivation
  (deftype RW (Arrow T T))
  (deftype RootRw (Arrow T OTPair.Maybe))
  (defn thmRewrite
    ((G Globals) (E (List Entry)) (n T) (g Ts) (hs Ts) (j T) (th Ts) (m Mt) (k T) (t T))
    OTPair.Maybe
    (bindAP (m 0 t (replicate k none))
      (lam ((sn Assign))
        (bindTP (allSomeT (assigned sn))
          (lam ((sg T))
            (let rd Ts (l4 j (node 0 th) sg 0)
              (mapTP (lam ((t2 T)) (pr t2 (dNode 16 rd (nil T))))
                (rootStep G E n g hs 16 rd t))))))))
  (defn tryRule ((G Globals) (E (List Entry)) (n T) (g Ts) (hs Ts) (r NR) (t T)) OTPair.Maybe
    (case (fst r)
      ((nrRule rl rdN)
       (let rd Ts (termsOf rdN)
         (mapTP (lam ((t2 T)) (pr t2 (dNode rl rd (nil T)))) (rootStep G E n g hs rl rd t))))
      ((nrDelta k)
       (if (and (eq (label t) 11) (eq (mD t 0) k))
         (mapTP (lam ((t2 T)) (pr t2 (dNode 8 (nil T) (nil T)))) (rootStep G E n g hs 8 (nil T) t))
         OTPair.nothing))
      ((nrBelow m ks)
       (if
         (and (eq (label t) 11)
           (and (lt (mD t 0) m) (not (anyT (lam ((x T)) (eq x (mD t 0))) (termsOf ks)))))
         (mapTP (lam ((t2 T)) (pr t2 (dNode 8 (nil T) (nil T)))) (rootStep G E n g hs 8 (nil T) t))
         OTPair.nothing))
      ((nrUnit)
       (if (and (eq (label t) 0) (equal (nth g (mD t 0)) (some one)))
         (mapTP (lam ((t2 T)) (pr t2 (dNode 7 (nil T) (nil T)))) (rootStep G E n g hs 7 (nil T) t))
         OTPair.nothing))
      ((nrThm j thN)
       (let th Ts (objsOf thN)
         (bindHP (thmAt E j)
           (lam ((a Thm))
             (bindPP (eqParts (thConcl a))
               (lam ((lr TPair))
                 (if (sameShape (p1 lr) t)
                   (thmRewrite G E n g hs j th
                     (matchTerm (if (isEmpty th) (p1 lr) (osubst th (p1 lr))))
                     (length (thCtx a))
                     t)
                   OTPair.nothing)))))))
      ((nrThmAt j thN p k)
       (if (sameShape p t) (thmRewrite G E n g hs j (objsOf thN) (snd r) k t) OTPair.nothing))
      ((nrHyp i)
       (let rd Ts (l2 i 0)
         (mapTP (lam ((t2 T)) (pr t2 (dNode 17 rd (nil T)))) (rootStep G E n g hs 17 rd t))))))
  (defn rootRewrite ((G Globals) (E (List Entry)) (n T) (rs NRs) (g Ts) (hs Ts) (t T)) OTPair.Maybe
    ((foldr NR RootRw
       (lam ((r NR) (rest RootRw))
         (lam ((u T))
           (let v OTPair.Maybe (tryRule G E n g hs r u) (if (OTPair.isJust v) v (rest u)))))
       (lam ((u T)) OTPair.nothing)
       rs) t))

  ; the rules with each theorem's matching prepared, its left side instantiated at its objects
  (def pr0 (pr 0 0))
  (def thm0 (mkThm 0 (objs (nil T)) (terms (nil T)) 0))
  (defn prepareRule ((E (List Entry)) (r NormRule)) NR
    (case r
      ((nrThm j thN)
       (let th Ts (objsOf thN)
         (let a OThm.Maybe (thmAt E j)
           (let lr OTPair.Maybe (bindHP a (lam ((a1 Thm)) (eqParts (thConcl a1))))
             (if (OTPair.isJust lr)
               (let p T
                 (if (isEmpty th) (p1 (OTPair.fromMaybe pr0 lr))
                   (osubst th (p1 (OTPair.fromMaybe pr0 lr))))
                 (pair (nrThmAt j thN p (length (thCtx (OThm.fromMaybe thm0 a)))) (matchTerm p)))
               (pair r noMatch))))))
      (else (pair r noMatch))))
  (defn prepareRules ((E (List Entry)) (rs (List NormRule))) NRs
    (foldr NormRule NRs (lam ((r NormRule) (acc NRs)) (cons (prepareRule E r) acc)) (nil NR) rs))

  ; the normal form of a term in a context under hypotheses, innermost first, within a depth of
  ; fuel: the optional pair of the normal form and its rewriting derivation, marked
  (data NFR (nfr T Marked))
  (defn nfTerm ((r NFR)) T (case r ((nfr t d) t)))
  (defn nfMarked ((r NFR)) Marked (case r ((nfr t d) d)))
  (import (Option NFR) as ONFR)
  (import (Each NFR) as EachNFR)
  (import (Map NFR T) as NFRTerm)
  (import (Map NFR Marked) as NFRMarked)
  (data NFRList (nfrs & NFR))
  (import (Option NFRList) as ONFRList)
  (defn nfrsOf ((l NFRList)) (List NFR) (case l ((nfrs xs) xs)))
  ; the bindings, images and collections of optional normal forms, as the base's of optional trees
  (defn bindNT ((m ONFR.Maybe) (f (Arrow NFR T))) T
    (case m ((ONFR.just r) (f r)) ((ONFR.nothing) none)))
  (defn bindNN ((m ONFR.Maybe) (f (Arrow NFR ONFR.Maybe))) ONFR.Maybe
    (case m ((ONFR.just r) (f r)) ((ONFR.nothing) ONFR.nothing)))
  (defn mapNN ((f (Arrow NFR NFR)) (m ONFR.Maybe)) ONFR.Maybe
    (case m ((ONFR.just r) (ONFR.just (f r))) ((ONFR.nothing) ONFR.nothing)))
  (defn bindTN ((m T) (f (Arrow T ONFR.Maybe))) ONFR.Maybe (if (isSome m) (f (get m)) ONFR.nothing))
  (defn bindSN ((m OScopes.Maybe) (f (Arrow Scopes ONFR.Maybe))) ONFR.Maybe
    (case m ((OScopes.just c) (f c)) ((OScopes.nothing) ONFR.nothing)))
  (defn allSomeN ((ms (List ONFR.Maybe))) ONFRList.Maybe
    (let r (Prod T (List NFR)) (ONFR.allJust ms)
      (if (fst r) (ONFRList.just (nfrs (snd r))) ONFRList.nothing)))
  (defn bindLN ((m ONFRList.Maybe) (f (Arrow NFRList ONFR.Maybe))) ONFR.Maybe
    (case m ((ONFRList.just l) (f l)) ((ONFRList.nothing) ONFR.nothing)))
  (defn bindHT ((m OTerms.Maybe) (f (Arrow Terms T))) T
    (case m ((OTerms.just h) (f h)) ((OTerms.nothing) none)))
  (deftype NF (Arrow Ts (Arrow Ts (Arrow T ONFR.Maybe))))
  (defn rebuild ((t T) (cs (List NFR))) T
    (node (label t) (cons (child t 0) (NFRTerm.map nfTerm cs))))
  (defn marked ((cs (List NFR))) T (EachNFR.any (lam ((c NFR)) (mFlag (nfMarked c))) cs))
  ; the pairs of the elements of two lists at the positions of the shorter
  (data ScopeTerm (scopeTerm Scope T))
  (import (Seq ScopeTerm) as ScopeTerms)
  (defn scopeOf ((cu ScopeTerm)) Scope (case cu ((scopeTerm c u) c)))
  (defn termOf ((cu ScopeTerm)) T (case cu ((scopeTerm c u) u)))
  (defn zipTs ((xs (List Scope)) (ys Ts)) (List ScopeTerm)
    ((foldr Scope (Arrow Ts (List ScopeTerm))
       (lam ((x Scope) (k (Arrow Ts (List ScopeTerm))))
         (lam ((zs Ts))
           (lcase T (List ScopeTerm) zs (nil ScopeTerm)
             (lam ((y T) (rest Ts)) (cons (scopeTerm x y) (k rest))))))
       (lam ((zs Ts)) (nil ScopeTerm))
       xs) ys))
  (import (Map ScopeTerm ONFR.Maybe) as NormEach)
  (defn normStep ((G Globals) (E (List Entry)) (n T) (rs NRs) (rec NF)) NF
    (lam ((g Ts) (hs Ts) (t T))
      (bindSN (childCtxs G n t g hs)
        (lam ((cxn Scopes))
          (let cx (List Scope) (scopesOf cxn)
            (bindLN
              (allSomeN
                (NormEach.map
                  (lam ((cu ScopeTerm))
                    (let c Scope (scopeOf cu) (rec (scopeCtx c) (scopeHyps c) (termOf cu))))
                  (zipTs cx (mArgs t))))
              (lam ((csn NFRList))
                (let cs (List NFR) (nfrsOf csn)
                  (let t1 T (rebuild t cs)
                    (let d1 Marked
                      (if (marked cs)
                        (mark
                          (dNode 2 (nil T) (NFRTerm.map (lam ((c NFR)) (mDeriv (nfMarked c))) cs))
                          1)
                        dRefl)
                      (let rr OTPair.Maybe (rootRewrite G E n rs g hs t1)
                        (if (OTPair.isJust rr)
                          (let r TPair (OTPair.fromMaybe pr0 rr)
                            (mapNN
                              (lam ((r3 NFR))
                                (nfr (nfTerm r3)
                                  (dTrans d1 (dTrans (mark (p2 r) 1) (nfMarked r3)))))
                              (rec g hs (p1 r))))
                          (ONFR.just (nfr t1 d1))))))))))))))
  (defn normalize ((G Globals) (E (List Entry)) (n T) (rs NRs) (fuel T)) NF
    (iter NF (normStep G E n rs) (lam ((g Ts) (hs Ts) (t T)) (ONFR.just (nfr t dRefl))) fuel))

  ; the proof of an equation by normalizing both sides to one term
  (defn joinBy ((nf NF) (g Ts) (hs Ts) (t T) (u T)) T
    (bindNT (nf g hs t)
      (lam ((a NFR))
        (bindNT (nf g hs u)
          (lam ((b NFR))
            (if (equal (nfTerm a) (nfTerm b))
              (some (dNode 18 (nil T) (l2 (mDeriv (nfMarked a)) (mDeriv (nfMarked b)))))
              none))))))
  (defn byNorm ((G Globals) (E (List Entry)) (n T) (rs NRs) (fuel T) (g Ts) (hs Ts) (t T) (u T)) T
    (joinBy (normalize G E n rs fuel) g hs t u))

  ; induction on the innermost variable, of the natural numbers or a list, with a step, each premise
  ; by normalization
  (defn instAt ((k T) (th Ts) (t T)) T (subst t (instVar (mArr k th mStar))))
  (defn byNatInd
    ((G Globals) (E (List Entry)) (n T) (kz T) (ks T) (s T) (rs NRs) (fuel T) (g Ts) (hs Ts) (t T)
     (u T))
    T
    (lcase T T g none
      (lam ((c T) (g1 Ts))
        (bindHT (lowerHyps G n g1 hs)
          (lam ((hn Terms))
            (let h1 Ts (termsOf hn)
              (bindO (byNorm G E n rs fuel g1 h1 (instAt kz (nil T) t) (instAt kz (nil T) u))
                (lam ((p0 T))
                  (bindO (byNorm G E n rs fuel g hs (natSuccAt ks t) (subst s (atVar0 t)))
                    (lam ((p1d T))
                      (mapO (lam ((p2d T)) (dNode 19 (l3 kz ks s) (l3 p0 p1d p2d)))
                        (byNorm G E n rs fuel g hs (natSuccAt ks u) (subst s (atVar0 u))))))))))))))
  (defn byListInd
    ((G Globals) (E (List Entry)) (n T) (kn T) (kc T) (s T) (rs NRs) (fuel T) (g Ts) (hs Ts) (t T)
     (u T))
    T
    (lcase T T g none
      (lam ((c T) (g1 Ts))
        (bindO (listPart c)
          (lam ((a T))
            (bindHT (lowerHyps G n g1 hs)
              (lam ((hn Terms))
                (let h1 Ts (termsOf hn)
                  (let g2 Ts (cons c (cons a g1))
                    (let h2 Ts (mapT weaken2 h1)
                      (bindO
                        (byNorm G E n rs fuel g1 h1 (instAt kn (single a) t)
                          (instAt kn (single a) u))
                        (lam ((p0 T))
                          (bindO
                            (byNorm G E n rs fuel g2 h2 (listConsAt kc a t)
                              (subst s (atVar0 (weakenElem t))))
                            (lam ((p1d T))
                              (mapO (lam ((p2d T)) (dNode 20 (l3 kn kc s) (l3 p0 p1d p2d)))
                                (byNorm G E n rs fuel g2 h2 (listConsAt kc a u)
                                  (subst s (atVar0 (weakenElem u)))))))))))))))))))

  ; induction with the induction hypothesis: the step's, normalized, cut in to rewrite by, the rules
  ; followed by the rewriting by the hypothesis of an index
  (defn withHyp ((rs NRs) (i T)) NRs
    (foldr NR NRs (lam ((x NR) (acc NRs)) (cons x acc)) (cons (pair (nrHyp i) noMatch) (nil NR))
      rs))
  (defn byNatIndHyp
    ((G Globals) (E (List Entry)) (n T) (kz T) (ks T) (rs NRs) (fuel T) (g Ts) (hs Ts) (t T) (u T))
    T
    (lcase T T g none
      (lam ((c T) (g1 Ts))
        (bindHT (lowerHyps G n g1 hs)
          (lam ((hn Terms))
            (let h1 Ts (termsOf hn)
              (bindO (byNorm G E n rs fuel g1 h1 (instAt kz (nil T) t) (instAt kz (nil T) u))
                (lam ((p0 T))
                  (let f1 Ts (append hs (single (mEq t u)))
                    (bindNT ((normalize G E n rs fuel) g f1 (mEq t u))
                      (lam ((npsi NFR))
                        (let psi T (nfTerm npsi)
                          (bindO
                            (byNorm G E n (withHyp rs (length f1)) fuel g (append f1 (single psi))
                              (natSuccAt ks t)
                              (natSuccAt ks u))
                            (lam ((q T))
                              (let ih T
                                (dNode 24 (single (mEq t u))
                                  (l2 (mDeriv (nfMarked npsi))
                                    (dNode 21 (single (length hs)) (nil T))))
                                (some
                                  (dNode 28 (l2 kz ks)
                                    (l2 p0 (dNode 22 (single psi) (l2 ih q))))))))))))))))))))
  (defn byListIndHyp
    ((G Globals) (E (List Entry)) (n T) (kn T) (kc T) (rs NRs) (fuel T) (g Ts) (hs Ts) (t T) (u T))
    T
    (lcase T T g none
      (lam ((c T) (g1 Ts))
        (bindO (listPart c)
          (lam ((a T))
            (bindHT (lowerHyps G n g1 hs)
              (lam ((hn Terms))
                (let h1 Ts (termsOf hn)
                  (bindO
                    (byNorm G E n rs fuel g1 h1 (instAt kn (single a) t) (instAt kn (single a) u))
                    (lam ((p0 T))
                      (let dl Ts (cons c (cons a g1))
                        (let e T (weakenElem (mEq t u))
                          (let f1 Ts (append (mapT weaken2 h1) (single e))
                            (bindNT ((normalize G E n rs fuel) dl f1 e)
                              (lam ((npsi NFR))
                                (let psi T (nfTerm npsi)
                                  (bindO
                                    (byNorm G E n (withHyp rs (length f1)) fuel dl
                                      (append f1 (single psi))
                                      (listConsAt kc a t)
                                      (listConsAt kc a u))
                                    (lam ((q T))
                                      (let ih T
                                        (dNode 24 (single e)
                                          (l2 (mDeriv (nfMarked npsi))
                                            (dNode 21 (single (length h1)) (nil T))))
                                        (some
                                          (dNode 29 (l2 kn kc)
                                            (l2 p0
                                              (dNode 22 (single psi)
                                                (l2 ih q))))))))))))))))))))))))

  ; the child whose normalization can enable a rule at a node's root other than an application: the
  ; pair's component a projection takes, and a fold's datum
  (defn headChild ((t T)) T
    (if (or (mIs 3 1 t) (mIs 4 1 t)) (some 0)
      (if (or (mIs 8 3 t) (mIs 9 3 t)) (some 2) (if (mIs 10 2 t) (some 1) none))))
  ; whether the normal form but for folds' starts and steps, and the weak normal form, leave a
  ; node's child of an index in place
  (defn keepsFold ((l T) (i T)) T (if (or (eq l 8) (eq l 9)) (lt i 2) (if (eq l 10) (eq i 0) 0)))
  (defn keepsWeak ((l T) (i T)) T (if (eq l 5) 1 (keepsFold l i)))

  ; the uses of the variable of an index in a term, each under an abstraction counted twice, a
  ; fold's start and step having none
  (deftype UF (Arrow T T))
  (deftype UFs (List UF))
  (import (Lists UF) as UFs)
  (defn ufAt ((rs UFs) (i T)) UF
    (lcase UF UF (iter UFs UFs.tail rs i) (lam ((d T)) 0) (lam ((r UF) (rest UFs)) r)))
  (defn ufSum ((rs UFs) (d T)) T
    (foldr UF T (lam ((r UF) (acc T)) (add (r d) acc)) 0 (UFs.tail rs)))
  (defn usesStep ((nd T) (rs UFs)) UF
    (lam ((d T))
      (let l T (label nd)
        (let k T (length (mArgs nd))
          (if (eq l 0) (if (eq (mD nd 0) d) 1 0)
            (if (eq l 5) (mul 2 (ufSum rs (add d 1)))
              (if (and (or (eq l 8) (eq l 9)) (eq k 3)) ((ufAt rs 3) d)
                (if (and (eq l 10) (eq k 2)) ((ufAt rs 2) d) (ufSum rs d)))))))))
  (defn uses ((t T) (d T)) T ((para UF usesStep t) d))

  ; the reduction of a term to a depth, 0 the weak head normal form, 1 the weak normal form, 2 the
  ; normal form but for folds' starts and steps and 3 the normal form, within a depth of fuel
  (deftype EV (Arrow T NF))
  (defn atRoot
    ((G Globals) (E (List Entry)) (n T) (rs NRs) (rec EV) (g Ts) (hs Ts) (dp T) (t1 T) (d1 Marked))
    ONFR.Maybe
    (let rr OTPair.Maybe (rootRewrite G E n rs g hs t1)
      (if (OTPair.isJust rr)
        (let r TPair (OTPair.fromMaybe pr0 rr)
          (mapNN
            (lam ((r3 NFR)) (nfr (nfTerm r3) (dTrans d1 (dTrans (mark (p2 r) 1) (nfMarked r3)))))
            (rec dp g hs (p1 r))))
        (ONFR.just (nfr t1 d1)))))
  (defn headStep ((G Globals) (E (List Entry)) (n T) (rs NRs) (rec EV) (g Ts) (hs Ts) (t T))
    ONFR.Maybe
    (if (mIs 6 2 t)
      (bindNN (rec 0 g hs (mArg t 0))
        (lam ((rf NFR))
          (let f1 T (nfTerm rf)
            (let u T (mArg t 1)
              (bindNN
                (if (mIs 5 1 f1)
                  (if (lt (uses (mArg f1 0) 0) 2) (ONFR.just (nfr u dRefl)) (rec 1 g hs u))
                  (rec 0 g hs u))
                (lam ((ru NFR))
                  (atRoot G E n rs rec g hs 0 (app f1 (nfTerm ru))
                    (dCong (MarkedF.l2 (nfMarked rf) (nfMarked ru))))))))))
      (let rr OTPair.Maybe (rootRewrite G E n rs g hs t)
        (if (OTPair.isJust rr)
          (let r TPair (OTPair.fromMaybe pr0 rr)
            (mapNN (lam ((r2 NFR)) (nfr (nfTerm r2) (dTrans (mark (p2 r) 1) (nfMarked r2))))
              (rec 0 g hs (p1 r))))
          (let hc T (headChild t)
            (if (isSome hc)
              (let i T (get hc)
                (let cs Ts (mArgs t)
                  (bindTN (nth cs i)
                    (lam ((c T))
                      (bindNN (rec 0 g hs c)
                        (lam ((rc NFR))
                          (if (mFlag (nfMarked rc))
                            (atRoot G E n rs rec g hs 0
                              (node (label t) (cons (child t 0) (setAt cs i (nfTerm rc))))
                              (dCong
                                (MarkedAt.map (lam ((j T)) (if (eq j i) (nfMarked rc) dRefl))
                                  (range (length cs)))))
                            (ONFR.just (nfr t dRefl)))))))))
              (ONFR.just (nfr t dRefl))))))))
  (import (Map T ONFR.Maybe) as NormAt)
  (defn deepStep
    ((G Globals) (E (List Entry)) (n T) (rs NRs) (rec EV) (dp T) (g Ts) (hs Ts) (w T) (dw Marked))
    ONFR.Maybe
    (let l T (label w)
      (let ws Ts (mArgs w)
        (if (eq dp 1)
          (bindLN
            (allSomeN
              (NormAt.map
                (lam ((i T))
                  (if (keepsWeak l i) (ONFR.just (nfr (at ws i) dRefl)) (rec 1 g hs (at ws i))))
                (range (length ws))))
            (lam ((csn NFRList))
              (let cs (List NFR) (nfrsOf csn)
                (let t1 T (rebuild w cs)
                  (let d1 Marked (dTrans dw (dCong (NFRMarked.map nfMarked cs)))
                    (if (marked cs) (atRoot G E n rs rec g hs 1 t1 d1) (ONFR.just (nfr t1 d1))))))))
          (bindSN (childCtxs G n w g hs)
            (lam ((cxn Scopes))
              (let cx (List Scope) (scopesOf cxn)
                (bindLN
                  (let z (List ScopeTerm) (zipTs cx ws)
                    (allSomeN
                      (NormAt.map
                        (lam ((i T))
                          (let cu ScopeTerm (ScopeTerms.atOr (scopeTerm scope0 0) z i)
                            (let c Scope (scopeOf cu)
                              (if (and (eq dp 2) (keepsFold l i))
                                (ONFR.just (nfr (termOf cu) dRefl))
                                (rec dp (scopeCtx c) (scopeHyps c) (termOf cu))))))
                        (range (ScopeTerms.length z)))))
                  (lam ((csn NFRList))
                    (let cs (List NFR) (nfrsOf csn)
                      (let t1 T (rebuild w cs)
                        (if (eq dp 2)
                          (let d1 Marked (dTrans dw (dCong (NFRMarked.map nfMarked cs)))
                            (if (marked cs) (atRoot G E n rs rec g hs 2 t1 d1)
                              (ONFR.just (nfr t1 d1))))
                          (let d1 Marked (dCong (NFRMarked.map nfMarked cs))
                            (let rr OTPair.Maybe (rootRewrite G E n rs g hs t1)
                              (if (OTPair.isJust rr)
                                (let r TPair (OTPair.fromMaybe pr0 rr)
                                  (mapNN
                                    (lam ((r3 NFR))
                                      (nfr (nfTerm r3)
                                        (dTrans dw
                                          (dTrans d1 (dTrans (mark (p2 r) 1) (nfMarked r3))))))
                                    (rec 3 g hs (p1 r))))
                                (ONFR.just (nfr t1 (dTrans dw d1))))))))))))))))))
  (defn evalStep ((G Globals) (E (List Entry)) (n T) (rs NRs) (rec EV)) EV
    (lam ((dp T) (g Ts) (hs Ts) (t T))
      (bindNN (headStep G E n rs rec g hs t)
        (lam ((w NFR))
          (if (eq dp 0) (ONFR.just w) (deepStep G E n rs rec dp g hs (nfTerm w) (nfMarked w)))))))
  (defn eval ((G Globals) (E (List Entry)) (n T) (rs NRs) (fuel T)) EV
    (iter EV (evalStep G E n rs) (lam ((dp T) (g Ts) (hs Ts) (t T)) (ONFR.just (nfr t dRefl)))
      fuel))
  (defn whnf ((G Globals) (E (List Entry)) (n T) (rs NRs) (fuel T)) NF (eval G E n rs fuel 0))
  (defn normalizeW ((G Globals) (E (List Entry)) (n T) (rs NRs) (fuel T)) NF (eval G E n rs fuel 3))
  (defn byNormW ((G Globals) (E (List Entry)) (n T) (rs NRs) (fuel T) (g Ts) (hs Ts) (t T) (u T)) T
    (joinBy (normalizeW G E n rs fuel) g hs t u))

  ; provers of equations, and the proofs of an equation from proofs of others
  (deftype Pv (Arrow Ts (Arrow Ts (Arrow T (Arrow T T)))))
  (defn abstractVar ((i T) (c T) (t T)) T
    (mLam c (subst (weaken1 t) (lam ((j T)) (if (eq j (add i 1)) (var 0) (var j))))))
  (defn byFunExt ((G Globals) (n T) (prove Pv)) Pv
    (lam ((g Ts) (hs Ts) (f T) (h T))
      (bindPT (bindTP (typeIn G n g f) expParts)
        (lam ((ab TPair))
          (mapO (lam ((d T)) (dNode 26 (nil T) (single d)))
            (prove (cons (p1 ab) g) (mapT weaken1 hs) (app (weaken1 f) (var 0))
              (app (weaken1 h) (var 0))))))))
  (defn bySplit ((kl T) (kr T) (i T) (prove Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (bindO (nth g i)
        (lam ((c T))
          (bindP (coprodParts c)
            (lam ((ab TPair))
              (let a T (p1 ab)
                (let b T (p2 ab)
                  (let F T (abstractVar i c t)
                    (let H T (abstractVar i c u)
                      (let inj (Arrow T (Arrow T T))
                        (lam ((k T) (s T)) (app (weaken1 s) (mArr k (l2 a b) (var 0))))
                        (bindO (prove (cons a g) (mapT weaken1 hs) (inj kl F) (inj kl H))
                          (lam ((q0 T))
                            (bindO (prove (cons b g) (mapT weaken1 hs) (inj kr F) (inj kr H))
                              (lam ((q1 T))
                                (let pp T
                                  (dNode 26 (nil T) (single (dNode 34 (l2 kl kr) (l2 q0 q1))))
                                  (let dx T
                                    (dNode 2 (nil T)
                                      (l2 (dNode 3 (nil T) (nil T)) (dNode 3 (nil T) (nil T))))
                                    (let px T
                                      (dNode 18 (nil T)
                                        (l2
                                          (dNode 2 (nil T)
                                            (l2 (dNode 17 (l2 (length hs) 0) (nil T))
                                              (dNode 0 (nil T) (nil T))))
                                          (dNode 0 (nil T) (nil T))))
                                      (let chi T (mEq (app F (var i)) (app H (var i)))
                                        (some
                                          (dNode 22 (single (mEq F H))
                                            (l2 pp
                                              (dNode 24 (single chi)
                                                (l2 dx px))))))))))))))))))))))))
  (defn byListIndWith ((G Globals) (n T) (kn T) (kc T) (p0 Pv) (p1v Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (lcase T T g none
        (lam ((c T) (g1 Ts))
          (bindO (listPart c)
            (lam ((a T))
              (bindHT (lowerHyps G n g1 hs)
                (lam ((hn Terms))
                  (let h1 Ts (termsOf hn)
                    (bindO (p0 g1 h1 (instAt kn (single a) t) (instAt kn (single a) u))
                      (lam ((d0 T))
                        (mapO (lam ((d1 T)) (dNode 29 (l2 kn kc) (l2 d0 d1)))
                          (p1v (cons c (cons a g1))
                            (append (mapT weaken2 h1) (single (weakenElem (mEq t u))))
                            (listConsAt kc a t)
                            (listConsAt kc a u))))))))))))))

  ; induction on a rose tree alone, in the form of the uniqueness of its fold, each premise by
  ; normalization; and with the hypothesis at each child, the premise by a prover
  (defn byRoseInd
    ((G Globals) (E (List Entry)) (n T) (kn T) (kl T) (kc T) (s T) (rs NRs) (fuel T) (g Ts) (t T)
     (u T))
    T
    (if (eq (length g) 1)
      (let r T (at g 0)
        (bindO (roseLabel r)
          (lam ((a T))
            (bindO (typeIn G n g t)
              (lam ((C T))
                (let g2 Ts (l2 (list r) a)
                  (bindO
                    (byNorm G E n rs fuel g2 (nil T) (roseNodeAt kn r a t)
                      (subst s (atVar0 (roseMapAt kl kc C t))))
                    (lam ((q1 T))
                      (mapO (lam ((q2 T)) (dNode 32 (l4 kn kl kc s) (l2 q1 q2)))
                        (byNorm G E n rs fuel g2 (nil T) (roseNodeAt kn r a u)
                          (subst s (atVar0 (roseMapAt kl kc C u)))))))))))))
      none))
  (defn byRoseIndHyp ((kn T) (kl T) (kc T) (p Pv)) Pv
    (lam ((g Ts) (hs Ts) (t T) (u T))
      (if (eq (length g) 1)
        (let r T (at g 0)
          (bindO (roseLabel r)
            (lam ((a T))
              (mapO (lam ((d T)) (dNode 33 (l3 kn kl kc) (single d)))
                (p (l2 (list r) a) (single (roseHyp kl kc (mEq t u))) (roseNodeAt kn r a t)
                  (roseNodeAt kn r a u))))))
        none))))
