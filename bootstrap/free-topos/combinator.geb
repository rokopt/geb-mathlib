;
; The prover of the theory of an elementary topos, written in the datatype language, computing
; as Geb.FreeTopos.Prover computes: the typing of terms from the axioms, the rewriting of terms
; by rules from the axioms and the development's theorems, normalization, the proofs by
; normalization and induction, and the library's development. The prover runs in a scope and a
; state: a computation is a function from a scope and a state to the optional pair of its
; value and the state after it. A scope is the node of label 0 over the node of its variables'
; sorts and the node of its hypotheses; a state the node of label 0 over the node of the
; development's entries, each the node of label 0 over a sequent and its certificate, the node
; of the terms typed so far with their typings and the node of the terms normalized so far with
; their normal forms, each the node of label 0 over a key and its value, the latest first, the
; node of the definitions in force, the node of the extended signature, and whether the typing
; is certified by the checker's oracle rules; a typing the node of label 0 over a term, its sort,
; its definedness certificate, its lower bound with its certificate and its upper bound with its
; certificate. Requires the prelude, the base, partial Horn logic, the theory and the inference.

; certificates, as Geb.PartialHorn.Cert builds them
(defn cHyp ((i T)) T (node PRule.hyp (single (node i (nil T)))))
(defn cRefl ((i T)) T (node PRule.refl (single (node i (nil T)))))
(defn cSymm ((p T)) T (node PRule.symm (single p)))
(defn cTrans ((p T) (q T)) T (node PRule.trans (l2 p q)))
(defn cCong ((d T) (ps Ts)) T (node PRule.cong (cons d ps)))
(defn cStrict ((j T) (p T)) T (node PRule.strict (l2 (node j (nil T)) p)))
(defn cAx ((j T) (ts Ts) (ds Ts) (hs Ts)) T
  (node PRule.ax (cons (node j (nil T)) (append ts (append ds hs)))))
(defn cThm ((j T) (ts Ts) (ds Ts) (hs Ts)) T
  (node PRule.thm (cons (node j (nil T)) (append ts (append ds hs)))))
(defnum PRule.typed 9)
(defnum PRule.objEq 10)

; scopes: the variables' sorts and the hypotheses
(data PhScope (scope T T))
(defn scCtx ((sc T)) Ts (case sc ((scope c h) (children c))))
(defn scHyps ((sc T)) Ts (case sc ((scope c h) (children h))))
(defn scSeq ((sc T) (q T)) T (mkSeq (scCtx sc) (scHyps sc) q))
(defn scCite ((sc T) (j T)) T
  (let n T (length (scCtx sc))
    (cThm j (mapT phVar (range n)) (mapT cRefl (range n)) (mapT cHyp (range (length (scHyps sc)))))))

; states
(data PSt (pst T T T T T T))
(defn stDev ((st T)) Ts (case st ((pst v m f d s i) (children v))))
(defn stMemo ((st T)) Ts (case st ((pst v m f d s i) (children m))))
(defn stNfs ((st T)) Ts (case st ((pst v m f d s i) (children f))))
(defn stDefs ((st T)) Ts (case st ((pst v m f d s i) (children d))))
(defn stSig ((st T)) Ts (case st ((pst v m f d s i) (children s))))
(defn stInfer ((st T)) T (case st ((pst v m f d s i) i)))
(defn withDev ((st T) (v Ts)) T (case st ((pst v0 m f d s i) (pst (node 0 v) m f d s i))))
(defn withMemo ((st T) (m Ts)) T (case st ((pst v m0 f d s i) (pst v (node 0 m) f d s i))))
(defn withNfs ((st T) (f Ts)) T (case st ((pst v m f0 d s i) (pst v m (node 0 f) d s i))))
; the value of a key in a table, the latest first
(defn tableFind ((tb Ts) (k T)) T
  (foldr T T (lam ((e T) (acc T)) (if (equal (at (children e) 0) k) (some (at (children e) 1)) acc))
    none tb))
(defn tableInsert ((tb Ts) (k T) (v T)) Ts (cons (node 0 (l2 k v)) tb))

; typings
(data PTy (pty T T T T T T T))
(defn tyT ((y T)) T (case y ((pty t s d l lc h hc) t)))
(defn tySort ((y T)) T (case y ((pty t s d l lc h hc) s)))
(defn tyDfd ((y T)) T (case y ((pty t s d l lc h hc) d)))
(defn tyLo ((y T)) T (case y ((pty t s d l lc h hc) l)))
(defn tyLoC ((y T)) T (case y ((pty t s d l lc h hc) lc)))
(defn tyHi ((y T)) T (case y ((pty t s d l lc h hc) h)))
(defn tyHiC ((y T)) T (case y ((pty t s d l lc h hc) hc)))

; the prover's computations: from a scope and a state to the optional pair of a value and the
; state after it
(deftype PM (Arrow T (Arrow T T)))
(deftype KM (Arrow T PM))
(defn pmPure ((v T)) PM (lam ((sc T) (st T)) (some (node 0 (l2 v st)))))
(defn pmFail ((sc T) (st T)) T none)
(defn pmBind ((m PM) (k KM)) PM
  (lam ((sc T) (st T))
    (bindO (m sc st) (lam ((r T)) (k (at (children r) 0) sc (at (children r) 1))))))
(defn pmOr ((a PM) (b PM)) PM (lam ((sc T) (st T)) (let r T (a sc st) (if (isSome r) r (b sc st)))))
(defn pmGet ((sc T) (st T)) T (some (node 0 (l2 st st))))
(defn pmRead ((sc T) (st T)) T (some (node 0 (l2 sc st))))
(defn pmSet ((s1 T)) PM (lam ((sc T) (st T)) (some (node 0 (l2 0 s1)))))
(defn pmGuard ((b T)) PM (lam ((sc T) (st T)) (if b (some (node 0 (l2 0 st))) none)))
; the values of a list's elements in turn, as the node of label 0 over them
(defn pmMapM ((f KM) (xs Ts)) PM
  (foldr T PM
    (lam ((x T) (acc PM))
      (pmBind (f x) (lam ((y T)) (pmBind acc (lam ((ys T)) (pmPure (node 0 (cons y (children ys)))))))))
    (pmPure (node 0 (nil T))) xs))
; the computations of a list's computations in turn
(defn pmSeq ((ms (List PM))) PM
  (foldr PM PM
    (lam ((m PM) (acc PM))
      (pmBind m (lam ((y T)) (pmBind acc (lam ((ys T)) (pmPure (node 0 (cons y (children ys)))))))))
    (pmPure (node 0 (nil T))) ms))
; the index of the first element of a list passing a test, or nothing
(defn findIdxT ((f (Arrow T T)) (xs Ts)) T
  (snd (foldr T (Prod T T)
    (lam ((x T) (s (Prod T T))) (pair (sub (fst s) 1) (if (f x) (some (sub (fst s) 1)) (snd s))))
    (pair (length xs) none) xs)))

; typing: the axioms of the extension by the definitions in force, lemmas, the table of typings,
; and the certificates of definedness and of equations between objects
(defn axiomAt ((j T)) PM
  (if (lt j (length axioms)) (pmPure (at axioms j))
    (pmBind pmGet (lam ((st T))
      (let r T (sub j (length axioms))
        (let md T (nth (stDefs st) (div r 2))
          (if (isSome md)
              (let ma T (nth (pdAxioms (add (length sig) (div r 2)) (get md)) (mod r 2))
                (if (isSome ma) (pmPure (get ma)) pmFail))
              pmFail)))))))
(defn addLemma ((q T) (c T)) PM
  (lam ((sc T) (st T))
    (some (node 0 (l2 (scCite sc (length (stDev st)))
                      (withDev st (append (stDev st) (single (node 0 (l2 (scSeq sc q) c))))))))))
(defn lookup ((t T)) PM (lam ((sc T) (st T)) (some (node 0 (l2 (tableFind (stMemo st) t) st)))))
(defn memoize ((y T)) PM
  (lam ((sc T) (st T)) (some (node 0 (l2 0 (withMemo st (tableInsert (stMemo st) (tyT y) y)))))))
(defn memoRet ((y T)) PM (pmBind (memoize y) (lam ((u T)) (pmPure y))))
(defn dfdCert ((t T) (c T)) PM
  (lam ((sc T) (st T))
    (if (stInfer st) (some (node 0 (l2 (node PRule.typed (single t)) st))) (addLemma (dfd t) c sc st))))
(defn eqCert ((q T) (c T)) PM
  (lam ((sc T) (st T))
    (if (stInfer st) (some (node 0 (l2 (node PRule.objEq (l2 (eqLhs q) (eqRhs q))) st)))
      (addLemma q c sc st))))
(defn objEq ((l T) (r T)) PM
  (lam ((sc T) (st T))
    (if (and (eq (tySort l) Sorts.obj) (and (eq (tySort r) Sorts.obj) (equal (tyLo l) (tyLo r))))
        (some (node 0 (l2 (if (stInfer st) (node PRule.objEq (l2 (tyT l) (tyT r)))
                              (cTrans (tyLoC l) (cSymm (tyLoC r))))
                          st)))
        none)))

; the typing of an axiom's side instantiated at typed arguments
(deftype PatTy (Arrow Ts (Arrow T PM)))
(defn proveHyp ((pt PatTy) (tys Ts) (h T)) PM
  (pmBind (pt tys (eqLhs h)) (lam ((l T))
    (if (equal (eqLhs h) (eqRhs h)) (pmPure (tyDfd l))
      (pmBind (pt tys (eqRhs h)) (lam ((r T)) (objEq l r)))))))
; the canonical bound of an application of operation k by the axiom j, with its certificate
(defn pBound ((pt PatTy) (tys Ts) (k T) (j T) (d T)) PM
  (pmBind (axiomAt j) (lam ((a T))
    (pmBind (pmMapM (lam ((h T)) (if (equal h (dfd (opVars k (length tys)))) (pmPure d)
                                   (proveHyp pt tys h)))
              (seqHyps a))
      (lam ((hs T))
        (let q T (cAx j (mapT tyT tys) (mapT tyDfd tys) (children hs))
          (pmBind (pt tys (eqRhs (seqConcl a))) (lam ((r T))
            (pmPure (node 0 (l2 (tyLo r) (cTrans q (tyLoC r)))))))))))))
; the typing of an application of the definition at position i, of sort s
(defn typeDefined ((pt PatTy) (i T) (s T) (tys Ts)) PM
  (pmBind pmGet (lam ((st T))
    (let md T (nth (stDefs st) i)
      (if (isSome md)
        (let ts Ts (mapT tyT tys)
          (let t T (phOp (add (length sig) i) ts)
            (pmBind (pt tys (pdBody (get md))) (lam ((b T))
              (pmBind pmGet (lam ((st1 T))
                (if (stInfer st1)
                    (let d T (node PRule.typed (single t))
                      (memoRet
                        (if (eq s Sorts.obj)
                            (pty t Sorts.obj d (tyLo b) (node PRule.objEq (l2 t (tyLo b))) (tyLo b)
                              (node PRule.objEq (l2 t (tyLo b))))
                            (pty t Sorts.arr d (tyLo b) (node PRule.objEq (l2 (dom t) (tyLo b)))
                              (tyHi b) (node PRule.objEq (l2 (cod t) (tyHi b)))))))
                    (pmBind (addLemma (eqn t (tyT b))
                              (cAx (defAxIdx i) ts (mapT tyDfd tys) (single (tyDfd b))))
                      (lam ((e T))
                        (pmBind (addLemma (dfd t) (cTrans e (cSymm e))) (lam ((d T))
                          (if (eq s Sorts.obj)
                              (pmBind (addLemma (eqn t (tyLo b)) (cTrans e (tyLoC b))) (lam ((c T))
                                (memoRet (pty t Sorts.obj d (tyLo b) c (tyLo b) c))))
                              (pmBind (addLemma (eqn (dom t) (tyLo b))
                                        (cTrans (cCong (cAx 0 (single t) (single d) (nil T))
                                                  (single e)) (tyLoC b)))
                                (lam ((dc T))
                                  (pmBind (addLemma (eqn (cod t) (tyHi b))
                                            (cTrans (cCong (cAx 1 (single t) (single d) (nil T))
                                                      (single e)) (tyHiC b)))
                                    (lam ((cc T))
                                      (memoRet (pty t Sorts.arr d (tyLo b) dc (tyHi b) cc))))))))))))))))))
        pmFail)))))
; the certificate of an application's definedness by the rule the table names for operation k
(defn typeOpDfd ((pt PatTy) (k T) (tys Ts)) PM
  (let ts Ts (mapT tyT tys)
    (let r T (nth dfdRules k)
      (if (and (isSome r) (isSome (get r)))
          (let rule T (get (get r))
            (let j T (at (children rule) 0)
              (if (eq (label rule) 0)
                  (pmBind (axiomAt j) (lam ((a T))
                    (pmBind (pmMapM (proveHyp pt tys) (seqHyps a)) (lam ((hs T))
                      (pmPure (cAx j ts (mapT tyDfd tys) (children hs)))))))
                (if (eq (label rule) 1)
                    (pmPure (cStrict 0 (cAx j ts (mapT tyDfd tys) (nil T))))
                  (let q T (cAx j (nil T) (nil T) (nil T)) (pmPure (cTrans (cSymm q) q)))))))
          pmFail))))
; the typing of an object t, an application of operation k defined by d, whose canonical form is
; the operation applied to its arguments' canonical forms
(defn typeOpObj ((k T) (t T) (d T) (tys Ts)) PM
  (let c T (phOp k (mapT (lam ((y T)) (if (eq (tySort y) Sorts.obj) (tyLo y) (tyT y))) tys))
    (if (equal c t) (pmPure (pty t Sorts.obj d t d t d))
      (pmBind (eqCert (eqn t c)
                (cCong d (mapT (lam ((y T)) (if (eq (tySort y) Sorts.obj) (tyLoC y) (tyDfd y))) tys)))
        (lam ((e T)) (pmPure (pty t Sorts.obj d c e c e)))))))
; the typing of an application of operation k of sort s, defined by d
(defn typeOpTy ((pt PatTy) (k T) (s T) (t T) (d T) (tys Ts)) PM
  (if (eq s Sorts.obj)
    (if (and (eq k 0) (eq (length tys) 1))
        (let f T (at tys 0) (pmPure (pty t Sorts.obj d (tyLo f) (tyLoC f) (tyLo f) (tyLoC f))))
      (if (and (eq k 1) (eq (length tys) 1))
          (let f T (at tys 0) (pmPure (pty t Sorts.obj d (tyHi f) (tyHiC f) (tyHi f) (tyHiC f))))
        (typeOpObj k t d tys)))
    (let jd T (nth domRules k)
      (let jc T (nth codRules k)
        (if (and (and (isSome jd) (isSome (get jd))) (and (isSome jc) (isSome (get jc))))
            (pmBind (pBound pt tys k (get (get jd)) d) (lam ((dp T))
              (pmBind (pBound pt tys k (get (get jc)) d) (lam ((cp T))
                (pmBind (eqCert (eqn (dom t) (at (children dp) 0)) (at (children dp) 1)) (lam ((de T))
                  (pmBind (eqCert (eqn (cod t) (at (children cp) 0)) (at (children cp) 1))
                    (lam ((ce T))
                      (pmPure (pty t Sorts.arr d (at (children dp) 0) de (at (children cp) 0)
                                ce))))))))))
            pmFail)))))
; the typing of an application of operation k to terms of the given typings
(defn typeOp ((pt PatTy) (k T) (tys Ts)) PM
  (pmBind pmGet (lam ((st T))
    (let mo T (nth (stSig st) k)
      (if (isSome mo)
          (let o T (get mo)
            (if (equalTs (mapT tySort tys) (opArgs o))
                (if (lt k (length sig))
                    (let t T (phOp k (mapT tyT tys))
                      (pmBind (typeOpDfd pt k tys) (lam ((dc T))
                        (pmBind (dfdCert t dc) (lam ((d T))
                          (pmBind (typeOpTy pt k (opSort o) t d tys) memoRet))))))
                    (typeDefined pt (sub k (length sig)) (opSort o) tys))
                pmFail))
          pmFail)))))
; one step of typing: a variable's node by lf, an application by typeOp unless its term, which
; term computes from the node, has been typed
(defn typeStep ((pt PatTy) (lf KM) (term (Arrow T T)) (nd T) (rs (List PM))) PM
  (let l T (label nd)
    (if (eq l 0)
        (if (eq (length (children nd)) 1) (lf (label (at (children nd) 0))) pmFail)
        (pmBind (lookup (term nd)) (lam ((mt T))
          (if (isSome mt) (pmPure (get mt))
            (pmBind (pmSeq rs) (lam ((ys T)) (typeOp pt (sub l 1) (children ys))))))))))
; the canonical bound of a variable's domain or codomain: that of the object a hypothesis
; equates it with, typed by tt, certified by the oracle's rule when inf holds, or itself
(defn varSide ((tt KM) (i T) (inf T) (o T) (j T)) PM
  (lam ((sc T) (st T))
    (let v T (phOp o (single (phVar i)))
      (let mh T (findIdxT (lam ((q T)) (equal (eqLhs q) v)) (scHyps sc))
        (if (isSome mh)
            (let h T (get mh)
              (let mq T (nth (scHyps sc) h)
                (if (isSome mq)
                    ((pmBind (tt (eqRhs (get mq))) (lam ((r T))
                       (pmPure (node 0 (l2 (tyLo r)
                                          (if inf (node PRule.objEq (l2 v (tyLo r)))
                                            (cTrans (cHyp h) (tyLoC r))))))))
                     sc st)
                    none)))
            (some (node 0 (l2 (node 0 (l2 v (cAx j (single (phVar i)) (single (cRefl i)) (nil T))))
                              st))))))))
; the typing of a variable of the scope
(defn typeVar ((tt KM) (i T)) PM
  (lam ((sc T) (st T))
    (let ms T (nth (scCtx sc) i)
      (if (isSome ms)
          (let s T (get ms)
            (if (eq s Sorts.obj)
                (some (node 0 (l2 (pty (phVar i) Sorts.obj (cRefl i) (phVar i) (cRefl i) (phVar i)
                                    (cRefl i))
                                  st)))
              (if (eq s Sorts.arr)
                  (let inf T (stInfer st)
                    ((pmBind (varSide tt i inf 0 0) (lam ((dp T))
                       (pmBind (varSide tt i inf 1 1) (lam ((cp T))
                         (pmPure (pty (phVar i) Sorts.arr (cRefl i) (at (children dp) 0)
                                   (at (children dp) 1) (at (children cp) 0) (at (children cp) 1)))))))
                     sc st))
                  none)))
          none))))
; the typers at a fuel: of an axiom's side instantiated at typed arguments, and of a term of the
; scope, each typing the instances of axioms' sides it meets at the fuel below
(deftype Typers (Prod PatTy KM))
(defn typers ((n T)) Typers
  (iter Typers
    (lam ((rec Typers))
      (pair (lam ((env Ts) (p T))
              (para PM (typeStep (fst rec)
                         (lam ((i T)) (let my T (nth env i) (if (isSome my) (pmPure (get my)) pmFail)))
                         (phSubst (mapT tyT env)))
                p))
            (lam ((t T)) (para PM (typeStep (fst rec) (typeVar (snd rec)) (lam ((u T)) u)) t))))
    (pair (lam ((env Ts) (p T)) pmFail) (lam ((t T)) pmFail))
    n))
(defn typeTerm ((t T)) PM ((snd (typers 8)) t))
(defn typePattern ((env Ts) (p T)) PM ((fst (typers 8)) env p))
; the run of a computation in a scope from a development, with definitions in force: its value
; and the development after it
(defn pmRun ((sc T) (dev Ts) (m PM) (defs Ts) (infer T)) T
  (mapO (lam ((r T)) (node 0 (l2 (at (children r) 0) (node 0 (stDev (at (children r) 1))))))
    (m sc (pst (node 0 dev) (node 0 (nil T)) (node 0 (nil T)) (node 0 defs)
            (node 0 (append sig (mapT (lam ((d T)) (opSig (node 0 (pdCtx d)) (pdSort d))) defs)))
            infer))))

; rewriting: the sources of rules, a rule as the node of label 0 over its source, whether it is
; read from right to left and the node of the root labels it avoids, and the match of a rule's
; side against a term, a match's state the node of label 0 over the node of the assignment's
; optional terms and the node of the pairs of objects deferred to their canonical forms
(data Src (srcAx T) (srcThm T))
(defn srcSeq ((s T)) PM
  (let j T (at (children s) 0)
    (if (eq (label s) 0) (axiomAt j)
      (pmBind pmGet (lam ((st T))
        (let me T (nth (stDev st) j)
          (if (isSome me) (pmPure (at (children (get me)) 0)) pmFail)))))))
(defn srcCert ((s T) (ts Ts) (ds Ts) (hs Ts)) T
  (if (eq (label s) 0) (cAx (at (children s) 0) ts ds hs) (cThm (at (children s) 0) ts ds hs)))
(data RwRule (rwRule T T T))
(defn rwSrc ((r T)) T (case r ((rwRule s f a) s)))
(defn rwFlip ((r T)) T (case r ((rwRule s f a) f)))
(defn rwAvoid ((r T)) Ts (case r ((rwRule s f a) (children a))))
(data MatchSt (matchSt T T))
(defn msSigma ((m T)) Ts (case m ((matchSt s o) (children s))))
(defn msObjs ((m T)) Ts (case m ((matchSt s o) (children o))))
(defn msDefer ((m T) (p T) (t T)) T
  (matchSt (node 0 (msSigma m)) (node 0 (cons (node 0 (l2 p t)) (msObjs m)))))
(deftype MF (Arrow T (Arrow T T)))
; the match of the children's matches against a term's children, in turn
(defn matchKids ((rs (List MF)) (us Ts) (m T)) T
  ((foldr MF (Arrow Ts (Arrow T T))
     (lam ((r MF) (k (Arrow Ts (Arrow T T))) (vs Ts) (m1 T))
       (lcase T T vs (some m1) (lam ((u T) (rest Ts)) (bindO (r u m1) (lam ((m2 T)) (k rest m2))))))
     (lam ((vs Ts) (m1 T)) (some m1)) rs)
   us m))
(defn matchStepP ((S Ts) (ctx Ts) (nd T) (rs (List MF))) MF
  (lam ((t T) (m T))
    (let l T (label nd)
      (if (eq l 0)
          (if (eq (length (children nd)) 1)
              (let i T (label (at (children nd) 0))
                (let mv T (nth (msSigma m) i)
                  (if (isSome mv)
                      (if (isSome (get mv))
                          (if (equal (get (get mv)) t) (some m)
                            (if (equal (nth ctx i) (some Sorts.obj)) (some (msDefer m nd t)) none))
                          (some (matchSt (node 0 (setAt (msSigma m) i (some t))) (node 0 (msObjs m)))))
                      none)))
              none)
          (if (equal (sortOf S ctx nd) (some Sorts.obj)) (some (msDefer m nd t))
            (if (and (eq (label t) l) (eq (length (children t)) (length (children nd))))
                (matchKids rs (children t) m)
                none))))))
(defn matchPat ((S Ts) (ctx Ts) (p T) (t T) (m T)) T (para MF (matchStepP S ctx) p t m))
; the certificate that a term equals the instance of a rule's side at the typed assignment tys
(deftype BF (Arrow T PM))
(defn bridgeKids ((rs (List BF)) (us Ts)) PM
  ((foldr BF (Arrow Ts PM)
     (lam ((r BF) (k (Arrow Ts PM)) (vs Ts))
       (lcase T PM vs (pmPure (node 0 (nil T)))
         (lam ((u T) (rest Ts))
           (pmBind (r u) (lam ((y T)) (pmBind (k rest) (lam ((ys T))
             (pmPure (node 0 (cons y (children ys)))))))))))
     (lam ((vs Ts)) (pmPure (node 0 (nil T)))) rs)
   us))
(defn bridgeStep ((tys Ts) (nd T) (rs (List BF))) BF
  (lam ((t T))
    (pmBind (typeTerm t) (lam ((ty T))
      (if (equal (phSubst (mapT tyT tys) nd) t) (pmPure (tyDfd ty))
        (if (eq (tySort ty) Sorts.obj)
            (pmBind (typePattern tys nd) (lam ((py T)) (objEq ty py)))
          (if (or (eq (label nd) 0) (not (eq (length (children t)) (length (children nd))))) pmFail
            (pmBind (bridgeKids rs (children t)) (lam ((cs T))
              (pmPure (cCong (tyDfd ty) (children cs))))))))))))
(defn bridge ((tys Ts) (p T) (t T)) PM (para BF (bridgeStep tys) p t))
; one rewriting step at a term's root by a rule: the instance of the rule's other side, with the
; certificate of the term's equation with it
(defn applyRule ((r T) (t T)) PM
  (pmBind (pmGuard (not (anyT (lam ((a T)) (eq (label t) a)) (rwAvoid r)))) (lam ((u0 T))
    (pmBind (srcSeq (rwSrc r)) (lam ((a T))
      (let p T (if (rwFlip r) (eqRhs (seqConcl a)) (eqLhs (seqConcl a)))
        (let q T (if (rwFlip r) (eqLhs (seqConcl a)) (eqRhs (seqConcl a)))
          (pmBind pmGet (lam ((st T))
            (let mm T (matchPat (stSig st) (seqCtx a) p t
                        (matchSt (node 0 (mapT (lam ((c T)) none) (seqCtx a))) (node 0 (nil T))))
              (if (isSome mm)
                  (let ms T (get mm)
                    (let mσ T (allSomeT (msSigma ms))
                      (if (isSome mσ)
                          (let σ Ts (children (get mσ))
                            (pmBind (pmMapM typeTerm σ) (lam ((tysN T))
                              (let tys Ts (children tysN)
                                (pmBind (pmMapM (lam ((e T))
                                                  (pmBind (typePattern tys (at (children e) 0))
                                                    (lam ((lo T))
                                                      (pmBind (typeTerm (at (children e) 1))
                                                        (lam ((lu T)) (objEq lo lu))))))
                                          (msObjs ms))
                                  (lam ((u1 T))
                                    (pmBind (bridge tys p t) (lam ((b T))
                                      (pmBind (pmMapM (proveHyp typePattern tys) (seqHyps a))
                                        (lam ((hs T))
                                          (let i T (srcCert (rwSrc r) σ (mapT tyDfd tys) (children hs))
                                            (pmPure (node 0 (l2 (phSubst σ q)
                                                              (cTrans b (if (rwFlip r) (cSymm i) i))))))))))))))))
                          pmFail)))
                  pmFail)))))))))))
(defn firstRule ((rules Ts) (t T)) PM
  (foldr T PM (lam ((r T) (k PM)) (pmOr (applyRule r t) k)) pmFail rules))
; the instance of associativity at a term comp a (comp b x)
(defn assocLeft ((t T)) PM
  (if (and (eq (label t) 4) (eq (length (children t)) 2))
      (let a T (at (children t) 0)
        (let bx T (at (children t) 1)
          (if (and (eq (label bx) 4) (eq (length (children bx)) 2))
              (let b T (at (children bx) 0)
                (let x T (at (children bx) 1)
                  (pmBind (typeTerm t) (lam ((d T))
                    (pmBind (typeTerm a) (lam ((ya T))
                      (pmBind (typeTerm b) (lam ((yb T))
                        (pmBind (typeTerm x) (lam ((yx T))
                          (pmPure (node 0 (l4 a b x
                                            (cAx 7 (l3 a b x) (l3 (tyDfd ya) (tyDfd yb) (tyDfd yx))
                                              (single (tyDfd d))))))))))))))))
              pmFail)))
      pmFail))
(defn rewriteRoot ((rules Ts) (t T)) PM
  (pmOr (firstRule rules t)
    (pmBind (assocLeft t) (lam ((q T))
      (let a T (at (children q) 0)
        (let b T (at (children q) 1)
          (let x T (at (children q) 2)
            (let c T (at (children q) 3)
              (pmBind (firstRule rules (comp a b)) (lam ((uc T))
                (pmBind (typeTerm (comp (comp a b) x)) (lam ((ab T))
                  (pmBind (typeTerm x) (lam ((yx T))
                    (pmPure (node 0 (l2 (comp (at (children uc) 0) x)
                                      (cTrans c (cCong (tyDfd ab)
                                                  (l2 (at (children uc) 1) (tyDfd yx)))))))))))))))))))))
; normal forms: the table of the terms normalized so far
(defn lookupNf ((t T)) PM (lam ((sc T) (st T)) (some (node 0 (l2 (tableFind (stNfs st) t) st)))))
(defn memoizeNf ((t T) (n T) (c T)) PM
  (pmBind (if (equal t n) (pmPure c) (addLemma (eqn t n) c)) (lam ((c1 T))
    (lam ((sc T) (st T))
      (some (node 0 (l2 (node 0 (l2 n c1)) (withNfs st (tableInsert (stNfs st) t (node 0 (l2 n c1)))))))))))
(deftype NB (Arrow T PM))
(defn normStepP ((rules Ts) (rec NB) (nd T) (rs (List PM))) PM
  (pmBind (lookupNf nd) (lam ((mr T))
    (if (isSome mr) (pmPure (get mr))
      (pmBind (typeTerm nd) (lam ((ty T))
        (if (eq (tySort ty) Sorts.obj) (pmPure (node 0 (l2 (tyLo ty) (tyLoC ty))))
          (if (eq (label nd) 0) (pmPure (node 0 (l2 nd (tyDfd ty))))
            (pmBind (pmSeq rs) (lam ((rsN T))
              (let ps Ts (children rsN)
                (let t1 T (node (label nd) (mapT (lam ((p T)) (at (children p) 0)) ps))
                  (let c1 T (if (equal t1 nd) (tyDfd ty)
                              (cCong (tyDfd ty) (mapT (lam ((p T)) (at (children p) 1)) ps)))
                    (pmBind (pmOr (pmBind (rewriteRoot rules t1) (lam ((r T)) (pmPure (some r))))
                              (pmPure none))
                      (lam ((mr2 T))
                        (if (isSome mr2)
                            (let r2 T (get mr2)
                              (pmBind (rec (at (children r2) 0)) (lam ((r3 T))
                                (memoizeNf nd (at (children r3) 0)
                                  (cTrans c1 (cTrans (at (children r2) 1) (at (children r3) 1)))))))
                            (memoizeNf nd t1 c1)))))))))))))))))
(defn normalizers ((rules Ts) (n T)) NB
  (iter NB (lam ((rec NB)) (lam ((t T)) (para PM (normStepP rules rec) t))) (lam ((t T)) pmFail) n))
(defn pNormalize ((rules Ts) (t T)) PM (normalizers rules 64 t))

; tactics: the axioms' indices by block, the instance of a source's sequent, the expansion of an
; arrow into a product, the unfolding of a definition, the proof by normalization, and the proof
; of a sequent, or the normalization of a theorem's left side, added to a development
(def beforeTerminal (length categoryAxioms))
(def beforeProduct (add beforeTerminal (length terminalAxioms)))
(def beforeExponential
  (add beforeProduct
    (add (length productAxioms)
      (add (length equalizerAxioms)
        (add (length initialAxioms) (add (length coproductAxioms) (length coequalizerAxioms)))))))
(def beforeNat (add beforeExponential (add (length exponentialAxioms) (length classifierAxioms))))
(def beforeList (add beforeNat (length natAxioms)))
(defn pInst ((s T) (σ Ts)) PM
  (pmBind (srcSeq s) (lam ((a T))
    (pmBind (pmMapM typeTerm σ) (lam ((tysN T))
      (let tys Ts (children tysN)
        (pmBind (pmMapM (proveHyp typePattern tys) (seqHyps a)) (lam ((hs T))
          (pmPure (node 0 (l2 (eqSubst σ (seqConcl a))
                            (srcCert s σ (mapT tyDfd tys) (children hs)))))))))))))
(defn etaExpand ((f T)) PM
  (pmBind (typeTerm f) (lam ((ty T))
    (let h T (tyHi ty)
      (if (and (eq (label h) 7) (eq (length (children h)) 2))
          (pmBind (pInst (srcAx (add beforeProduct 11)) (l3 f (at (children h) 0) (at (children h) 1)))
            (lam ((qc T))
              (pmPure (node 0 (l2 (eqLhs (at (children qc) 0)) (cSymm (at (children qc) 1)))))))
          pmFail)))))
(defn rwAx ((j T)) T (rwRule (srcAx j) 0 (node 0 (nil T))))
(defn rwThm ((j T)) T (rwRule (srcThm j) 0 (node 0 (nil T))))
(defn deltaRule ((i T)) T (rwAx (defAxIdx i)))
(defn pByNorm ((rules Ts) (q T)) PM
  (pmBind (pNormalize rules (eqLhs q)) (lam ((l T))
    (pmBind (pNormalize rules (eqRhs q)) (lam ((r T))
      (pmBind (pmGuard (equal (at (children l) 0) (at (children r) 0))) (lam ((u T))
        (pmPure (cTrans (at (children l) 1) (cSymm (at (children r) 1)))))))))))
(defn proveSeq ((a T) (m PM) (defs Ts) (infer T) (dev Ts)) T
  (bindO (pmRun (scope (node 0 (seqCtx a)) (node 0 (seqHyps a))) dev m defs infer) (lam ((r T))
    (let dev1 Ts (children (at (children r) 1))
      (some (node 0 (l2 (length dev1)
                        (node 0 (append dev1 (single (node 0 (l2 a (at (children r) 0)))))))))))))
(defn normalizeThm ((rules Ts) (j T) (defs Ts) (infer T) (dev Ts)) T
  (bindO (nth dev j) (lam ((e T))
    (let a T (at (children e) 0)
      (let sc T (scope (node 0 (seqCtx a)) (node 0 (seqHyps a)))
        (bindO (pmRun sc dev (pNormalize rules (eqLhs (seqConcl a))) defs infer) (lam ((r T))
          (let nc T (at (children r) 0)
            (let dev1 Ts (children (at (children r) 1))
              (some (node 0 (l2 (length dev1)
                                (node 0 (append dev1
                                          (single (node 0 (l2 (scSeq sc (eqn (at (children nc) 0)
                                                                          (eqRhs (seqConcl a))))
                                                            (cTrans (cSymm (at (children nc) 1))
                                                              (scCite sc j)))))))))))))))))))

; induction: the instance of a source's sequent whose equations between arrows are proved by
; normalization, the certificate of an equation's rewriting inside a term, and the proofs of
; equations between arrows from the natural numbers object and from list objects
(defn instBy ((rules Ts) (s T) (σ Ts)) PM
  (pmBind (srcSeq s) (lam ((a T))
    (pmBind (pmMapM typeTerm σ) (lam ((tysN T))
      (let tys Ts (children tysN)
        (pmBind (pmMapM (lam ((h T)) (pmOr (proveHyp typePattern tys h) (pByNorm rules (eqSubst σ h))))
                  (seqHyps a))
          (lam ((hs T))
            (pmPure (node 0 (l2 (eqSubst σ (seqConcl a))
                              (srcCert s σ (mapT tyDfd tys) (children hs)))))))))))))
(defn congStep ((e T) (ce T) (nd T) (rs (List BF))) BF
  (lam ((t T))
    (pmBind (typeTerm nd) (lam ((ty T))
      (if (equal nd t) (pmPure (tyDfd ty))
        (if (and (equal nd (eqLhs e)) (equal t (eqRhs e))) (pmPure ce)
          (if (eq (tySort ty) Sorts.obj)
              (pmBind (typeTerm t) (lam ((yt T)) (objEq ty yt)))
            (if (or (eq (label nd) 0)
                  (or (not (eq (label t) (label nd)))
                    (not (eq (length (children t)) (length (children nd))))))
                pmFail
              (pmBind (bridgeKids rs (children t)) (lam ((cs T))
                (pmPure (cCong (tyDfd ty) (children cs)))))))))))))
(defn congBy ((e T) (ce T) (s T) (t T)) PM (para BF (congStep e ce) s t))
(defn natRecUniq ((rules Ts) (z T) (s T) (f T)) PM
  (pmBind (instBy rules (srcAx (add beforeNat 12)) (l3 z s f)) (lam ((qc T))
    (pmPure (at (children qc) 1)))))
(defn listRecUniq ((rules Ts) (a T) (z T) (s T) (f T)) PM
  (pmBind (instBy rules (srcAx (add beforeList 13)) (l4 a z s f)) (lam ((qc T))
    (pmPure (at (children qc) 1)))))
(defn byNatInduction ((rules Ts) (z T) (s T) (q T)) PM
  (pmBind (natRecUniq rules z s (eqLhs q)) (lam ((cl T))
    (pmBind (natRecUniq rules z s (eqRhs q)) (lam ((cr T)) (pmPure (cTrans cl (cSymm cr))))))))
(defn byListInduction ((rules Ts) (a T) (z T) (s T) (q T)) PM
  (pmBind (listRecUniq rules a z s (eqLhs q)) (lam ((cl T))
    (pmBind (listRecUniq rules a z s (eqRhs q)) (lam ((cr T)) (pmPure (cTrans cl (cSymm cr))))))))
(defn byListParamInduction ((rules Ts) (a T) (z T) (s T) (q T)) PM
  (pmBind (typeTerm (eqLhs q)) (lam ((ty T))
    (let lo T (tyLo ty)
      (if (and (eq (label lo) 7) (eq (length (children lo)) 2))
          (let l T (at (children lo) 0)
            (let p T (at (children lo) 1)
              (let b T (tyHi ty)
                (let e T (exp p b)
                  (let ae T (prod a e)
                    (let z1 T (curry one p (comp z (cSnd one p)))
                      (let s1 T (curry ae p
                                  (comp s (cPair (cPair (comp (cFst a e) (cFst ae p))
                                                   (comp (ev p b) (cPair (comp (cSnd a e) (cFst ae p))
                                                                    (cSnd ae p))))
                                            (cSnd ae p))))
                        (let cf T (curry l p (eqLhs q))
                          (let cg T (curry l p (eqRhs q))
                            (pmBind (byListInduction rules a z1 s1 (eqn cf cg)) (lam ((cc T))
                              (pmBind (pInst (srcAx (add beforeExponential 7)) (l3 l p (eqLhs q)))
                                (lam ((bfp T))
                                  (pmBind (pInst (srcAx (add beforeExponential 7)) (l3 l p (eqRhs q)))
                                    (lam ((bgp T))
                                      (pmBind (congBy (eqn cf cg) cc (eqLhs (at (children bfp) 0))
                                                (eqLhs (at (children bgp) 0)))
                                        (lam ((mid T))
                                          (pmPure (cTrans (cSymm (at (children bfp) 1))
                                                    (cTrans mid (at (children bgp) 1)))))))))))))))))))))
          pmFail)))))

; the library: the rules from the axioms, the derived equations with their proofs, and its
; development, the indices of the derived equations the node of label 0 over them
(def baseRules
  (cons (rwRule (srcAx 7) 1 (node 0 (nil T)))
    (cons (rwAx 10)
      (cons (rwAx 11)
        (cons (rwAx (add beforeProduct 9))
          (cons (rwAx (add beforeProduct 10))
            (cons (rwAx (add beforeProduct 11))
              (cons (rwRule (srcAx (add beforeTerminal 3)) 0 (node 0 (l2 3 6)))
                (cons (rwAx (add beforeNat 10))
                  (cons (rwAx (add beforeNat 11))
                    (l2 (rwAx (add beforeList 11)) (rwAx (add beforeList 12)))))))))))))
(def compPairSeq
  (mkSeq (l3 Sorts.arr Sorts.arr Sorts.arr)
    (l2 (eqn (dom (x 1)) (dom (x 0))) (eqn (cod (x 2)) (dom (x 0))))
    (eqn (comp (cPair (x 0) (x 1)) (x 2)) (cPair (comp (x 0) (x 2)) (comp (x 1) (x 2))))))
(def pairFstSndSeq
  (mkSeq (l2 Sorts.obj Sorts.obj) (nil T)
    (eqn (cPair (cFst (x 0) (x 1)) (cSnd (x 0) (x 1))) (idt (prod (x 0) (x 1))))))
(def evCurrySeq
  (mkSeq (l5 Sorts.obj Sorts.obj Sorts.arr Sorts.arr Sorts.arr)
    (l4 (eqn (dom (x 2)) (prod (x 0) (x 1))) (eqn (cod (x 3)) (x 0)) (eqn (cod (x 4)) (x 1))
      (eqn (dom (x 4)) (dom (x 3))))
    (eqn (comp (ev (x 1) (cod (x 2))) (cPair (comp (curry (x 0) (x 1) (x 2)) (x 3)) (x 4)))
      (comp (x 2) (cPair (x 3) (x 4))))))
(def evCurry0Seq
  (mkSeq (l4 Sorts.obj Sorts.obj Sorts.arr Sorts.arr)
    (l3 (eqn (dom (x 2)) (prod (x 0) (x 1))) (eqn (cod (x 3)) (x 1)) (eqn (dom (x 3)) (x 0)))
    (eqn (comp (ev (x 1) (cod (x 2))) (cPair (curry (x 0) (x 1) (x 2)) (x 3)))
      (comp (x 2) (cPair (idt (x 0)) (x 3))))))
(def curryNatSeq
  (mkSeq (l4 Sorts.obj Sorts.obj Sorts.arr Sorts.arr)
    (l2 (eqn (dom (x 2)) (prod (x 0) (x 1))) (eqn (cod (x 3)) (x 0)))
    (eqn (comp (curry (x 0) (x 1) (x 2)) (x 3))
      (curry (dom (x 3)) (x 1) (comp (x 2) (prodMapLeft (x 3) (x 1)))))))
(def bangOneSeq (mkSeq (nil T) (nil T) (eqn (bang one) (idt one))))
(defn seqLhs ((a T)) T (eqLhs (seqConcl a)))
(defn seqRhs ((a T)) T (eqRhs (seqConcl a)))
(def compPairProof
  (pmBind (etaExpand (seqLhs compPairSeq)) (lam ((ec T))
    (pmBind (pNormalize baseRules (at (children ec) 0)) (lam ((nc T))
      (pmBind (pmGuard (equal (at (children nc) 0) (seqRhs compPairSeq))) (lam ((u T))
        (pmPure (cTrans (at (children ec) 1) (at (children nc) 1))))))))))
(def pairFstSndProof
  (let p T (prod (x 0) (x 1))
    (pmBind (pInst (srcAx (add beforeProduct 11)) (l3 (idt p) (x 0) (x 1))) (lam ((qc T))
      (pmBind (pNormalize baseRules (eqLhs (at (children qc) 0))) (lam ((nc T))
        (pmBind (pmGuard (equal (at (children nc) 0) (seqLhs pairFstSndSeq))) (lam ((u T))
          (pmPure (cTrans (cSymm (at (children nc) 1)) (at (children qc) 1)))))))))))
(defn evCurryProof ((cp T)) PM
  (let rs Ts (append baseRules (single (rwThm cp)))
    (pmBind (pInst (srcAx (add beforeExponential 7)) (l3 (x 0) (x 1) (x 2))) (lam ((qc T))
      (let gh T (cPair (x 3) (x 4))
        (let u T (comp (eqLhs (at (children qc) 0)) gh)
          (pmBind (pNormalize rs u) (lam ((nu T))
            (pmBind (pNormalize rs (seqLhs evCurrySeq)) (lam ((ng T))
              (pmBind (pmGuard (equal (at (children nu) 0) (at (children ng) 0))) (lam ((u0 T))
                (pmBind (typeTerm u) (lam ((du T))
                  (pmBind (typeTerm gh) (lam ((dg T))
                    (pmPure (cTrans (cTrans (at (children ng) 1) (cSymm (at (children nu) 1)))
                              (cCong (tyDfd du) (l2 (at (children qc) 1) (tyDfd dg)))))))))))))))))))))
(defn evCurry0Proof ((ec T)) PM
  (pmBind (pInst (srcThm ec) (l5 (x 0) (x 1) (x 2) (idt (x 0)) (x 3))) (lam ((qc T))
    (let q T (at (children qc) 0)
      (pmBind (pNormalize baseRules (eqLhs q)) (lam ((nc T))
        (pmBind (pmGuard (and (equal (at (children nc) 0) (seqLhs evCurry0Seq))
                           (equal (eqRhs q) (seqRhs evCurry0Seq))))
          (lam ((u T))
            (pmPure (cTrans (cSymm (at (children nc) 1)) (at (children qc) 1)))))))))))
(defn curryNatProof ((cp T) (ec T)) PM
  (let rs Ts (append baseRules (l2 (rwThm cp) (rwThm ec)))
    (let k T (seqLhs curryNatSeq)
      (pmBind (pInst (srcAx (add beforeExponential 8)) (l4 (dom (x 3)) (x 1) (cod (x 2)) k))
        (lam ((qc T))
          (pmBind (pNormalize rs (eqLhs (at (children qc) 0))) (lam ((nc T))
            (pmBind (pNormalize rs (seqRhs curryNatSeq)) (lam ((rc T))
              (pmBind (pmGuard (equal (at (children nc) 0) (at (children rc) 0))) (lam ((u T))
                (pmPure (cTrans (cSymm (at (children qc) 1))
                          (cTrans (at (children nc) 1) (cSymm (at (children rc) 1))))))))))))))))
(def bangOneProof
  (pmBind (pInst (srcAx (add beforeTerminal 3)) (single (idt one))) (lam ((qc T))
    (pmBind (pNormalize baseRules (eqRhs (at (children qc) 0))) (lam ((nc T))
      (pmBind (pmGuard (equal (at (children nc) 0) (bang one))) (lam ((u T))
        (pmPure (cSymm (cTrans (at (children qc) 1) (at (children nc) 1)))))))))))
(defn libraryWith ((infer T)) T
  (bindO (proveSeq compPairSeq compPairProof (nil T) infer (nil T)) (lam ((r1 T))
    (let cp T (at (children r1) 0)
      (bindO (proveSeq pairFstSndSeq pairFstSndProof (nil T) infer (children (at (children r1) 1)))
        (lam ((r2 T))
          (let pf T (at (children r2) 0)
            (bindO (proveSeq evCurrySeq (evCurryProof cp) (nil T) infer (children (at (children r2) 1)))
              (lam ((r3 T))
                (let ec T (at (children r3) 0)
                  (bindO (proveSeq evCurry0Seq (evCurry0Proof ec) (nil T) infer
                           (children (at (children r3) 1)))
                    (lam ((r4 T))
                      (let e0 T (at (children r4) 0)
                        (bindO (proveSeq curryNatSeq (curryNatProof cp ec) (nil T) infer
                                 (children (at (children r4) 1)))
                          (lam ((r5 T))
                            (let cn T (at (children r5) 0)
                              (bindO (proveSeq bangOneSeq bangOneProof (nil T) infer
                                       (children (at (children r5) 1)))
                                (lam ((r6 T))
                                  (some (node 0 (l2 (node 0 (l6 cp pf ec e0 cn (at (children r6) 0)))
                                                    (at (children r6) 1))))))))))))))))))))))
(defn libRules ((i T)) Ts
  (append baseRules
    (l5 (rwThm (at (children i) 0)) (rwThm (at (children i) 1)) (rwThm (at (children i) 4))
      (rwThm (at (children i) 3)) (rwThm (at (children i) 5)))))
