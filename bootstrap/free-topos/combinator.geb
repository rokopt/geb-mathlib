;
; The prover of the theory of an elementary topos, written in the datatype language, computing
; as Geb.FreeTopos.Prover computes: the typing of terms from the axioms, the rewriting of terms
; by rules from the axioms and the development's theorems, normalization, the proofs by
; normalization and induction, and the library's development. The prover runs in a scope and a
; state: a computation is a function from a scope and a state to the optional pair of its
; value and the state after it. Its result and composition are generic in the value types. A
; scope holds its variables' sorts and its hypotheses; a state the development's entries, each a
; sequent with its certificate, the terms typed so far with their typings and the terms
; normalized so far with their normal forms, each table the latest first, the definitions in
; force, the extended signature, and whether the typing is certified by the checker's oracle
; rules; a typing a term, its sort, its definedness certificate, its lower bound with its
; certificate and its upper bound with its certificate.

(module Combinator
  (export cRefl cTrans scope lookup MF matchKids matchPat bridge applyRule pByNorm proveSeq
    normalizeThm
    byNatInduction
    byListInduction
    byListParamInduction
    libraryWith
    libRules
    cAx
    cHyp
    cCong
    cSymm
    cStrict
    PhScope
    PSt
    PTy
    pty
    tyT
    tySort
    tyDfd
    tyLo
    tyLoC
    pty0
    PTys
    ptysOf
    Pairs
    pairs
    pairsOf
    PairM
    TreeM
    TypingM
    PatTy
    Typers
    EqnCert
    ecEqn
    ecCert
    EqnCertM
    typeOpTy
    typeOp
    typeVar
    typeTerm
    seqY
    seqP
    memoRet
    pmGuard
    pmStart
    DevEntry
    devEntry
    stDev
    addLemma
    pInst
    srcAx
    baseRules
    rewriteRoot
    beforeProduct
    beforeExponential)
  (import Prelude)
  (import Base)
  (import PartialHorn)
  (import Theory)
  (import Infer)
  (import Language)
  (import Prover)

  ; certificates, as Geb.PartialHorn.Cert builds them
  (defn cHyp ((i T)) T (node PRule.hyp (single (node i (nil T)))))
  (defn cRefl ((i T)) T (node PRule.refl (single (node i (nil T)))))
  (defn cSymm ((p T)) T (node PRule.symm (single p)))
  (defn cTrans ((p T) (q T)) T (node PRule.trans (l2 p q)))
  (defn cCong ((d T) (ps Ts)) T (node PRule.cong (cons d ps)))
  (defn cStrict ((j T) (p T)) T (node PRule.strict (l2 (node j (nil T)) p)))
  (defn cAx ((j T) (ts Ts) (ds Ts) (hs Ts)) T
    (node PRule.ax (cons (node j (nil T)) (append ts (append ds hs)))))
  (defn cThm ((j T) (ts Ts) (ds Ts) (hs Ts)) T
    (node PRule.thm (cons (node j (nil T)) (append ts (append ds hs)))))
  (defnum PRule.typed 9)
  (defnum PRule.objEq 10)
  (data Certs (certs & T))
  (defn certsOf ((c Certs)) Ts (case c ((certs & xs) xs)))

  ; scopes: the variables' sorts and the hypotheses
  (data PhScope (scope SortList EqnList))
  (defn scCtx ((sc PhScope)) Ts (case sc ((scope c h) (case c ((sorts & xs) xs)))))
  (defn scHyps ((sc PhScope)) (List Eqn) (case sc ((scope c h) (case h ((eqns & xs) xs)))))
  (defn scSeq ((sc PhScope) (q Eqn)) Sequent (mkSeq (scCtx sc) (scHyps sc) q))
  (defn scCite ((sc PhScope) (j T)) T
    (let n T (length (scCtx sc))
      (cThm j (mapT phVar (range n)) (mapT cRefl (range n))
        (mapT cHyp (range (Seq.length Eqn (scHyps sc)))))))

  ; typings
  (data PTy (pty T T T T T T T))

  (data PTys (ptys & PTy))
  (defn ptysOf ((ys PTys)) (List PTy) (case ys ((ptys & xs) xs)))
  (defn tyT ((y PTy)) T (case y ((pty t s d l lc h hc) t)))
  (defn tySort ((y PTy)) T (case y ((pty t s d l lc h hc) s)))
  (defn tyDfd ((y PTy)) T (case y ((pty t s d l lc h hc) d)))
  (defn tyLo ((y PTy)) T (case y ((pty t s d l lc h hc) l)))
  (defn tyLoC ((y PTy)) T (case y ((pty t s d l lc h hc) lc)))
  (defn tyHi ((y PTy)) T (case y ((pty t s d l lc h hc) h)))
  (defn tyHiC ((y PTy)) T (case y ((pty t s d l lc h hc) hc)))
  (def pty0 (pty 0 0 0 0 0 0 0))

  ; states: the development's entries, the tables of typings and of normal forms, the latest
  ; first, the definitions in force, the extended signature, and whether the typing is inferred
  (data DevEntry (devEntry Sequent T))

  (defn devSeq ((e DevEntry)) Sequent (case e ((devEntry a c) a)))
  (data DevList (devs & DevEntry))
  (data MemoEntry (memoEntry T PTy))
  (data MemoList (memos & MemoEntry))
  (data Pairs (pairs & TPair))
  (defn pairsOf ((ps Pairs)) (List TPair) (case ps ((pairs & xs) xs)))
  (data NfEntry (nfEntry T TPair))
  (data NfList (nfList & NfEntry))
  (data PSt (pst DevList MemoList NfList PDefnList OpSigList T))
  (defn stDev ((st PSt)) (List DevEntry) (case st ((pst v m f d s i) (case v ((devs & xs) xs)))))
  (defn stMemo ((st PSt)) (List MemoEntry) (case st ((pst v m f d s i) (case m ((memos & xs) xs)))))
  (defn stNfs ((st PSt)) (List NfEntry) (case st ((pst v m f d s i) (case f ((nfList & xs) xs)))))
  (defn stDefs ((st PSt)) (List PDefn) (case st ((pst v m f d s i) (case d ((pdefns & xs) xs)))))
  (defn stSig ((st PSt)) (List OpSig) (case st ((pst v m f d s i) (case s ((opSigs & xs) xs)))))
  (defn stInfer ((st PSt)) T (case st ((pst v m f d s i) i)))
  (defn withDev ((st PSt) (v (List DevEntry))) PSt
    (case st ((pst v0 m f d s i) (pst (devs v) m f d s i))))
  (defn withMemo ((st PSt) (m (List MemoEntry))) PSt
    (case st ((pst v m0 f d s i) (pst v (memos m) f d s i))))
  (defn withNfs ((st PSt) (f (List NfEntry))) PSt
    (case st ((pst v m f0 d s i) (pst v m (nfList f) d s i))))
  ; the value of a key in a table, the latest first
  (defn memoFind ((tb (List MemoEntry)) (k T)) (Option.Maybe PTy)
    (foldr MemoEntry (Option.Maybe PTy)
      (lam ((e MemoEntry) (acc (Option.Maybe PTy)))
        (case e ((memoEntry k1 v) (if (equal k1 k) (Option.just PTy v) acc))))
      (Option.nothing PTy)
      tb))
  (defn nfFind ((tb (List NfEntry)) (k T)) (Option.Maybe TPair)
    (foldr NfEntry (Option.Maybe TPair)
      (lam ((e NfEntry) (acc (Option.Maybe TPair)))
        (case e ((nfEntry k1 v) (if (equal k1 k) (Option.just TPair v) acc))))
      (Option.nothing TPair)
      tb))

  ; the prover's computations at each type of values, and their compositions: a computation
  ; with a computation from its value, the state, a guard, and the values of computations from
  ; a list's elements, or of a list's computations, in turn
  (data EqnCert (eqnCert Eqn T))
  (defn ecEqn ((q EqnCert)) Eqn (case q ((eqnCert e c) e)))
  (defn ecCert ((q EqnCert)) T (case q ((eqnCert e c) c)))
  (data Assoc (assoc T T T T))
  (module Comp (export Res res Out bad ok pure fail orElse bind) (data (Res V) (res V PSt))
    (data (Out V) (bad) (ok (Res V)))
    (defn (pure V) ((v V) (sc PhScope) (st PSt)) (Out V) (ok V (res V v st)))
    (defn (fail V) ((sc PhScope) (st PSt)) (Out V) (bad V))
    (defn (orElse V)
      ((a (Arrow PhScope (Arrow PSt (Out V)))) (b (Arrow PhScope (Arrow PSt (Out V)))) (sc PhScope)
       (st PSt))
      (Out V)
      (let r (Out V) (a sc st) (case r ((ok V q) r) ((bad V) (b sc st)))))
    (defn (bind A B)
      ((m (Arrow PhScope (Arrow PSt (Out A)))) (k (Arrow A (Arrow PhScope (Arrow PSt (Out B)))))
       (sc PhScope)
       (st PSt))
      (Out B)
      (case (m sc st) ((ok A r) (case r ((res A v s) (k v sc s)))) ((bad A) (bad B)))))
  (deftype TreeM (Arrow PhScope (Arrow PSt (Comp.Out T))))
  (deftype TypingM (Arrow PhScope (Arrow PSt (Comp.Out PTy))))
  (deftype SequentM (Arrow PhScope (Arrow PSt (Comp.Out Sequent))))
  (deftype PairM (Arrow PhScope (Arrow PSt (Comp.Out TPair))))
  (deftype EqnCertM (Arrow PhScope (Arrow PSt (Comp.Out EqnCert))))
  (deftype CertsM (Arrow PhScope (Arrow PSt (Comp.Out Certs))))
  (deftype TypingsM (Arrow PhScope (Arrow PSt (Comp.Out PTys))))
  (deftype PairsM (Arrow PhScope (Arrow PSt (Comp.Out Pairs))))
  (deftype MaybeTypingM (Arrow PhScope (Arrow PSt (Comp.Out (Option.Maybe PTy)))))
  (deftype MaybePairM (Arrow PhScope (Arrow PSt (Comp.Out (Option.Maybe TPair)))))
  (deftype AssocM (Arrow PhScope (Arrow PSt (Comp.Out Assoc))))

  (defn pmGet ((sc PhScope) (st PSt)) (Comp.Out PSt) (Comp.ok PSt (Comp.res PSt st st)))
  (defn pmGuard ((b T)) TreeM
    (lam ((sc PhScope) (st PSt)) (if b (Comp.ok T (Comp.res T 0 st)) (Comp.bad T))))
  (defn mapMEqC ((f (Arrow Eqn TreeM)) (xs (List Eqn))) CertsM
    (foldr Eqn CertsM
      (lam ((x Eqn) (acc CertsM))
        (Comp.bind T Certs (f x)
          (lam ((y T))
            (Comp.bind Certs Certs acc
              (lam ((ys Certs)) (Comp.pure Certs (certs (cons y (certsOf ys)))))))))
      (Comp.pure Certs (certs (nil T)))
      xs))
  (defn mapMPairC ((f (Arrow TPair TreeM)) (xs (List TPair))) CertsM
    (foldr TPair CertsM
      (lam ((x TPair) (acc CertsM))
        (Comp.bind T Certs (f x)
          (lam ((y T))
            (Comp.bind Certs Certs acc
              (lam ((ys Certs)) (Comp.pure Certs (certs (cons y (certsOf ys)))))))))
      (Comp.pure Certs (certs (nil T)))
      xs))
  (defn mapMTY ((f (Arrow T TypingM)) (xs Ts)) TypingsM
    (foldr T TypingsM
      (lam ((x T) (acc TypingsM))
        (Comp.bind PTy PTys (f x)
          (lam ((y PTy))
            (Comp.bind PTys PTys acc
              (lam ((ys PTys)) (Comp.pure PTys (ptys (cons y (ptysOf ys)))))))))
      (Comp.pure PTys (ptys (nil PTy)))
      xs))
  (defn seqY ((ms (List TypingM))) TypingsM
    (foldr TypingM TypingsM
      (lam ((m TypingM) (acc TypingsM))
        (Comp.bind PTy PTys m
          (lam ((y PTy))
            (Comp.bind PTys PTys acc
              (lam ((ys PTys)) (Comp.pure PTys (ptys (cons y (ptysOf ys)))))))))
      (Comp.pure PTys (ptys (nil PTy)))
      ms))
  (defn seqP ((ms (List PairM))) PairsM
    (foldr PairM PairsM
      (lam ((m PairM) (acc PairsM))
        (Comp.bind TPair Pairs m
          (lam ((y TPair))
            (Comp.bind Pairs Pairs acc
              (lam ((ys Pairs)) (Comp.pure Pairs (pairs (cons y (pairsOf ys)))))))))
      (Comp.pure Pairs (pairs (nil TPair)))
      ms))
  ; the index of the first hypothesis passing a test, or nothing
  (defn findIdx ((f (Arrow Eqn T)) (xs (List Eqn))) T
    (snd
      (foldr Eqn (Prod T T)
        (lam ((x Eqn) (s (Prod T T)))
          (pair (sub (fst s) 1) (if (f x) (some (sub (fst s) 1)) (snd s))))
        (pair (Seq.length Eqn xs) none)
        xs)))

  ; typing: the axioms of the extension by the definitions in force, lemmas, the table of typings,
  ; and the certificates of definedness and of equations between objects
  (def seq0 (mkSeq (nil T) (nil Eqn) (eqn 0 0)))
  (def pdefn0 (pdefn (sorts (nil T)) 0 0))
  (defn axiomAt ((j T)) SequentM
    (if (lt j (Seq.length Sequent axioms)) (Comp.pure Sequent (Seq.atOr Sequent seq0 axioms j))
      (Comp.bind PSt Sequent pmGet
        (lam ((st PSt))
          (let*
            ((r T (sub j (Seq.length Sequent axioms)))
             (md (Option.Maybe PDefn) (Option.nthOf PDefn (stDefs st) (div r 2))))
            (if (Option.isJust PDefn md)
              (let ma (Option.Maybe Sequent)
                (Option.nthOf Sequent
                  (pdAxioms (add (Seq.length OpSig sig) (div r 2))
                    (Option.fromMaybe PDefn pdefn0 md))
                  (mod r 2))
                (if (Option.isJust Sequent ma)
                  (Comp.pure Sequent (Option.fromMaybe Sequent seq0 ma))
                  (Comp.fail Sequent)))
              (Comp.fail Sequent)))))))
  (defn addLemma ((q Eqn) (c T)) TreeM
    (lam ((sc PhScope) (st PSt))
      (Comp.ok T
        (Comp.res T (scCite sc (Seq.length DevEntry (stDev st)))
          (withDev st
            (Seq.append DevEntry (stDev st) (Seq.single DevEntry (devEntry (scSeq sc q) c))))))))
  (defn lookup ((t T)) MaybeTypingM
    (lam ((sc PhScope) (st PSt))
      (Comp.ok (Option.Maybe PTy) (Comp.res (Option.Maybe PTy) (memoFind (stMemo st) t) st))))
  (defn memoize ((y PTy)) TreeM
    (lam ((sc PhScope) (st PSt))
      (Comp.ok T (Comp.res T 0 (withMemo st (cons (memoEntry (tyT y) y) (stMemo st)))))))
  (defn memoRet ((y PTy)) TypingM (Comp.bind T PTy (memoize y) (lam ((u T)) (Comp.pure PTy y))))
  (defn dfdCert ((t T) (c T)) TreeM
    (lam ((sc PhScope) (st PSt))
      (if (stInfer st) (Comp.ok T (Comp.res T (node PRule.typed (single t)) st))
        (addLemma (dfd t) c sc st))))
  (defn eqCert ((q Eqn) (c T)) TreeM
    (lam ((sc PhScope) (st PSt))
      (if (stInfer st) (Comp.ok T (Comp.res T (node PRule.objEq (l2 (eqLhs q) (eqRhs q))) st))
        (addLemma q c sc st))))
  (defn objEq ((l PTy) (r PTy)) TreeM
    (lam ((sc PhScope) (st PSt))
      (if (and (eq (tySort l) Sorts.obj) (and (eq (tySort r) Sorts.obj) (equal (tyLo l) (tyLo r))))
        (Comp.ok T
          (Comp.res T
            (if (stInfer st) (node PRule.objEq (l2 (tyT l) (tyT r)))
              (cTrans (tyLoC l) (cSymm (tyLoC r))))
            st))
        (Comp.bad T))))

  ; the typing of an axiom's side instantiated at typed arguments
  (deftype PatTy (Arrow (List PTy) (Arrow T TypingM)))
  (defn proveHyp ((pt PatTy) (tys (List PTy)) (h Eqn)) TreeM
    (Comp.bind PTy T (pt tys (eqLhs h))
      (lam ((l PTy))
        (if (equal (eqLhs h) (eqRhs h)) (Comp.pure T (tyDfd l))
          (Comp.bind PTy T (pt tys (eqRhs h)) (lam ((r PTy)) (objEq l r)))))))
  ; the canonical bound of an application of operation k by the axiom j, with its certificate
  (defn pBound ((pt PatTy) (tys (List PTy)) (k T) (j T) (d T)) PairM
    (Comp.bind Sequent TPair (axiomAt j)
      (lam ((a Sequent))
        (Comp.bind Certs TPair
          (mapMEqC
            (lam ((h Eqn))
              (if (equal (rep h) (rep (dfd (opVars k (Seq.length PTy tys))))) (Comp.pure T d)
                (proveHyp pt tys h)))
            (seqHyps a))
          (lam ((hs Certs))
            (let q T (cAx j (Map.map PTy T tyT tys) (Map.map PTy T tyDfd tys) (certsOf hs))
              (Comp.bind PTy TPair (pt tys (eqRhs (seqConcl a)))
                (lam ((r PTy)) (Comp.pure TPair (pr (tyLo r) (cTrans q (tyLoC r))))))))))))
  ; the typing of an application of the definition at position i, of sort s
  (defn typeDefined ((pt PatTy) (i T) (s T) (tys (List PTy))) TypingM
    (Comp.bind PSt PTy pmGet
      (lam ((st PSt))
        (let md (Option.Maybe PDefn) (Option.nthOf PDefn (stDefs st) i)
          (if (Option.isJust PDefn md)
            (let* ((ts Ts (Map.map PTy T tyT tys)) (t T (phOp (add (Seq.length OpSig sig) i) ts)))
              (Comp.bind PTy PTy (pt tys (pdBody (Option.fromMaybe PDefn pdefn0 md)))
                (lam ((b PTy))
                  (Comp.bind PSt PTy pmGet
                    (lam ((st1 PSt))
                      (if (stInfer st1)
                        (let d T (node PRule.typed (single t))
                          (memoRet
                            (if (eq s Sorts.obj)
                              (pty t Sorts.obj d (tyLo b) (node PRule.objEq (l2 t (tyLo b)))
                                (tyLo b)
                                (node PRule.objEq (l2 t (tyLo b))))
                              (pty t Sorts.arr d (tyLo b) (node PRule.objEq (l2 (dom t) (tyLo b)))
                                (tyHi b)
                                (node PRule.objEq (l2 (cod t) (tyHi b)))))))
                        (Comp.bind T PTy
                          (addLemma (eqn t (tyT b))
                            (cAx (defAxIdx i) ts (Map.map PTy T tyDfd tys) (single (tyDfd b))))
                          (lam ((e T))
                            (Comp.bind T PTy (addLemma (dfd t) (cTrans e (cSymm e)))
                              (lam ((d T))
                                (if (eq s Sorts.obj)
                                  (Comp.bind T PTy (addLemma (eqn t (tyLo b)) (cTrans e (tyLoC b)))
                                    (lam ((c T))
                                      (memoRet (pty t Sorts.obj d (tyLo b) c (tyLo b) c))))
                                  (Comp.bind T PTy
                                    (addLemma (eqn (dom t) (tyLo b))
                                      (cTrans
                                        (cCong (cAx 0 (single t) (single d) (nil T)) (single e))
                                        (tyLoC b)))
                                    (lam ((dc T))
                                      (Comp.bind T PTy
                                        (addLemma (eqn (cod t) (tyHi b))
                                          (cTrans
                                            (cCong (cAx 1 (single t) (single d) (nil T)) (single e))
                                            (tyHiC b)))
                                        (lam ((cc T))
                                          (memoRet
                                            (pty t Sorts.arr d (tyLo b) dc (tyHi b)
                                              cc)))))))))))))))))
            (Comp.fail PTy))))))
  ; the certificate of an application's definedness by the rule the table names for operation k
  (defn typeOpDfd ((pt PatTy) (k T) (tys (List PTy))) TreeM
    (let ts Ts (Map.map PTy T tyT tys)
      (case (Option.nthOf (Option.Maybe DfdRule) dfdRules k)
        ((Option.just (Option.Maybe DfdRule) m)
         (case m
           ((Option.just DfdRule rule)
            (case rule
              ((direct j)
               (Comp.bind Sequent T (axiomAt j)
                 (lam ((a Sequent))
                   (Comp.bind Certs T (mapMEqC (proveHyp pt tys) (seqHyps a))
                     (lam ((hs Certs))
                       (Comp.pure T (cAx j ts (Map.map PTy T tyDfd tys) (certsOf hs))))))))
              ((strict j) (Comp.pure T (cStrict 0 (cAx j ts (Map.map PTy T tyDfd tys) (nil T)))))
              ((rhsRule j)
               (let q T (cAx j (nil T) (nil T) (nil T)) (Comp.pure T (cTrans (cSymm q) q))))))
           ((Option.nothing DfdRule) (Comp.fail T))))
        ((Option.nothing (Option.Maybe DfdRule)) (Comp.fail T)))))
  ; the typing of an object t, an application of operation k defined by d, whose canonical form is
  ; the operation applied to its arguments' canonical forms
  (defn typeOpObj ((k T) (t T) (d T) (tys (List PTy))) TypingM
    (let c T
      (phOp k (Map.map PTy T (lam ((y PTy)) (if (eq (tySort y) Sorts.obj) (tyLo y) (tyT y))) tys))
      (if (equal c t) (Comp.pure PTy (pty t Sorts.obj d t d t d))
        (Comp.bind T PTy
          (eqCert (eqn t c)
            (cCong d
              (Map.map PTy T (lam ((y PTy)) (if (eq (tySort y) Sorts.obj) (tyLoC y) (tyDfd y)))
                tys)))
          (lam ((e T)) (Comp.pure PTy (pty t Sorts.obj d c e c e)))))))
  ; the typing of an application of operation k of sort s, defined by d
  (defn typeOpTy ((pt PatTy) (k T) (s T) (t T) (d T) (tys (List PTy))) TypingM
    (if (eq s Sorts.obj)
      (cond
        ((and (eq k 0) (eq (Seq.length PTy tys) 1))
         (let f PTy (Seq.atOr PTy pty0 tys 0)
           (Comp.pure PTy (pty t Sorts.obj d (tyLo f) (tyLoC f) (tyLo f) (tyLoC f)))))
        ((and (eq k 1) (eq (Seq.length PTy tys) 1))
         (let f PTy (Seq.atOr PTy pty0 tys 0)
           (Comp.pure PTy (pty t Sorts.obj d (tyHi f) (tyHiC f) (tyHi f) (tyHiC f)))))
        (else (typeOpObj k t d tys)))
      (let* ((jd T (nth domRules k)) (jc T (nth codRules k)))
        (if (and (and (isSome jd) (isSome (get jd))) (and (isSome jc) (isSome (get jc))))
          (Comp.bind TPair PTy (pBound pt tys k (get (get jd)) d)
            (lam ((dp TPair))
              (Comp.bind TPair PTy (pBound pt tys k (get (get jc)) d)
                (lam ((cp TPair))
                  (Comp.bind T PTy (eqCert (eqn (dom t) (p1 dp)) (p2 dp))
                    (lam ((de T))
                      (Comp.bind T PTy (eqCert (eqn (cod t) (p1 cp)) (p2 cp))
                        (lam ((ce T))
                          (Comp.pure PTy (pty t Sorts.arr d (p1 dp) de (p1 cp) ce))))))))))
          (Comp.fail PTy)))))
  ; the typing of an application of operation k to terms of the given typings
  (def opSig0 (opSig (sorts (nil T)) 0))
  (defn typeOp ((pt PatTy) (k T) (tys (List PTy))) TypingM
    (Comp.bind PSt PTy pmGet
      (lam ((st PSt))
        (let mo (Option.Maybe OpSig) (Option.nthOf OpSig (stSig st) k)
          (if (Option.isJust OpSig mo)
            (let o OpSig (Option.fromMaybe OpSig opSig0 mo)
              (if (equalTs (Map.map PTy T tySort tys) (opArgs o))
                (if (lt k (Seq.length OpSig sig))
                  (let t T (phOp k (Map.map PTy T tyT tys))
                    (Comp.bind T PTy (typeOpDfd pt k tys)
                      (lam ((dc T))
                        (Comp.bind T PTy (dfdCert t dc)
                          (lam ((d T))
                            (Comp.bind PTy PTy (typeOpTy pt k (opSort o) t d tys) memoRet))))))
                  (typeDefined pt (sub k (Seq.length OpSig sig)) (opSort o) tys))
                (Comp.fail PTy)))
            (Comp.fail PTy))))))
  ; one step of typing: a variable's node by lf, an application by typeOp unless its term, which
  ; term computes from the node, has been typed
  (defn typeStep ((pt PatTy) (lf (Arrow T TypingM)) (term (Arrow T T)) (nd T) (rs (List TypingM)))
    TypingM
    (let l T (label nd)
      (if (eq l 0)
        (if (eq (length (children nd)) 1) (lf (label (at (children nd) 0))) (Comp.fail PTy))
        (Comp.bind (Option.Maybe PTy) PTy (lookup (term nd))
          (lam ((mt (Option.Maybe PTy)))
            (if (Option.isJust PTy mt) (Comp.pure PTy (Option.fromMaybe PTy pty0 mt))
              (Comp.bind PTys PTy (seqY rs)
                (lam ((ys PTys)) (typeOp pt (sub l 1) (ptysOf ys))))))))))
  ; the canonical bound of a variable's domain or codomain: that of the object a hypothesis
  ; equates it with, typed by tt, certified by the oracle's rule when inf holds, or itself
  (def eqn0 (eqn 0 0))
  (defn varSide ((tt (Arrow T TypingM)) (i T) (inf T) (o T) (j T)) PairM
    (lam ((sc PhScope) (st PSt))
      (let*
        ((v T (phOp o (single (phVar i))))
         (mh T (findIdx (lam ((q Eqn)) (equal (eqLhs q) v)) (scHyps sc))))
        (if (isSome mh)
          (let* ((h T (get mh)) (mq (Option.Maybe Eqn) (Option.nthOf Eqn (scHyps sc) h)))
            (if (Option.isJust Eqn mq)
              ((Comp.bind PTy TPair (tt (eqRhs (Option.fromMaybe Eqn eqn0 mq)))
                 (lam ((r PTy))
                   (Comp.pure TPair
                     (pr (tyLo r)
                       (if inf (node PRule.objEq (l2 v (tyLo r))) (cTrans (cHyp h) (tyLoC r)))))))
               sc
               st)
              (Comp.bad TPair)))
          (Comp.ok TPair
            (Comp.res TPair (pr v (cAx j (single (phVar i)) (single (cRefl i)) (nil T))) st))))))
  ; the typing of a variable of the scope
  (defn typeVar ((tt (Arrow T TypingM)) (i T)) TypingM
    (lam ((sc PhScope) (st PSt))
      (let ms T (nth (scCtx sc) i)
        (if (isSome ms)
          (let s T (get ms)
            (cond
              ((eq s Sorts.obj)
               (Comp.ok PTy
                 (Comp.res PTy
                   (pty (phVar i) Sorts.obj (cRefl i) (phVar i) (cRefl i) (phVar i) (cRefl i))
                   st)))
              ((eq s Sorts.arr)
               (let inf T (stInfer st)
                 ((Comp.bind TPair PTy (varSide tt i inf 0 0)
                    (lam ((dp TPair))
                      (Comp.bind TPair PTy (varSide tt i inf 1 1)
                        (lam ((cp TPair))
                          (Comp.pure PTy
                            (pty (phVar i) Sorts.arr (cRefl i) (p1 dp) (p2 dp) (p1 cp) (p2 cp)))))))
                  sc
                  st)))
              (else (Comp.bad PTy))))
          (Comp.bad PTy)))))
  ; the typers: of an axiom's side instantiated at typed arguments, and of a term of the scope, each
  ; typing the instances of axioms' sides it meets by the typers one level below, to eight levels: a
  ; fixed composition of the step, whose uses each have their own decoration
  (deftype Typers (Prod PatTy (Arrow T TypingM)))
  (defn typerStep ((rec Typers)) Typers
    (pair
      (lam ((env (List PTy)) (p T))
        (para TypingM
          (typeStep (fst rec)
            (lam ((i T))
              (let my (Option.Maybe PTy) (Option.nthOf PTy env i)
                (if (Option.isJust PTy my) (Comp.pure PTy (Option.fromMaybe PTy pty0 my))
                  (Comp.fail PTy))))
            (phSubst (Map.map PTy T tyT env)))
          p))
      (lam ((t T)) (para TypingM (typeStep (fst rec) (typeVar (snd rec)) (lam ((u T)) u)) t))))
  (defn typerStep2 ((rec Typers)) Typers (typerStep (typerStep rec)))
  (defn typerStep4 ((rec Typers)) Typers (typerStep2 (typerStep2 rec)))
  (def typers
    (typerStep4
      (typerStep4
        (pair (lam ((env (List PTy)) (p T)) (Comp.fail PTy)) (lam ((t T)) (Comp.fail PTy))))))
  (defn typeTerm ((t T)) TypingM ((snd typers) t))
  (defn typePattern ((env (List PTy)) (p T)) TypingM ((fst typers) env p))
  ; the state in which a computation starts from a development, with definitions in force

  (defn pmStart ((dev (List DevEntry)) (defs (List PDefn)) (infer T)) PSt
    (pst (devs dev) (memos (nil MemoEntry)) (nfList (nil NfEntry)) (pdefns defs)
      (opSigs
        (Seq.append OpSig sig
          (Map.map PDefn OpSig (lam ((d PDefn)) (opSig (sorts (pdCtx d)) (pdSort d))) defs)))
      infer))

  ; rewriting: the sources of rules, a rule as its source, whether it is read from right to left
  ; and the root labels it avoids, and the match of a rule's side against a term, a match's state
  ; the assignment's optional terms and the pairs of objects deferred to their canonical forms
  (data Src (srcAx T) (srcThm T))
  (def dev0 (devEntry seq0 0))
  (defn srcSeq ((s Src)) SequentM
    (case s ((srcAx j) (axiomAt j))
      ((srcThm j)
       (Comp.bind PSt Sequent pmGet
         (lam ((st PSt))
           (let me (Option.Maybe DevEntry) (Option.nthOf DevEntry (stDev st) j)
             (if (Option.isJust DevEntry me)
               (Comp.pure Sequent (devSeq (Option.fromMaybe DevEntry dev0 me)))
               (Comp.fail Sequent))))))))
  (defn srcCert ((s Src) (ts Ts) (ds Ts) (hs Ts)) T
    (case s ((srcAx j) (cAx j ts ds hs)) ((srcThm j) (cThm j ts ds hs))))
  (data Labels (labels & T))
  (data RwRule (rwRule Src T Labels))

  (defn rwSrc ((r RwRule)) Src (case r ((rwRule s f a) s)))
  (defn rwFlip ((r RwRule)) T (case r ((rwRule s f a) f)))
  (defn rwAvoid ((r RwRule)) Ts (case r ((rwRule s f a) (case a ((labels & xs) xs)))))
  (data Opts (opts & T))
  (data MatchSt (matchSt Opts Pairs))

  (defn msSigma ((m MatchSt)) Ts (case m ((matchSt s o) (case s ((opts & xs) xs)))))
  (defn msObjs ((m MatchSt)) (List TPair) (case m ((matchSt s o) (pairsOf o))))
  (defn msDefer ((m MatchSt) (p T) (t T)) MatchSt
    (matchSt (opts (msSigma m)) (pairs (cons (pr p t) (msObjs m)))))
  (defn bindM ((m (Option.Maybe MatchSt)) (f (Arrow MatchSt (Option.Maybe MatchSt))))
    (Option.Maybe MatchSt)
    (case m ((Option.just MatchSt x) (f x)) ((Option.nothing MatchSt) (Option.nothing MatchSt))))
  (deftype MF (Arrow T (Arrow MatchSt (Option.Maybe MatchSt))))
  ; the match of the children's matches against a term's children, in turn
  (defn matchKids ((rs (List MF)) (us Ts) (m MatchSt)) (Option.Maybe MatchSt)
    ((foldr MF (Arrow Ts (Arrow MatchSt (Option.Maybe MatchSt)))
       (lam ((r MF) (k (Arrow Ts (Arrow MatchSt (Option.Maybe MatchSt)))) (vs Ts) (m1 MatchSt))
         (lcase T (Option.Maybe MatchSt) vs (Option.just MatchSt m1)
           (lam ((u T) (rest Ts)) (bindM (r u m1) (lam ((m2 MatchSt)) (k rest m2))))))
       (lam ((vs Ts) (m1 MatchSt)) (Option.just MatchSt m1))
       rs) us m))
  (defn matchStepP ((S (List OpSig)) (ctx Ts) (nd T) (rs (List MF))) MF
    (lam ((t T) (m MatchSt))
      (let l T (label nd)
        (cond
          ((eq l 0)
           (if (eq (length (children nd)) 1)
             (let* ((i T (label (at (children nd) 0))) (mv T (nth (msSigma m) i)))
               (if (isSome mv)
                 (if (isSome (get mv))
                   (cond ((equal (get (get mv)) t) (Option.just MatchSt m))
                     ((equal (nth ctx i) (some Sorts.obj)) (Option.just MatchSt (msDefer m nd t)))
                     (else (Option.nothing MatchSt)))
                   (Option.just MatchSt
                     (matchSt (opts (setAt (msSigma m) i (some t))) (pairs (msObjs m)))))
                 (Option.nothing MatchSt)))
             (Option.nothing MatchSt)))
          ((equal (sortOf S ctx nd) (some Sorts.obj)) (Option.just MatchSt (msDefer m nd t)))
          ((and (eq (label t) l) (eq (length (children t)) (length (children nd))))
           (matchKids rs (children t) m))
          (else (Option.nothing MatchSt))))))
  (defn matchPat ((S (List OpSig)) (ctx Ts) (p T) (t T) (m MatchSt)) (Option.Maybe MatchSt)
    (para MF (matchStepP S ctx) p t m))
  ; the certificate that a term equals the instance of a rule's side at the typed assignment tys
  (deftype BF (Arrow T TreeM))
  (defn bridgeKids ((rs (List BF)) (us Ts)) CertsM
    ((foldr BF (Arrow Ts CertsM)
       (lam ((r BF) (k (Arrow Ts CertsM)) (vs Ts))
         (lcase T CertsM vs (Comp.pure Certs (certs (nil T)))
           (lam ((u T) (rest Ts))
             (Comp.bind T Certs (r u)
               (lam ((y T))
                 (Comp.bind Certs Certs (k rest)
                   (lam ((ys Certs)) (Comp.pure Certs (certs (cons y (certsOf ys)))))))))))
       (lam ((vs Ts)) (Comp.pure Certs (certs (nil T))))
       rs) us))
  (defn bridgeStep ((tys (List PTy)) (nd T) (rs (List BF))) BF
    (lam ((t T))
      (Comp.bind PTy T (typeTerm t)
        (lam ((ty PTy))
          (cond ((equal (phSubst (Map.map PTy T tyT tys) nd) t) (Comp.pure T (tyDfd ty)))
            ((eq (tySort ty) Sorts.obj)
             (Comp.bind PTy T (typePattern tys nd) (lam ((py PTy)) (objEq ty py))))
            ((or (eq (label nd) 0) (not (eq (length (children t)) (length (children nd)))))
             (Comp.fail T))
            (else
              (Comp.bind Certs T (bridgeKids rs (children t))
                (lam ((cs Certs)) (Comp.pure T (cCong (tyDfd ty) (certsOf cs)))))))))))
  (defn bridge ((tys (List PTy)) (p T) (t T)) TreeM (para BF (bridgeStep tys) p t))
  ; one rewriting step at a term's root by a rule: the instance of the rule's other side, with the
  ; certificate of the term's equation with it
  (def ms0 (matchSt (opts (nil T)) (pairs (nil TPair))))
  (defn applyRule ((r RwRule) (t T)) PairM
    (Comp.bind T TPair (pmGuard (not (anyT (lam ((a T)) (eq (label t) a)) (rwAvoid r))))
      (lam ((u0 T))
        (Comp.bind Sequent TPair (srcSeq (rwSrc r))
          (lam ((a Sequent))
            (let*
              ((p T (if (rwFlip r) (eqRhs (seqConcl a)) (eqLhs (seqConcl a))))
               (q T (if (rwFlip r) (eqLhs (seqConcl a)) (eqRhs (seqConcl a)))))
              (Comp.bind PSt TPair pmGet
                (lam ((st PSt))
                  (let mm (Option.Maybe MatchSt)
                    (matchPat (stSig st) (seqCtx a) p t
                      (matchSt (opts (mapT (lam ((c T)) none) (seqCtx a))) (pairs (nil TPair))))
                    (if (Option.isJust MatchSt mm)
                      (let*
                        ((ms MatchSt (Option.fromMaybe MatchSt ms0 mm))
                         (mSigma T (allSomeT (msSigma ms))))
                        (if (isSome mSigma)
                          (let sigma Ts (children (get mSigma))
                            (Comp.bind PTys TPair (mapMTY typeTerm sigma)
                              (lam ((tysN PTys))
                                (let tys (List PTy) (ptysOf tysN)
                                  (Comp.bind Certs TPair
                                    (mapMPairC
                                      (lam ((e TPair))
                                        (Comp.bind PTy T (typePattern tys (p1 e))
                                          (lam ((lo PTy))
                                            (Comp.bind PTy T (typeTerm (p2 e))
                                              (lam ((lu PTy)) (objEq lo lu))))))
                                      (msObjs ms))
                                    (lam ((u1 Certs))
                                      (Comp.bind T TPair (bridge tys p t)
                                        (lam ((b T))
                                          (Comp.bind Certs TPair
                                            (mapMEqC (proveHyp typePattern tys) (seqHyps a))
                                            (lam ((hs Certs))
                                              (let i T
                                                (srcCert (rwSrc r) sigma (Map.map PTy T tyDfd tys)
                                                  (certsOf hs))
                                                (Comp.pure TPair
                                                  (pr (phSubst sigma q)
                                                    (cTrans b
                                                      (if (rwFlip r) (cSymm i) i)))))))))))))))
                          (Comp.fail TPair)))
                      (Comp.fail TPair)))))))))))
  (defn firstRule ((rules (List RwRule)) (t T)) PairM
    (foldr RwRule PairM (lam ((r RwRule) (k PairM)) (Comp.orElse TPair (applyRule r t) k))
      (Comp.fail TPair)
      rules))
  ; the instance of associativity at a term comp a (comp b x)
  (defn assocLeft ((t T)) AssocM
    (if (and (eq (label t) 4) (eq (length (children t)) 2))
      (let* ((a T (at (children t) 0)) (bx T (at (children t) 1)))
        (if (and (eq (label bx) 4) (eq (length (children bx)) 2))
          (let* ((b T (at (children bx) 0)) (x T (at (children bx) 1)))
            (Comp.bind PTy Assoc (typeTerm t)
              (lam ((d PTy))
                (Comp.bind PTy Assoc (typeTerm a)
                  (lam ((ya PTy))
                    (Comp.bind PTy Assoc (typeTerm b)
                      (lam ((yb PTy))
                        (Comp.bind PTy Assoc (typeTerm x)
                          (lam ((yx PTy))
                            (Comp.pure Assoc
                              (assoc a b x
                                (cAx 7 (l3 a b x) (l3 (tyDfd ya) (tyDfd yb) (tyDfd yx))
                                  (single (tyDfd d))))))))))))))
          (Comp.fail Assoc)))
      (Comp.fail Assoc)))
  (defn rewriteRoot ((rules (List RwRule)) (t T)) PairM
    (Comp.orElse TPair (firstRule rules t)
      (Comp.bind Assoc TPair (assocLeft t)
        (lam ((q Assoc))
          (case q
            ((assoc a b x c)
             (Comp.bind TPair TPair (firstRule rules (comp a b))
               (lam ((uc TPair))
                 (Comp.bind PTy TPair (typeTerm (comp (comp a b) x))
                   (lam ((ab PTy))
                     (Comp.bind PTy TPair (typeTerm x)
                       (lam ((yx PTy))
                         (Comp.pure TPair
                           (pr (comp (p1 uc) x)
                             (cTrans c (cCong (tyDfd ab) (l2 (p2 uc) (tyDfd yx))))))))))))))))))
  ; normal forms: the table of the terms normalized so far
  (defn lookupNf ((t T)) MaybePairM
    (lam ((sc PhScope) (st PSt))
      (Comp.ok (Option.Maybe TPair) (Comp.res (Option.Maybe TPair) (nfFind (stNfs st) t) st))))
  (defn memoizeNf ((t T) (n T) (c T)) PairM
    (Comp.bind T TPair (if (equal t n) (Comp.pure T c) (addLemma (eqn t n) c))
      (lam ((c1 T))
        (lam ((sc PhScope) (st PSt))
          (Comp.ok TPair
            (Comp.res TPair (pr n c1) (withNfs st (cons (nfEntry t (pr n c1)) (stNfs st)))))))))
  (deftype NB (Arrow T PairM))
  (def pr0 (pr 0 0))
  (defn normStepP ((rules (List RwRule)) (rec NB) (nd T) (rs (List PairM))) PairM
    (Comp.bind (Option.Maybe TPair) TPair (lookupNf nd)
      (lam ((mr (Option.Maybe TPair)))
        (if (Option.isJust TPair mr) (Comp.pure TPair (Option.fromMaybe TPair pr0 mr))
          (Comp.bind PTy TPair (typeTerm nd)
            (lam ((ty PTy))
              (cond ((eq (tySort ty) Sorts.obj) (Comp.pure TPair (pr (tyLo ty) (tyLoC ty))))
                ((eq (label nd) 0) (Comp.pure TPair (pr nd (tyDfd ty))))
                (else
                  (Comp.bind Pairs TPair (seqP rs)
                    (lam ((rsN Pairs))
                      (let*
                        ((ps (List TPair) (pairsOf rsN))
                         (t1 T (node (label nd) (Map.map TPair T p1 ps)))
                         (c1 T
                           (if (equal t1 nd) (tyDfd ty)
                             (cCong (tyDfd ty) (Map.map TPair T p2 ps)))))
                        (Comp.bind (Option.Maybe TPair) TPair
                          (Comp.orElse (Option.Maybe TPair)
                            (Comp.bind TPair (Option.Maybe TPair) (rewriteRoot rules t1)
                              (lam ((r TPair))
                                (Comp.pure (Option.Maybe TPair) (Option.just TPair r))))
                            (Comp.pure (Option.Maybe TPair) (Option.nothing TPair)))
                          (lam ((mr2 (Option.Maybe TPair)))
                            (if (Option.isJust TPair mr2)
                              (let r2 TPair (Option.fromMaybe TPair pr0 mr2)
                                (Comp.bind TPair TPair (rec (p1 r2))
                                  (lam ((r3 TPair))
                                    (memoizeNf nd (p1 r3) (cTrans c1 (cTrans (p2 r2) (p2 r3)))))))
                              (memoizeNf nd t1 c1)))))))))))))))
  ; the normalizers, each normalizing the term its root rewrites to by the normalizer one level
  ; below, to 64 levels: a fixed composition of the step, whose uses each have their own decoration
  (defn normP ((rules (List RwRule)) (rec NB)) NB
    (lam ((t T)) (para PairM (normStepP rules rec) t)))
  (defn normP2 ((rules (List RwRule)) (rec NB)) NB (normP rules (normP rules rec)))
  (defn normP4 ((rules (List RwRule)) (rec NB)) NB (normP2 rules (normP2 rules rec)))
  (defn normP8 ((rules (List RwRule)) (rec NB)) NB (normP4 rules (normP4 rules rec)))
  (defn normP16 ((rules (List RwRule)) (rec NB)) NB (normP8 rules (normP8 rules rec)))
  (defn normP32 ((rules (List RwRule)) (rec NB)) NB (normP16 rules (normP16 rules rec)))
  (defn normalizers ((rules (List RwRule))) NB
    (normP32 rules (normP32 rules (lam ((t T)) (Comp.fail TPair)))))
  (defn pNormalize ((rules (List RwRule)) (t T)) PairM (normalizers rules t))

  ; tactics: the axioms' indices by block, the instance of a source's sequent, the expansion of an
  ; arrow into a product, the unfolding of a definition, the proof by normalization, and the proof
  ; of a sequent, or the normalization of a theorem's left side, added to a development, with
  ; the index of its entry
  (def beforeTerminal (Seq.length Sequent categoryAxioms))
  (def beforeProduct (add beforeTerminal (Seq.length Sequent terminalAxioms)))
  (def beforeExponential
    (add beforeProduct
      (add (Seq.length Sequent productAxioms)
        (add (Seq.length Sequent equalizerAxioms)
          (add (Seq.length Sequent initialAxioms)
            (add (Seq.length Sequent coproductAxioms) (Seq.length Sequent coequalizerAxioms)))))))
  (def beforeNat
    (add beforeExponential
      (add (Seq.length Sequent exponentialAxioms) (Seq.length Sequent classifierAxioms))))
  (def beforeList (add beforeNat (Seq.length Sequent natAxioms)))
  (defn pInst ((s Src) (sigma Ts)) EqnCertM
    (Comp.bind Sequent EqnCert (srcSeq s)
      (lam ((a Sequent))
        (Comp.bind PTys EqnCert (mapMTY typeTerm sigma)
          (lam ((tysN PTys))
            (let tys (List PTy) (ptysOf tysN)
              (Comp.bind Certs EqnCert (mapMEqC (proveHyp typePattern tys) (seqHyps a))
                (lam ((hs Certs))
                  (Comp.pure EqnCert
                    (eqnCert (eqSubst sigma (seqConcl a))
                      (srcCert s sigma (Map.map PTy T tyDfd tys) (certsOf hs))))))))))))
  (defn etaExpand ((f T)) PairM
    (Comp.bind PTy TPair (typeTerm f)
      (lam ((ty PTy))
        (let h T (tyHi ty)
          (if (and (eq (label h) 7) (eq (length (children h)) 2))
            (Comp.bind EqnCert TPair
              (pInst (srcAx (add beforeProduct 11)) (l3 f (at (children h) 0) (at (children h) 1)))
              (lam ((qc EqnCert)) (Comp.pure TPair (pr (eqLhs (ecEqn qc)) (cSymm (ecCert qc))))))
            (Comp.fail TPair))))))
  (defn rwAx ((j T)) RwRule (rwRule (srcAx j) 0 (labels (nil T))))
  (defn rwThm ((j T)) RwRule (rwRule (srcThm j) 0 (labels (nil T))))
  (defn deltaRule ((i T)) RwRule (rwAx (defAxIdx i)))
  (defn pByNorm ((rules (List RwRule)) (q Eqn)) TreeM
    (Comp.bind TPair T (pNormalize rules (eqLhs q))
      (lam ((l TPair))
        (Comp.bind TPair T (pNormalize rules (eqRhs q))
          (lam ((r TPair))
            (Comp.bind T T (pmGuard (equal (p1 l) (p1 r)))
              (lam ((u T)) (Comp.pure T (cTrans (p2 l) (cSymm (p2 r)))))))))))
  (data Proved (proved T DevList))

  (defn provedIdx ((p Proved)) T (case p ((proved i d) i)))
  (defn provedDev ((p Proved)) (List DevEntry) (case p ((proved i d) (case d ((devs & xs) xs)))))
  (defn proveSeq ((a Sequent) (m TreeM) (defs (List PDefn)) (infer T) (dev (List DevEntry)))
    (Option.Maybe Proved)
    (case (m (scope (sorts (seqCtx a)) (eqns (seqHyps a))) (pmStart dev defs infer))
      ((Comp.ok T r)
       (case r
         ((Comp.res T c st)
          (let dev1 (List DevEntry) (stDev st)
            (Option.just Proved
              (proved (Seq.length DevEntry dev1)
                (devs (Seq.append DevEntry dev1 (Seq.single DevEntry (devEntry a c))))))))))
      ((Comp.bad T) (Option.nothing Proved))))
  (defn normalizeThm
    ((rules (List RwRule)) (j T) (defs (List PDefn)) (infer T) (dev (List DevEntry)))
    (Option.Maybe Proved)
    (case (Option.nthOf DevEntry dev j)
      ((Option.just DevEntry e)
       (let* ((a Sequent (devSeq e)) (sc PhScope (scope (sorts (seqCtx a)) (eqns (seqHyps a)))))
         (case ((pNormalize rules (eqLhs (seqConcl a))) sc (pmStart dev defs infer))
           ((Comp.ok TPair r)
            (case r
              ((Comp.res TPair nc st)
               (let dev1 (List DevEntry) (stDev st)
                 (Option.just Proved
                   (proved (Seq.length DevEntry dev1)
                     (devs
                       (Seq.append DevEntry dev1
                         (Seq.single DevEntry
                           (devEntry (scSeq sc (eqn (p1 nc) (eqRhs (seqConcl a))))
                             (cTrans (cSymm (p2 nc)) (scCite sc j))))))))))))
           ((Comp.bad TPair) (Option.nothing Proved)))))
      ((Option.nothing DevEntry) (Option.nothing Proved))))

  ; induction: the instance of a source's sequent whose equations between arrows are proved by
  ; normalization, the certificate of an equation's rewriting inside a term, and the proofs of
  ; equations between arrows from the natural numbers object and from list objects
  (defn instBy ((rules (List RwRule)) (s Src) (sigma Ts)) EqnCertM
    (Comp.bind Sequent EqnCert (srcSeq s)
      (lam ((a Sequent))
        (Comp.bind PTys EqnCert (mapMTY typeTerm sigma)
          (lam ((tysN PTys))
            (let tys (List PTy) (ptysOf tysN)
              (Comp.bind Certs EqnCert
                (mapMEqC
                  (lam ((h Eqn))
                    (Comp.orElse T (proveHyp typePattern tys h) (pByNorm rules (eqSubst sigma h))))
                  (seqHyps a))
                (lam ((hs Certs))
                  (Comp.pure EqnCert
                    (eqnCert (eqSubst sigma (seqConcl a))
                      (srcCert s sigma (Map.map PTy T tyDfd tys) (certsOf hs))))))))))))
  (defn congStep ((e Eqn) (ce T) (nd T) (rs (List BF))) BF
    (lam ((t T))
      (Comp.bind PTy T (typeTerm nd)
        (lam ((ty PTy))
          (cond ((equal nd t) (Comp.pure T (tyDfd ty)))
            ((and (equal nd (eqLhs e)) (equal t (eqRhs e))) (Comp.pure T ce))
            ((eq (tySort ty) Sorts.obj)
             (Comp.bind PTy T (typeTerm t) (lam ((yt PTy)) (objEq ty yt))))
            ((or (eq (label nd) 0)
               (or (not (eq (label t) (label nd)))
                 (not (eq (length (children t)) (length (children nd)))))) (Comp.fail T))
            (else
              (Comp.bind Certs T (bridgeKids rs (children t))
                (lam ((cs Certs)) (Comp.pure T (cCong (tyDfd ty) (certsOf cs)))))))))))
  (defn congBy ((e Eqn) (ce T) (s T) (t T)) TreeM (para BF (congStep e ce) s t))
  (defn natRecUniq ((rules (List RwRule)) (z T) (s T) (f T)) TreeM
    (Comp.bind EqnCert T (instBy rules (srcAx (add beforeNat 12)) (l3 z s f))
      (lam ((qc EqnCert)) (Comp.pure T (ecCert qc)))))
  (defn listRecUniq ((rules (List RwRule)) (a T) (z T) (s T) (f T)) TreeM
    (Comp.bind EqnCert T (instBy rules (srcAx (add beforeList 13)) (l4 a z s f))
      (lam ((qc EqnCert)) (Comp.pure T (ecCert qc)))))
  (defn byNatInduction ((rules (List RwRule)) (z T) (s T) (q Eqn)) TreeM
    (Comp.bind T T (natRecUniq rules z s (eqLhs q))
      (lam ((cl T))
        (Comp.bind T T (natRecUniq rules z s (eqRhs q))
          (lam ((cr T)) (Comp.pure T (cTrans cl (cSymm cr))))))))
  (defn byListInduction ((rules (List RwRule)) (a T) (z T) (s T) (q Eqn)) TreeM
    (Comp.bind T T (listRecUniq rules a z s (eqLhs q))
      (lam ((cl T))
        (Comp.bind T T (listRecUniq rules a z s (eqRhs q))
          (lam ((cr T)) (Comp.pure T (cTrans cl (cSymm cr))))))))
  (defn byListParamInduction ((rules (List RwRule)) (a T) (z T) (s T) (q Eqn)) TreeM
    (Comp.bind PTy T (typeTerm (eqLhs q))
      (lam ((ty PTy))
        (let lo T (tyLo ty)
          (if (and (eq (label lo) 7) (eq (length (children lo)) 2))
            (let*
              ((l T (at (children lo) 0)) (p T (at (children lo) 1)) (b T (tyHi ty)) (e T (exp p b))
               (ae T (prod a e))
               (z1 T (curry one p (comp z (cSnd one p))))
               (s1 T
                 (curry ae p
                   (comp s
                     (cPair
                       (cPair (comp (cFst a e) (cFst ae p))
                         (comp (ev p b) (cPair (comp (cSnd a e) (cFst ae p)) (cSnd ae p))))
                       (cSnd ae p)))))
               (cf T (curry l p (eqLhs q)))
               (cg T (curry l p (eqRhs q))))
              (Comp.bind T T (byListInduction rules a z1 s1 (eqn cf cg))
                (lam ((cc T))
                  (Comp.bind EqnCert T (pInst (srcAx (add beforeExponential 7)) (l3 l p (eqLhs q)))
                    (lam ((bfp EqnCert))
                      (Comp.bind EqnCert T
                        (pInst (srcAx (add beforeExponential 7)) (l3 l p (eqRhs q)))
                        (lam ((bgp EqnCert))
                          (Comp.bind T T
                            (congBy (eqn cf cg) cc (eqLhs (ecEqn bfp)) (eqLhs (ecEqn bgp)))
                            (lam ((mid T))
                              (Comp.pure T
                                (cTrans (cSymm (ecCert bfp)) (cTrans mid (ecCert bgp)))))))))))))
            (Comp.fail T))))))

  ; the library: the rules from the axioms, the derived equations with their proofs, and its
  ; development, with the indices of the derived equations
  (def baseRules
    (cons (rwRule (srcAx 7) 1 (labels (nil T)))
      (cons (rwAx 10)
        (cons (rwAx 11)
          (cons (rwAx (add beforeProduct 9))
            (cons (rwAx (add beforeProduct 10))
              (cons (rwAx (add beforeProduct 11))
                (cons (rwRule (srcAx (add beforeTerminal 3)) 0 (labels (l2 3 6)))
                  (cons (rwAx (add beforeNat 10))
                    (cons (rwAx (add beforeNat 11))
                      (Few.l2 RwRule (rwAx (add beforeList 11))
                        (rwAx (add beforeList 12)))))))))))))
  (def compPairSeq
    (mkSeq (l3 Sorts.arr Sorts.arr Sorts.arr)
      (Few.l2 Eqn (eqn (dom (x 1)) (dom (x 0))) (eqn (cod (x 2)) (dom (x 0))))
      (eqn (comp (cPair (x 0) (x 1)) (x 2)) (cPair (comp (x 0) (x 2)) (comp (x 1) (x 2))))))
  (def pairFstSndSeq
    (mkSeq (l2 Sorts.obj Sorts.obj) (nil Eqn)
      (eqn (cPair (cFst (x 0) (x 1)) (cSnd (x 0) (x 1))) (idt (prod (x 0) (x 1))))))
  (def evCurrySeq
    (mkSeq (l5 Sorts.obj Sorts.obj Sorts.arr Sorts.arr Sorts.arr)
      (Few.l4 Eqn (eqn (dom (x 2)) (prod (x 0) (x 1))) (eqn (cod (x 3)) (x 0))
        (eqn (cod (x 4)) (x 1))
        (eqn (dom (x 4)) (dom (x 3))))
      (eqn (comp (ev (x 1) (cod (x 2))) (cPair (comp (curry (x 0) (x 1) (x 2)) (x 3)) (x 4)))
        (comp (x 2) (cPair (x 3) (x 4))))))
  (def evCurry0Seq
    (mkSeq (l4 Sorts.obj Sorts.obj Sorts.arr Sorts.arr)
      (Few.l3 Eqn (eqn (dom (x 2)) (prod (x 0) (x 1))) (eqn (cod (x 3)) (x 1))
        (eqn (dom (x 3)) (x 0)))
      (eqn (comp (ev (x 1) (cod (x 2))) (cPair (curry (x 0) (x 1) (x 2)) (x 3)))
        (comp (x 2) (cPair (idt (x 0)) (x 3))))))
  (def curryNatSeq
    (mkSeq (l4 Sorts.obj Sorts.obj Sorts.arr Sorts.arr)
      (Few.l2 Eqn (eqn (dom (x 2)) (prod (x 0) (x 1))) (eqn (cod (x 3)) (x 0)))
      (eqn (comp (curry (x 0) (x 1) (x 2)) (x 3))
        (curry (dom (x 3)) (x 1) (comp (x 2) (prodMapLeft (x 3) (x 1)))))))
  (def bangOneSeq (mkSeq (nil T) (nil Eqn) (eqn (bang one) (idt one))))
  (defn seqLhs ((a Sequent)) T (eqLhs (seqConcl a)))
  (defn seqRhs ((a Sequent)) T (eqRhs (seqConcl a)))
  (def compPairProof
    (Comp.bind TPair T (etaExpand (seqLhs compPairSeq))
      (lam ((ec TPair))
        (Comp.bind TPair T (pNormalize baseRules (p1 ec))
          (lam ((nc TPair))
            (Comp.bind T T (pmGuard (equal (p1 nc) (seqRhs compPairSeq)))
              (lam ((u T)) (Comp.pure T (cTrans (p2 ec) (p2 nc))))))))))
  (def pairFstSndProof
    (let p T (prod (x 0) (x 1))
      (Comp.bind EqnCert T (pInst (srcAx (add beforeProduct 11)) (l3 (idt p) (x 0) (x 1)))
        (lam ((qc EqnCert))
          (Comp.bind TPair T (pNormalize baseRules (eqLhs (ecEqn qc)))
            (lam ((nc TPair))
              (Comp.bind T T (pmGuard (equal (p1 nc) (seqLhs pairFstSndSeq)))
                (lam ((u T)) (Comp.pure T (cTrans (cSymm (p2 nc)) (ecCert qc)))))))))))
  (defn evCurryProof ((cp T)) TreeM
    (let rs (List RwRule) (Seq.append RwRule baseRules (Seq.single RwRule (rwThm cp)))
      (Comp.bind EqnCert T (pInst (srcAx (add beforeExponential 7)) (l3 (x 0) (x 1) (x 2)))
        (lam ((qc EqnCert))
          (let* ((gh T (cPair (x 3) (x 4))) (u T (comp (eqLhs (ecEqn qc)) gh)))
            (Comp.bind TPair T (pNormalize rs u)
              (lam ((nu TPair))
                (Comp.bind TPair T (pNormalize rs (seqLhs evCurrySeq))
                  (lam ((ng TPair))
                    (Comp.bind T T (pmGuard (equal (p1 nu) (p1 ng)))
                      (lam ((u0 T))
                        (Comp.bind PTy T (typeTerm u)
                          (lam ((du PTy))
                            (Comp.bind PTy T (typeTerm gh)
                              (lam ((dg PTy))
                                (Comp.pure T
                                  (cTrans (cTrans (p2 ng) (cSymm (p2 nu)))
                                    (cCong (tyDfd du) (l2 (ecCert qc) (tyDfd dg))))))))))))))))))))
  (defn evCurry0Proof ((ec T)) TreeM
    (Comp.bind EqnCert T (pInst (srcThm ec) (l5 (x 0) (x 1) (x 2) (idt (x 0)) (x 3)))
      (lam ((qc EqnCert))
        (let q Eqn (ecEqn qc)
          (Comp.bind TPair T (pNormalize baseRules (eqLhs q))
            (lam ((nc TPair))
              (Comp.bind T T
                (pmGuard
                  (and (equal (p1 nc) (seqLhs evCurry0Seq)) (equal (eqRhs q) (seqRhs evCurry0Seq))))
                (lam ((u T)) (Comp.pure T (cTrans (cSymm (p2 nc)) (ecCert qc)))))))))))
  (defn curryNatProof ((cp T) (ec T)) TreeM
    (let*
      ((rs (List RwRule) (Seq.append RwRule baseRules (Few.l2 RwRule (rwThm cp) (rwThm ec))))
       (k T (seqLhs curryNatSeq)))
      (Comp.bind EqnCert T
        (pInst (srcAx (add beforeExponential 8)) (l4 (dom (x 3)) (x 1) (cod (x 2)) k))
        (lam ((qc EqnCert))
          (Comp.bind TPair T (pNormalize rs (eqLhs (ecEqn qc)))
            (lam ((nc TPair))
              (Comp.bind TPair T (pNormalize rs (seqRhs curryNatSeq))
                (lam ((rc TPair))
                  (Comp.bind T T (pmGuard (equal (p1 nc) (p1 rc)))
                    (lam ((u T))
                      (Comp.pure T
                        (cTrans (cSymm (ecCert qc)) (cTrans (p2 nc) (cSymm (p2 rc)))))))))))))))
  (def bangOneProof
    (Comp.bind EqnCert T (pInst (srcAx (add beforeTerminal 3)) (single (idt one)))
      (lam ((qc EqnCert))
        (Comp.bind TPair T (pNormalize baseRules (eqRhs (ecEqn qc)))
          (lam ((nc TPair))
            (Comp.bind T T (pmGuard (equal (p1 nc) (bang one)))
              (lam ((u T)) (Comp.pure T (cSymm (cTrans (ecCert qc) (p2 nc)))))))))))
  (data Indices (indices & T))
  (data Library (library Indices DevList))

  (defn bindPr ((m (Option.Maybe Proved)) (f (Arrow Proved (Option.Maybe Library))))
    (Option.Maybe Library)
    (case m ((Option.just Proved p) (f p)) ((Option.nothing Proved) (Option.nothing Library))))
  (defn libraryWith ((infer T)) (Option.Maybe Library)
    (bindPr (proveSeq compPairSeq compPairProof (nil PDefn) infer (nil DevEntry))
      (lam ((r1 Proved))
        (let cp T (provedIdx r1)
          (bindPr (proveSeq pairFstSndSeq pairFstSndProof (nil PDefn) infer (provedDev r1))
            (lam ((r2 Proved))
              (let pf T (provedIdx r2)
                (bindPr (proveSeq evCurrySeq (evCurryProof cp) (nil PDefn) infer (provedDev r2))
                  (lam ((r3 Proved))
                    (let ec T (provedIdx r3)
                      (bindPr
                        (proveSeq evCurry0Seq (evCurry0Proof ec) (nil PDefn) infer (provedDev r3))
                        (lam ((r4 Proved))
                          (let e0 T (provedIdx r4)
                            (bindPr
                              (proveSeq curryNatSeq (curryNatProof cp ec) (nil PDefn) infer
                                (provedDev r4))
                              (lam ((r5 Proved))
                                (let cn T (provedIdx r5)
                                  (bindPr
                                    (proveSeq bangOneSeq bangOneProof (nil PDefn) infer
                                      (provedDev r5))
                                    (lam ((r6 Proved))
                                      (Option.just Library
                                        (library (indices (l6 cp pf ec e0 cn (provedIdx r6)))
                                          (devs (provedDev r6))))))))))))))))))))))
  (defn libRules ((i Indices)) (List RwRule)
    (let is Ts (case i ((indices & xs) xs))
      (Seq.append RwRule baseRules
        (Few.l5 RwRule (rwThm (at is 0)) (rwThm (at is 1)) (rwThm (at is 4)) (rwThm (at is 3))
          (rwThm (at is 5)))))))
