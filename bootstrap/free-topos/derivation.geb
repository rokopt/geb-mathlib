; Authors: Terence Rokop
;
; The checker of the internal language's derivations and of developments, written in the datatype
; language, deciding as Geb.FreeTopos.Internal decides: the rewriting a derivation performs and
; the judgments it proves, the sequents theorems compile to, the certificates of the combinators,
; and the check of a development's declarations, each with the constants and the entries before
; it. A derivation is the node of its rule's position among Geb.FreeTopos.Internal.Rule's
; constructors over the node of the rule's data followed by its children, a term among the data
; as the language encodes it, objects and terms the node of their list and a truth value a
; label. A theorem is the node of label 0 over its arity, the node of its context, the node of its
; hypotheses and its conclusion, an entry and a declaration the node of their constructor's
; position over their fields, an optional certificate the optional tree, and the state of a
; development the pair of its constants and the node of its entries, as their datatypes declare
; them. Requires the prelude, the lists of bootstrap/seq.geb, the base, partial Horn logic, the
; theory, the inference and the language.

(module Derivation
  (export nilPrim consPrim lnodePrim inlPrim inrPrim casePrim instVar instVar2 atVar0 natSuccAt
    listConsAt
    roseNodeAt
    weakenElem
    weaken1
    weaken2
    weakenStep2
    roseMapAt
    roseHyp
    eqParts
    instTerm
    typeIn
    Terms
    terms
    OTerms.Maybe
    OTerms.nothing
    OTerms.just
    lowerHyps
    Thm
    mkThm
    thCtx
    thConcl
    OThm.Maybe
    OThm.nothing
    OThm.just
    OThm.isJust
    OThm.fromMaybe
    Entry
    entLang
    entComb
    entryLanguage
    thmAt
    scopesOf
    bindPT
    certifies
    Scope
    scope
    scopeCtx
    scopeHyps
    scope0
    Scopes
    scopes
    OScopes.Maybe
    OScopes.nothing
    OScopes.just
    childCtxs
    rootStep
    Chk3
    DV
    rw
    pf
    check
    Decl
    declLang
    declComb
    declDef
    declConst
    declObj
    declQuot
    declDesc
    EntryList
    entries
    DevState
    devState
    ODevState.Maybe
    ODevState.nothing
    ODevState.just
    push
    declStep
    checkDev)
  (import Prelude)
  (import Base)
  (import PartialHorn)
  (import Theory)
  (import Infer)
  (import Language)
  (import (Seq Eqn) as Eqns)
  (import (Seq OpSig) as OpSigs)
  (import (Seq Primitive) as Prims)
  (import (Seq Definition) as Defs)
  (defn copairIn ((X T) (A T) (B T) (C T) (F T) (G T)) T
    (comp (ev X C)
      (cPair
        (comp
          (copair (curry A X (comp F (cPair (cSnd A X) (cFst A X))))
            (curry B X (comp G (cPair (cSnd B X) (cFst B X)))))
          (cSnd X (coprod A B)))
        (cFst X (coprod A B)))))
  (defn caseArr ((A T) (B T) (C T)) T
    (let P T (prod (exp A C) (exp B C))
      (curry P (coprod A B)
        (copairIn P A B C
          (comp (ev A C) (cPair (comp (cFst (exp A C) (exp B C)) (cFst P A)) (cSnd P A)))
          (comp (ev B C) (cPair (comp (cSnd (exp A C) (exp B C)) (cFst P B)) (cSnd P B)))))))

  ; the primitive arrows of the data objects and of coproducts
  (def zeroPrim (primitive 0 zeroN one nat))
  (def succPrim (primitive 0 succ nat nat))
  (def nilPrim (primitive 1 (cNil (x 0)) one (list (x 0))))
  (def consPrim (primitive 1 (cCons (x 0)) (prod (x 0) (list (x 0))) (list (x 0))))
  (def nodePrim (primitive 0 cNode (prod nat (list rose)) rose))
  (def lnodePrim (primitive 1 (lnode (x 0)) (prod (x 0) (list (lrose (x 0)))) (lrose (x 0))))
  (def inlPrim (primitive 2 (inl (x 0) (x 1)) (x 0) (coprod (x 0) (x 1))))
  (def inrPrim (primitive 2 (inr (x 0) (x 1)) (x 1) (coprod (x 0) (x 1))))
  (def casePrim
    (primitive 3 (caseArr (x 0) (x 1) (x 2)) (prod (exp (x 0) (x 2)) (exp (x 1) (x 2)))
      (exp (coprod (x 0) (x 1)) (x 2))))
  (defn primIs ((G Globals) (k T) (p Primitive)) T
    (equal (rep (OPrimitive.nthOf (gPrims G) k)) (rep (OPrimitive.just p))))
  (defn objVars ((n T)) Ts (mapT x (range n)))

  ; the recognition of a coequalizer's projection, and of a quotient's by a relation
  (defn isCoeqProj ((p Primitive)) T
    (let a T (prArrow p)
      (if (eq (arity a) 2)
        (let f T (child a 0)
          (let g T (child a 1)
            (if (and (eq (arity f) 2) (eq (arity g) 2))
              (and (equal a (coeqProj f g))
                (and (equal f (comp (child f 0) (child f 1)))
                  (equal g (comp (child g 0) (child g 1)))))
              0)))
        0)))
  (defn relL ((A T) (r T)) T (comp (cFst A A) (truthIncl r)))
  (defn relR ((A T) (r T)) T (comp (cSnd A A) (truthIncl r)))
  (defn primRel ((p Primitive)) T
    (let a T (prArrow p)
      (if (eq (arity a) 2)
        (let f T (child a 0)
          (if (eq (arity f) 2)
            (let m T (child f 1)
              (if (eq (arity m) 2)
                (let r T (child m 0)
                  (if (equal a (coeqProj (relL (prDom p) r) (relR (prDom p) r))) (some r) none))
                none))
            none))
        none)))

  ; substitutions for the innermost variables, and weakenings
  (defn instVar ((u T) (i T)) T (if (eq i 0) u (var (sub i 1))))
  (defn instVar2 ((u T) (v T) (i T)) T (if (eq i 0) u (if (eq i 1) v (var (sub i 2)))))
  (defn atVar0 ((u T) (i T)) T (if (eq i 0) u (var i)))
  (defn natSuccAt ((ks T) (t T)) T (subst t (atVar0 (mArr ks (nil T) (var 0)))))
  (defn listConsAt ((kc T) (a T) (t T)) T
    (subst t
      (lam ((i T)) (if (eq i 0) (mArr kc (single a) (mPair (var 1) (var 0))) (var (add i 1))))))
  (defn roseNodeAt ((kn T) (r T) (a T) (t T)) T
    (subst t
      (lam ((i T))
        (if (eq i 0) (mArr kn (if (equal r rose) (nil T) (single a)) (mPair (var 1) (var 0)))
          (var (add i 1))))))
  (defn weakenElem ((t T)) T (rename t (lam ((i T)) (if (eq i 0) 0 (add i 1)))))
  (defn weaken1 ((t T)) T (rename t (lam ((i T)) (add i 1))))
  (defn weaken2 ((t T)) T (rename t (lam ((i T)) (add i 2))))
  (defn weakenStep2 ((s T)) T (rename s (lam ((i T)) (if (eq i 0) 0 (add i 2)))))
  (defn lower1 ((t T)) T (rename t (lam ((i T)) (sub i 1))))
  (defn roseMapAt ((kl T) (kc T) (c T) (t T)) T
    (mListRec (mArr kl (single c) mStar)
      (mArr kc (single c) (mPair (rename t (lam ((i T)) (if (eq i 0) 1 (add i 3)))) (var 0)))
      (var 0)))
  (defn roseHyp ((kl T) (kc T) (phi T)) T
    (mEq (roseMapAt kl kc omega phi) (roseMapAt kl kc omega (mEq mStar mStar))))

  ; the image of an optional pair of trees, as the base maps optional trees
  (defn mapPT ((f (Arrow TPair T)) (m OTPair.Maybe)) T
    (case m ((OTPair.just p) (some (f p))) ((OTPair.nothing) none)))

  ; the sides of an equation, the instance of a theorem's term, and the type of a term in a context
  (def pr0 (pr 0 0))
  (defn eqParts ((phi T)) OTPair.Maybe
    (if (mIs 12 2 phi) (OTPair.just (pr (mArg phi 0) (mArg phi 1))) OTPair.nothing))
  (defn instTerm ((th Ts) (sg Ts) (s T)) T (subst (osubst th s) (substList sg)))
  (defn typeIn ((G Globals) (n T) (g Ts) (t T)) T
    (mapPT p2 ((compile G n t) (ctxObj g) (stdEnv g))))
  (defn isFormula ((G Globals) (n T) (g Ts) (t T)) T (equal (typeIn G n g t) (some omega)))

  ; hypotheses that do not mention the innermost variable, in the context without it
  (data Terms (terms & T))
  (import (Option Terms) as OTerms)
  (defn allSomeTerms ((ms Ts)) OTerms.Maybe
    (if (allT isSome ms) (OTerms.just (terms (mapT get ms))) OTerms.nothing))
  (defn termsOr ((m OTerms.Maybe)) Ts
    (case m ((OTerms.just h) (case h ((terms xs) xs))) ((OTerms.nothing) (nil T))))
  (defn lowerHyps ((G Globals) (n T) (g Ts) (hs Ts)) OTerms.Maybe
    (allSomeTerms
      (mapT
        (lam ((h T))
          (let l T (lower1 h) (if (and (equal (weaken1 l) h) (isFormula G n g l)) (some l) none)))
        hs)))

  ; theorems: an arity, a context, hypotheses and a conclusion
  (data Thm (mkThm T Objs Terms T))
  (defn thArity ((a Thm)) T (case a ((mkThm m c h q) m)))
  (defn thCtx ((a Thm)) Ts (case a ((mkThm m c h q) (case c ((objs xs) xs)))))
  (defn thHyps ((a Thm)) Ts (case a ((mkThm m c h q) (case h ((terms xs) xs)))))
  (defn thConcl ((a Thm)) T (case a ((mkThm m c h q) q)))
  (import (Option Thm) as OThm)
  (def thm0 (mkThm 0 (objs (nil T)) (terms (nil T)) 0))

  ; whether objects and terms instantiate a theorem in a context
  (defn instOk ((G Globals) (n T) (g Ts) (a Thm) (th Ts) (sg Ts)) T
    (and (eq (length th) (thArity a))
      (and (allT (isTy G n) th)
        (and (eq (length sg) (length (thCtx a)))
          (allT (lam ((i T)) (equal (typeIn G n g (at sg i)) (some (phSubst th (at (thCtx a) i)))))
            (range (length sg)))))))

  ; the subobject on which arrows into the subobject classifier are truth, with its inclusion
  (defn truthSub ((X T) (hs Ts)) TPair
    (foldr T TPair
      (lam ((h T) (p TPair)) (let c T (comp h (p2 p)) (pr (truthEq c) (comp (p2 p) (truthIncl c)))))
      (pr X (idt X))
      (reverse hs)))

  ; the sequent of the combinators a theorem compiles to
  (defn thmArrow ((G Globals) (a Thm) (phi T)) T
    (getD (mapPT p1 ((compile G (thArity a) phi) (ctxObj (thCtx a)) (stdEnv (thCtx a))))
      (idt (ctxObj (thCtx a)))))
  (defn thmSide ((G Globals) (a Thm) (f T)) T
    (if (isEmpty (thHyps a)) f
      (comp f (p2 (truthSub (ctxObj (thCtx a)) (mapT (thmArrow G a) (thHyps a)))))))
  (defn thmSeq ((G Globals) (a Thm)) Sequent
    (let ep OTPair.Maybe (eqParts (thConcl a))
      (mkSeq (replicate (thArity a) Sorts.obj) (nil Eqn)
        (if (OTPair.isJust ep)
          (eqn (thmSide G a (thmArrow G a (p1 (OTPair.fromMaybe pr0 ep))))
            (thmSide G a (thmArrow G a (p2 (OTPair.fromMaybe pr0 ep)))))
          (eqn (thmSide G a (thmArrow G a (thConcl a)))
            (thmSide G a (comp tru (bang (ctxObj (thCtx a))))))))))

  ; the entries of a development: theorems of the language and sequents of the combinators
  (data Entry (entLang Thm) (entComb Sequent))
  (import (Option Entry) as OEntry)
  (import (Seq Entry) as Entries)
  (defn entryLanguage ((e Entry)) OThm.Maybe
    (case e ((entLang a) (OThm.just a)) ((entComb s) OThm.nothing)))
  (defn bindEH ((m OEntry.Maybe) (f (Arrow Entry OThm.Maybe))) OThm.Maybe
    (case m ((OEntry.just e) (f e)) ((OEntry.nothing) OThm.nothing)))
  (defn thmAt ((E (List Entry)) (i T)) OThm.Maybe (bindEH (OEntry.nthOf E i) entryLanguage))
  (defn entrySeq ((G Globals) (e Entry)) Sequent
    (case e ((entLang a) (thmSeq G a)) ((entComb s) s)))

  ; whether the compilations of the constants' definitions pass a test, and whether a certificate
  ; proves a sequent in the theory they extend, with the entries' sequents as its theorems
  (def pdl0 (pdefns (nil PDefn)))
  (defn pdefnsOf ((l PDefnList)) (List PDefn) (case l ((pdefns xs) xs)))
  (defn anyDefs ((G Globals) (f (Arrow (List PDefn) T))) T
    (let cd OPDefnList.Maybe (compileDefs G)
      (if (OPDefnList.isJust cd) (f (pdefnsOf (OPDefnList.fromMaybe pdl0 cd))) 0)))
  (import (Map Entry Sequent) as SeqOf)
  (defn certifies ((G Globals) (E (List Entry)) (c T) (s Sequent)) T
    (anyDefs G
      (lam ((cds (List PDefn)))
        (if (eq (gBase G) (OpSigs.length sig))
          (equal (rep ((pcheck (ext cds) (SeqOf.map (entrySeq G) E) c) (seqCtx s) (seqHyps s)))
            (rep (OEqn.just (seqConcl s))))
          0))))

  ; the contexts and hypotheses of a node's children
  (data Scope (scope Objs Terms))
  (defn scopeCtx ((c Scope)) Ts (case c ((scope g hs) (case g ((objs xs) xs)))))
  (defn scopeHyps ((c Scope)) Ts (case c ((scope g hs) (case hs ((terms xs) xs)))))
  (defn ctxPair ((g Ts) (hs Ts)) Scope (scope (objs g) (terms hs)))
  (import (Seq Scope) as ScopeL)
  (import (Few Scope) as ScopeF)
  (import (Map T Scope) as ScopeAt)
  (data Scopes (scopes & Scope))
  (defn scopesOf ((c Scopes)) (List Scope) (case c ((scopes xs) xs)))
  (import (Option Scopes) as OScopes)
  (def scope0 (ctxPair (nil T) (nil T)))
  (defn bindTS ((m T) (f (Arrow T OScopes.Maybe))) OScopes.Maybe
    (if (isSome m) (f (get m)) OScopes.nothing))
  (defn bindST ((m OScopes.Maybe) (f (Arrow Scopes T))) T
    (case m ((OScopes.just c) (f c)) ((OScopes.nothing) none)))
  (defn childCtxs ((G Globals) (n T) (t T) (g Ts) (hs Ts)) OScopes.Maybe
    (let l T (label t)
      (let ts Ts (mArgs t)
        (let k T (length ts)
          (if (and (eq l 5) (eq k 1))
            (OScopes.just (scopes (ScopeL.single (ctxPair (cons (mD t 0) g) (mapT weaken1 hs)))))
            (if (and (eq l 8) (eq k 3))
              (bindTS (typeIn G n g (at ts 0))
                (lam ((c T))
                  (OScopes.just
                    (scopes
                      (ScopeF.l3 (ctxPair g hs) (ctxPair (cons c g) (mapT weaken1 hs))
                        (ctxPair g hs))))))
              (if (and (eq l 9) (eq k 3))
                (bindTS (typeIn G n g (at ts 0))
                  (lam ((c T))
                    (bindTS (bindO (typeIn G n g (at ts 2)) listPart)
                      (lam ((a T))
                        (OScopes.just
                          (scopes
                            (ScopeF.l3 (ctxPair g hs)
                              (ctxPair (cons c (cons a g)) (mapT weaken2 hs))
                              (ctxPair g hs))))))))
                (if (and (eq l 10) (eq k 2))
                  (bindTS (bindO (typeIn G n g (at ts 1)) roseLabel)
                    (lam ((a T))
                      (OScopes.just
                        (scopes
                          (ScopeF.l2 (ctxPair (cons (prod a (list (mD t 0))) g) (mapT weaken1 hs))
                            (ctxPair g hs))))))
                  (OScopes.just (scopes (ScopeAt.map (lam ((u T)) (ctxPair g hs)) ts)))))))))))
  (defn sameCtx ((l T) (i T)) T
    (if (eq l 5) 0 (if (or (eq l 8) (eq l 9)) (not (eq i 1)) (if (eq l 10) (eq i 1) 1))))
  (defn congCtxs ((G Globals) (n T) (t T) (g Ts) (hs Ts) (ds Ts)) OScopes.Maybe
    (if (allT (lam ((i T)) (or (sameCtx (label t) i) (eq (label (at ds i)) 0))) (range (length ds)))
      (OScopes.just (scopes (ScopeAt.map (lam ((u T)) (ctxPair g hs)) (mArgs t))))
      (childCtxs G n t g hs)))

  ; the rewritings of a term at its root by the rules of the language's equations, each by one
  ; rule: beta, the components of a pair, the eta of pairs and of the terminal type, the unfolding
  ; of a definition, the folds of the natural numbers, lists and rose trees at their constructions,
  ; the case analysis of a coproduct, an equational theorem and an equation among the hypotheses
  (defn rootBeta ((t T)) T
    (let a0 T (mArg t 0)
      (if (and (mIs 6 2 t) (mIs 5 1 a0)) (some (subst (mArg a0 0) (instVar (mArg t 1)))) none)))
  (defn rootFst ((t T)) T
    (let a0 T (mArg t 0) (if (and (mIs 3 1 t) (mIs 2 2 a0)) (some (mArg a0 0)) none)))
  (defn rootSnd ((t T)) T
    (let a0 T (mArg t 0) (if (and (mIs 4 1 t) (mIs 2 2 a0)) (some (mArg a0 1)) none)))
  (defn rootPairEta ((t T)) T
    (let a0 T (mArg t 0)
      (let a1 T (mArg t 1)
        (if (and (mIs 2 2 t) (and (mIs 3 1 a0) (mIs 4 1 a1)))
          (if (equal (mArg a0 0) (mArg a1 0)) (some (mArg a0 0)) none)
          none))))
  ; the images and bindings of optional values, as the base maps and binds optional trees
  (defn mapLT ((f (Arrow LDefn T)) (m OLDefn.Maybe)) T
    (case m ((OLDefn.just d) (some (f d))) ((OLDefn.nothing) none)))
  (defn bindPT ((m OTPair.Maybe) (f (Arrow TPair T))) T
    (case m ((OTPair.just p) (f p)) ((OTPair.nothing) none)))
  (defn bindHT ((m OThm.Maybe) (f (Arrow Thm T))) T
    (case m ((OThm.just a) (f a)) ((OThm.nothing) none)))
  (defn rootUnitEta ((G Globals) (n T) (g Ts) (t T)) T
    (if (equal (typeIn G n g t) (some one)) (some mStar) none))
  (defn rootDelta ((G Globals) (t T)) T
    (if (eq (label t) 11)
      (mapLT
        (lam ((df LDefn)) (subst (osubst (children (mD t 1)) (ldBody df)) (substList (mArgs t))))
        (bindDL (ODefinition.nthOf (gDefs G) (mD t 0)) defLanguage))
      none))
  (defn rootNat ((G Globals) (rl T) (rd Ts) (t T)) T
    (let a0 T (mArg t 0)
      (let a1 T (mArg t 1)
        (let a2 T (mArg t 2)
          (if (and (mIs 8 3 t) (and (mIs 7 1 a2) (eq (arity (mD a2 1)) 0)))
            (let k T (at rd 0)
              (if (eq rl 9)
                (if (and (eq (mD a2 0) k) (and (primIs G k zeroPrim) (equal (mArg a2 0) mStar)))
                  (some a0)
                  none)
                (if (and (eq (mD a2 0) k) (primIs G k succPrim))
                  (some (subst a1 (instVar (mNatRec a0 a1 (mArg a2 0)))))
                  none)))
            none)))))
  (defn rootListNil ((G Globals) (rd Ts) (t T)) T
    (let a2 T (mArg t 2)
      (if (and (mIs 9 3 t) (and (mIs 7 1 a2) (eq (arity (mD a2 1)) 1)))
        (let k T (at rd 0)
          (if (and (eq (mD a2 0) k) (and (primIs G k nilPrim) (equal (mArg a2 0) mStar)))
            (some (mArg t 0))
            none))
        none)))
  (defn rootListCons ((G Globals) (rd Ts) (t T)) T
    (let a2 T (mArg t 2)
      (if (and (mIs 9 3 t) (and (mIs 7 1 a2) (eq (arity (mD a2 1)) 1)))
        (let p T (mArg a2 0)
          (let k T (at rd 0)
            (if (and (mIs 2 2 p) (and (eq (mD a2 0) k) (primIs G k consPrim)))
              (some
                (subst (mArg t 1)
                  (instVar2 (mListRec (mArg t 0) (mArg t 1) (mArg p 1)) (mArg p 0))))
              none)))
        none)))
  (defn rootRoseNode ((G Globals) (rd Ts) (t T)) T
    (let a0 T (mArg t 0)
      (let a1 T (mArg t 1)
        (if (and (mIs 10 2 t) (mIs 7 1 a1))
          (let p T (mArg a1 0)
            (let kn T (at rd 0)
              (let kl T (at rd 1)
                (let kc T (at rd 2)
                  (let c T (mD t 0)
                    (if
                      (and (mIs 2 2 p)
                        (and (eq (mD a1 0) kn)
                          (and (or (primIs G kn nodePrim) (primIs G kn lnodePrim))
                            (and (primIs G kl nilPrim) (primIs G kc consPrim)))))
                      (some
                        (subst a0
                          (instVar
                            (mPair (mArg p 0)
                              (mListRec (mArr kl (single c) mStar)
                                (mArr kc (single c)
                                  (mPair (mRoseRec c (weakenStep2 a0) (var 1)) (var 0)))
                                (mArg p 1))))))
                      none))))))
          none))))
  (defn rootCase ((G Globals) (pj Primitive) (i T) (rd Ts) (t T)) T
    (let a0 T (mArg t 0)
      (let a1 T (mArg t 1)
        (if (and (mIs 6 2 t) (and (mIs 7 1 a0) (mIs 7 1 a1)))
          (let p T (mArg a0 0)
            (let kc T (at rd 0)
              (let kj T (at rd 1)
                (if
                  (and (mIs 2 2 p)
                    (and (eq (mD a0 0) kc)
                      (and (eq (mD a1 0) kj) (and (primIs G kc casePrim) (primIs G kj pj)))))
                  (some (app (mArg p i) (mArg a1 0)))
                  none))))
          none))))
  (defn rootThm ((G Globals) (E (List Entry)) (n T) (g Ts) (rd Ts) (t T)) T
    (let th Ts (children (at rd 1))
      (let sg Ts (children (at rd 2))
        (let fl T (at rd 3)
          (bindHT (bindEH (OEntry.nthOf E (at rd 0)) entryLanguage)
            (lam ((a Thm))
              (bindPT (if (isEmpty (thHyps a)) (eqParts (thConcl a)) OTPair.nothing)
                (lam ((lr TPair))
                  (if
                    (and (instOk G n g a th sg) (equal t (instTerm th sg (if fl (p2 lr) (p1 lr)))))
                    (some (instTerm th sg (if fl (p1 lr) (p2 lr))))
                    none)))))))))
  (defn rootHyp ((hs Ts) (rd Ts) (t T)) T
    (let fl T (at rd 1)
      (bindPT (bindTP (nth hs (at rd 0)) eqParts)
        (lam ((lr TPair))
          (if (equal t (if fl (p2 lr) (p1 lr))) (some (if fl (p1 lr) (p2 lr))) none)))))

  ; the rewriting of a term at its root by a rule of the language's equations
  (defn rootStep ((G Globals) (E (List Entry)) (n T) (g Ts) (hs Ts) (rl T) (rd Ts) (t T)) T
    (if (eq rl 3) (rootBeta t)
      (if (eq rl 4) (rootFst t)
        (if (eq rl 5) (rootSnd t)
          (if (eq rl 6) (rootPairEta t)
            (if (eq rl 7) (rootUnitEta G n g t)
              (if (eq rl 8) (rootDelta G t)
                (if (or (eq rl 9) (eq rl 10)) (rootNat G rl rd t)
                  (if (eq rl 11) (rootListNil G rd t)
                    (if (eq rl 12) (rootListCons G rd t)
                      (if (eq rl 13) (rootRoseNode G rd t)
                        (if (eq rl 14) (rootCase G inlPrim 0 rd t)
                          (if (eq rl 15) (rootCase G inrPrim 1 rd t)
                            (if (eq rl 16) (rootThm G E n g rd t)
                              (if (eq rl 17) (rootHyp hs rd t) none)))))))))))))))

  ; the fold of a derivation with the derivation at each node, its values its rewriting and its
  ; proving, each a function of a context, hypotheses and a term
  (deftype Chk3 (Arrow Ts (Arrow Ts (Arrow T T))))
  (deftype DV (Prod Chk3 Chk3))
  (deftype DP (Prod T DV))
  (deftype DPs (List DP))
  (defn dpTrees ((rs DPs)) Ts (foldr DP Ts (lam ((r DP) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
  (import (Lists DP) as DPs)
  (defn dpAt ((rs DPs) (i T)) DV
    (lcase DP DV (iter DPs DPs.tail rs i)
      (pair (lam ((g Ts) (hs Ts) (t T)) none) (lam ((g Ts) (hs Ts) (t T)) 0))
      (lam ((r DP) (rest DPs)) (snd r))))
  (defn rw ((rs DPs) (i T)) Chk3 (fst (dpAt rs i)))
  (defn pf ((rs DPs) (i T)) Chk3 (snd (dpAt rs i)))

  ; one step of the rewriting, at a node of a rule, from its children's results
  (defn rewriteStep
    ((G Globals) (E (List Entry)) (n T) (rl T) (rd Ts) (ds Ts) (as DPs) (g Ts) (hs Ts) (t T))
    T
    (let k T (length ds)
      (if (and (eq rl 0) (eq k 0)) (some t)
        (if (and (eq rl 1) (eq k 2)) (bindO ((rw as 0) g hs t) ((rw as 1) g hs))
          (if (eq rl 2)
            (bindST (congCtxs G n t g hs ds)
              (lam ((cxN Scopes))
                (let cx (List Scope) (scopesOf cxN)
                  (let ta Ts (mArgs t)
                    (if (and (eq k (length ta)) (eq (ScopeL.length cx) (length ta)))
                      (mapO (lam ((tsN T)) (node (label t) (cons (child t 0) (children tsN))))
                        (allSomeT
                          (mapT
                            (lam ((i T))
                              (let c Scope (ScopeL.atOr scope0 cx i)
                                ((rw as i) (scopeCtx c) (scopeHyps c) (at ta i))))
                            (range k))))
                      none)))))
            (if (eq k 0) (rootStep G E n g hs rl rd t) none))))))

  ; the premises of induction on the innermost variable of a type of the data objects
  (defn rosePrimsOk ((G Globals) (kn T) (kl T) (kc T) (r T) (a T)) T
    (and
      (or (and (primIs G kn nodePrim) (equal r rose))
        (and (primIs G kn lnodePrim) (equal r (lrose a))))
      (and (primIs G kl nilPrim) (primIs G kc consPrim))))

  ; one step of the proving, at a node of a rule, from its children's results
  (def prim0 (primitive 0 0 0 0))
  (def seq0 (mkSeq (nil T) (nil Eqn) (eqn 0 0)))
  (defn proveStep
    ((G Globals) (E (List Entry)) (n T) (rl T) (rd Ts) (ds Ts) (as DPs) (g Ts) (hs Ts) (phi T))
    T
    (let k T (length ds)
      (let ep OTPair.Maybe (eqParts phi)
        (let tt T (p1 (OTPair.fromMaybe pr0 ep))
          (let uu T (p2 (OTPair.fromMaybe pr0 ep))
            (let d0 T (at rd 0)
              (let d1 T (at rd 1)
                (if (and (eq rl 18) (eq k 2))
                  (if (OTPair.isJust ep)
                    (let v T ((rw as 0) g hs tt)
                      (let w T ((rw as 1) g hs uu)
                        (and (isSome v) (and (isSome w) (equal (get v) (get w))))))
                    0)
                  (if (and (eq rl 19) (eq k 3))
                    (if (and (OTPair.isJust ep) (not (isEmpty g)))
                      (let c T (at g 0)
                        (let g1 Ts (tail g)
                          (let s T (at rd 2)
                            (let mC T (typeIn G n g tt)
                              (let mH OTerms.Maybe (lowerHyps G n g1 hs)
                                (if (and (isSome mC) (OTerms.isJust mH))
                                  (let C T (get mC)
                                    (let z T (mArr d0 (nil T) mStar)
                                      (if
                                        (and (equal c nat)
                                          (and (primIs G d0 zeroPrim)
                                            (and (primIs G d1 succPrim)
                                              (and (equal (typeIn G n g uu) (some C))
                                                (equal (typeIn G n (cons C g1) s) (some C))))))
                                        (if
                                          ((pf as 0) g1 (termsOr mH)
                                           (mEq (subst tt (instVar z)) (subst uu (instVar z))))
                                          (if
                                            ((pf as 1) g hs
                                             (mEq (natSuccAt d1 tt) (subst s (atVar0 tt))))
                                            ((pf as 2) g hs
                                             (mEq (natSuccAt d1 uu) (subst s (atVar0 uu))))
                                            0)
                                          0)
                                        0)))
                                  0))))))
                      0)
                    (if (and (eq rl 20) (eq k 3))
                      (if (and (OTPair.isJust ep) (not (isEmpty g)))
                        (let c T (at g 0)
                          (let g1 Ts (tail g)
                            (let s T (at rd 2)
                              (let mC T (typeIn G n g tt)
                                (let ma T (listPart c)
                                  (let mH OTerms.Maybe (lowerHyps G n g1 hs)
                                    (if (and (isSome mC) (and (isSome ma) (OTerms.isJust mH)))
                                      (let C T (get mC)
                                        (let a T (get ma)
                                          (let g2 Ts (cons c (cons a g1))
                                            (let h2 Ts (mapT weaken2 (termsOr mH))
                                              (let z T (mArr d0 (single a) mStar)
                                                (if
                                                  (and (primIs G d0 nilPrim)
                                                    (and (primIs G d1 consPrim)
                                                      (and (equal (typeIn G n g uu) (some C))
                                                        (equal (typeIn G n (cons C (cons a g1)) s)
                                                          (some C)))))
                                                  (if
                                                    ((pf as 0) g1 (termsOr mH)
                                                     (mEq (subst tt (instVar z))
                                                       (subst uu (instVar z))))
                                                    (if
                                                      ((pf as 1) g2 h2
                                                       (mEq (listConsAt d1 a tt)
                                                         (subst s (atVar0 (weakenElem tt)))))
                                                      ((pf as 2) g2 h2
                                                       (mEq (listConsAt d1 a uu)
                                                         (subst s (atVar0 (weakenElem uu)))))
                                                      0)
                                                    0)
                                                  0))))))
                                      0)))))))
                        0)
                      (if (and (eq rl 21) (eq k 0)) (equal (nth hs d0) (some phi))
                        (if (and (eq rl 22) (eq k 2))
                          (if (isFormula G n g d0)
                            (if ((pf as 0) g hs d0) ((pf as 1) g (append hs (single d0)) phi) 0)
                            0)
                          (if (and (eq rl 23) (eq k 2))
                            (let m T ((rw as 0) g hs phi)
                              (if (isSome m) ((pf as 1) g hs (get m)) 0))
                            (if (and (eq rl 24) (eq k 2))
                              (if (and (isFormula G n g d0) (equal ((rw as 0) g hs d0) (some phi)))
                                ((pf as 1) g hs d0)
                                0)
                              (if (and (eq rl 25) (eq k 2))
                                (if (OTPair.isJust ep)
                                  (if (and (isFormula G n g tt) (isFormula G n g uu))
                                    (if ((pf as 0) g (append hs (single tt)) uu)
                                      ((pf as 1) g (append hs (single uu)) tt)
                                      0)
                                    0)
                                  0)
                                (if (and (eq rl 26) (eq k 1))
                                  (if (OTPair.isJust ep)
                                    (let mab OTPair.Maybe
                                      (let ty T (typeIn G n g tt)
                                        (if (isSome ty) (expParts (get ty)) OTPair.nothing))
                                      (if (OTPair.isJust mab)
                                        ((pf as 0) (cons (p1 (OTPair.fromMaybe pr0 mab)) g)
                                         (mapT weaken1 hs)
                                         (mEq (app (weaken1 tt) (var 0))
                                           (app (weaken1 uu) (var 0))))
                                        0))
                                    0)
                                  (if (eq rl 27)
                                    (let th Ts (children d1)
                                      (let sg Ts (children (at rd 2))
                                        (let ma OThm.Maybe (thmAt E d0)
                                          (if (OThm.isJust ma)
                                            (let a Thm (OThm.fromMaybe thm0 ma)
                                              (if
                                                (and (instOk G n g a th sg)
                                                  (and (equal phi (instTerm th sg (thConcl a)))
                                                    (eq k (length (thHyps a)))))
                                                (allT
                                                  (lam ((i T))
                                                    ((pf as i) g hs
                                                     (instTerm th sg (at (thHyps a) i))))
                                                  (range k))
                                                0))
                                            0))))
                                    (if (and (eq rl 28) (eq k 2))
                                      (if (not (isEmpty g))
                                        (let c T (at g 0)
                                          (let g1 Ts (tail g)
                                            (let mH OTerms.Maybe (lowerHyps G n g1 hs)
                                              (if (OTerms.isJust mH)
                                                (if
                                                  (and (equal c nat)
                                                    (and (primIs G d0 zeroPrim)
                                                      (and (primIs G d1 succPrim)
                                                        (isFormula G n g phi))))
                                                  (if
                                                    ((pf as 0) g1 (termsOr mH)
                                                     (subst phi (instVar (mArr d0 (nil T) mStar))))
                                                    ((pf as 1) g (append hs (single phi))
                                                     (natSuccAt d1 phi))
                                                    0)
                                                  0)
                                                0))))
                                        0)
                                      (if (and (eq rl 29) (eq k 2))
                                        (if (not (isEmpty g))
                                          (let c T (at g 0)
                                            (let g1 Ts (tail g)
                                              (let ma T (listPart c)
                                                (let mH OTerms.Maybe (lowerHyps G n g1 hs)
                                                  (if (and (isSome ma) (OTerms.isJust mH))
                                                    (let a T (get ma)
                                                      (if
                                                        (and (primIs G d0 nilPrim)
                                                          (and (primIs G d1 consPrim)
                                                            (isFormula G n g phi)))
                                                        (if
                                                          ((pf as 0) g1 (termsOr mH)
                                                           (subst phi
                                                             (instVar (mArr d0 (single a) mStar))))
                                                          ((pf as 1) (cons c (cons a g1))
                                                           (append (mapT weaken2 (termsOr mH))
                                                             (single (weakenElem phi)))
                                                           (listConsAt d1 a phi))
                                                          0)
                                                        0))
                                                    0)))))
                                          0)
                                        (if (and (eq rl 34) (eq k 2))
                                          (if (not (isEmpty g))
                                            (let c T (at g 0)
                                              (let g1 Ts (tail g)
                                                (let mab OTPair.Maybe (coprodParts c)
                                                  (let mH OTerms.Maybe (lowerHyps G n g1 hs)
                                                    (if (and (OTPair.isJust mab) (OTerms.isJust mH))
                                                      (let a T (p1 (OTPair.fromMaybe pr0 mab))
                                                        (let b T (p2 (OTPair.fromMaybe pr0 mab))
                                                          (if
                                                            (and (primIs G d0 inlPrim)
                                                              (and (primIs G d1 inrPrim)
                                                                (isFormula G n g phi)))
                                                            (if
                                                              ((pf as 0) (cons a g1) hs
                                                               (subst phi
                                                                 (atVar0
                                                                   (mArr d0 (l2 a b) (var 0)))))
                                                              ((pf as 1) (cons b g1) hs
                                                               (subst phi
                                                                 (atVar0
                                                                   (mArr d1 (l2 a b) (var 0)))))
                                                              0)
                                                            0)))
                                                      0)))))
                                            0)
                                          (if (and (eq rl 35) (eq k 0))
                                            (and (equal (nth g d0) (some cZero))
                                              (isFormula G n g phi))
                                            (if (and (eq rl 36) (eq k 1))
                                              (let th Ts (children d1)
                                                (let mp OPrimitive.Maybe
                                                  (OPrimitive.nthOf (gPrims G) d0)
                                                  (if (and (not (isEmpty g)) (OPrimitive.isJust mp))
                                                    (let c T (at g 0)
                                                      (let g1 Ts (tail g)
                                                        (let p Primitive
                                                          (OPrimitive.fromMaybe prim0 mp)
                                                          (if
                                                            (and (isCoeqProj p)
                                                              (OTerms.isJust (lowerHyps G n g1 hs)))
                                                            (if
                                                              (and (eq (length th) (prArity p))
                                                                (and (allT (isTy G n) th)
                                                                  (and
                                                                    (equal c (phSubst th (prCod p)))
                                                                    (isFormula G n g phi))))
                                                              ((pf as 0)
                                                               (cons (phSubst th (prDom p)) g1)
                                                               hs
                                                               (subst phi
                                                                 (atVar0 (mArr d0 th (var 0)))))
                                                              0)
                                                            0))))
                                                    0)))
                                              (if (and (eq rl 30) (eq k 0))
                                                (if (OTPair.isJust ep)
                                                  (let mq OSequent.Maybe (compileEq G n g tt uu)
                                                    (if (OSequent.isJust mq)
                                                      (certifies G E d0
                                                        (OSequent.fromMaybe seq0 mq))
                                                      0))
                                                  0)
                                                (if (and (eq rl 31) (eq k 0))
                                                  (if
                                                    (and (allT (isFormula G n g) hs)
                                                      (isFormula G n g phi))
                                                    (certifies G E d0
                                                      (thmSeq G (mkThm n (objs g) (terms hs) phi)))
                                                    0)
                                                  (if (and (eq rl 32) (eq k 2))
                                                    (if (and (OTPair.isJust ep) (eq (length g) 1))
                                                      (let r T (at g 0)
                                                        (let mC T (typeIn G n g tt)
                                                          (let ma T (roseLabel r)
                                                            (if (and (isSome mC) (isSome ma))
                                                              (let C T (get mC)
                                                                (let a T (get ma)
                                                                  (let s T (at rd 3)
                                                                    (let kl T d1
                                                                      (let kc T (at rd 2)
                                                                        (let g2 Ts (l2 (list r) a)
                                                                          (if
                                                                            (and
                                                                              (rosePrimsOk G d0 kl
                                                                                kc
                                                                                r
                                                                                a)
                                                                              (and
                                                                                (equal
                                                                                  (typeIn G n g uu)
                                                                                  (some C))
                                                                                (equal
                                                                                  (typeIn G n
                                                                                    (l2 (list C) a)
                                                                                    s)
                                                                                  (some C))))
                                                                            (if
                                                                              ((pf as 0) g2 (nil T)
                                                                               (mEq
                                                                                 (roseNodeAt d0 r a
                                                                                   tt)
                                                                                 (subst s
                                                                                   (atVar0
                                                                                     (roseMapAt kl
                                                                                       kc
                                                                                       C
                                                                                       tt)))))
                                                                              ((pf as 1) g2 (nil T)
                                                                               (mEq
                                                                                 (roseNodeAt d0 r a
                                                                                   uu)
                                                                                 (subst s
                                                                                   (atVar0
                                                                                     (roseMapAt kl
                                                                                       kc
                                                                                       C
                                                                                       uu)))))
                                                                              0)
                                                                            0)))))))
                                                              0))))
                                                      0)
                                                    (if (and (eq rl 33) (eq k 1))
                                                      (if (not (isEmpty g))
                                                        (let r T (at g 0)
                                                          (let g1 Ts (tail g)
                                                            (let ma T (roseLabel r)
                                                              (let mH OTerms.Maybe
                                                                (lowerHyps G n g1 hs)
                                                                (if
                                                                  (and (isSome ma)
                                                                    (OTerms.isJust mH))
                                                                  (let a T (get ma)
                                                                    (let kc T (at rd 2)
                                                                      (if
                                                                        (and
                                                                          (rosePrimsOk G d0 d1 kc r
                                                                            a)
                                                                          (isFormula G n g phi))
                                                                        ((pf as 0)
                                                                         (cons (list r) (cons a g1))
                                                                         (append
                                                                           (mapT weaken2
                                                                             (termsOr mH))
                                                                           (single
                                                                             (roseHyp d1 kc phi)))
                                                                         (roseNodeAt d0 r a phi))
                                                                        0)))
                                                                  0)))))
                                                        0)
                                                      0))))))))))))))))))))))))))

  ; the checker: the rewriting a derivation performs and whether it proves a formula, in a context
  ; under hypotheses
  (defn check ((G Globals) (E (List Entry)) (n T) (d T)) DV
    (snd
      (fold DP
        (lam ((l T) (rs DPs))
          (let ts Ts (dpTrees rs)
            (let rd Ts (children (at ts 0))
              (let as DPs (DPs.tail rs)
                (let ds Ts (tail ts)
                  (pair (node l ts)
                    (pair (lam ((g Ts) (hs Ts) (t T)) (rewriteStep G E n l rd ds as g hs t))
                      (lam ((g Ts) (hs Ts) (phi T)) (proveStep G E n l rd ds as g hs phi)))))))))
        d)))

  ; whether a derivation proves a theorem
  (defn thmChecks ((G Globals) (E (List Entry)) (a Thm) (d T)) T
    (let n T (thArity a)
      (let g Ts (thCtx a)
        (if
          (and (allT (isTy G n) g)
            (and (allT (isFormula G n g) (thHyps a)) (isFormula G n g (thConcl a))))
          ((snd (check G E n d)) g (thHyps a) (thConcl a))
          0))))

  ; the confirmation of primitive arrows, object definitions and definitions of the language
  (defn primSeq ((p Primitive)) Sequent
    (mkSeq (replicate (prArity p) Sorts.obj) (nil Eqn)
      (eqn (comp (idt (prCod p)) (comp (prArrow p) (idt (prDom p)))) (prArrow p))))
  (defn primConfirms ((G Globals) (E (List Entry)) (p Primitive) (c T)) T
    (if (isSome c)
      (if (anyDefs G (lam ((cds (List PDefn))) (primWf G (thySig (ext cds)) p)))
        (certifies G E (get c) (primSeq p))
        0)
      (anyDefs G
        (lam ((cds (List PDefn)))
          (if (eq (gBase G) (OpSigs.length sig)) (primOk G (envOfDefs cds) p) 0)))))
  (defn objConfirms ((G Globals) (E (List Entry)) (m T) (b T) (c T)) T
    (if (isSome c)
      (if
        (anyDefs G
          (lam ((cds (List PDefn)))
            (equal (sortOf (thySig (ext cds)) (replicate m Sorts.obj) b) (some Sorts.obj))))
        (certifies G E (get c) (mkSeq (replicate m Sorts.obj) (nil Eqn) (dfd b)))
        0)
      (anyDefs G
        (lam ((cds (List PDefn)))
          (if (eq (gBase G) (OpSigs.length sig)) (objOk (envOfDefs cds) m b) 0)))))
  (defn ldChecks ((G Globals) (d LDefn)) T
    (and (OPDefn.isJust (ldCompile G d)) (isTy G (ldArity d) (ldType d))))

  ; declarations, and the state of a development
  (data Decl (declLang Thm T) (declComb Sequent T) (declDef LDefn) (declConst Primitive T)
    (declObj T T T)
    (declQuot T T T)
    (declDesc T T T T))
  (data EntryList (entries & Entry))
  (data DevState (devState Globals EntryList))
  (import (Option DevState) as ODevState)
  (defn stateOf ((G Globals) (E (List Entry))) DevState (devState G (entries E)))
  (defn withPrims ((G Globals) (ps (List Primitive))) Globals
    (globals (prims ps) (defs (gDefs G)) (gBase G)))
  (defn withDefs ((G Globals) (ds (List Definition))) Globals
    (globals (prims (gPrims G)) (defs ds) (gBase G)))
  (defn push ((E (List Entry)) (e Entry)) (List Entry) (Entries.append E (Entries.single e)))
  (defn pushPrim ((ps (List Primitive)) (p Primitive)) (List Primitive)
    (Prims.append ps (Prims.single p)))
  (defn pushDef ((ds (List Definition)) (d Definition)) (List Definition)
    (Defs.append ds (Defs.single d)))
  (defn sortsArr ((G Globals) (m T) (f T)) T
    (anyDefs G
      (lam ((cds (List PDefn)))
        (equal (sortOf (thySig (ext cds)) (replicate m Sorts.obj) f) (some Sorts.arr)))))

  ; the bindings of optional values into optional states, as the base binds optional trees
  (defn bindPD ((m OTPair.Maybe) (f (Arrow TPair ODevState.Maybe))) ODevState.Maybe
    (case m ((OTPair.just p) (f p)) ((OTPair.nothing) ODevState.nothing)))
  (defn bindRD ((m OPrimitive.Maybe) (f (Arrow Primitive ODevState.Maybe))) ODevState.Maybe
    (case m ((OPrimitive.just p) (f p)) ((OPrimitive.nothing) ODevState.nothing)))
  (defn bindHD ((m OThm.Maybe) (f (Arrow Thm ODevState.Maybe))) ODevState.Maybe
    (case m ((OThm.just a) (f a)) ((OThm.nothing) ODevState.nothing)))
  (defn bindTD ((m T) (f (Arrow T ODevState.Maybe))) ODevState.Maybe
    (if (isSome m) (f (get m)) ODevState.nothing))
  (defn bindSD ((m ODevState.Maybe) (f (Arrow DevState ODevState.Maybe))) ODevState.Maybe
    (case m ((ODevState.just a) (f a)) ((ODevState.nothing) ODevState.nothing)))
  (defn stConsts ((st DevState)) Globals (case st ((devState G E) G)))
  (defn stEntries ((st DevState)) (List Entry)
    (case st ((devState G E) (case E ((entries xs) xs)))))

  ; the quotient of a type by a relation
  (defn quotStep ((G Globals) (E (List Entry)) (n T) (A T) (R T)) ODevState.Maybe
    (let AA Ts (l2 A A)
      (bindPD ((compile G n R) (ctxObj AA) (stdEnv AA))
        (lam ((rt TPair))
          (let f T (relL A (p1 rt))
            (let g T (relR A (p1 rt))
              (let q Primitive
                (primitive n (coeqProj f g) A
                  (phOp (add (gBase G) (Defs.length (gDefs G))) (objVars n)))
                (let G2 Globals
                  (globals (prims (pushPrim (gPrims G) q))
                    (defs (pushDef (gDefs G) (defObj n (coeqz f g))))
                    (gBase G))
                  (let k T (Prims.length (gPrims G))
                    (let rel Thm
                      (mkThm n (objs AA) (terms (single R))
                        (mEq (mArr k (objVars n) (var 1)) (mArr k (objVars n) (var 0))))
                      (if
                        (and (eq (gBase G) (OpSigs.length sig))
                          (and (isTy G n A)
                            (and (equal (p2 rt) omega)
                              (and (scoped n (prArrow q))
                                (and (isTy G2 n (prCod q))
                                  (and (sortsArr G n (prArrow q))
                                    (isFormula G2 n AA (thConcl rel))))))))
                        (ODevState.just (stateOf G2 (push E (entLang rel))))
                        ODevState.nothing)))))))))))

  ; the descent of a function through a quotient
  (defn descStep ((G Globals) (E (List Entry)) (kq T) (C T) (h T) (jr T)) ODevState.Maybe
    (bindRD (OPrimitive.nthOf (gPrims G) kq)
      (lam ((p Primitive))
        (bindHD (bindEH (OEntry.nthOf E jr) entryLanguage)
          (lam ((Th Thm))
            (bindTD (primRel p)
              (lam ((r T))
                (let m T (prArity p)
                  (let D Ts (single (prDom p))
                    (bindPD ((compile G m h) (ctxObj D) (stdEnv D))
                      (lam ((HC TPair))
                        (if (eq (length (thHyps Th)) 1)
                          (let R2 T (at (thHyps Th) 0)
                            (let DD Ts (l2 (prDom p) (prDom p))
                              (let dp Primitive
                                (primitive m
                                  (coeqDesc (relL (prDom p) r) (relR (prDom p) r) (p1 HC))
                                  (prCod p)
                                  C)
                                (let G2 Globals (withPrims G (pushPrim (gPrims G) dp))
                                  (let dq T
                                    (mArr (Prims.length (gPrims G)) (objVars m)
                                      (mArr kq (objVars m) (var 0)))
                                    (let cmp Thm (mkThm m (objs D) (terms (nil T)) (mEq dq h))
                                      (if
                                        (and (eq (gBase G) (OpSigs.length sig))
                                          (and (equal (p2 HC) C)
                                            (and (isTy G m C)
                                              (and (eq (thArity Th) m)
                                                (and (equalTs (thCtx Th) DD)
                                                  (and (equal (thConcl Th) (mEq (weaken1 h) h))
                                                    (and
                                                      (equal
                                                        (rep
                                                          ((compile G m R2) (ctxObj DD)
                                                           (stdEnv DD)))
                                                        (rep (OTPair.just (pr r omega))))
                                                      (and (scoped m (prArrow dp))
                                                        (and (sortsArr G m (prArrow dp))
                                                          (isFormula G2 m D (thConcl cmp)))))))))))
                                        (ODevState.just (stateOf G2 (push E (entLang cmp))))
                                        ODevState.nothing)))))))
                          ODevState.nothing))))))))))))

  ; the state after a declaration, where its proof proves it with the constants and the entries
  ; before it
  (defn declStep ((G Globals) (E (List Entry)) (d Decl)) ODevState.Maybe
    (case d
      ((declLang a dv)
       (if (thmChecks G E a dv) (ODevState.just (stateOf G (push E (entLang a))))
         ODevState.nothing))
      ((declComb s c)
       (if (certifies G E c s) (ODevState.just (stateOf G (push E (entComb s)))) ODevState.nothing))
      ((declDef df)
       (if (ldChecks G df)
         (ODevState.just (stateOf (withDefs G (pushDef (gDefs G) (defLang df))) E))
         ODevState.nothing))
      ((declConst p c)
       (if (primConfirms G E p c) (ODevState.just (stateOf (withPrims G (pushPrim (gPrims G) p)) E))
         ODevState.nothing))
      ((declObj m b c)
       (if (objConfirms G E m b c)
         (ODevState.just (stateOf (withDefs G (pushDef (gDefs G) (defObj m b))) E))
         ODevState.nothing))
      ((declQuot m A R) (quotStep G E m A R))
      ((declDesc kq C h jr) (descStep G E kq C h jr))))

  ; the state after a development, each declaration proved with those before it
  (import (Seq Decl) as Decls)
  (defn checkDev ((G Globals) (E (List Entry)) (ds (List Decl))) ODevState.Maybe
    (foldr Decl ODevState.Maybe
      (lam ((d Decl) (st ODevState.Maybe))
        (bindSD st (lam ((s DevState)) (declStep (stConsts s) (stEntries s) d))))
      (ODevState.just (stateOf G E))
      (Decls.reverse ds))))
