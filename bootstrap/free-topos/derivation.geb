;
; The checker of the internal language's derivations and of developments, written in the datatype
; language, deciding as Geb.FreeTopos.Internal decides: the rewriting a derivation performs and
; the judgments it proves, the sequents theorems compile to, the certificates of the combinators,
; and the check of a development's declarations, each with the constants and the entries before
; it. The rewriting is Geb.FreeTopos.Internal.checkFast's, under the hypotheses as stated with the
; number of variables past which they are weakened, each weakened where the rewriting at the root
; reads it. A derivation is the node of its rule's position among Geb.FreeTopos.Internal.Rule's
; constructors over the node of the rule's data followed by its children, a term among the data
; as the language encodes it, objects and terms the node of their list and a truth value a
; label. A theorem is the node of label 0 over its arity, the node of its context, the node of its
; hypotheses and its conclusion, an entry and a declaration the node of their constructor's
; position over their fields, an optional certificate the optional tree, and the state of a
; development the pair of its constants and the node of its entries, as their datatypes declare
; them.

(module Derivation
  (export thArity thHyps isFormula primIs zeroPrim succPrim nodePrim nilPrim consPrim lnodePrim
    inlPrim
    inrPrim
    casePrim
    instVar
    instVar2
    atVar0
    natSuccAt
    listConsAt
    roseNodeAt
    weakenElem
    weaken1
    weaken2
    weakenStep2
    roseMapAt
    roseHyp
    eqParts
    instTerm
    typeIn
    Terms
    terms
    lowerHyps
    Thm
    mkThm
    thCtx
    thConcl
    Entry
    entLang
    entComb
    entryLanguage
    thmAt
    scopesOf
    bindPT
    certifies
    Scope
    scope
    scopeCtx
    scopeHyps
    scope0
    Scopes
    scopes
    childCtxs
    Binder
    binderCtx
    binderNum
    binder0
    Binders
    bindersOf
    childBinders
    weakenBy
    rootStep
    rootStepK
    checkStep
    check
    Decl
    declLang
    declComb
    declDef
    declConst
    declObj
    declQuot
    declDesc
    EntryList
    entries
    DevState
    devState
    push
    declStep
    checkDev)
  (import Prelude)
  (import Base)
  (import PartialHorn)
  (import Theory)
  (import Infer)
  (import Language)

  (defn copairIn ((X T) (A T) (B T) (C T) (F T) (G T)) T
    (comp (ev X C)
      (cPair
        (comp
          (copair (curry A X (comp F (cPair (cSnd A X) (cFst A X))))
            (curry B X (comp G (cPair (cSnd B X) (cFst B X)))))
          (cSnd X (coprod A B)))
        (cFst X (coprod A B)))))
  (defn caseArr ((A T) (B T) (C T)) T
    (let P T (prod (exp A C) (exp B C))
      (curry P (coprod A B)
        (copairIn P A B C
          (comp (ev A C) (cPair (comp (cFst (exp A C) (exp B C)) (cFst P A)) (cSnd P A)))
          (comp (ev B C) (cPair (comp (cSnd (exp A C) (exp B C)) (cFst P B)) (cSnd P B)))))))

  ; the primitive arrows of the data objects and of coproducts
  (def zeroPrim (primitive 0 zeroN one nat))
  (def succPrim (primitive 0 succ nat nat))
  (def nilPrim (primitive 1 (cNil (x 0)) one (list (x 0))))
  (def consPrim (primitive 1 (cCons (x 0)) (prod (x 0) (list (x 0))) (list (x 0))))
  (def nodePrim (primitive 0 cNode (prod nat (list rose)) rose))
  (def lnodePrim (primitive 1 (lnode (x 0)) (prod (x 0) (list (lrose (x 0)))) (lrose (x 0))))
  (def inlPrim (primitive 2 (inl (x 0) (x 1)) (x 0) (coprod (x 0) (x 1))))
  (def inrPrim (primitive 2 (inr (x 0) (x 1)) (x 1) (coprod (x 0) (x 1))))
  (def casePrim
    (primitive 3 (caseArr (x 0) (x 1) (x 2)) (prod (exp (x 0) (x 2)) (exp (x 1) (x 2)))
      (exp (coprod (x 0) (x 1)) (x 2))))
  (defn primIs ((G Globals) (k T) (p Primitive)) T
    (equal (rep (Option.nthOf Primitive (gPrims G) k)) (rep (Option.just Primitive p))))
  (defn objVars ((n T)) Ts (mapT x (range n)))

  ; the recognition of a coequalizer's projection, and of a quotient's by a relation
  (defn isCoeqProj ((p Primitive)) T
    (let a T (prArrow p)
      (if (eq (arity a) 2)
        (let* ((f T (child a 0)) (g T (child a 1)))
          (if (and (eq (arity f) 2) (eq (arity g) 2))
            (and (equal a (coeqProj f g))
              (and (equal f (comp (child f 0) (child f 1)))
                (equal g (comp (child g 0) (child g 1)))))
            0))
        0)))
  (defn relL ((A T) (r T)) T (comp (cFst A A) (truthIncl r)))
  (defn relR ((A T) (r T)) T (comp (cSnd A A) (truthIncl r)))
  (defn primRel ((p Primitive)) T
    (let a T (prArrow p)
      (if (eq (arity a) 2)
        (let f T (child a 0)
          (if (eq (arity f) 2)
            (let m T (child f 1)
              (if (eq (arity m) 2)
                (let r T (child m 0)
                  (if (equal a (coeqProj (relL (prDom p) r) (relR (prDom p) r))) (some r) none))
                none))
            none))
        none)))

  ; substitutions for the innermost variables, and weakenings
  (defn instVar ((u T) (i T)) T (if (eq i 0) u (var (sub i 1))))
  (defn instVar2 ((u T) (v T) (i T)) T (cond ((eq i 0) u) ((eq i 1) v) (else (var (sub i 2)))))
  (defn atVar0 ((u T) (i T)) T (if (eq i 0) u (var i)))
  (defn natSuccAt ((ks T) (t T)) T (subst t (atVar0 (mArr ks (nil T) (var 0)))))
  (defn listConsAt ((kc T) (a T) (t T)) T
    (subst t
      (lam ((i T)) (if (eq i 0) (mArr kc (single a) (mPair (var 1) (var 0))) (var (add i 1))))))
  (defn roseNodeAt ((kn T) (r T) (a T) (t T)) T
    (subst t
      (lam ((i T))
        (if (eq i 0) (mArr kn (if (equal r rose) (nil T) (single a)) (mPair (var 1) (var 0)))
          (var (add i 1))))))
  (defn weakenElem ((t T)) T (rename t (lam ((i T)) (if (eq i 0) 0 (add i 1)))))
  (defn weaken1 ((t T)) T (rename t (lam ((i T)) (add i 1))))
  (defn weaken2 ((t T)) T (rename t (lam ((i T)) (add i 2))))
  (defn weakenStep2 ((s T)) T (rename s (lam ((i T)) (if (eq i 0) 0 (add i 2)))))
  (defn lower1 ((t T)) T (rename t (lam ((i T)) (sub i 1))))
  (defn roseMapAt ((kl T) (kc T) (c T) (t T)) T
    (mListRec (mArr kl (single c) mStar)
      (mArr kc (single c) (mPair (rename t (lam ((i T)) (if (eq i 0) 1 (add i 3)))) (var 0)))
      (var 0)))
  (defn roseHyp ((kl T) (kc T) (phi T)) T
    (mEq (roseMapAt kl kc omega phi) (roseMapAt kl kc omega (mEq mStar mStar))))

  ; the image of an optional pair of trees, as the base maps optional trees
  (defn mapPT ((f (Arrow TPair T)) (m (Option.Maybe TPair))) T
    (case m ((Option.just TPair p) (some (f p))) ((Option.nothing TPair) none)))

  ; the sides of an equation, the instance of a theorem's term, and the type of a term in a context
  (def pr0 (pr 0 0))
  (defn eqParts ((phi T)) (Option.Maybe TPair)
    (if (mIs 12 2 phi) (Option.just TPair (pr (mArg phi 0) (mArg phi 1))) (Option.nothing TPair)))
  (defn instTerm ((th Ts) (sg Ts) (s T)) T (subst (osubst th s) (substList sg)))
  (defn typeIn ((G Globals) (n T) (g Ts) (t T)) T ((typeOf G n t) g))
  (defn isFormula ((G Globals) (n T) (g Ts) (t T)) T (equal (typeIn G n g t) (some omega)))

  ; hypotheses that do not mention the innermost variable, in the context without it
  (data Terms (terms & T))

  (defn allSomeTerms ((ms Ts)) (Option.Maybe Terms)
    (if (allT isSome ms) (Option.just Terms (terms (mapT get ms))) (Option.nothing Terms)))
  (defn termsOr ((m (Option.Maybe Terms))) Ts
    (case m ((Option.just Terms h) (case h ((terms & xs) xs))) ((Option.nothing Terms) (nil T))))
  (defn lowerHyps ((G Globals) (n T) (g Ts) (hs Ts)) (Option.Maybe Terms)
    (allSomeTerms
      (mapT
        (lam ((h T))
          (let l T (lower1 h) (if (and (equal (weaken1 l) h) (isFormula G n g l)) (some l) none)))
        hs)))

  ; theorems: an arity, a context, hypotheses and a conclusion
  (data Thm (mkThm T Objs Terms T))
  (defn thArity ((a Thm)) T (case a ((mkThm m c h q) m)))
  (defn thCtx ((a Thm)) Ts (case a ((mkThm m c h q) (case c ((objs & xs) xs)))))
  (defn thHyps ((a Thm)) Ts (case a ((mkThm m c h q) (case h ((terms & xs) xs)))))
  (defn thConcl ((a Thm)) T (case a ((mkThm m c h q) q)))

  (def thm0 (mkThm 0 (objs (nil T)) (terms (nil T)) 0))

  ; whether objects and terms instantiate a theorem in a context
  (defn instOk ((G Globals) (n T) (g Ts) (a Thm) (th Ts) (sg Ts)) T
    (and (eq (length th) (thArity a))
      (and (allT (isTy G n) th)
        (and (eq (length sg) (length (thCtx a)))
          (allT (lam ((i T)) (equal (typeIn G n g (at sg i)) (some (phSubst th (at (thCtx a) i)))))
            (range (length sg)))))))

  ; the subobject on which arrows into the subobject classifier are truth, with its inclusion
  (defn truthSub ((X T) (hs Ts)) TPair
    (foldr T TPair
      (lam ((h T) (p TPair)) (let c T (comp h (p2 p)) (pr (truthEq c) (comp (p2 p) (truthIncl c)))))
      (pr X (idt X))
      (reverse hs)))

  ; the sequent of the combinators a theorem compiles to
  (defn thmArrow ((G Globals) (a Thm) (phi T)) T
    (getD (mapPT p1 ((compile G (thArity a) phi) (ctxObj (thCtx a)) (stdEnv (thCtx a))))
      (idt (ctxObj (thCtx a)))))
  (defn thmSide ((G Globals) (a Thm) (f T)) T
    (if (isEmpty (thHyps a)) f
      (comp f (p2 (truthSub (ctxObj (thCtx a)) (mapT (thmArrow G a) (thHyps a)))))))
  (defn thmSeq ((G Globals) (a Thm)) Sequent
    (let ep (Option.Maybe TPair) (eqParts (thConcl a))
      (mkSeq (replicate (thArity a) Sorts.obj) (nil Eqn)
        (if (Option.isJust TPair ep)
          (eqn (thmSide G a (thmArrow G a (p1 (Option.fromMaybe TPair pr0 ep))))
            (thmSide G a (thmArrow G a (p2 (Option.fromMaybe TPair pr0 ep)))))
          (eqn (thmSide G a (thmArrow G a (thConcl a)))
            (thmSide G a (comp tru (bang (ctxObj (thCtx a))))))))))

  ; the entries of a development: theorems of the language and sequents of the combinators
  (data Entry (entLang Thm) (entComb Sequent))

  (defn entryLanguage ((e Entry)) (Option.Maybe Thm)
    (case e ((entLang a) (Option.just Thm a)) ((entComb s) (Option.nothing Thm))))
  (defn bindEH ((m (Option.Maybe Entry)) (f (Arrow Entry (Option.Maybe Thm)))) (Option.Maybe Thm)
    (case m ((Option.just Entry e) (f e)) ((Option.nothing Entry) (Option.nothing Thm))))
  (defn thmAt ((E (List Entry)) (i T)) (Option.Maybe Thm)
    (bindEH (Option.nthOf Entry E i) entryLanguage))
  (defn entrySeq ((G Globals) (e Entry)) Sequent
    (case e ((entLang a) (thmSeq G a)) ((entComb s) s)))

  ; whether the compilations of the constants' definitions pass a test, and whether a certificate
  ; proves a sequent in the theory they extend, with the entries' sequents as its theorems
  (def pdl0 (pdefns (nil PDefn)))
  (defn pdefnsOf ((l PDefnList)) (List PDefn) (case l ((pdefns & xs) xs)))
  (defn anyDefs ((G Globals) (f (Arrow (List PDefn) T))) T
    (let cd (Option.Maybe PDefnList) (compileDefs G)
      (if (Option.isJust PDefnList cd) (f (pdefnsOf (Option.fromMaybe PDefnList pdl0 cd))) 0)))

  (defn certifies ((G Globals) (E (List Entry)) (c T) (s Sequent)) T
    (anyDefs G
      (lam ((cds (List PDefn)))
        (if (eq (gBase G) (Seq.length OpSig sig))
          (equal
            (rep
              ((pcheck (ext cds) (Map.map Entry Sequent (entrySeq G) E) c) (seqCtx s) (seqHyps s)))
            (rep (Option.just Eqn (seqConcl s))))
          0))))

  ; the contexts and hypotheses of a node's children
  (data Scope (scope Objs Terms))
  (defn scopeCtx ((c Scope)) Ts (case c ((scope g hs) (case g ((objs & xs) xs)))))
  (defn scopeHyps ((c Scope)) Ts (case c ((scope g hs) (case hs ((terms & xs) xs)))))
  (defn ctxPair ((g Ts) (hs Ts)) Scope (scope (objs g) (terms hs)))

  (data Scopes (scopes & Scope))
  (defn scopesOf ((c Scopes)) (List Scope) (case c ((scopes & xs) xs)))

  (def scope0 (ctxPair (nil T) (nil T)))
  ; a child's context with the number of variables by which it extends its node's
  (data Binder (binder Objs T))
  (defn binderCtx ((b Binder)) Ts (case b ((binder g m) (case g ((objs & xs) xs)))))
  (defn binderNum ((b Binder)) T (case b ((binder g m) m)))
  (defn ctxNum ((g Ts) (m T)) Binder (binder (objs g) m))

  (data Binders (binders & Binder))
  (defn bindersOf ((c Binders)) (List Binder) (case c ((binders & xs) xs)))

  (def binder0 (ctxNum (nil T) 0))
  (defn bindTB ((m T) (f (Arrow T (Option.Maybe Binders)))) (Option.Maybe Binders)
    (if (isSome m) (f (get m)) (Option.nothing Binders)))
  (defn bindBT ((m (Option.Maybe Binders)) (f (Arrow Binders T))) T
    (case m ((Option.just Binders c) (f c)) ((Option.nothing Binders) none)))
  (defn bindTS ((m T) (f (Arrow T (Option.Maybe Scopes)))) (Option.Maybe Scopes)
    (if (isSome m) (f (get m)) (Option.nothing Scopes)))
  (defn bindST ((m (Option.Maybe Scopes)) (f (Arrow Scopes T))) T
    (case m ((Option.just Scopes c) (f c)) ((Option.nothing Scopes) none)))
  (defn childCtxs ((G Globals) (n T) (t T) (g Ts) (hs Ts)) (Option.Maybe Scopes)
    (let* ((l T (label t)) (ts Ts (mArgs t)) (k T (length ts)))
      (cond
        ((and (eq l 5) (eq k 1))
         (Option.just Scopes
           (scopes (Seq.single Scope (ctxPair (cons (mD t 0) g) (mapT weaken1 hs))))))
        ((and (eq l 8) (eq k 3))
         (bindTS (typeIn G n g (at ts 0))
           (lam ((c T))
             (Option.just Scopes
               (scopes
                 (Few.l3 Scope (ctxPair g hs) (ctxPair (cons c g) (mapT weaken1 hs))
                   (ctxPair g hs)))))))
        ((and (eq l 9) (eq k 3))
         (bindTS (typeIn G n g (at ts 0))
           (lam ((c T))
             (bindTS (bindO (typeIn G n g (at ts 2)) listPart)
               (lam ((a T))
                 (Option.just Scopes
                   (scopes
                     (Few.l3 Scope (ctxPair g hs) (ctxPair (cons c (cons a g)) (mapT weaken2 hs))
                       (ctxPair g hs)))))))))
        ((and (eq l 10) (eq k 2))
         (bindTS (bindO (typeIn G n g (at ts 1)) roseLabel)
           (lam ((a T))
             (Option.just Scopes
               (scopes
                 (Few.l2 Scope (ctxPair (cons (prod a (list (mD t 0))) g) (mapT weaken1 hs))
                   (ctxPair g hs)))))))
        (else (Option.just Scopes (scopes (Map.map T Scope (lam ((u T)) (ctxPair g hs)) ts)))))))
  (defn sameCtx ((l T) (i T)) T
    (cond ((eq l 5) 0) ((or (eq l 8) (eq l 9)) (not (eq i 1))) ((eq l 10) (eq i 1)) (else 1)))
  ; the contexts of a node's children, each with the number of variables by which it extends the
  ; node's, as childCtxs computes them
  (defn childBinders ((G Globals) (n T) (t T) (g Ts)) (Option.Maybe Binders)
    (let* ((l T (label t)) (ts Ts (mArgs t)) (k T (length ts)))
      (cond
        ((and (eq l 5) (eq k 1))
         (Option.just Binders (binders (Seq.single Binder (ctxNum (cons (mD t 0) g) 1)))))
        ((and (eq l 8) (eq k 3))
         (bindTB (typeIn G n g (at ts 0))
           (lam ((c T))
             (Option.just Binders
               (binders (Few.l3 Binder (ctxNum g 0) (ctxNum (cons c g) 1) (ctxNum g 0)))))))
        ((and (eq l 9) (eq k 3))
         (bindTB (typeIn G n g (at ts 0))
           (lam ((c T))
             (bindTB (bindO (typeIn G n g (at ts 2)) listPart)
               (lam ((a T))
                 (Option.just Binders
                   (binders
                     (Few.l3 Binder (ctxNum g 0) (ctxNum (cons c (cons a g)) 2) (ctxNum g 0)))))))))
        ((and (eq l 10) (eq k 2))
         (bindTB (bindO (typeIn G n g (at ts 1)) roseLabel)
           (lam ((a T))
             (Option.just Binders
               (binders
                 (Few.l2 Binder (ctxNum (cons (prod a (list (mD t 0))) g) 1) (ctxNum g 0)))))))
        (else (Option.just Binders (binders (Map.map T Binder (lam ((u T)) (ctxNum g 0)) ts)))))))
  ; the contexts in which a congruence rewrites a node's children by the derivations ds, each with
  ; the number of variables by which it extends the node's
  (defn congBinders ((G Globals) (n T) (t T) (g Ts) (ds Ts)) (Option.Maybe Binders)
    (if (allT (lam ((i T)) (or (sameCtx (label t) i) (eq (label (at ds i)) 0))) (range (length ds)))
      (Option.just Binders (binders (Map.map T Binder (lam ((u T)) (ctxNum g 0)) (mArgs t))))
      (childBinders G n t g)))

  ; the rewritings of a term at its root by the rules of the language's equations, each by one
  ; rule: beta, the components of a pair, the eta of pairs and of the terminal type, the unfolding
  ; of a definition, the folds of the natural numbers, lists and rose trees at their constructions,
  ; the case analysis of a coproduct, an equational theorem and an equation among the hypotheses
  (defn rootBeta ((t T)) T
    (let a0 T (mArg t 0)
      (if (and (mIs 6 2 t) (mIs 5 1 a0)) (some (subst (mArg a0 0) (instVar (mArg t 1)))) none)))
  (defn rootFst ((t T)) T
    (let a0 T (mArg t 0) (if (and (mIs 3 1 t) (mIs 2 2 a0)) (some (mArg a0 0)) none)))
  (defn rootSnd ((t T)) T
    (let a0 T (mArg t 0) (if (and (mIs 4 1 t) (mIs 2 2 a0)) (some (mArg a0 1)) none)))
  (defn rootPairEta ((t T)) T
    (let* ((a0 T (mArg t 0)) (a1 T (mArg t 1)))
      (if (and (mIs 2 2 t) (and (mIs 3 1 a0) (mIs 4 1 a1)))
        (if (equal (mArg a0 0) (mArg a1 0)) (some (mArg a0 0)) none)
        none)))
  ; the images and bindings of optional values, as the base maps and binds optional trees
  (defn mapLT ((f (Arrow LDefn T)) (m (Option.Maybe LDefn))) T
    (case m ((Option.just LDefn d) (some (f d))) ((Option.nothing LDefn) none)))
  (defn bindPT ((m (Option.Maybe TPair)) (f (Arrow TPair T))) T
    (case m ((Option.just TPair p) (f p)) ((Option.nothing TPair) none)))
  (defn bindHT ((m (Option.Maybe Thm)) (f (Arrow Thm T))) T
    (case m ((Option.just Thm a) (f a)) ((Option.nothing Thm) none)))
  (defn rootUnitEta ((G Globals) (n T) (g Ts) (t T)) T
    (if (equal (typeIn G n g t) (some one)) (some mStar) none))
  (defn rootDelta ((G Globals) (t T)) T
    (if (eq (label t) 11)
      (mapLT
        (lam ((df LDefn)) (subst (osubst (children (mD t 1)) (ldBody df)) (substList (mArgs t))))
        (bindDL (Option.nthOf Definition (gDefs G) (mD t 0)) defLanguage))
      none))
  (defn rootNat ((G Globals) (rl T) (rd Ts) (t T)) T
    (let* ((a0 T (mArg t 0)) (a1 T (mArg t 1)) (a2 T (mArg t 2)))
      (if (and (mIs 8 3 t) (and (mIs 7 1 a2) (eq (arity (mD a2 1)) 0)))
        (let k T (at rd 0)
          (cond
            ((eq rl 9)
             (if (and (eq (mD a2 0) k) (and (primIs G k zeroPrim) (equal (mArg a2 0) mStar)))
               (some a0)
               none))
            ((and (eq (mD a2 0) k) (primIs G k succPrim))
             (some (subst a1 (instVar (mNatRec a0 a1 (mArg a2 0))))))
            (else none)))
        none)))
  (defn rootListNil ((G Globals) (rd Ts) (t T)) T
    (let a2 T (mArg t 2)
      (if (and (mIs 9 3 t) (and (mIs 7 1 a2) (eq (arity (mD a2 1)) 1)))
        (let k T (at rd 0)
          (if (and (eq (mD a2 0) k) (and (primIs G k nilPrim) (equal (mArg a2 0) mStar)))
            (some (mArg t 0))
            none))
        none)))
  (defn rootListCons ((G Globals) (rd Ts) (t T)) T
    (let a2 T (mArg t 2)
      (if (and (mIs 9 3 t) (and (mIs 7 1 a2) (eq (arity (mD a2 1)) 1)))
        (let* ((p T (mArg a2 0)) (k T (at rd 0)))
          (if (and (mIs 2 2 p) (and (eq (mD a2 0) k) (primIs G k consPrim)))
            (some
              (subst (mArg t 1) (instVar2 (mListRec (mArg t 0) (mArg t 1) (mArg p 1)) (mArg p 0))))
            none))
        none)))
  (defn rootRoseNode ((G Globals) (rd Ts) (t T)) T
    (let* ((a0 T (mArg t 0)) (a1 T (mArg t 1)))
      (if (and (mIs 10 2 t) (mIs 7 1 a1))
        (let* ((p T (mArg a1 0)) (kn T (at rd 0)) (kl T (at rd 1)) (kc T (at rd 2)) (c T (mD t 0)))
          (if
            (and (mIs 2 2 p)
              (and (eq (mD a1 0) kn)
                (and (or (primIs G kn nodePrim) (primIs G kn lnodePrim))
                  (and (primIs G kl nilPrim) (primIs G kc consPrim)))))
            (some
              (subst a0
                (instVar
                  (mPair (mArg p 0)
                    (mListRec (mArr kl (single c) mStar)
                      (mArr kc (single c) (mPair (mRoseRec c (weakenStep2 a0) (var 1)) (var 0)))
                      (mArg p 1))))))
            none))
        none)))
  (defn rootCase ((G Globals) (pj Primitive) (i T) (rd Ts) (t T)) T
    (let* ((a0 T (mArg t 0)) (a1 T (mArg t 1)))
      (if (and (mIs 6 2 t) (and (mIs 7 1 a0) (mIs 7 1 a1)))
        (let* ((p T (mArg a0 0)) (kc T (at rd 0)) (kj T (at rd 1)))
          (if
            (and (mIs 2 2 p)
              (and (eq (mD a0 0) kc)
                (and (eq (mD a1 0) kj) (and (primIs G kc casePrim) (primIs G kj pj)))))
            (some (app (mArg p i) (mArg a1 0)))
            none))
        none)))
  (defn rootThm ((G Globals) (E (List Entry)) (n T) (g Ts) (rd Ts) (t T)) T
    (let* ((th Ts (children (at rd 1))) (sg Ts (children (at rd 2))) (fl T (at rd 3)))
      (bindHT (bindEH (Option.nthOf Entry E (at rd 0)) entryLanguage)
        (lam ((a Thm))
          (bindPT (if (isEmpty (thHyps a)) (eqParts (thConcl a)) (Option.nothing TPair))
            (lam ((lr TPair))
              (if (and (instOk G n g a th sg) (equal t (instTerm th sg (if fl (p2 lr) (p1 lr)))))
                (some (instTerm th sg (if fl (p1 lr) (p2 lr))))
                none)))))))
  (defn rootHyp ((hs Ts) (rd Ts) (t T)) T
    (let fl T (at rd 1)
      (bindPT (bindTP (nth hs (at rd 0)) eqParts)
        (lam ((lr TPair))
          (if (equal t (if fl (p2 lr) (p1 lr))) (some (if fl (p1 lr) (p2 lr))) none)))))

  ; the rewriting of a term at its root by a rule of the language's equations
  (defn rootStep ((G Globals) (E (List Entry)) (n T) (g Ts) (hs Ts) (rl T) (rd Ts) (t T)) T
    (cond ((eq rl 3) (rootBeta t)) ((eq rl 4) (rootFst t)) ((eq rl 5) (rootSnd t))
      ((eq rl 6) (rootPairEta t))
      ((eq rl 7) (rootUnitEta G n g t))
      ((eq rl 8) (rootDelta G t))
      ((or (eq rl 9) (eq rl 10)) (rootNat G rl rd t))
      ((eq rl 11) (rootListNil G rd t))
      ((eq rl 12) (rootListCons G rd t))
      ((eq rl 13) (rootRoseNode G rd t))
      ((eq rl 14) (rootCase G inlPrim 0 rd t))
      ((eq rl 15) (rootCase G inrPrim 1 rd t))
      ((eq rl 16) (rootThm G E n g rd t))
      ((eq rl 17) (rootHyp hs rd t))
      (else none)))

  ; a term weakened past k new innermost variables, the term itself past none
  (defn weakenBy ((k T) (psi T)) T (if (eq k 0) psi (rename psi (lam ((i T)) (add i k)))))
  ; the rewriting of a term at its root by a rule under the hypotheses weakened past k new
  ; innermost variables, from the hypotheses before the weakening: an equation among them
  ; weakened alone, and the other rules under none of the hypotheses, which they do not read
  (defn rootHypK ((k T) (hs Ts) (rd Ts) (t T)) T
    (let fl T (at rd 1)
      (bindPT (bindTP (nth hs (at rd 0)) eqParts)
        (lam ((lr TPair))
          (if (equal t (weakenBy k (if fl (p2 lr) (p1 lr))))
            (some (weakenBy k (if fl (p1 lr) (p2 lr))))
            none)))))
  (defn rootStepK ((G Globals) (E (List Entry)) (n T) (g Ts) (k T) (hs Ts) (rl T) (rd Ts) (t T)) T
    (if (eq rl 17) (rootHypK k hs rd t) (rootStep G E n g (nil T) rl rd t)))

  ; the checker's result at a node: a function of a mode, 0 the rewriting and 1 the proving, a
  ; context, a number of variables, hypotheses and a term; the rewriting under the hypotheses
  ; weakened past that number of new innermost variables, the proving under the hypotheses, at the
  ; number zero
  (deftype CK (Arrow T (Arrow Ts (Arrow T (Arrow Ts (Arrow T T))))))
  (deftype CKs (List CK))
  (def ck0 (lam ((md T) (g Ts) (k T) (hs Ts) (t T)) 0))

  ; one step of the rewriting other than a congruence, at a node of a rule of m premises c0 and c1,
  ; under the hypotheses weakened past k new innermost variables: they are weakened where the
  ; rewriting at the root reads them, rather than at each congruence past a binder
  (defn rewriteStep
    ((G Globals) (E (List Entry)) (n T) (rl T) (rd Ts) (m T) (c0 CK) (c1 CK) (g Ts) (k T) (hs Ts)
     (t T))
    T
    (cond ((and (eq rl 0) (eq m 0)) (some t))
      ((and (eq rl 1) (eq m 2)) (bindO (c0 0 g k hs t) (lam ((u T)) (c1 0 g k hs u))))
      ((eq m 0) (rootStepK G E n g k hs rl rd t))
      (else none)))
  ; the premises' rewritings at their contexts and terms, composed into one function: whether each
  ; rewrites, and their results
  (deftype CR (Arrow (List Binder) (Arrow T (Arrow Ts (Arrow Ts (Prod T Ts))))))
  (defn congAll ((cs CKs)) CR
    (foldr CK CR
      (lam ((c CK) (rest CR) (bx (List Binder)) (k T) (hs Ts) (us Ts))
        (lcase Binder (Prod T Ts) bx (pair 0 (nil T))
          (lam ((b Binder) (bx1 (List Binder)))
            (lcase T (Prod T Ts) us (pair 0 (nil T))
              (lam ((u T) (us1 Ts))
                (let*
                  ((r T (c 0 (binderCtx b) (add k (binderNum b)) hs u))
                   (s (Prod T Ts) (rest bx1 k hs us1)))
                  (pair (and (isSome r) (fst s)) (cons (get r) (snd s)))))))))
      (lam ((bx (List Binder)) (k T) (hs Ts) (us Ts)) (pair 1 (nil T)))
      cs))
  ; the rewriting by a congruence, of the premises' composed rewritings f
  (defn congStep ((G Globals) (n T) (ds Ts) (f CR) (g Ts) (k T) (hs Ts) (t T)) T
    (bindBT (congBinders G n t g ds)
      (lam ((bxN Binders))
        (let* ((bx (List Binder) (bindersOf bxN)) (ta Ts (mArgs t)))
          (if (and (eq (length ds) (length ta)) (eq (Seq.length Binder bx) (length ta)))
            (let s (Prod T Ts) (f bx k hs ta)
              (if (fst s) (some (node (label t) (cons (child t 0) (snd s)))) none))
            none)))))

  ; the premises of induction on the innermost variable of a type of the data objects
  (defn rosePrimsOk ((G Globals) (kn T) (kl T) (kc T) (r T) (a T)) T
    (and
      (or (and (primIs G kn nodePrim) (equal r rose))
        (and (primIs G kn lnodePrim) (equal r (lrose a))))
      (and (primIs G kl nilPrim) (primIs G kc consPrim))))

  ; one step of the proving, at a node of a rule, from its children's results
  (def prim0 (primitive 0 0 0 0))
  (def seq0 (mkSeq (nil T) (nil Eqn) (eqn 0 0)))
  (defn proveStep
    ((G Globals) (E (List Entry)) (n T) (rl T) (rd Ts) (m T) (c0 CK) (c1 CK) (c2 CK) (g Ts) (hs Ts)
     (phi T))
    T
    (let*
      ((k T m) (ep (Option.Maybe TPair) (eqParts phi)) (tt T (p1 (Option.fromMaybe TPair pr0 ep)))
       (uu T (p2 (Option.fromMaybe TPair pr0 ep)))
       (d0 T (at rd 0))
       (d1 T (at rd 1)))
      (cond
        ((and (eq rl 18) (eq k 2))
         (if (Option.isJust TPair ep)
           (let* ((v T (c0 0 g 0 hs tt)) (w T (c1 0 g 0 hs uu)))
             (and (isSome v) (and (isSome w) (equal (get v) (get w)))))
           0))
        ((and (eq rl 19) (eq k 3))
         (if (and (Option.isJust TPair ep) (not (isEmpty g)))
           (let*
             ((c T (at g 0)) (g1 Ts (tail g)) (s T (at rd 2)) (mC T (typeIn G n g tt))
              (mH (Option.Maybe Terms) (lowerHyps G n g1 hs)))
             (if (and (isSome mC) (Option.isJust Terms mH))
               (let* ((C T (get mC)) (z T (mArr d0 (nil T) mStar)))
                 (if
                   (and (equal c nat)
                     (and (primIs G d0 zeroPrim)
                       (and (primIs G d1 succPrim)
                         (and (equal (typeIn G n g uu) (some C))
                           (equal (typeIn G n (cons C g1) s) (some C))))))
                   (if (c0 1 g1 0 (termsOr mH) (mEq (subst tt (instVar z)) (subst uu (instVar z))))
                     (if (c1 1 g 0 hs (mEq (natSuccAt d1 tt) (subst s (atVar0 tt))))
                       (c2 1 g 0 hs (mEq (natSuccAt d1 uu) (subst s (atVar0 uu))))
                       0)
                     0)
                   0))
               0))
           0))
        ((and (eq rl 20) (eq k 3))
         (if (and (Option.isJust TPair ep) (not (isEmpty g)))
           (let*
             ((c T (at g 0)) (g1 Ts (tail g)) (s T (at rd 2)) (mC T (typeIn G n g tt))
              (ma T (listPart c))
              (mH (Option.Maybe Terms) (lowerHyps G n g1 hs)))
             (if (and (isSome mC) (and (isSome ma) (Option.isJust Terms mH)))
               (let*
                 ((C T (get mC)) (a T (get ma)) (g2 Ts (cons c (cons a g1)))
                  (h2 Ts (mapT weaken2 (termsOr mH)))
                  (z T (mArr d0 (single a) mStar)))
                 (if
                   (and (primIs G d0 nilPrim)
                     (and (primIs G d1 consPrim)
                       (and (equal (typeIn G n g uu) (some C))
                         (equal (typeIn G n (cons C (cons a g1)) s) (some C)))))
                   (if (c0 1 g1 0 (termsOr mH) (mEq (subst tt (instVar z)) (subst uu (instVar z))))
                     (if
                       (c1 1 g2 0 h2 (mEq (listConsAt d1 a tt) (subst s (atVar0 (weakenElem tt)))))
                       (c2 1 g2 0 h2 (mEq (listConsAt d1 a uu) (subst s (atVar0 (weakenElem uu)))))
                       0)
                     0)
                   0))
               0))
           0))
        ((and (eq rl 21) (eq k 0)) (equal (nth hs d0) (some phi)))
        ((and (eq rl 22) (eq k 2))
         (if (isFormula G n g d0) (if (c0 1 g 0 hs d0) (c1 1 g 0 (append hs (single d0)) phi) 0) 0))
        ((and (eq rl 23) (eq k 2))
         (let m T (c0 0 g 0 hs phi) (if (isSome m) (c1 1 g 0 hs (get m)) 0)))
        ((and (eq rl 24) (eq k 2))
         (if (and (isFormula G n g d0) (equal (c0 0 g 0 hs d0) (some phi))) (c1 1 g 0 hs d0) 0))
        ((and (eq rl 25) (eq k 2))
         (if (Option.isJust TPair ep)
           (if (and (isFormula G n g tt) (isFormula G n g uu))
             (if (c0 1 g 0 (append hs (single tt)) uu) (c1 1 g 0 (append hs (single uu)) tt) 0)
             0)
           0))
        ((and (eq rl 26) (eq k 1))
         (if (Option.isJust TPair ep)
           (let mab (Option.Maybe TPair)
             (let ty T (typeIn G n g tt)
               (if (isSome ty) (expParts (get ty)) (Option.nothing TPair)))
             (if (Option.isJust TPair mab)
               (c0 1 (cons (p1 (Option.fromMaybe TPair pr0 mab)) g) 0 (mapT weaken1 hs)
                 (mEq (app (weaken1 tt) (var 0)) (app (weaken1 uu) (var 0))))
               0))
           0))
        ((eq rl 27) 0)
        ((and (eq rl 28) (eq k 2))
         (if (not (isEmpty g))
           (let* ((c T (at g 0)) (g1 Ts (tail g)) (mH (Option.Maybe Terms) (lowerHyps G n g1 hs)))
             (if (Option.isJust Terms mH)
               (if
                 (and (equal c nat)
                   (and (primIs G d0 zeroPrim) (and (primIs G d1 succPrim) (isFormula G n g phi))))
                 (if (c0 1 g1 0 (termsOr mH) (subst phi (instVar (mArr d0 (nil T) mStar))))
                   (c1 1 g 0 (append hs (single phi)) (natSuccAt d1 phi))
                   0)
                 0)
               0))
           0))
        ((and (eq rl 29) (eq k 2))
         (if (not (isEmpty g))
           (let*
             ((c T (at g 0)) (g1 Ts (tail g)) (ma T (listPart c))
              (mH (Option.Maybe Terms) (lowerHyps G n g1 hs)))
             (if (and (isSome ma) (Option.isJust Terms mH))
               (let a T (get ma)
                 (if (and (primIs G d0 nilPrim) (and (primIs G d1 consPrim) (isFormula G n g phi)))
                   (if (c0 1 g1 0 (termsOr mH) (subst phi (instVar (mArr d0 (single a) mStar))))
                     (c1 1 (cons c (cons a g1)) 0
                       (append (mapT weaken2 (termsOr mH)) (single (weakenElem phi)))
                       (listConsAt d1 a phi))
                     0)
                   0))
               0))
           0))
        ((and (eq rl 34) (eq k 2))
         (if (not (isEmpty g))
           (let*
             ((c T (at g 0)) (g1 Ts (tail g)) (mab (Option.Maybe TPair) (coprodParts c))
              (mH (Option.Maybe Terms) (lowerHyps G n g1 hs)))
             (if (and (Option.isJust TPair mab) (Option.isJust Terms mH))
               (let*
                 ((a T (p1 (Option.fromMaybe TPair pr0 mab)))
                  (b T (p2 (Option.fromMaybe TPair pr0 mab))))
                 (if (and (primIs G d0 inlPrim) (and (primIs G d1 inrPrim) (isFormula G n g phi)))
                   (if (c0 1 (cons a g1) 0 hs (subst phi (atVar0 (mArr d0 (l2 a b) (var 0)))))
                     (c1 1 (cons b g1) 0 hs (subst phi (atVar0 (mArr d1 (l2 a b) (var 0)))))
                     0)
                   0))
               0))
           0))
        ((and (eq rl 35) (eq k 0)) (and (equal (nth g d0) (some cZero)) (isFormula G n g phi)))
        ((and (eq rl 36) (eq k 1))
         (let*
           ((th Ts (children d1))
            (mp (Option.Maybe Primitive) (Option.nthOf Primitive (gPrims G) d0)))
           (if (and (not (isEmpty g)) (Option.isJust Primitive mp))
             (let*
               ((c T (at g 0)) (g1 Ts (tail g)) (p Primitive (Option.fromMaybe Primitive prim0 mp)))
               (if (and (isCoeqProj p) (Option.isJust Terms (lowerHyps G n g1 hs)))
                 (if
                   (and (eq (length th) (prArity p))
                     (and (allT (isTy G n) th)
                       (and (equal c (phSubst th (prCod p))) (isFormula G n g phi))))
                   (c0 1 (cons (phSubst th (prDom p)) g1) 0 hs
                     (subst phi (atVar0 (mArr d0 th (var 0)))))
                   0)
                 0))
             0)))
        ((and (eq rl 30) (eq k 0))
         (if (Option.isJust TPair ep)
           (let mq (Option.Maybe Sequent) (compileEq G n g tt uu)
             (if (Option.isJust Sequent mq) (certifies G E d0 (Option.fromMaybe Sequent seq0 mq))
               0))
           0))
        ((and (eq rl 31) (eq k 0))
         (if (and (allT (isFormula G n g) hs) (isFormula G n g phi))
           (certifies G E d0 (thmSeq G (mkThm n (objs g) (terms hs) phi)))
           0))
        ((and (eq rl 32) (eq k 2))
         (if (and (Option.isJust TPair ep) (eq (length g) 1))
           (let* ((r T (at g 0)) (mC T (typeIn G n g tt)) (ma T (roseLabel r)))
             (if (and (isSome mC) (isSome ma))
               (let*
                 ((C T (get mC)) (a T (get ma)) (s T (at rd 3)) (kl T d1) (kc T (at rd 2))
                  (g2 Ts (l2 (list r) a)))
                 (if
                   (and (rosePrimsOk G d0 kl kc r a)
                     (and (equal (typeIn G n g uu) (some C))
                       (equal (typeIn G n (l2 (list C) a) s) (some C))))
                   (if
                     (c0 1 g2 0 (nil T)
                       (mEq (roseNodeAt d0 r a tt) (subst s (atVar0 (roseMapAt kl kc C tt)))))
                     (c1 1 g2 0 (nil T)
                       (mEq (roseNodeAt d0 r a uu) (subst s (atVar0 (roseMapAt kl kc C uu)))))
                     0)
                   0))
               0))
           0))
        ((and (eq rl 33) (eq k 1))
         (if (not (isEmpty g))
           (let*
             ((r T (at g 0)) (g1 Ts (tail g)) (ma T (roseLabel r))
              (mH (Option.Maybe Terms) (lowerHyps G n g1 hs)))
             (if (and (isSome ma) (Option.isJust Terms mH))
               (let* ((a T (get ma)) (kc T (at rd 2)))
                 (if (and (rosePrimsOk G d0 d1 kc r a) (isFormula G n g phi))
                   (c0 1 (cons (list r) (cons a g1)) 0
                     (append (mapT weaken2 (termsOr mH)) (single (roseHyp d1 kc phi)))
                     (roseNodeAt d0 r a phi))
                   0))
               0))
           0))
        (else 0))))

  ; the proving by the application of a theorem, of the premises' composed provings pa
  (deftype PAll (Arrow Ts (Arrow Ts (Arrow Ts T))))
  (defn proveAll ((cs CKs)) PAll
    (foldr CK PAll
      (lam ((c CK) (rest PAll) (g Ts) (hs Ts) (fs Ts))
        (lcase T T fs 0 (lam ((f T) (fs1 Ts)) (and (c 1 g 0 hs f) (rest g hs fs1)))))
      (lam ((g Ts) (hs Ts) (fs Ts)) (isEmpty fs))
      cs))
  (defn proveApply
    ((G Globals) (E (List Entry)) (n T) (rd Ts) (k T) (pa PAll) (g Ts) (hs Ts) (phi T))
    T
    (let*
      ((th Ts (children (at rd 1))) (sg Ts (children (at rd 2)))
       (ma (Option.Maybe Thm) (thmAt E (at rd 0))))
      (if (Option.isJust Thm ma)
        (let a Thm (Option.fromMaybe Thm thm0 ma)
          (if
            (and (instOk G n g a th sg)
              (and (equal phi (instTerm th sg (thConcl a))) (eq k (length (thHyps a)))))
            (pa g hs (mapT (lam ((h T)) (instTerm th sg h)) (thHyps a)))
            0))
        0)))

  ; the checker: the paramorphism of a derivation whose result at a node is the rewriting and the
  ; proving it performs, selected by a mode; its step takes the list of the premises' results apart
  ; once, composing them into one function at a congruence and at the application of a theorem
  (defn stepAt ((G Globals) (E (List Entry)) (n T) (rl T) (rd Ts) (m T) (c0 CK) (c1 CK) (c2 CK)) CK
    (lam ((md T) (g Ts) (k T) (hs Ts) (t T))
      (if md (proveStep G E n rl rd m c0 c1 c2 g hs t) (rewriteStep G E n rl rd m c0 c1 g k hs t))))
  (defn checkStep ((G Globals) (E (List Entry)) (n T) (nd T) (rs CKs)) CK
    (let*
      ((rl T (label nd)) (rd Ts (children (child nd 0))) (ds Ts (tail (children nd)))
       (m T (length ds)))
      (lcase CK CK rs ck0
        (lam ((r0 CK) (cs CKs))
          (cond
            ((eq rl 2)
             (let f CR (congAll cs)
               (lam ((md T) (g Ts) (k T) (hs Ts) (t T)) (if md 0 (congStep G n ds f g k hs t)))))
            ((eq rl 27)
             (let pa PAll (proveAll cs)
               (lam ((md T) (g Ts) (k T) (hs Ts) (t T))
                 (if md (proveApply G E n rd m pa g hs t) none))))
            (else
              (lcase CK CK cs (stepAt G E n rl rd m ck0 ck0 ck0)
                (lam ((c0 CK) (cs1 CKs))
                  (lcase CK CK cs1 (stepAt G E n rl rd m c0 ck0 ck0)
                    (lam ((c1 CK) (cs2 CKs))
                      (lcase CK CK cs2 (stepAt G E n rl rd m c0 c1 ck0)
                        (lam ((c2 CK) (cs3 CKs)) (stepAt G E n rl rd m c0 c1 c2)))))))))))))
  (defn check ((G Globals) (E (List Entry)) (n T) (d T)) CK (para CK (checkStep G E n) d))

  ; whether a derivation proves a theorem
  (defn thmChecks ((G Globals) (E (List Entry)) (a Thm) (d T)) T
    (let* ((n T (thArity a)) (g Ts (thCtx a)))
      (if
        (and (allT (isTy G n) g)
          (and (allT (isFormula G n g) (thHyps a)) (isFormula G n g (thConcl a))))
        ((check G E n d) 1 g 0 (thHyps a) (thConcl a))
        0)))

  ; the confirmation of primitive arrows, object definitions and definitions of the language
  (defn primSeq ((p Primitive)) Sequent
    (mkSeq (replicate (prArity p) Sorts.obj) (nil Eqn)
      (eqn (comp (idt (prCod p)) (comp (prArrow p) (idt (prDom p)))) (prArrow p))))
  (defn primConfirms ((G Globals) (E (List Entry)) (p Primitive) (c T)) T
    (if (isSome c)
      (if (anyDefs G (lam ((cds (List PDefn))) (primWf G (thySig (ext cds)) p)))
        (certifies G E (get c) (primSeq p))
        0)
      (anyDefs G
        (lam ((cds (List PDefn)))
          (if (eq (gBase G) (Seq.length OpSig sig)) (primOk G (envOfDefs cds) p) 0)))))
  (defn objConfirms ((G Globals) (E (List Entry)) (m T) (b T) (c T)) T
    (if (isSome c)
      (if
        (anyDefs G
          (lam ((cds (List PDefn)))
            (equal (sortOf (thySig (ext cds)) (replicate m Sorts.obj) b) (some Sorts.obj))))
        (certifies G E (get c) (mkSeq (replicate m Sorts.obj) (nil Eqn) (dfd b)))
        0)
      (anyDefs G
        (lam ((cds (List PDefn)))
          (if (eq (gBase G) (Seq.length OpSig sig)) (objOk (envOfDefs cds) m b) 0)))))
  (defn ldChecks ((G Globals) (d LDefn)) T
    (and (Option.isJust PDefn (ldCompile G d)) (isTy G (ldArity d) (ldType d))))

  ; declarations, and the state of a development
  (data Decl (declLang Thm T) (declComb Sequent T) (declDef LDefn) (declConst Primitive T)
    (declObj T T T)
    (declQuot T T T)
    (declDesc T T T T))
  (data EntryList (entries & Entry))
  (data DevState (devState Globals EntryList))

  (defn stateOf ((G Globals) (E (List Entry))) DevState (devState G (entries E)))
  (defn withPrims ((G Globals) (ps (List Primitive))) Globals
    (globals (prims ps) (defs (gDefs G)) (gBase G)))
  (defn withDefs ((G Globals) (ds (List Definition))) Globals
    (globals (prims (gPrims G)) (defs ds) (gBase G)))
  (defn push ((E (List Entry)) (e Entry)) (List Entry) (Seq.append Entry E (Seq.single Entry e)))
  (defn pushPrim ((ps (List Primitive)) (p Primitive)) (List Primitive)
    (Seq.append Primitive ps (Seq.single Primitive p)))
  (defn pushDef ((ds (List Definition)) (d Definition)) (List Definition)
    (Seq.append Definition ds (Seq.single Definition d)))
  (defn sortsArr ((G Globals) (m T) (f T)) T
    (anyDefs G
      (lam ((cds (List PDefn)))
        (equal (sortOf (thySig (ext cds)) (replicate m Sorts.obj) f) (some Sorts.arr)))))

  ; the bindings of optional values into optional states, as the base binds optional trees
  (defn bindPD ((m (Option.Maybe TPair)) (f (Arrow TPair (Option.Maybe DevState))))
    (Option.Maybe DevState)
    (case m ((Option.just TPair p) (f p)) ((Option.nothing TPair) (Option.nothing DevState))))
  (defn bindRD ((m (Option.Maybe Primitive)) (f (Arrow Primitive (Option.Maybe DevState))))
    (Option.Maybe DevState)
    (case m ((Option.just Primitive p) (f p))
      ((Option.nothing Primitive) (Option.nothing DevState))))
  (defn bindHD ((m (Option.Maybe Thm)) (f (Arrow Thm (Option.Maybe DevState))))
    (Option.Maybe DevState)
    (case m ((Option.just Thm a) (f a)) ((Option.nothing Thm) (Option.nothing DevState))))
  (defn bindTD ((m T) (f (Arrow T (Option.Maybe DevState)))) (Option.Maybe DevState)
    (if (isSome m) (f (get m)) (Option.nothing DevState)))
  (defn bindSD ((m (Option.Maybe DevState)) (f (Arrow DevState (Option.Maybe DevState))))
    (Option.Maybe DevState)
    (case m ((Option.just DevState a) (f a)) ((Option.nothing DevState) (Option.nothing DevState))))
  (defn stConsts ((st DevState)) Globals (case st ((devState G E) G)))
  (defn stEntries ((st DevState)) (List Entry)
    (case st ((devState G E) (case E ((entries & xs) xs)))))

  ; the quotient of a type by a relation
  (defn quotStep ((G Globals) (E (List Entry)) (n T) (A T) (R T)) (Option.Maybe DevState)
    (let AA Ts (l2 A A)
      (bindPD ((compile G n R) (ctxObj AA) (stdEnv AA))
        (lam ((rt TPair))
          (let*
            ((f T (relL A (p1 rt))) (g T (relR A (p1 rt)))
             (q Primitive
               (primitive n (coeqProj f g) A
                 (phOp (add (gBase G) (Seq.length Definition (gDefs G))) (objVars n))))
             (G2 Globals
               (globals (prims (pushPrim (gPrims G) q))
                 (defs (pushDef (gDefs G) (defObj n (coeqz f g))))
                 (gBase G)))
             (k T (Seq.length Primitive (gPrims G)))
             (rel Thm
               (mkThm n (objs AA) (terms (single R))
                 (mEq (mArr k (objVars n) (var 1)) (mArr k (objVars n) (var 0))))))
            (if
              (and (eq (gBase G) (Seq.length OpSig sig))
                (and (isTy G n A)
                  (and (equal (p2 rt) omega)
                    (and (scoped n (prArrow q))
                      (and (isTy G2 n (prCod q))
                        (and (sortsArr G n (prArrow q)) (isFormula G2 n AA (thConcl rel))))))))
              (Option.just DevState (stateOf G2 (push E (entLang rel))))
              (Option.nothing DevState)))))))

  ; the descent of a function through a quotient
  (defn descStep ((G Globals) (E (List Entry)) (kq T) (C T) (h T) (jr T)) (Option.Maybe DevState)
    (bindRD (Option.nthOf Primitive (gPrims G) kq)
      (lam ((p Primitive))
        (bindHD (bindEH (Option.nthOf Entry E jr) entryLanguage)
          (lam ((Th Thm))
            (bindTD (primRel p)
              (lam ((r T))
                (let* ((m T (prArity p)) (D Ts (single (prDom p))))
                  (bindPD ((compile G m h) (ctxObj D) (stdEnv D))
                    (lam ((HC TPair))
                      (if (eq (length (thHyps Th)) 1)
                        (let*
                          ((R2 T (at (thHyps Th) 0)) (DD Ts (l2 (prDom p) (prDom p)))
                           (dp Primitive
                             (primitive m (coeqDesc (relL (prDom p) r) (relR (prDom p) r) (p1 HC))
                               (prCod p)
                               C))
                           (G2 Globals (withPrims G (pushPrim (gPrims G) dp)))
                           (dq T
                             (mArr (Seq.length Primitive (gPrims G)) (objVars m)
                               (mArr kq (objVars m) (var 0))))
                           (cmp Thm (mkThm m (objs D) (terms (nil T)) (mEq dq h))))
                          (if
                            (and (eq (gBase G) (Seq.length OpSig sig))
                              (and (equal (p2 HC) C)
                                (and (isTy G m C)
                                  (and (eq (thArity Th) m)
                                    (and (equalTs (thCtx Th) DD)
                                      (and (equal (thConcl Th) (mEq (weaken1 h) h))
                                        (and
                                          (equal (rep ((compile G m R2) (ctxObj DD) (stdEnv DD)))
                                            (rep (Option.just TPair (pr r omega))))
                                          (and (scoped m (prArrow dp))
                                            (and (sortsArr G m (prArrow dp))
                                              (isFormula G2 m D (thConcl cmp)))))))))))
                            (Option.just DevState (stateOf G2 (push E (entLang cmp))))
                            (Option.nothing DevState)))
                        (Option.nothing DevState))))))))))))

  ; the state after a declaration, where its proof proves it with the constants and the entries
  ; before it
  (defn declStep ((G Globals) (E (List Entry)) (d Decl)) (Option.Maybe DevState)
    (case d
      ((declLang a dv)
       (if (thmChecks G E a dv) (Option.just DevState (stateOf G (push E (entLang a))))
         (Option.nothing DevState)))
      ((declComb s c)
       (if (certifies G E c s) (Option.just DevState (stateOf G (push E (entComb s))))
         (Option.nothing DevState)))
      ((declDef df)
       (if (ldChecks G df)
         (Option.just DevState (stateOf (withDefs G (pushDef (gDefs G) (defLang df))) E))
         (Option.nothing DevState)))
      ((declConst p c)
       (if (primConfirms G E p c)
         (Option.just DevState (stateOf (withPrims G (pushPrim (gPrims G) p)) E))
         (Option.nothing DevState)))
      ((declObj m b c)
       (if (objConfirms G E m b c)
         (Option.just DevState (stateOf (withDefs G (pushDef (gDefs G) (defObj m b))) E))
         (Option.nothing DevState)))
      ((declQuot m A R) (quotStep G E m A R))
      ((declDesc kq C h jr) (descStep G E kq C h jr))))

  ; the state after a development, each declaration proved with those before it

  (defn checkDev ((G Globals) (E (List Entry)) (ds (List Decl))) (Option.Maybe DevState)
    (foldr Decl (Option.Maybe DevState)
      (lam ((d Decl) (st (Option.Maybe DevState)))
        (bindSD st (lam ((s DevState)) (declStep (stConsts s) (stEntries s) d))))
      (Option.just DevState (stateOf G E))
      (Seq.reverse Decl ds))))
