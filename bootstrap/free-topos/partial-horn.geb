;
; Partial Horn logic over rose trees, written in the datatype language, deciding as
; Geb.PartialHorn decides: the sorts of terms, their variables' scope and substitution,
; sequents, the checker of certificates, and the extension of a theory by definitions. A term
; is a rose tree, a variable the node of label 0 over the leaf of its index and an operation's
; application the node of the operation's index plus one; a sort is a label. An operation's
; signature is the node of label 0 over the node of its arguments' sorts and its sort, an
; equation the node of label 0 over its sides, a sequent the node of label 0 over the node of
; its context's sorts, the node of its hypotheses and its conclusion, a theory the node of label
; 0 over the node of its signature and the node of its axioms, and a definition the node of
; label 0 over the node of its arguments' sorts, its sort and its body, as their datatypes
; declare them. Requires the prelude, the lists of bootstrap/seq.geb and the base.

(module PartialHorn
  (export PRule.hyp PRule.refl PRule.symm PRule.trans PRule.cong PRule.strict PRule.ax PRule.thm
    phVar
    phOp
    PT
    PTs
    ptTrees
    ptValues
    SortList
    sorts
    OpSig
    opSig
    opArgs
    opSort
    sortOf
    scoped
    phSubst
    Eqn
    eqn
    eqLhs
    eqRhs
    eqSubst
    EqnList
    eqns
    sameEqns
    Sequent
    seq
    seqCtx
    seqHyps
    seqConcl
    mkSeq
    seqScoped
    OpSigList
    opSigs
    SeqList
    seqs
    Theory
    theory
    thySig
    thyAxioms
    PhChk
    inst
    pcheck
    PDefn
    pdefn
    PDefnList
    pdefns
    pdCtx
    pdSort
    pdBody
    opVars
    pdAxioms
    thyExtendAll
    OOpSig.Maybe
    OOpSig.nothing
    OOpSig.just
    OOpSig.isJust
    OOpSig.fromMaybe
    OOpSig.nthOf
    OOpSig.allJust
    OEqn.Maybe
    OEqn.nothing
    OEqn.just
    OEqn.isJust
    OEqn.fromMaybe
    OEqn.nthOf
    OEqn.allJust
    OSequent.Maybe
    OSequent.nothing
    OSequent.just
    OSequent.isJust
    OSequent.fromMaybe
    OSequent.nthOf
    OSequent.allJust
    OPDefn.Maybe
    OPDefn.nothing
    OPDefn.just
    OPDefn.isJust
    OPDefn.fromMaybe
    OPDefn.nthOf
    OPDefn.allJust
    OPDefnList.Maybe
    OPDefnList.nothing
    OPDefnList.just
    OPDefnList.isJust
    OPDefnList.fromMaybe)
  (import Prelude)
  (import Base)
  ; the labels of the certificates' rules, as Geb.PartialHorn.Rule names them
  (defnum PRule.hyp 0)
  (defnum PRule.refl 1)
  (defnum PRule.symm 2)
  (defnum PRule.trans 3)
  (defnum PRule.cong 4)
  (defnum PRule.strict 5)
  (defnum PRule.ax 6)
  (defnum PRule.cut 7)
  (defnum PRule.thm 8)

  ; terms
  (defn phVar ((i T)) T (node 0 (single (node i (nil T)))))
  (defn phOp ((k T) (ts Ts)) T (node (add k 1) ts))

  ; the fold of a tree with the tree at each node, for paramorphisms
  (deftype PT (Prod T T))
  (deftype PTs (List PT))
  (defn ptTrees ((rs PTs)) Ts (foldr PT Ts (lam ((r PT) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
  (defn ptValues ((rs PTs)) Ts (foldr PT Ts (lam ((r PT) (acc Ts)) (cons (snd r) acc)) (nil T) rs))

  ; signatures: an operation's arguments' sorts and its sort
  (data SortList (sorts & T))
  (data OpSig (opSig SortList T))
  (import (Option OpSig) as OOpSig)
  (defn opArgs ((o OpSig)) Ts (case o ((opSig as s) (case as ((sorts xs) xs)))))
  (defn opSort ((o OpSig)) T (case o ((opSig as s) s)))

  ; the binding of an optional signature into an optional tree, as the base binds optional trees
  (defn bindOT ((m OOpSig.Maybe) (f (Arrow OpSig T))) T
    (case m ((OOpSig.just o) (f o)) ((OOpSig.nothing) none)))

  ; the sort of a term in a context of sorts, or nothing when it is not well sorted
  (defn sortOf ((S (List OpSig)) (ctx Ts) (t T)) T
    (snd
      (fold PT
        (lam ((l T) (rs PTs))
          (let cs Ts (ptTrees rs)
            (pair (node l cs)
              (if (eq l 0)
                (if (eq (length cs) 1)
                  (let i T (at cs 0) (if (eq (arity i) 0) (nth ctx (label i)) none))
                  none)
                (bindOT (OOpSig.nthOf S (sub l 1))
                  (lam ((o OpSig))
                    (if (equalTs (ptValues rs) (mapT some (opArgs o))) (some (opSort o)) none)))))))
        t)))

  ; whether every variable of a term has an index below n
  (defn scoped ((n T) (t T)) T
    (snd
      (fold PT
        (lam ((l T) (rs PTs))
          (let cs Ts (ptTrees rs)
            (pair (node l cs)
              (if (eq l 0)
                (if (eq (length cs) 1) (let i T (at cs 0) (and (eq (arity i) 0) (lt (label i) n)))
                  0)
                (allT (lam ((b T)) b) (ptValues rs))))))
        t)))

  ; the substitution of terms for a term's variables, by index; a variable beyond the terms, and a
  ; node of label 0 that is not a variable, is left in place
  (defn phSubst ((ts Ts) (t T)) T
    (snd
      (fold PT
        (lam ((l T) (rs PTs))
          (let cs Ts (ptTrees rs)
            (pair (node l cs)
              (if (and (eq l 0) (eq (length cs) 1))
                (let i T (at cs 0)
                  (if (eq (arity i) 0) (getD (nth ts (label i)) (phVar (label i))) (node 0 cs)))
                (node l (ptValues rs))))))
        t)))

  ; equations and sequents
  (data Eqn (eqn T T))
  (defn eqLhs ((q Eqn)) T (case q ((eqn s t) s)))
  (defn eqRhs ((q Eqn)) T (case q ((eqn s t) t)))
  (defn eqSubst ((ts Ts) (q Eqn)) Eqn (eqn (phSubst ts (eqLhs q)) (phSubst ts (eqRhs q))))
  (defn eqScoped ((n T) (q Eqn)) T (and (scoped n (eqLhs q)) (scoped n (eqRhs q))))
  (data EqnList (eqns & Eqn))
  (import (Seq Eqn) as Eqns)
  (import (Each Eqn) as EachEqn)
  (import (Option Eqn) as OEqn)
  (import (Seq OEqn.Maybe) as OEqns)
  (import (Each OEqn.Maybe) as EachOEqn)
  (data OEqnList (oeqns & OEqn.Maybe))
  (defn sameEqns ((xs (List Eqn)) (ys (List Eqn))) T (equal (rep (eqns xs)) (rep (eqns ys))))
  (defn sameOEqns ((xs (List OEqn.Maybe)) (ys (List OEqn.Maybe))) T
    (equal (rep (oeqns xs)) (rep (oeqns ys))))
  (data Sequent (seq SortList EqnList Eqn))
  (import (Option Sequent) as OSequent)
  (defn seqCtx ((a Sequent)) Ts (case a ((seq c h q) (case c ((sorts xs) xs)))))
  (defn seqHyps ((a Sequent)) (List Eqn) (case a ((seq c h q) (case h ((eqns xs) xs)))))
  (defn seqConcl ((a Sequent)) Eqn (case a ((seq c h q) q)))
  (defn mkSeq ((ctx Ts) (hs (List Eqn)) (q Eqn)) Sequent (seq (sorts ctx) (eqns hs) q))
  (defn seqScoped ((a Sequent)) T
    (let n T (length (seqCtx a))
      (and (EachEqn.all (eqScoped n) (seqHyps a)) (eqScoped n (seqConcl a)))))

  ; theories: a signature and axioms
  (data OpSigList (opSigs & OpSig))
  (data SeqList (seqs & Sequent))
  (data Theory (theory OpSigList SeqList))
  (defn thySig ((th Theory)) (List OpSig) (case th ((theory s a) (case s ((opSigs xs) xs)))))
  (defn thyAxioms ((th Theory)) (List Sequent) (case th ((theory s a) (case a ((seqs xs) xs)))))

  ; the checker's result at a certificate: an optional equation, as a function of the context's
  ; sorts and the hypotheses
  (deftype PhChk (Arrow Ts (Arrow (List Eqn) OEqn.Maybe)))
  (deftype PC (Prod T PhChk))
  (deftype PCs (List PC))
  (defn pcTrees ((rs PCs)) Ts (foldr PC Ts (lam ((r PC) (acc Ts)) (cons (fst r) acc)) (nil T) rs))
  (defn pcResults ((rs PCs) (ctx Ts) (hs (List Eqn))) (List OEqn.Maybe)
    (foldr PC (List OEqn.Maybe) (lam ((r PC) (acc (List OEqn.Maybe))) (cons ((snd r) ctx hs) acc))
      (nil OEqn.Maybe)
      rs))
  (import (Lists PC) as PCs)
  (defn pcPrem ((rs PCs) (i T)) PhChk
    (lcase PC PhChk (iter PCs PCs.tail rs i) (lam ((ctx Ts) (hs (List Eqn))) OEqn.nothing)
      (lam ((r PC) (rest PCs)) (snd r))))
  ; an optional equation's left and right sides, as optional trees
  (defn lhsOf ((m OEqn.Maybe)) T (case m ((OEqn.just q) (some (eqLhs q))) ((OEqn.nothing) none)))
  (defn rhsOf ((m OEqn.Maybe)) T (case m ((OEqn.just q) (some (eqRhs q))) ((OEqn.nothing) none)))

  ; the binding and image of optional equations, sequents and trees into optional equations, as
  ; the base binds and maps optional trees
  (defn bindE ((m OEqn.Maybe) (f (Arrow Eqn OEqn.Maybe))) OEqn.Maybe
    (case m ((OEqn.just q) (f q)) ((OEqn.nothing) OEqn.nothing)))
  (defn mapE ((f (Arrow Eqn Eqn)) (m OEqn.Maybe)) OEqn.Maybe
    (case m ((OEqn.just q) (OEqn.just (f q))) ((OEqn.nothing) OEqn.nothing)))
  (defn bindSE ((m OSequent.Maybe) (f (Arrow Sequent OEqn.Maybe))) OEqn.Maybe
    (case m ((OSequent.just a) (f a)) ((OSequent.nothing) OEqn.nothing)))
  (defn bindTE ((m T) (f (Arrow T OEqn.Maybe))) OEqn.Maybe (if (isSome m) (f (get m)) OEqn.nothing))
  (defn mapTE ((f (Arrow T Eqn)) (m T)) OEqn.Maybe
    (if (isSome m) (OEqn.just (f (get m))) OEqn.nothing))

  ; the index a leaf names
  (defn leafIndex ((t T)) T (if (eq (arity t) 0) (some (label t)) none))

  ; the instance of a sequent at the terms of a certificate's node: the terms for the context's
  ; variables, then a premise for each term whose conclusion's left side is that term, then a
  ; premise for each hypothesis whose conclusion is its instance
  (import (Map OEqn.Maybe T) as LhsOf)
  (import (Map Eqn OEqn.Maybe) as JustEqn)
  (defn inst ((S (List OpSig)) (a Sequent) (cs PCs) (ctx Ts) (hs (List Eqn))) OEqn.Maybe
    (let n T (length (seqCtx a))
      (let ts Ts (take n (pcTrees cs))
        (let rs (List OEqn.Maybe) (pcResults cs ctx hs)
          (if
            (and (seqScoped a)
              (and (equalTs (mapT (sortOf S ctx) ts) (mapT some (seqCtx a)))
                (and (equalTs (LhsOf.map lhsOf (EachOEqn.take n (OEqns.drop n rs))) (mapT some ts))
                  (sameOEqns (OEqns.drop (add n n) rs)
                    (JustEqn.map (lam ((h Eqn)) (OEqn.just (eqSubst ts h))) (seqHyps a))))))
            (OEqn.just (eqSubst ts (seqConcl a)))
            OEqn.nothing)))))

  ; one rule of the checker, by the label of a certificate's node
  (defn pShape ((l T) (k T) (l0 T) (k0 T)) T (and (eq l l0) (eq k k0)))
  (defn pcheckStep ((th Theory) (E (List Sequent)) (l T) (cs Ts) (rs PCs) (ctx Ts) (hs (List Eqn)))
    OEqn.Maybe
    (let k T (length cs)
      (let c0 T (at cs 0)
        (if (pShape l k PRule.hyp 1) (bindTE (leafIndex c0) (lam ((i T)) (OEqn.nthOf hs i)))
          (if (pShape l k PRule.refl 1)
            (bindTE (leafIndex c0)
              (lam ((i T))
                (if (lt i (length ctx)) (OEqn.just (eqn (phVar i) (phVar i))) OEqn.nothing)))
            (if (pShape l k PRule.symm 1)
              (mapE (lam ((q Eqn)) (eqn (eqRhs q) (eqLhs q))) ((pcPrem rs 0) ctx hs))
              (if (pShape l k PRule.trans 2)
                (bindE ((pcPrem rs 0) ctx hs)
                  (lam ((q Eqn))
                    (bindE ((pcPrem rs 1) ctx hs)
                      (lam ((q2 Eqn))
                        (if (equal (eqRhs q) (eqLhs q2)) (OEqn.just (eqn (eqLhs q) (eqRhs q2)))
                          OEqn.nothing)))))
                (if (and (eq l PRule.cong) (lt 0 k))
                  (bindE ((pcPrem rs 0) ctx hs)
                    (lam ((q Eqn))
                      (let res (List OEqn.Maybe) (pcResults (PCs.tail rs) ctx hs)
                        (if
                          (and (not (eq (label (eqLhs q)) 0))
                            (equalTs (LhsOf.map lhsOf res) (mapT some (children (eqLhs q)))))
                          (mapTE
                            (lam ((ts T)) (eqn (eqLhs q) (node (label (eqLhs q)) (children ts))))
                            (allSomeT (LhsOf.map rhsOf res)))
                          OEqn.nothing))))
                  (if (pShape l k PRule.strict 2)
                    (bindTE (leafIndex c0)
                      (lam ((j T))
                        (bindE ((pcPrem rs 1) ctx hs)
                          (lam ((q Eqn))
                            (if (not (eq (label (eqLhs q)) 0))
                              (mapTE (lam ((t T)) (eqn t t)) (nth (children (eqLhs q)) j))
                              OEqn.nothing)))))
                    (if (and (eq l PRule.ax) (lt 0 k))
                      (bindTE (leafIndex c0)
                        (lam ((j T))
                          (bindSE (OSequent.nthOf (thyAxioms th) j)
                            (lam ((a Sequent)) (inst (thySig th) a (PCs.tail rs) ctx hs)))))
                      (if (pShape l k PRule.cut 2)
                        (bindE ((pcPrem rs 0) ctx hs)
                          (lam ((h Eqn)) ((pcPrem rs 1) ctx (cons h hs))))
                        (if (and (eq l PRule.thm) (lt 0 k))
                          (bindTE (leafIndex c0)
                            (lam ((j T))
                              (bindSE (OSequent.nthOf E j)
                                (lam ((a Sequent)) (inst (thySig th) a (PCs.tail rs) ctx hs)))))
                          OEqn.nothing))))))))))))

  ; the checker: the conclusion of a certificate in a theory and an environment of theorems, as a
  ; function of the context's sorts and the hypotheses
  (defn pcheck ((th Theory) (E (List Sequent)) (c T)) PhChk
    (snd
      (fold PC
        (lam ((l T) (rs PCs))
          (let cs Ts (pcTrees rs)
            (pair (node l cs) (lam ((ctx Ts) (hs (List Eqn))) (pcheckStep th E l cs rs ctx hs)))))
        c)))

  ; definitions of operations: the arguments' sorts, the sort and the body
  (data PDefn (pdefn SortList T T))
  (data PDefnList (pdefns & PDefn))
  (import (Option PDefn) as OPDefn)
  (import (Option PDefnList) as OPDefnList)
  (defn pdCtx ((d PDefn)) Ts (case d ((pdefn c s b) (case c ((sorts xs) xs)))))
  (defn pdSort ((d PDefn)) T (case d ((pdefn c s b) s)))
  (defn pdBody ((d PDefn)) T (case d ((pdefn c s b) b)))

  ; the application of the operation of index n to the first m variables
  (defn opVars ((n T) (m T)) T (phOp n (mapT phVar (range m))))

  ; the axioms of a definition as the operation of index n: the operation is defined where the
  ; body is and equal to it there, and defined only where the body is
  (import (Seq Sequent) as Seqs)
  (import (Seq OpSig) as OpSigs)
  (defn pdAxioms ((n T) (d PDefn)) (List Sequent)
    (let t T (opVars n (length (pdCtx d)))
      (let b T (pdBody d)
        (cons (mkSeq (pdCtx d) (Eqns.single (eqn b b)) (eqn t b))
          (Seqs.single (mkSeq (pdCtx d) (Eqns.single (eqn t t)) (eqn b b)))))))

  ; the extension of a theory by a definition, and by a list of definitions in order
  (defn thyExtend ((th Theory) (d PDefn)) Theory
    (let S (List OpSig) (thySig th)
      (theory (opSigs (OpSigs.append S (OpSigs.single (opSig (sorts (pdCtx d)) (pdSort d)))))
        (seqs (Seqs.append (thyAxioms th) (pdAxioms (OpSigs.length S) d))))))
  (import (Seq PDefn) as PDefns)
  (defn thyExtendAll ((th Theory) (ds (List PDefn))) Theory
    (foldr PDefn Theory (lam ((d PDefn) (acc Theory)) (thyExtend acc d)) th (PDefns.reverse ds))))
