;
; The metalogic: its checker, its translation, its prover, the checker with a step of conversion,
; with the evaluation at literals and the environment machine, its tactics, its combinators, the
; printer, the check of elementary-affine certificates and the checker of proof sketches.
; Each part has a layer of emitted Lean. The kernel checks the entries against the loaded program.

(program metalogic (edition 0) (document (syntax authoring 0) (schema 0) (prose verso 0))
  (layers
    (Checker prelude.geb seq.geb free-topos/base.geb free-topos/partial-horn.geb
      free-topos/theory.geb
      free-topos/infer.geb
      free-topos/language.geb
      free-topos/derivation.geb
      reader.geb
      check.geb)
    (Translation free-topos/translation.geb)
    (Prover free-topos/prove.geb)
    (Conversion free-topos/literals.geb free-topos/machine.geb free-topos/conversion.geb)
    (Tactics free-topos/tactics.geb)
    (Combinator free-topos/combinator.geb)
    (Printer datatype.geb printer.geb)
    (Affine affine.geb)
    (ProofHoles free-topos/holes.geb free-topos/hole-conditions.geb free-topos/hole-plan.geb
      free-topos/hole-sequent.geb
      free-topos/hole-rose.geb
      free-topos/hole-certificates.geb))
  (entries Derivation.checkDev Translation.program Translation.trGlobals Translation.thm
    Prover.prepareRules
    Prover.byNorm
    Prover.byNatInd
    Prover.byListInd
    Prover.byNatIndHyp
    Prover.byListIndHyp
    Prover.byNormW
    Prover.byFunExt
    Prover.bySplit
    Prover.byListIndWith
    Prover.byRoseInd
    Prover.byRoseIndHyp
    Tactics.byMode
    Tactics.byWeak
    Tactics.byNF
    Tactics.normH
    Tactics.funExts
    Tactics.byListIndWeak
    Tactics.byRoseIndWith
    Tactics.byListSplit
    Tactics.bySplit2
    Tactics.byListCases
    Tactics.bitsInd
    Tactics.bitsCases
    Tactics.byBits
    Tactics.byLength3
    Tactics.withWeakHyps
    Tactics.byListIndHypWeak
    Tactics.byBitsIndHyp
    Tactics.withInsts
    Tactics.withChildHyps
    Tactics.revertCase
    Tactics.byImpI
    Tactics.withImpElim
    Tactics.bySuccPred
    Tactics.byInsts
    Tactics.byAuto
    Tactics.byTreeSplit
    Tactics.byAutoT
    Tactics.byAutoC
    Tactics.maskRw
    Tactics.byMaskSubs
    Tactics.byGeneralize
    Tactics.byRevert
    Tactics.byLabelClash
    Tactics.withMember
    Tactics.refuteMember
    Tactics.refuteLonger
    Tactics.byFixed
    Tactics.byRest
    Tactics.byLabels
    Tactics.byMemberCases
    Tactics.byMachine
    Combinator.typeTerm
    Combinator.pNormalize
    Combinator.pInst
    Combinator.etaExpand
    Combinator.deltaRule
    Combinator.pByNorm
    Combinator.proveSeq
    Combinator.normalizeThm
    Combinator.instBy
    Combinator.byNatInduction
    Combinator.byListInduction
    Combinator.byListParamInduction
    Combinator.libraryWith
    Combinator.libRules
    Printer.printTermOpt
    Printer.readBack
    PartialHorn.sortOf
    PartialHorn.scoped
    PartialHorn.phSubst
    PartialHorn.pcheck
    PartialHorn.thyExtendAll
    Theory.toposTheory
    Infer.envOfDefs
    Infer.infers
    Derivation.declStep
    Tactics.openSubterms
    Tactics.stuckVar
    Tactics.mentions
    Tactics.matchesOf
    Tactics.condParts
    Tactics.stuckVarC
    Tactics.appsOf
    Tactics.unnodeU
    Tactics.occRewrite
    Tactics.abstractTerm
    Tactics.stuckLength
    Affine.check
    Literals.litEval
    Literals.ready
    Conversion.machineRun
    Conversion.convCheck
    Conversion.thmConvChecks
    Conversion.checkConvDev
    ProofHoles.checkSketch
    ProofHoles.fill
    ProofHoles.finish
    HoleConditions.conditional
    HoleConditions.directCertify
    HoleCertificates.certify))
