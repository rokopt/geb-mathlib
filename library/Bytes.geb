;
; Byte strings. A value of {geb}`Bytes.Bytes` is the node of label 0 over the leaves of its
; bytes, the tree that {lit}`geb-kernel run` reads a file as and whose children it writes as
; bytes; a case analysis gives the list of the bytes. The theorem in {lit}`Bytes.proofs.geb` is
; about {geb}`Bytes.firstLine`.

(module Bytes (export Bytes bytes firstLine)
  ; A byte string, each byte the leaf of its value.
  (data Bytes (bytes & T))
  ; The bytes of a list before its first line feed.
  (note (example (node 0 (Bytes.firstLine (cons 97 (cons 10 (cons 98 (nil T)))))) (quote (0 (97)))))
  (defn firstLine ((cs (List T))) (List T)
    (foldr T (List T) (lam ((c T) (r (List T))) (if (eq c 10) (nil T) (cons c r))) (nil T) cs)))
