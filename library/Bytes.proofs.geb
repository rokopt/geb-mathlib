;
; A theorem about the first line of a list of bytes. A client's proof document imports this one
; and is proved against the client's program.

(proofs 6 (program library)
  ; The first line of bytes that begin with a line feed is empty, at every list of the bytes
  ; after it.
  (theorem first-line-empty (forall ((cs (List T))) (equal (Bytes.firstLine (cons 10 cs)) (nil T)))
    (by (normalize 256))))
