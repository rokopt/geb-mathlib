{
  // Editor and file conventions matching mathlib style.
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.rulers": [100],
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "geb.programs": [{
    "name": "Pair",
    "manifest": "examples/authoring/pair.manifest",
    "proofs": "examples/authoring/Pair.proofs.geb"
  }, {
    "name": "Roundtrip",
    "manifest": "examples/roundtrip/roundtrip.manifest",
    "proofs": "examples/roundtrip/Roundtrip.proofs.geb",
    "record": "examples/roundtrip/record"
  }, {
    "name": "Tree cases",
    "manifest": "bootstrap/expansion.manifest",
    "proofs": "bootstrap/proofs/tree-cases.proofs.geb"
  }]
}
