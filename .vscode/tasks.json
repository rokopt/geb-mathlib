{
  "version": "2.0.0",
  "tasks": [{
    "label": "Geb: format saved file",
    "type": "process",
    "command": "lake",
    "args": ["exe", "geb-fmt", "${file}"],
    "options": { "cwd": "${workspaceFolder}" },
    "problemMatcher": []
  }, {
    "label": "Geb: check saved file",
    "type": "process",
    "command": "lake",
    "args": ["exe", "geb-author", "check", "--cache", ".lake/geb-proof-cache", "${file}"],
    "options": { "cwd": "${workspaceFolder}" },
    "problemMatcher": "$geb"
  }]
}
